<!-- Meta CAPI Parameter Builder (클라이언트) — 랜딩 시 _fbc/_fbp 수집, fbclid 미변형 -->
<script src="https://unpkg.com/meta-capi-param-builder-clientjs@1.3.0/dist/clientParamBuilder.bundle.js"></script>
<script>
(function () {
  function run() {
    if (typeof clientParamBuilder === "undefined" || !clientParamBuilder.processAndCollectAllParams) return;
    clientParamBuilder.processAndCollectAllParams(window.location.href).catch(function (e) {
      console.warn("[Meta ParamBuilder client]", e);
    });
  }
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", run);
  } else {
    run();
  }
})();
</script>
