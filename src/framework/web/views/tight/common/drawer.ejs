<style>
.wh-drawer-overlay {
  background: rgba(0, 0, 0, 0.45);
  z-index: 1;
}

.wh-drawer-panel {
  position: relative;
  z-index: 2;
  isolation: isolate;
  display: flex;
  flex-direction: column;
  min-height: 100%;
  width: min(300px, 82vw);
  background: #fff;
  border-left: none;
  border-radius: 16px 0 0 16px;
  box-shadow: -4px 0 24px rgba(0, 0, 0, 0.12);
  font-family: 'Pretendard', -apple-system, sans-serif;
  color: #111;
}

/* drawer 열릴 때 배경만 블러 (drawer 패널 제외) */
body:has(#my-drawer:checked) .drawer-end ~ * {
  filter: blur(2px);
  -webkit-filter: blur(2px);
}

body:has(#my-drawer:checked) #bottom-nav-bar {
  display: none !important;
}

.wh-drawer-head {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16px 16px 8px;
}

.wh-drawer-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border: none;
  background: transparent;
  color: #111;
  cursor: pointer;
  padding: 0;
}
.wh-drawer-close svg {
  width: 22px;
  height: 22px;
}

.wh-drawer-body {
  flex: 1;
  overflow-y: auto;
}

.wh-drawer-menu {
  list-style: none;
  margin: 0;
  padding: 0 20px;
}

.wh-drawer-menu li {
  border-bottom: 1px solid #f0f0f0;
}
.wh-drawer-menu li:last-child {
  border-bottom: none;
}

.wh-drawer-menu a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 0;
  color: #111;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.3px;
  text-decoration: none;
}
.wh-drawer-menu a:active {
  opacity: 0.65;
}

.wh-drawer-menu__chev {
  flex-shrink: 0;
  width: 14px;
  height: 14px;
  color: #bbb;
}

.wh-drawer-foot {
  margin-top: auto;
  padding: 24px 20px calc(24px + env(safe-area-inset-bottom, 0px));
  border-top: 1px solid #f0f0f0;
}

.wh-drawer-kakao {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 50px;
  border-radius: 10px;
  background: #fee500;
  color: #191919;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: -0.3px;
  text-decoration: none;
}
.wh-drawer-kakao:active {
  filter: brightness(0.96);
}
.wh-drawer-kakao svg {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
}

.wh-drawer-hours {
  margin: 12px 0 0;
  font-size: 12px;
  font-weight: 500;
  color: #999;
  text-align: center;
  letter-spacing: -0.1px;
}
</style>

<div class="drawer-end">
  <input id="my-drawer" type="checkbox" class="drawer-toggle" />

  <div class="drawer-side z-40">
    <label for="my-drawer" class="drawer-overlay wh-drawer-overlay" aria-label="메뉴 닫기"></label>

    <div class="drawer-content wh-drawer-panel">

      <header class="wh-drawer-head">
        <label for="my-drawer" class="wh-drawer-close" aria-label="닫기">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 6l12 12M18 6L6 18"/>
          </svg>
        </label>
      </header>

      <div class="wh-drawer-body">
        <ul class="wh-drawer-menu">
          <li>
            <a href="/saju/ticket">
              <span>티켓</span>
              <svg class="wh-drawer-menu__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </a>
          </li>
          <li>
            <a href="/saju/review">
              <span>유료 운세 결과 다시보기</span>
              <svg class="wh-drawer-menu__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </a>
          </li>
          <li>
            <a href="/saju/reviews">
              <span>이용 후기</span>
              <svg class="wh-drawer-menu__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <% const KAKAO_INQUIRY_URL = "https://pf.kakao.com/_qxgixfX/friend"; %>
      <footer class="wh-drawer-foot">
        <a class="wh-drawer-kakao" href="<%= KAKAO_INQUIRY_URL %>" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M12 3C6.48 3 2 6.58 2 11c0 2.84 1.87 5.33 4.66 6.77-.2.74-.73 2.69-.84 3.12-.13.5.18.49.38.36.16-.1 2.55-1.73 3.59-2.42.66.1 1.34.15 2.21.15 5.52 0 10-3.58 10-8S17.52 3 12 3z"/>
          </svg>
          카카오톡 문의
        </a>
        <p class="wh-drawer-hours">운영시간 평일 09:00~18:00</p>
      </footer>

    </div>
  </div>
</div>
