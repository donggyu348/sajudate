<style>
/* =========================
   Luxury Drawer (CSS only)
========================= */

/* overlay */
.luxury-overlay {
  background: rgba(0,0,0,0.65);
}

/* drawer 열렸을 때만 blur */
.drawer-toggle:checked ~ .drawer-side .luxury-overlay {
  backdrop-filter: blur(2px);
  background: radial-gradient(
    circle at top,
    rgba(0,0,0,0.55),
    rgba(0,0,0,0.85)
  );
}

/* panel */
.luxury-panel {
  background: linear-gradient(180deg, #0b0f1a 0%, #05070d 100%);
  box-shadow: 8px 0 40px rgba(0,0,0,0.65);
  border-right: 1px solid rgba(212,175,55,0.18);
}

/* navbar */
.luxury-panel .navbar {
  background: transparent;
  border-bottom: 1px solid rgba(212,175,55,0.18);
}

/* logo icon */
.luxury-panel .logo-circle {
  border-radius: 9999px;
  background: radial-gradient(circle at top left, #ffd700, #b48a2c);
  box-shadow: 0 0 14px rgba(212,175,55,0.55);
}

/* logo text */
.luxury-panel .logo-text {
  font-weight: 700;
  letter-spacing: 0.5px;
  color: #f5f5f5;
}

/* close button */
.luxury-panel .close-icon {
  stroke: rgba(255,255,255,0.7);
  transition: transform .25s ease, stroke .25s ease;
}
.luxury-panel label:hover .close-icon {
  transform: rotate(90deg);
  stroke: #ffd700;
}

/* menu */
.luxury-menu li {
  border: none;
}

.luxury-menu a {
  position: relative;
  border-radius: 14px;
  color: rgba(255,255,255,0.85);
  font-weight: 600;
  letter-spacing: 0.2px;
  transition: all .25s ease;
}

/* gold accent line */
.luxury-menu a::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  width: 2px;
  height: 0%;
  background: linear-gradient(180deg, #ffd700, #ff8c00);
  transform: translateY(-50%);
  transition: height .25s ease;
  border-radius: 2px;
}

/* hover */
.luxury-menu a:hover {
  background: linear-gradient(
    90deg,
    rgba(212,175,55,0.14),
    rgba(212,175,55,0.02)
  );
  color: #ffffff;
  transform: translateX(4px);
}
.luxury-menu a:hover::before {
  height: 60%;
}

/* arrow */
.luxury-menu .arrow {
  fill: rgba(255,255,255,0.5);
  transition: transform .25s ease, fill .25s ease;
}
.luxury-menu a:hover .arrow {
  transform: translateX(4px);
  fill: #ffd700;
}

/* highlight items */
.luxury-highlight {
  color: #ffd700 !important;
  font-weight: 700;
}
</style>

<div class="drawer-end">
  <input id="my-drawer" type="checkbox" class="drawer-toggle" />

  <div class="drawer-side z-40">
    <label for="my-drawer" class="drawer-overlay luxury-overlay"></label>

    <div class="drawer-content min-h-full w-72 md:w-96 luxury-panel text-white">

      <!-- header -->
      <div class="navbar px-4">
        <div class="flex-1">
          <a href="/saju" class="flex items-center gap-3">
            <div class="w-9 h-9 flex items-center justify-center logo-circle">
              <span class="text-black font-bold text-sm" style="font-family: 'Noto Serif KR', serif;">사</span>
            </div>
            <span class="logo-text text-xl font-semibold" style="font-family: 'Noto Serif KR', serif;">사주정감</span>
            <span class="text-amber-400/80 text-xs font-medium tracking-widest uppercase">Saju</span>
          </a>
        </div>

        <div class="flex-none">
          <label for="my-drawer" class="btn btn-square btn-ghost">
            <svg viewBox="0 0 32 32" class="w-5 h-5 close-icon">
              <path d="M2 2 30 30M2 30 30 2" stroke-width="4" fill="none"/>
            </svg>
          </label>
        </div>
      </div>

      <!-- menu -->
      <ul class="menu px-3 py-4 luxury-menu text-base md:text-lg">

        <li>
          <a href="/saju/classic/intro" class="py-4">
            <span>신년사주</span>
            <svg viewBox="0 0 139 139" class="w-6 h-6 ml-auto arrow">
              <path d="M84.629 65.592L62.108 43.257a5.4 5.4 0 0 0-7.637 7.638l18.611 18.609-18.705 18.707a5.398 5.398 0 1 0 7.634 7.635l21.706-21.703a5.37 5.37 0 0 0 0-7.724z"/>
            </svg>
          </a>
        </li>

        <li>
          <a href="/saju/romantic/intro" class="py-4">
            <span>연애사주</span>
            <svg viewBox="0 0 139 139" class="w-6 h-6 ml-auto arrow">
              <path d="M84.629 65.592L62.108 43.257a5.4 5.4 0 0 0-7.637 7.638l18.611 18.609-18.705 18.707a5.398 5.398 0 1 0 7.634 7.635l21.706-21.703a5.37 5.37 0 0 0 0-7.724z"/>
            </svg>
          </a>
        </li>

        <li>
          <a href="/saju/ticket" class="py-4 luxury-highlight">
            티켓
          </a>
        </li>

        <li>
          <a href="/saju/review" class="py-4 luxury-highlight">
            유료 운세 결과 다시보기
          </a>
        </li>


      </ul>
    </div>
  </div>
</div>
