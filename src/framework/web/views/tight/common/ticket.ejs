<!DOCTYPE html>
<html lang="ko">
    <%- include('./../common/header') %>

<body>
    
<div class="ticket-page">
  <div class="ticket-card">
    <p class="ticket-badge">SAJU TICKET</p>

    <h2 class="ticket-title">사주 티켓 등록</h2>
    <p class="ticket-desc">
      문자로 받으신 <b>티켓 코드</b>를 입력하시면<br>
      리포트를 바로 확인하실 수 있어요.
    </p>

    <input
      type="text"
      id="ticketCodeInput"
      placeholder="예) SAJU8F3K"
      class="ticket-input"
    />

    <button class="ticket-btn" onclick="handleTicketVerify()">
      리포트 확인하기
    </button>

    <p class="ticket-footnote">
      티켓은 <b>1회 사용</b> 가능하며,<br>
      이미 사용된 티켓은 재등록이 불가합니다.
    </p>
  </div>
</div>
<style>
.ticket-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background:
    radial-gradient(circle at top, #2a2a2a, #000);
  padding: 20px;
}

.ticket-card {
  width: 100%;
  max-width: 420px;
  background: linear-gradient(180deg, #111, #000);
  border: 1px solid rgba(212,175,55,0.25);
  border-radius: 18px;
  padding: 36px 28px 40px;
  text-align: center;
  box-shadow:
    0 20px 40px rgba(0,0,0,0.6),
    inset 0 0 30px rgba(212,175,55,0.05);
}

.ticket-badge {
  display: inline-block;
  padding: 6px 14px;
  font-size: 12px;
  letter-spacing: 0.18em;
  color: #d4af37;
  border: 1px solid rgba(212,175,55,0.4);
  border-radius: 999px;
  margin-bottom: 18px;
}

.ticket-title {
  color: #fff;
  font-size: 24px;
  margin-bottom: 10px;
}

.ticket-desc {
  color: #aaa;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 26px;
}

.ticket-input {
  width: 100%;
  padding: 16px;
  background: #000;
  border: 1px solid #333;
  border-radius: 10px;
  color: #fff;
  font-size: 16px;
  letter-spacing: 0.15em;
  text-align: center;
  margin-bottom: 18px;
}

.ticket-input::placeholder {
  color: #666;
  letter-spacing: normal;
}

.ticket-input:focus {
  outline: none;
  border-color: #d4af37;
  box-shadow: 0 0 0 1px rgba(212,175,55,0.4);
}

.ticket-btn {
  width: 100%;
  padding: 16px;
  border-radius: 12px;
  background: linear-gradient(135deg, #d4af37, #f1d27a);
  color: #000;
  font-weight: 700;
  font-size: 16px;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}

.ticket-btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 20px rgba(212,175,55,0.35);
}

.ticket-footnote {
  margin-top: 22px;
  font-size: 12px;
  color: #777;
  line-height: 1.5;
}


/* 📱 모바일 반응형 보정 */
@media (max-width: 480px) {

  .ticket-card {
    max-width: 100%;
    padding: 28px 20px 32px;
    border-radius: 16px;
  }

  .ticket-title {
    font-size: 22px;
  }

  .ticket-desc {
    font-size: 15px;
  }

  .ticket-input {
    font-size: 17px;
    letter-spacing: 0.08em; /* ⬅️ 핵심 */
    padding: 18px 14px;
  }

  .ticket-btn {
    font-size: 17px;
    padding: 18px;
  }

  .ticket-badge {
    font-size: 11px;
    padding: 6px 12px;
  }
}

</style>
<script>
function handleTicketVerify() {
  const ticketCode = document.getElementById('ticketCodeInput').value.trim();
  if (!ticketCode) {
    alert('티켓 코드를 입력해주세요.');
    return;
  }
  // 서버의 검증 라우터로 이동 (서버가 티켓 타입에 맞춰 classic/romantic으로 보내줌)
  window.location.href = `/saju/ticket/verify?code=${encodeURIComponent(ticketCode)}`;
}
</script>
</body>
