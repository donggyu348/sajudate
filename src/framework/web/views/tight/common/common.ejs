<%- include('./drawer') %>

<style>
#main-navbar { transition: transform 0.3s ease-out; }
#main-navbar.navbar-scroll-hide { transform: translateY(-100%); }
</style>
<div id="main-navbar" class="fixed top-0 left-0 right-0 z-50 flex justify-center h-14 px-4" style="background: linear-gradient(to bottom, rgba(12,12,12,0.85) 0%, transparent 100%);">
    <div class="w-full max-w-[480px] flex items-center justify-between">
        <a href="/saju" class="flex items-center">
            <span class="font-black text-2xl tracking-tight" style="color: #FF2D55; letter-spacing: -1px; font-family: 'Pretendard', -apple-system, sans-serif;">월하점</span>
        </a>
        <div class="flex items-center gap-1">
            <label for="my-drawer" class="btn btn-ghost btn-circle btn-sm text-white/90 hover:text-white hover:bg-white/5 cursor-pointer" aria-label="메뉴">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </label>
        </div>
    </div>
</div>
<script>
(function() {
  var nav = document.getElementById('main-navbar');
  if (!nav) return;
  var lastY = window.scrollY || window.pageYOffset;
  var threshold = 60;
  function onScroll() {
    var y = window.scrollY || window.pageYOffset;
    if (y > threshold && y > lastY) {
      nav.classList.add('navbar-scroll-hide');
    } else {
      nav.classList.remove('navbar-scroll-hide');
    }
    lastY = y;
  }
  window.addEventListener('scroll', onScroll, { passive: true });
})();
</script>
