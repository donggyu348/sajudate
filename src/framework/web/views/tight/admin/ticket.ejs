<!DOCTYPE html>
<html lang="ko">

<%- include('./../common/header') %>

<body>

<div class="w-full bg-black flex items-start justify-center min-h-screen p-2">
  <div class="container max-w-5xl">
    <div class="bg-white rounded-xl shadow-md overflow-hidden">

      <div class="p-6 border-b border-gray-200 flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
          <h2 class="text-xl font-bold text-gray-800">무료 티켓 발급</h2>
          <p class="text-gray-500 mt-1">
            발급한 코드를 <span class="font-semibold">/saju/ticket</span> 에서 입력하면
            결제 없이 바로 해당 상품 리포트가 만들어집니다.
          </p>
        </div>
        <a href="/admin/payment"
           class="mt-4 md:mt-0 px-4 py-2 text-sm font-semibold rounded-lg border border-gray-300 text-gray-700 hover:bg-gray-50">
          결제내역으로
        </a>
      </div>

      <!-- ===== 발급 ===== -->
      <div class="p-6 border-b border-gray-200">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">상품</label>
            <select id="issue-goods"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500">
              <% goodsList.forEach(function (g) { %>
              <option value="<%= g.code %>"><%= g.title %></option>
              <% }); %>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">장수</label>
            <input id="issue-count" type="number" min="1" max="100" value="1"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500">
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">메모 (선택)</label>
            <input id="issue-memo" type="text" placeholder="예: 인스타 이벤트"
                   class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-indigo-500 focus:border-indigo-500">
          </div>

          <div>
            <button id="issue-btn" type="button"
                    class="w-full px-4 py-2 bg-indigo-600 text-white text-sm font-semibold rounded-lg hover:bg-indigo-700 disabled:opacity-50">
              발급하기
            </button>
          </div>
        </div>

        <!-- 방금 뽑은 코드 -->
        <div id="issue-result" class="hidden mt-5 p-4 bg-indigo-50 border border-indigo-200 rounded-lg">
          <div class="flex items-center justify-between mb-2">
            <p class="text-sm font-bold text-indigo-800" id="issue-result-title"></p>
            <button id="copy-btn" type="button"
                    class="px-3 py-1 text-xs font-semibold rounded border border-indigo-300 text-indigo-700 hover:bg-indigo-100">
              전체 복사
            </button>
          </div>
          <pre id="issue-result-codes"
               class="text-sm font-mono text-gray-800 whitespace-pre-wrap break-all"></pre>
        </div>
      </div>

      <!-- ===== 발급 내역 ===== -->
      <div class="p-6">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4 gap-3">
          <h3 class="text-lg font-bold text-gray-800">발급 내역 <span id="ticket-total" class="text-sm font-normal text-gray-500"></span></h3>
          <div class="flex gap-2">
            <select id="filter-goods" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
              <option value="">전체 상품</option>
              <% goodsList.forEach(function (g) { %>
              <option value="<%= g.code %>"><%= g.title %></option>
              <% }); %>
            </select>
            <select id="filter-used" class="border border-gray-300 rounded-lg px-3 py-2 text-sm">
              <option value="">전체</option>
              <option value="unused">미사용</option>
              <option value="used">사용됨</option>
            </select>
          </div>
        </div>

        <div class="overflow-x-auto border rounded-xl shadow-sm">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">코드</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">상품</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">상태</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">메모</th>
                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">발급일</th>
                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">관리</th>
              </tr>
            </thead>
            <tbody id="ticket-list-body" class="bg-white divide-y divide-gray-200">
              <tr><td colspan="6" class="text-center text-sm text-gray-500 py-4">불러오는 중...</td></tr>
            </tbody>
          </table>
        </div>

        <div id="ticket-pagination" class="mt-4 flex justify-center gap-1"></div>
      </div>

    </div>
  </div>
</div>

<script>
$(function () {
  const esc = (v) => $('<div>').text(v == null ? '' : v).html();

  /* ── 발급 ── */
  $('#issue-btn').on('click', function () {
    const $btn = $(this);
    const goodsType = $('#issue-goods').val();
    const count = $('#issue-count').val();
    const memo = $('#issue-memo').val();

    $btn.prop('disabled', true).text('발급 중...');

    $.ajax({
      url: '/admin/ticket/issue',
      type: 'POST',
      data: { goodsType, count, memo },
      success: function (res) {
        const d = res.data;
        $('#issue-result-title').text(`${d.title} 티켓 ${d.codes.length}장`);
        $('#issue-result-codes').text(d.codes.join('\n'));
        $('#issue-result').removeClass('hidden');
        loadTickets(1);
      },
      error: function (xhr) {
        alert(xhr.responseJSON?.message || '발급에 실패했습니다.');
      },
      complete: function () {
        $btn.prop('disabled', false).text('발급하기');
      }
    });
  });

  /* 방금 뽑은 코드를 한 번에 복사 — 여러 장 뽑을 때 손으로 옮기기 번거로워서 */
  $('#copy-btn').on('click', function () {
    const text = $('#issue-result-codes').text();
    const done = () => { $(this).text('복사됨'); setTimeout(() => $(this).text('전체 복사'), 1500); };

    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
    } else {
      fallbackCopy(text, done);
    }
  });

  // http로 접속했을 때는 navigator.clipboard가 없다
  function fallbackCopy(text, done) {
    const $ta = $('<textarea>').val(text).css({ position: 'fixed', opacity: 0 }).appendTo('body');
    $ta[0].select();
    try { document.execCommand('copy'); done(); } catch (e) { alert('복사에 실패했습니다. 직접 선택해 주세요.'); }
    $ta.remove();
  }

  /* ── 목록 ── */
  let currentPage = 1;

  function loadTickets(page = 1) {
    currentPage = page;
    $.ajax({
      url: '/admin/ticket/list',
      type: 'GET',
      data: {
        page,
        goodsType: $('#filter-goods').val(),
        used: $('#filter-used').val()
      },
      success: function (res) {
        const { rows, count } = res.data;
        const tbody = $('#ticket-list-body').empty();
        $('#ticket-total').text(`(${count}장)`);

        if (!rows.length) {
          tbody.append('<tr><td colspan="6" class="text-center text-sm text-gray-500 py-4">발급된 티켓이 없습니다.</td></tr>');
          $('#ticket-pagination').empty();
          return;
        }

        rows.forEach(function (t) {
          const badge = t.isUsed
            ? '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-gray-200 text-gray-600">사용됨</span>'
            : '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">미사용</span>';

          const del = t.isUsed
            ? '<span class="text-xs text-gray-300">—</span>'
            : `<button type="button" class="del-btn text-xs text-red-600 hover:underline" data-code="${esc(t.code)}">삭제</button>`;

          tbody.append(`
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 whitespace-nowrap text-sm font-mono font-semibold text-gray-900">${esc(t.code)}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-700">${esc(t.goodsTitle)}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">${badge}</td>
              <td class="px-4 py-3 text-sm text-gray-500">${esc(t.memo)}</td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500">${t.createdAt ? new Date(t.createdAt).toLocaleDateString() : '-'}</td>
              <td class="px-4 py-3 whitespace-nowrap text-right">${del}</td>
            </tr>
          `);
        });

        renderPagination(count, page);
      },
      error: function () {
        $('#ticket-list-body').html('<tr><td colspan="6" class="text-center text-sm text-red-500 py-4">목록을 불러오지 못했습니다.</td></tr>');
      }
    });
  }

  function renderPagination(count, page) {
    const limit = 20;
    const totalPages = Math.ceil(count / limit);
    const $p = $('#ticket-pagination').empty();
    if (totalPages <= 1) return;

    for (let i = 1; i <= totalPages; i++) {
      $(`<a href="javascript:void(0);" class="px-3 py-1 border rounded text-sm ${
        i === page ? 'bg-indigo-50 text-indigo-600 border-indigo-300' : 'bg-white text-gray-700 border-gray-300'
      }">${i}</a>`)
        .on('click', function () { loadTickets(i); })
        .appendTo($p);
    }
  }

  $('#ticket-list-body').on('click', '.del-btn', function () {
    const code = $(this).data('code');
    if (!confirm(`${code} 티켓을 삭제할까요?`)) return;

    $.ajax({
      url: '/admin/ticket/delete',
      type: 'POST',
      data: { code },
      success: function () { loadTickets(currentPage); },
      error: function (xhr) { alert(xhr.responseJSON?.message || '삭제에 실패했습니다.'); }
    });
  });

  $('#filter-goods, #filter-used').on('change', function () { loadTickets(1); });

  loadTickets(1);
});
</script>

</body>
</html>
