                    <span class="text-sm text-gray-500">최근 30일 기준</span>
                </div>
                <div id="trend-options-monthly" class="trend-options mb-3 hidden flex-wrap items-center gap-2">
                    <span class="text-sm text-gray-500">최근 12개월 기준</span>
                </div>
                <div class="h-80">
                    <canvas id="sales-trend-chart"></canvas>
                </div>
            </div>

            <div class="p-6 border-b border-gray-200">
                <h3 class="text-lg font-bold text-gray-800 mb-3">상품별 판매 수</h3>
                <p class="text-sm text-gray-500 mb-3">기간을 선택하면 해당 구간 판매 건수가 집계됩니다.</p>
                <div class="flex flex-wrap items-center gap-2 mb-4">
                    <span class="text-sm font-medium text-gray-600">기간:</span>
                    <button type="button" data-range="all"
                        class="sales-range-btn px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50">
                        전체
                    </button>
                    <button type="button" data-range="0"
                        class="sales-range-btn px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50">
                        오늘
                    </button>
                    <button type="button" data-range="15"
                        class="sales-range-btn px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50">
                        15일
                    </button>
                    <button type="button" data-range="30"
                        class="sales-range-btn px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50">
                        1달
                    </button>
                    <button type="button" data-range="60"
                        class="sales-range-btn px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50">
                        2달
                    </button>
                    <button type="button" data-range="90"
                        class="sales-range-btn px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-300 bg-white text-gray-700 hover:bg-gray-50">
                        3달
                    </button>
                    <span id="sales-count-range-label" class="ml-2 text-sm text-gray-500"></span>
                </div>
                <div class="overflow-x-auto border rounded-xl shadow-sm">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">상품명</th>
                                <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">판매 수</th>
                            </tr>
                        </thead>
                        <tbody id="sales-count-by-goods-list" class="bg-white divide-y divide-gray-200">
                            <tr>
                                <td colspan="2" class="text-center text-sm text-gray-500 py-4">기간을 선택하거나 조회 중...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                    <tr>
      
                   <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            ID
                        </th>
                     
    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            결제코드
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
   
                          상품코드
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  
           휴대폰
                        </th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                            결제금액
     
                    </th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            결제일
                    
     </th>
                    </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200" id="payment-list-body"> 
                    </tbody>
             
    </table>
            </div>

            <div class="bg-white px-4 py-3 border-t border-gray-200 sm:px-6">
                <div class="flex items-center justify-between flex-col sm:flex-row">
                    <div class="mb-4 sm:mb-0">
          
               <p id="totalCnt" class="text-sm text-gray-700">

                        </p>
                    </div>
                    <div>
                   
      <div id="pagination" class="relative z-0 inline-flex rounded-md shadow-sm -space-x-px"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
  // 상품코드 → 상품명 (서버에서 전달)
  const GOODS_TITLES = <%- typeof goodsTitles !== 'undefined' ? JSON.stringify(goodsTitles) : '{}' %>;
  const getGoodsTitle = (code) => (code && GOODS_TITLES[code]) || code || '-';

  // 유틸리티: 통화 형식 포매터 함수
  const formatKrw = (n) => {
    try { 
      return Number(n || 0).toLocaleString('ko-KR') + '원'; 
    } catch(e) { 
      return n + '원'; 
    } 
  };
  
  // 기능: 일일 총 매출액 조회 함수 (오늘 하루 총합)
  const fetchDailySales = (platform) => {
    $.ajax({
      url: `/api/payments/daily-summary?platform=${platform}`,
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        const total = res?.data?.totalAmount;
        $('#daily-sales').text(formatKrw(Number(total ?? 0)));
      },
      error: function(xhr, status, error) {
        console.error('Error fetching daily sales:', status, error, xhr?.status, xhr?.responseText);
        $('#daily-sales').text('조회 오류');
      }
    });
  };

  // 기능: 한달 총 매출액 조회 함수 (이번 달 총합)
  const fetchMonthlySales = (platform) => {
    $.ajax({
      url: `/api/payments/monthly-summary?platform=${platform}`,
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        const total = res?.data?.totalAmount;
        $('#monthly-sales').text(formatKrw(Number(total ?? 0)));
      },
      error: function(xhr, status, error) {
        console.error('Error fetching monthly sales:', status, error, xhr?.status, xhr?.responseText);
        $('#monthly-sales').text('조회 오류');
      }
    });
  };

  // 기능: 날짜별 매출 히스토리 조회 및 렌더링 함수
  const fetchSalesHistory = (platform) => {
    $.ajax({
      url: `/api/payments/sales-history?platform=${platform}`,
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        const $list = $('#sales-history-list'); // [수정 포인트] 정확한 ID 선택
        $list.empty();
        
        if (res.data && res.data.length > 0) {
          res.data.forEach(item => {
            const row = `
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${item.saleDate}</td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium text-green-700">${formatKrw(item.totalAmount)}</td>
              </tr>
            `;
            $list.append(row);
          });
        } else {
           $list.append('<tr><td colspan="2" class="text-center text-sm text-gray-500 py-4">매출 기록이 없습니다.</td></tr>');
        }
      },
      error: function(xhr, status, error) {
        console.error('Error fetching sales history:', error);
        // 오류 시에도 sales-history-list만 업데이트
        $('#sales-history-list').html('<tr><td colspan="2" class="text-center text-sm text-red-500 py-4">매출 기록 조회 오류</td></tr>');
      }
    });
  };

  // 한국 시간(KST) 기준 YYYY-MM-DD — en-CA는 환경에 따라 M/D/YYYY가 되어 API·DB와 어긋날 수 있음
  const toKstDateStr = (d) => {
    if (!d) return '';
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Seoul',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(d);
    const y = parts.find((p) => p.type === 'year')?.value;
    const m = parts.find((p) => p.type === 'month')?.value;
    const day = parts.find((p) => p.type === 'day')?.value;
    return y && m && day ? `${y}-${m}-${day}` : '';
  };

  // 기능: 상품별 판매 수 조회 및 렌더링 (기간 선택 가능)
  const fetchSalesCountByGoods = (platform, startDate, endDate, rangeLabel) => {
    let url = `/api/payments/sales-count-by-goods?platform=${platform}`;
    if (startDate && endDate) {
      const startStr = typeof startDate === 'string' ? startDate : toKstDateStr(startDate);
      const endStr = typeof endDate === 'string' ? endDate : toKstDateStr(endDate);
      url += `&startDate=${startStr}&endDate=${endStr}`;
    }
    $('#sales-count-range-label').text(rangeLabel || '');
    const $list = $('#sales-count-by-goods-list');
    $list.html('<tr><td colspan="2" class="text-center text-sm text-gray-500 py-4">조회 중...</td></tr>');
    $.ajax({
      url,
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        $list.empty();
        if (res.data && res.data.length > 0) {
          let total = 0;
          res.data.forEach(item => {
            const title = item.goodsCode ? getGoodsTitle(item.goodsCode) : '미분류';
            const count = Number(item.count) || 0;
            total += count;
            $list.append(`
              <tr>
                <td class="px-6 py-3 text-sm text-gray-900">${title}</td>
                <td class="px-6 py-3 text-right text-sm font-medium text-gray-900">${count.toLocaleString()}건</td>
              </tr>
            `);
          });
          $list.append(`
            <tr class="bg-gray-50 font-semibold">
              <td class="px-6 py-3 text-sm text-gray-900">합계</td>
              <td class="px-6 py-3 text-right text-sm text-gray-900">${total.toLocaleString()}건</td>
            </tr>
          `);
        } else {
          $list.append('<tr><td colspan="2" class="text-center text-sm text-gray-500 py-4">해당 기간 판매 내역이 없습니다.</td></tr>');
        }
      },
      error: function(xhr, status, error) {
        console.error('Error fetching sales count by goods:', error);
        $('#sales-count-by-goods-list').html('<tr><td colspan="2" class="text-center text-sm text-red-500 py-4">조회 오류</td></tr>');
      }
    });
  };

  const getSalesCountRangeParams = (days) => {
    if (days === 'all') return { start: null, end: null, label: '전체 기간' };
    const end = new Date();
    const start = new Date();
    const n = Number(days);
    if (n === 0) {
      const kstToday = toKstDateStr(end);
      const label = `오늘 (${end.toLocaleDateString('ko-KR', { timeZone: 'Asia/Seoul' })})`;
      return { start: kstToday, end: kstToday, label };
    }
    start.setDate(start.getDate() - n);
    start.setHours(0, 0, 0, 0);
    end.setHours(23, 59, 59, 999);
    const label = `${start.toLocaleDateString('ko-KR')} ~ ${end.toLocaleDateString('ko-KR')}`;
    return { start, end, label };
  };

  // ---------- 판매량 추세 차트 ----------
  let salesTrendChart = null;
  const PLATFORM_TREND = 'TIGHT';

  function destroyTrendChart() {
    if (salesTrendChart) {
      salesTrendChart.destroy();
      salesTrendChart = null;
    }
  }

  function renderTrendChart(labels, values, title) {
    destroyTrendChart();
    const ctx = document.getElementById('sales-trend-chart');
    if (!ctx || typeof Chart === 'undefined') return;
    salesTrendChart = new Chart(ctx, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: '매출액 (원)',
          data: values,
          backgroundColor: 'rgba(99, 102, 241, 0.5)',
          borderColor: 'rgb(99, 102, 241)',
          borderWidth: 1,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          title: { display: !!title, text: title || '' },
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(v) {
                if (v >= 10000) return (v / 10000) + '만';
                return v;
              }
            }
          }
        }
      }
    });
  }

  function loadHourlyTrend(dateStr) {
    const url = `/api/payments/sales-history/hourly?platform=${PLATFORM_TREND}&date=${dateStr}`;
    $.getJSON(url, function(res) {
      const data = res.data || [];
      const labels = data.map(d => d.hour + '시');
      const values = data.map(d => Number(d.totalAmount) || 0);
      renderTrendChart(labels, values, dateStr + ' 시간별 매출');
    }).fail(function() {
      destroyTrendChart();
    });
  }

  function loadDailyTrend() {
    $.ajax({
      url: `/api/payments/sales-history?platform=${PLATFORM_TREND}`,
      type: 'GET',
      dataType: 'json',
      success: function(res) {
        const data = (res.data || []).slice().reverse();
        const labels = data.map(d => d.saleDate);
        const values = data.map(d => Number(d.totalAmount) || 0);
        renderTrendChart(labels, values, '일별 매출 (최근 30일)');
      },
      error: function() {
        destroyTrendChart();
      }
    });
  }

  function loadMonthlyTrend() {
    const end = new Date();
    const start = new Date();
    start.setMonth(start.getMonth() - 11);
    const startStr = start.toISOString().slice(0, 10);
    const endStr = end.toISOString().slice(0, 10);
    $.getJSON(`/api/payments/sales-history/monthly?platform=${PLATFORM_TREND}&startDate=${startStr}&endDate=${endStr}`, function(res) {
      const data = res.data || [];
      const labels = data.map(d => d.yearMonth);
      const values = data.map(d => Number(d.totalAmount) || 0);
      renderTrendChart(labels, values, '월별 매출 (최근 12개월)');
    }).fail(function() {
      destroyTrendChart();
    });
  }

  function showTrendTab(tab) {
    $('.trend-tab-btn').removeClass('bg-indigo-100 border-indigo-400').addClass('bg-white border-gray-300');
    $('.trend-tab-btn[data-trend="' + tab + '"]').addClass('bg-indigo-100 border-indigo-400').removeClass('bg-white border-gray-300');
    $('.trend-options').addClass('hidden');
    $('#trend-options-' + tab).removeClass('hidden');
    if (tab === 'hourly') {
      const today = new Date().toISOString().slice(0, 10);
      $('#trend-hourly-date').val(today);
      loadHourlyTrend(today);
    } else if (tab === 'daily') {
      loadDailyTrend();
    } else if (tab === 'monthly') {
      loadMonthlyTrend();
    }
  }

  $(document).ready(function() {
    const PLATFORM = 'TIGHT'; // 기운소 플랫폼 코드
    setList(1);
    fetchDailySales(PLATFORM);
    fetchMonthlySales(PLATFORM);
    fetchSalesHistory(PLATFORM);
    fetchSalesCountByGoods(PLATFORM, null, null, '전체 기간');

    // Chart.js 로드 후 추세 차트 초기화 (일별 기본)
    (function loadChartAndInit() {
      if (typeof Chart !== 'undefined') {
        showTrendTab('daily');
        return;
      }
      const s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/chart.js';
      s.onload = function() { showTrendTab('daily'); };
      document.head.appendChild(s);
    })();

    $('.sales-range-btn').on('click', function() {
      const range = $(this).data('range');
      const { start, end, label } = getSalesCountRangeParams(range);
      $('.sales-range-btn').removeClass('bg-indigo-100 border-indigo-400').addClass('bg-white border-gray-300');
      $(this).addClass('bg-indigo-100 border-indigo-400').removeClass('bg-white border-gray-300');
      fetchSalesCountByGoods(PLATFORM, start, end, label);
    });
    $('.sales-range-btn[data-range="all"]').addClass('bg-indigo-100 border-indigo-400').removeClass('bg-white border-gray-300');

    $('.trend-tab-btn').on('click', function() {
      const tab = $(this).data('trend');
      showTrendTab(tab);
    });
    $('#trend-hourly-apply').on('click', function() {
      const dateStr = $('#trend-hourly-date').val();
      if (dateStr) loadHourlyTrend(dateStr);
    });
  });
  
  // setList 함수: ID 'payment-list-body'에만 데이터 삽입하도록 수정
  const setList = (page = 1) => {
    const PLATFORM = 'TIGHT'; 
    $.ajax({
      url: `/api/payments/list?page=${page}&platform=${PLATFORM}`,
      type: 'POST',
      dataType: 'json',
      success: function(res) {
        
        const rows = res.data.rows;
        const count = res.data.count;

        $('#totalCnt').text(count + ' 건');

        const tbody = $('#payment-list-body'); // [수정 포인트] ID 선택자를 사용하여 충돌 방지
        tbody.empty();
        
        rows.forEach((payment, index) => {
          const row = `
            <tr class="hover:bg-gray-50 transition-colors duration-150">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${payment.id}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${payment.shopOrderNo}</td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${payment.reportHistory.goodsType}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">${payment.userTelNo}</td>
              <td class="px-6 py-4 whitespace-nowrap">
                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                  ${formatKrw(payment.amount)}
                </span>
            </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm text-gray-900">${new Date(payment.approvalDate).toLocaleDateString()}</td>
            </tr>
          `;
          tbody.append(row);
        });

        const limit = 10;
        const totalPages = Math.ceil(count / limit);
        const $pagination = $('#pagination');
        $pagination.empty();
        const maxButtons = 10;
        const startPage = Math.max(1, page - Math.floor(maxButtons / 2));
        const endPage = Math.min(totalPages, startPage + maxButtons - 1);
        
        for (let i = startPage; i <= endPage; i++) {
          const button = $(`
            <a href="javascript:void(0);" class="relative inline-flex items-center px-4 py-2 border border-gray-300 ${
              i === page ? 'bg-indigo-50 text-indigo-600' : 'bg-white text-gray-700'
            } text-sm font-medium hover:bg-indigo-100" data-page="${i}">
              ${i}
            </a>
          `);
          button.on('click', function(e) {
            e.preventDefault();
            setList(i);
          });
          $pagination.append(button);
        }
      },
      error: function(xhr, status, error) {
        console.error('Error fetching payment list:', error);
      }
    });
  }

</script>