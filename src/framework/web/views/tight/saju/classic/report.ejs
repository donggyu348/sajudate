    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 16px;
    margin-top: 8px;
  }

  .preview-badge {
    font-family: "Nunito", sans-serif;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
