  .color-wood {
    color: #7dcf9e;
  }

  .bg-wood {
    background: linear-gradient(180deg, #6bc98e, #3d9a62);
    box-shadow: 0 0 8px rgba(125, 207, 158, 0.35);
  }

  .color-fire {
    color: #ff889e;
  }

  .bg-fire {
    background: linear-gradient(180deg, #ff7e96, #d3405e);
    box-shadow: 0 0 8px rgba(255, 136, 158, 0.35);
  }

  .color-earth {
    color: #f2d793;
  }

  .bg-earth {
    background: linear-gradient(180deg, #f0daa8, #c4a862);
    box-shadow: 0 0 8px rgba(242, 215, 147, 0.25);
  }

  .color-metal {
    color: #c7d6eb;
  }

  .bg-metal {
    background: linear-gradient(180deg, #b8cae3, #6b7fa0);
    box-shadow: 0 0 8px rgba(199, 214, 235, 0.25);
  }

  .color-water {
    color: #7ec8ff;
  }

  .bg-water {
    background: linear-gradient(180deg, #6ab8fa, #1c6fad);
    box-shadow: 0 0 8px rgba(126, 200, 255, 0.35);
  }

  .saju-grid-title {
    font-family: "Nunito", sans-serif;
    font-size: 11px;
    color: rgba(230, 236, 255, 0.55);
    text-align: center;
    letter-spacing: 0.2em;
    margin-bottom: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .saju-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .saju-node {
    background: #141824;
    border: 2px solid rgba(255, 255, 255, 0.12);
