<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<%
  const STEM_TO_FILE = {
    "甲":"갑목","乙":"을목","丙":"병화","丁":"정화","戊":"무토",
    "己":"기토","庚":"경금","辛":"신금","壬":"임수","癸":"계수",
    "갑":"갑목","을":"을목","병":"병화","정":"정화","무":"무토",
    "기":"기토","경":"경금","신":"신금","임":"임수","계":"계수"
  };
  const myDayStem = STEM_TO_FILE[saju.day.gan] || "갑목";
  
  const g = String(userInfo.gender).trim();
  let genderKey = (["여","여자","여성","female","woman"].includes(g)) ? "woman" : "man";

  /** ── 성적 에너지 비주얼 대시보드(사주 기반 결정값, 의학·실측 아님 표시용) ── */
  function hashSeed(str) {
    let h = 2166136261;
    const s = String(str || "");
    for (let i = 0; i < s.length; i++) {
      h ^= s.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return Math.abs(h) >>> 0;
  }
  const vizSeed = hashSeed(
    String(userInfo?.birthDate || userInfo?.birthdate || "") +
      String(userInfo?.name || "") +
      String(saju?.day?.gan || "") +
      String(saju?.day?.ji || "")
  );
  function pickViz(arr, salt) {
    return arr[(vizSeed + (salt >>> 0)) % arr.length];
  }
  function clampViz(n, a, b) {
    return Math.max(a, Math.min(b, Math.round(n)));
  }

  const fe = saju.fiveElements || { 목: 0, 화: 0, 토: 0, 금: 0, 수: 0 };
  const tg = saju.tenGod || {};
  const godList = [tg.year, tg.month, tg.day, tg.hour].filter(Boolean).map(String);
  const has관 = godList.filter((g) => g === "편관" || g === "정관").length;
  const has식상 = godList.filter((g) => g === "식신" || g === "상관").length;
  const has재 = godList.filter((g) => g === "편재" || g === "정재").length;
  const has비겁 = godList.filter((g) => g === "비견" || g === "겁재").length;
  const has인 = godList.filter((g) => g === "편인" || g === "정인").length;

  const maxFE = Math.max(fe.목, fe.화, fe.토, fe.금, fe.수);
  const minFE = Math.min(fe.목, fe.화, fe.토, fe.금, fe.수);
  const spread = maxFE - minFE;

  const vitality = clampViz(42 + fe.화 * 9 + has식상 * 11 + (vizSeed % 7), 36, 97);
  const finesse = clampViz(40 + fe.수 * 8 + has인 * 9 + ((vizSeed >> 3) % 9), 36, 97);
  const conquer = clampViz(38 + fe.금 * 7 + has관 * 12 + ((vizSeed >> 5) % 8), 36, 97);
  const liberation = clampViz(44 + fe.목 * 8 + has식상 * 6 + ((vizSeed >> 7) % 6), 36, 97);
  const edge = clampViz(34 + spread * 9 + has비겁 * 5 + has재 * 4 + ((vizSeed >> 9) % 10), 34, 95);

  const radarAxes = [
    { label: "정력", val: vitality },
    { label: "기교", val: finesse },
    { label: "정복욕", val: conquer },
    { label: "해방감", val: liberation },
    { label: "변태성", val: edge },
  ];

  const cxR = 100, cyR = 100, maxR = 74;
  const nAx = radarAxes.length;
  const radarPoly = radarAxes
    .map((d, i) => {
      const ang = (-90 + (360 / nAx) * i) * (Math.PI / 180);
      const rr = maxR * (d.val / 100);
      return `${(cxR + rr * Math.cos(ang)).toFixed(2)},${(cyR + rr * Math.sin(ang)).toFixed(2)}`;
    })
    .join(" ");
  const radarGrid = radarAxes
    .map((_, i) => {
      const ang = (-90 + (360 / nAx) * i) * (Math.PI / 180);
      return `${(cxR + maxR * Math.cos(ang)).toFixed(2)},${(cyR + maxR * Math.sin(ang)).toFixed(2)}`;
    })
    .join(" ");
  const lrPad = maxR + 22;
  const radarLabels = radarAxes.map((d, i) => {
    const ang = (-90 + (360 / nAx) * i) * (Math.PI / 180);
    return {
      label: d.label,
      tx: cxR + lrPad * Math.cos(ang),
      ty: cyR + lrPad * Math.sin(ang),
    };
  });
  function pentPoints(scale) {
    return radarAxes
      .map((_, i) => {
        const ang = (-90 + (360 / nAx) * i) * (Math.PI / 180);
        const r = maxR * scale;
        return `${(cxR + r * Math.cos(ang)).toFixed(2)},${(cyR + r * Math.sin(ang)).toFixed(2)}`;
      })
      .join(" ");
  }
  const radarGrid50 = pentPoints(0.45);
  const radarGrid73 = pentPoints(0.72);

  const instinctTemp = clampViz(
    (vitality + liberation + finesse + conquer * 0.6) / 3.6 + (vizSeed % 6),
    55,
    99
  );
  let tempCaption = "달궈지기 시작한 온도";
  if (instinctTemp >= 94) tempCaption = "폭발 직전 화산";
  else if (instinctTemp >= 84) tempCaption = "이미 깊게 달궈진 상태";
  else if (instinctTemp >= 71) tempCaption = "금방 끓어오를 타이밍";

  const hotZonesCatalog = [
    { id: "neck", label: "목덜미", pctL: 56, pctT: 16 },
    { id: "wrist", label: "손목 라인", pctL: 18, pctT: 42 },
    { id: "spine", label: "등·척추 라인", pctL: 46, pctT: 36 },
    { id: "lip", label: "입술·턱 라인", pctL: 50, pctT: 10 },
    { id: "ear", label: "귓바퀴", pctL: 36, pctT: 12 },
    { id: "hip", label: "골반·허리", pctL: 48, pctT: 54 },
    { id: "calf", label: "종아리 라인", pctL: 44, pctT: 74 },
    { id: "palm", label: "손바닥·손등", pctL: 22, pctT: 48 },
  ];
  const zs = [];
  const zSeen = new Set();
  for (let z = 0; z < 5; z++) {
    const h = hotZonesCatalog[(vizSeed + z * 13) % hotZonesCatalog.length];
    if (!zSeen.has(h.id)) {
      zSeen.add(h.id);
      zs.push(h);
    }
    if (zs.length >= 3) break;
  }

  const stimLabels = ["시각적 신호", "청각·속삭임", "스치는 촉각", "잔향·후각", "시선 거리"];
  const stimPrimary = stimLabels[vizSeed % stimLabels.length];
  const stimPct = 118 + ((vizSeed >> 4) % 45);

  const beasts = [
    { icon: "🐺", t: "굶주린 늑대" },
    { icon: "🐈‍⬛", t: "영악한 고양이" },
    { icon: "🐎", t: "힘 넘치는 야생마" },
    { icon: "🦊", t: "잔망한 여우" },
    { icon: "🐯", t: "은밀한 범" },
    { icon: "🐍", t: "천천히 감는 뱀" },
    { icon: "🦅", t: "날카로운 매" },
    { icon: "🦌", t: "경계하는 숲 속 사슴" },
  ];
  const beastPick = beasts[vizSeed % beasts.length];

  const badgeDefs = [
    { k: "Dominant", ko: "지배자" },
    { k: "Addicted", ko: "탐닉자" },
    { k: "Seducer", ko: "유혹자" },
    { k: "Switch", ko: "스위치형" },
    { k: "Edge", ko: "에지" },
    { k: "Romantic", ko: "무드 장인" },
  ];
  const badgePick = [];
  const addBadge = (b) => {
    if (!badgePick.find((x) => x.k === b.k)) badgePick.push(b);
  };
  if (conquer >= finesse) addBadge(badgeDefs[0]);
  else addBadge(badgeDefs[2]);
  if (edge >= 72) addBadge(badgeDefs[4]);
  else addBadge(badgeDefs[5]);
  if (liberation >= vitality) addBadge(badgeDefs[3]);
  else addBadge(badgeDefs[1]);
  let saltB = 0;
  while (badgePick.length < 3)
    addBadge(badgeDefs[(vizSeed + saltB++) % badgeDefs.length]);

  const nickStem = pickViz(
    [
      "밤의 지배자",
      "은밀한 도화",
      "침묵 속 불꽃",
      "경계 너머",
      "심장 박동 수집가",
      "속삭임 전문가",
      "결의 온도계",
      "서리 장미",
      "달빛 포식자",
    ],
    101
  );
  const displayName =
    ((userInfo && (userInfo.nickname || userInfo.name)) || "당신").toString().trim();
  const personaNick = nickStem + " · " + displayName.slice(0, 8);

  const oneLiner = pickViz(
    [
      "겉은 차갑게 식어 보여도, 닿는 순간 가장 먼저 뜨거워지는 결을 가졌어요.",
      "말은 줄여도 몸의 언어는 솔직해서, 가까워질수록 밀도가 급상승하는 타입이에요.",
      "통제하려 들수록 오히려 더 깊이 스며드는, 역설적인 끌림을 품고 있어요.",
      "스위치가 켜지면 끊기 어려운, 끈적한 여운을 남기는 편이에요.",
      "처음은 느린데 한 번 깊어지면, 급격히 무게가 실리는 패턴이에요.",
      "예고 없는 온도 변화가 무기가 되어, 상대 방어를 허무는 타입이에요.",
    ],
    207
  );

  const tagPool = [
    "#집착",
    "#낮이밤이",
    "#속궁합백점",
    "#거친호흡",
    "#결박무드",
    "#스위치ON",
    "#은밀한시선",
    "#침대위리더",
    "#도파민",
    "#경계너머",
    "#무드장인",
    "#밤의온도",
    "#손끝신호",
    "#숨결리듬",
    "#몸의거짓말",
    "#말없는유혹",
    "#짐승합",
    "#밀도중독",
    "#핫존예민",
    "#탐색욕구",
    "#달궈짐",
  ];
  const tagCloud = [];
  const tSeen = new Set();
  for (let t = 0; t < 14; t++) {
    const w = tagPool[(vizSeed + t * 31) % tagPool.length];
    if (!tSeen.has(w)) {
      tSeen.add(w);
      tagCloud.push(w);
    }
  }

  const elemMoods = {
    목: { name: "원초의 그린", hex: "#5ee9a8", line: "새싹처럼 솟는 확장·욕망" },
    화: { name: "치명적 레드", hex: "#fb7185", line: "한 번 붙으면 번지는 열기" },
    토: { name: "중압의 샌드", hex: "#e8d4b8", line: "느리게 익는 무게·집착" },
    금: { name: "날선 실버", hex: "#c8ced9", line: "정돈된 날카·깊이" },
    수: { name: "은밀 딥블루", hex: "#67d7ff", line: "스며드는 감각·번짐" },
  };
  const feArr = [
    { k: "목", v: fe.목 },
    { k: "화", v: fe.화 },
    { k: "토", v: fe.토 },
    { k: "금", v: fe.금 },
    { k: "수", v: fe.수 },
  ];
  const feSorted = [...feArr].sort((a, b) => a.v - b.v);
  const lackKey = feSorted[0].k;
  const excessKey = feSorted[feSorted.length - 1].k;
  const moodChips = [
    { role: "넘침", ...elemMoods[excessKey], key: excessKey },
    { role: "부족", ...elemMoods[lackKey], key: lackKey },
  ];
%>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Serif+KR:wght@400;600;700&family=Outfit:wght@500;600;700&display=swap');

  /**
   * 로맨틱 리포트와 같은 랩/스크랩북 구조 (--shadow-hard 카드 등)
   * 팔레트는 크림 톤 대신 더 어두운 종이 위에 대비 높은 잉크
   */
  :root {
    --veil: #05070e;
    --veil-mid: #090c16;
    --glow-violet: rgba(167, 139, 250, 0.22);
    --glow-cyan: rgba(34, 211, 238, 0.14);
    --glow-rose: rgba(244, 114, 182, 0.14);
    --ink: #e9eef9;
    --ink-soft: rgba(215, 224, 244, 0.78);
    --muted: rgba(200, 210, 235, 0.72);
    --card-bg: rgba(255, 255, 255, 0.045);
    --stroke: rgba(255, 255, 255, 0.14);
    --gold-bright: rgba(253, 230, 178, 0.95);
    --shadow-soft: 0 18px 44px rgba(0, 0, 0, 0.55);
    --shadow-glow: 0 0 48px rgba(124, 58, 237, 0.1), 0 0 100px rgba(34, 211, 238, 0.06);
    --paper: #070910;
    --paper-2: #10141f;
    --accent-color: #f08ba8;
    --accent-2: #3fd4b8;
    --accent-3: #d7b446;
    --shadow-hard: 6px 6px 0 rgba(2, 4, 12, 0.85);
    --text-body: rgba(226, 233, 248, 0.92);
    --text-muted: rgba(160, 174, 204, 0.72);
    --shadow-card: rgba(233, 75, 107, 0.22);
    --report-gutter-x: clamp(12px, 3.6vw, 16px);
  }

  .report-bg {
    font-family: "Noto Sans KR", "Outfit", system-ui, -apple-system, sans-serif;
    background-color: var(--paper);
    background-image:
      radial-gradient(900px 520px at 8% -4%, rgba(124, 58, 237, 0.16) 0%, transparent 50%),
      radial-gradient(760px 420px at 94% 6%, rgba(34, 211, 238, 0.08) 0%, transparent 45%),
      radial-gradient(520px 360px at 50% 100%, rgba(244, 114, 182, 0.06) 0%, transparent 42%),
      repeating-linear-gradient(-4deg, transparent, transparent 11px, rgba(255, 255, 255, 0.028) 11px, rgba(255, 255, 255, 0.028) 12px),
      linear-gradient(180deg, var(--veil-mid), var(--veil));
    min-height: 100vh;
    padding-top: 56px;
    position: relative;
  }

  .report-bg::before {
    content: "";
    pointer-events: none;
    position: fixed;
    inset: 0;
    opacity: 0.42;
    background-image: radial-gradient(rgba(255, 255, 255, 0.066) 1px, transparent 1px);
    background-size: 14px 14px;
    mix-blend-mode: screen;
  }

  .report-bg::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.035;
    background-image: radial-gradient(rgba(255, 255, 255, 0.95) 0.85px, transparent 0.85px);
    background-size: 20px 20px;
  }

  /* 히어로: 로맨틱식 테이프 + 하드 카드 · 다크 종이 */
  .top-hero {
    padding: 20px 16px 8px;
    position: relative;
    z-index: 1;
  }

  .cl-ro-tape {
    position: relative;
    z-index: 2;
    width: 132px;
    height: 24px;
    margin: 0 auto -10px;
    transform: rotate(-2deg);
    background: repeating-linear-gradient(90deg, var(--accent-3), var(--accent-3) 6px, rgba(246, 220, 120, 0.85) 6px, rgba(246, 220, 120, 0.85) 12px);
    opacity: 0.9;
    border-radius: 2px;
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .top-hero-card {
    border-radius: 4px 18px 18px 18px;
    position: relative;
    border: 2px solid var(--stroke);
    background: linear-gradient(180deg, #141824 0%, var(--paper-2) 100%);
    box-shadow: var(--shadow-hard), var(--shadow-glow);
    transform: rotate(-0.35deg);
    overflow: visible;
  }

  .top-hero-card::after {
    content: "";
    position: absolute;
    top: -7px;
    right: 16px;
    width: 48px;
    height: 15px;
    background: rgba(244, 114, 182, 0.25);
    border: 2px solid rgba(255, 255, 255, 0.18);
    border-radius: 2px;
    transform: rotate(-4deg);
    pointer-events: none;
    opacity: 0.72;
  }

  .top-hero-inner { padding: 24px 18px 20px; position: relative; z-index: 1; }

  .hero-kicker {
    font-family: "Nunito", sans-serif;
    font-weight: 800;
    letter-spacing: 0.15em;
    font-size: 10px;
    color: var(--accent-2);
    text-transform: uppercase;
  }

  .hero-title {
    margin-top: 10px;
    font-family: "Nunito", sans-serif;
    font-size: clamp(22px, 5.5vw, 28px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.22;
    color: var(--ink);
  }

  .hero-sub {
    margin-top: 10px;
    font-family: "Noto Sans KR", sans-serif;
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--muted);
    font-weight: 500;
  }

  .hero-sub b {
    color: rgba(246, 250, 255, 0.92);
    font-weight: 700;
  }

  .pill-row {
    margin-top: 16px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(18, 22, 34, 0.9);
    border: 2px solid rgba(255, 255, 255, 0.14);
    color: rgba(238, 244, 255, 0.92);
    font-size: 12px;
    line-height: 1;
    font-weight: 600;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.35);
  }

  .pill .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: radial-gradient(circle at 30% 30%, #fff 0%, var(--accent-2) 45%, var(--accent-color) 100%);
    box-shadow: 0 0 8px rgba(63, 212, 184, 0.45);
    flex-shrink: 0;
  }

  /* 챕터 헤더·본문: 모든 장 동일 게터(px-* Tailwind 미적용 페이지에서도 깨지지 않게) */
  .chapter-progress-wrap {
    padding-top: 48px;
    padding-bottom: 28px;
    text-align: left;
    position: relative;
    z-index: 1;
    padding-left: max(var(--report-gutter-x), env(safe-area-inset-left));
    padding-right: max(var(--report-gutter-x), env(safe-area-inset-right));
  }

  .report-ch-stack {
    box-sizing: border-box;
    width: 100%;
    padding-left: max(var(--report-gutter-x), env(safe-area-inset-left));
    padding-right: max(var(--report-gutter-x), env(safe-area-inset-right));
  }

  .report-content.rom-ch-report-inner .callout .co-body,
  .report-content.rom-ch-report-inner .callout {
    max-width: none;
    width: 100%;
    box-sizing: border-box;
  }

  .report-content.rom-ch-report-inner .meter,
  .report-content.rom-ch-report-inner .meters {
    width: 100%;
    box-sizing: border-box;
    max-width: none;
  }

  .report-content.rom-ch-report-inner dd,
  .report-content.rom-ch-report-inner dl {
    max-width: none;
  }

  .report-content.rom-ch-report-inner .dd {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
  }

  .report-content.rom-ch-report-inner div[style*="max-width"],
  .report-content.rom-ch-report-inner div[style*="max-width:"] {
    max-width: 100% !important;
  }

  .chapter-badge {
    display: inline-block;
    font-family: "Nunito", sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: var(--ink);
    margin-bottom: 8px;
    text-transform: uppercase;
    padding: 4px 10px;
    background: rgba(215, 180, 70, 0.22);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    transform: rotate(-1deg);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.35);
  }

  .chapter-title {
    font-family: "Nunito", sans-serif;
    font-size: clamp(22px, 5.8vw, 28px);
    font-weight: 800;
    line-height: 1.22;
    color: var(--ink);
    letter-spacing: -0.03em;
  }

  .chapter-line {
    width: 100%;
    max-width: 200px;
    height: 4px;
    background: var(--accent-2);
    margin: 12px 0 0;
    border-radius: 4px;
    border: 2px solid rgba(255, 255, 255, 0.16);
  }

  .content-card {
    background: var(--paper-2);
    border: 2px solid rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    padding: 22px 18px;
    margin-bottom: 22px;
    box-shadow: var(--shadow-hard);
    position: relative;
    z-index: 1;
    overflow: visible;
  }

  .content-card::after {
    content: "";
    position: absolute;
    top: -6px;
    right: 14px;
    width: 48px;
    height: 16px;
    background: rgba(240, 139, 168, 0.22);
    border: 2px solid rgba(255, 255, 255, 0.14);
    border-radius: 2px;
    transform: rotate(-4deg);
    pointer-events: none;
    opacity: 0.8;
  }

  .content-card > * {
    position: relative;
    z-index: 1;
  }

  .report-title {
    font-family: "Noto Sans KR", sans-serif;
    font-size: clamp(17px, 4.5vw, 19px);
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 14px;
    line-height: 1.42;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 2px dashed rgba(255, 255, 255, 0.12);
  }

  .report-title::before {
    content: "▎";
    color: var(--accent-color);
    font-weight: 900;
    line-height: 1.25;
    font-size: 1.05em;
  }

  .report-content {
    font-family: "Noto Sans KR", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.88;
    color: var(--text-body);
    white-space: pre-line;
    word-break: keep-all;
  }

  .section-lead {
    font-size: 14.5px;
    line-height: 1.85;
    color: var(--ink-soft);
    margin: 0 0 16px;
    padding: 12px 14px;
    border-radius: 10px;
    background: rgba(215, 180, 70, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.14);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35);
  }

  .insight-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 2px 0 16px;
  }

  .insight-cell {
    border-radius: 10px;
    padding: 10px;
    background: #161b28;
    border: 2px solid rgba(255, 255, 255, 0.14);
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 62px;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.35);
  }

  .insight-k {
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
    font-family: "Nunito", sans-serif;
  }

  .insight-v {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.4;
  }

  @media (max-width: 380px) {
    .insight-row {
      grid-template-columns: 1fr;
    }
  }

  .chapter-dots {
    display: none;
  }

  /* 로맨틱과 동일 클래스명(챕터 진행) — 도트 비표시 */
  .dot {
    display: none;
  }

  .dot.active {
    display: none;
  }

  .highlight {
    color: var(--accent-color);
    font-weight: 800;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }

  .hl {
    color: var(--accent-color);
    font-weight: 800;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: auto;
    min-height: 26px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink);
    border: 2px solid rgba(255, 255, 255, 0.18);
    background: #161b28;
    margin-right: 6px;
    margin-top: 6px;
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.4);
  }

  .hero-sum {
    border-radius: 12px;
    padding: 12px 12px;
    background: #161b28;
    border: 2px solid rgba(255, 255, 255, 0.14);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.35);
  }

  .hs-name {
    font-size: 15px;
    color: var(--ink);
    line-height: 1.55;
    font-weight: 600;
  }

  .hs-sub {
    margin-top: 6px;
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .hs-chips {
    margin-top: 6px;
  }

  .viz-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 12px;
  }

  .viz-card {
    border-radius: 12px;
    padding: 12px;
    background: #14192a;
    border: 2px solid rgba(255, 255, 255, 0.13);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35);
  }

  .viz-t {
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 800;
    font-family: "Nunito", sans-serif;
  }

  .viz-v {
    margin-top: 6px;
    font-size: 13px;
    color: var(--ink);
    line-height: 1.5;
    font-weight: 700;
  }

  .viz-s {
    margin-top: 6px;
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  @media (max-width: 420px) {
    .viz-grid {
      grid-template-columns: 1fr;
    }
  }

  .bullets {
    margin: 0;
    padding-left: 18px;
  }

  .bullets li {
    margin-top: 8px;
    color: var(--ink-soft);
    line-height: 1.65;
  }

  .bullets li:first-child {
    margin-top: 0;
  }

  .callout {
    margin-top: 12px;
    border-radius: 12px;
    padding: 12px;
    border: 2px solid rgba(255, 255, 255, 0.14);
    background: #151a27;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35);
  }

  .callout.kind-tip {
    background: #1a1520;
    border-color: rgba(255, 255, 255, 0.14);
  }

  .callout.kind-warn {
    background: #1b1814;
    border-color: rgba(255, 255, 255, 0.14);
  }

  .callout.kind-note {
    background: #121e1c;
    border-color: rgba(255, 255, 255, 0.14);
  }

  .co-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }

  .co-badge {
    font-size: 9px;
    font-weight: 800;
    font-family: "Nunito", sans-serif;
    letter-spacing: 0.1em;
    color: var(--ink);
    padding: 3px 8px;
    border-radius: 6px;
    border: 2px solid rgba(255, 255, 255, 0.16);
    background: rgba(215, 180, 70, 0.2);
  }

  .co-title {
    font-size: 13px;
    color: var(--ink);
    font-weight: 800;
  }

  .co-body .p {
    margin-top: 8px;
    color: var(--ink-soft);
    line-height: 1.75;
    font-size: 14.5px;
  }

  .co-body .p:first-child {
    margin-top: 0;
  }

  .quote {
    margin-top: 8px;
    border-left: 4px solid var(--accent-color);
    padding: 8px 12px;
    color: var(--ink);
    line-height: 1.65;
    background: rgba(240, 139, 168, 0.08);
    border-radius: 0 8px 8px 0;
    font-style: normal;
    font-weight: 500;
  }

  .meter {
    margin-top: 10px;
  }

  .meters .meter:first-child {
    margin-top: 0;
  }

  .meter-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .meter-k {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .meter-v {
    font-size: 11.5px;
    font-weight: 800;
    color: var(--ink);
    font-family: "Nunito", sans-serif;
  }

  .meter-rail {
    height: 12px;
    border-radius: 999px;
    background: #2a3142;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.12);
  }

  .meter-fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    transition: width 900ms ease;
  }

  .tone-pink {
    background: linear-gradient(90deg, var(--accent-color), #ff8fab);
  }

  .tone-gold {
    background: linear-gradient(90deg, var(--accent-3), #c9a227);
  }

  .tone-ice {
    background: linear-gradient(90deg, #5ec8ff, var(--accent-2));
  }

  .tone-violet {
    background: linear-gradient(90deg, #a78bfa, var(--accent-color));
  }

  .timeline {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tl-item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .tl-dot {
    width: 12px;
    height: 12px;
    border-radius: 999px;
    background: var(--accent-2);
    border: 2px solid rgba(255, 255, 255, 0.16);
    margin-top: 5px;
    flex: 0 0 auto;
  }

  .tl-box {
    flex: 1;
    border-radius: 10px;
    padding: 10px;
    background: #161b28;
    border: 2px solid rgba(255, 255, 255, 0.13);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.32);
  }

  .tl-t {
    font-size: 10px;
    font-weight: 800;
    font-family: "Nunito", sans-serif;
    letter-spacing: 0.08em;
    color: var(--accent-color);
    text-transform: uppercase;
  }

  .tl-d {
    margin-top: 4px;
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .quiz {
    margin-top: 12px;
    border-radius: 12px;
    padding: 12px;
    background: #121c2a;
    border: 2px solid rgba(255, 255, 255, 0.13);
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35);
  }

  .quiz-q {
    font-size: 13px;
    color: var(--ink);
    font-weight: 800;
  }

  .quiz-opts {
    margin-top: 8px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
  }

  .quiz-opt {
    border-radius: 10px;
    padding: 10px;
    background: #161b28;
    border: 2px solid rgba(255, 255, 255, 0.12);
    color: var(--ink-soft);
    font-size: 12.5px;
    line-height: 1.42;
    font-weight: 500;
  }

  .quiz-hint {
    margin-top: 8px;
    font-size: 11.5px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .dd {
    margin-top: 12px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .dd-col {
    border-radius: 12px;
    padding: 10px;
    background: #161b28;
    border: 2px solid rgba(255, 255, 255, 0.12);
  }

  .dd-h {
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 8px;
    font-family: "Nunito", sans-serif;
  }

  .dd-h.ok {
    color: var(--accent-2);
  }

  .dd-h.no {
    color: var(--accent-color);
  }

  .dd .bullets li {
    margin-top: 6px;
    color: var(--ink-soft);
  }

  .dd-t {
    color: var(--ink-soft);
  }

  @media (max-width: 420px) {
    .dd {
      grid-template-columns: 1fr;
    }
  }

  .plan-grid {
    margin-top: 12px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .plan-card {
    border-radius: 12px;
    padding: 10px;
    background: #161b28;
    border: 2px solid rgba(255, 255, 255, 0.12);
  }

  .plan-t {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.09em;
    color: var(--accent-color);
    font-family: "Nunito", sans-serif;
    text-transform: uppercase;
  }

  .plan-d {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .plan-s {
    color: var(--text-muted);
    font-size: 12px;
  }

  .ending {
    border-radius: 12px;
    padding: 12px;
    background: linear-gradient(135deg, #1a1810, #21141c);
    border: 2px solid rgba(255, 255, 255, 0.12);
  }

  .ending-t {
    font-size: 14px;
    color: var(--ink);
    line-height: 1.58;
    font-weight: 600;
  }

  .ending-s {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.62;
  }

  .mascot {
    margin-top: 12px;
    border-radius: 12px;
    padding: 12px;
    background: #1a1710;
    border: 2px solid rgba(255, 255, 255, 0.12);
    display: flex;
    gap: 10px;
    align-items: flex-start;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.35);
    transform: rotate(-0.3deg);
  }

  .ms-emoji {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #161b28;
    border: 2px solid rgba(255, 255, 255, 0.12);
    font-size: 20px;
    flex: 0 0 auto;
  }

  .ms-lines {
    flex: 1;
  }

  .ms-line {
    margin-top: 4px;
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.55;
    font-weight: 500;
  }

  .ms-line:first-child {
    margin-top: 0;
  }

  /* 챕터 가로 피 미리보기(클래식 전용 이름) */
  .cl-ro-chapter-scroll {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 4px 18px 8px;
    margin: 2px 0 6px;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }

  .cl-ro-chapter-pill {
    flex: 0 0 auto;
    scroll-snap-align: start;
    min-width: 132px;
    padding: 10px 10px;
    background: var(--paper-2);
    border: 2px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.4);
  }

  .cl-ro-pill-num {
    font-family: "Nunito", sans-serif;
    font-weight: 800;
    font-size: 13px;
    color: var(--accent-color);
  }

  .cl-ro-pill-t {
    margin-top: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  .lab-ingredients-heading {
    font-family: "Nunito", sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 20px 8px;
    position: relative;
    z-index: 1;
  }

  .saju-summary-tool {
    background: linear-gradient(165deg, rgba(63, 212, 184, 0.12) 0%, rgba(18, 24, 36, 0.96) 42%, #0d121c 100%);
    border: 3px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px 16px 6px 16px;
    padding: 20px 16px 22px;
    margin: 0 18px 12px;
    box-shadow:
      8px 8px 0 rgba(0, 0, 0, 0.45),
      inset 0 -60px 50px rgba(255, 255, 255, 0.02);
    font-family: "Noto Sans KR", sans-serif;
    position: relative;
    z-index: 1;
    transform: rotate(-0.4deg);
  }

  .saju-summary-tool::before {
    content: "내 사주 레시피";
    position: absolute;
    top: -12px;
    left: 16px;
    background: rgba(215, 180, 70, 0.35);
    color: var(--ink);
    font-size: 11px;
    font-weight: 800;
    padding: 4px 10px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    transform: rotate(-3deg);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.4);
  }

  .preview-badge-wrap {
