    border: 2px solid rgba(255, 255, 255, 0.16);
    padding: 4px 10px;
    border-radius: 999px;
    text-transform: uppercase;
    background: #141824;
    box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.35);
