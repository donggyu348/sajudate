    <body>
        
    <div class="flex flex-col w-full max-w-[480px] mx-auto">
        <div class="flex justify-center flex-col items-center mx-auto max-w-7xl">

            <%- include('./../../common/common') %>

            <div id="container">
                <div class="`relative w-full max-w-[448px] mx-auto`">
                    <img src="/assets/images/tight/classic/sangse1.jpeg" class="w-full h-auto object-cover pb-16" />
                    <img src="/assets/images/tight/classic/sangse2.jpeg" class="w-full h-auto object-cover pb-16" />
                    <img src="/assets/images/tight/classic/sangse3.jpeg" class="w-full h-auto object-cover pb-16" />
                    <img src="/assets/images/tight/classic/sangse4.jpeg" class="w-full h-auto object-cover pb-16" />
                    <img src="/assets/images/tight/classic/sangse5.jpeg" class="w-full h-auto object-cover pb-16" />


                    <div class="fixed bottom-0 left-1/2 -translate-x-1/2 z-50 w-full max-w-[480px] px-4 pb-[calc(env(safe-area-inset-bottom)+16px)]">
