<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<style>
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.55) 0%,
    rgba(0,0,0,0.35) 40%,
    rgba(0,0,0,0.55) 100%
  );
}

.saju-wrapper {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  transform: translateY(-5%);
}




.question-box {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 48px 24px;
}

.question-box::before {
  content: none;
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,0.35) 0%,
    rgba(0,0,0,0.15) 60%,
    rgba(0,0,0,0) 100%
  );
  z-index: -1;
  border-radius: 16px;
}

.q-title {
  font-size: 22px;
  font-weight: 600;
  color: rgba(255,255,255,0.95);
  line-height: 1.4;
}

.q-desc {
  margin-top: 8px;
  font-size: 14px;
  color: rgba(255,255,255,0.75);
}

.answer-area {
  margin-top: 40px;
}

.answer-area input {
  width: 100%;
  background: transparent;
  border: none;
  border-bottom: 1.5px solid rgba(255,255,255,0.35);
  padding: 14px 4px;
  font-size: 18px;
  color: rgba(255,255,255,0.95);
  outline: none;
}

.answer-area input:focus {
  border-bottom-color: #5a4633;
}

.answer-area input::placeholder {
  color: rgba(255,255,255,0.45);
}

.select-row {
  display: flex;
  gap: 12px;
}

.select-btn {
  flex: 1;
  padding: 14px 0;
  border-radius: 999px;
  border: 1px solid rgba(0,0,0,0.25);
  background: rgba(255,255,255,0.4);
  font-size: 16px;
  color: #2b2b2b;
}

.select-btn.active {
  background: #5a4633;
  color: #fff;
  border-color: #5a4633;
}
.back-btn {
  position: absolute;
  top: 24px;
  left: 24px;
  background: none;
  border: none;
  padding: 0;
  font-size: 14px;
  color: rgba(255,255,255,0.65);
  cursor: pointer;
  z-index: 2;
}

.back-btn:hover {
  color: rgba(255,255,255,0.9);
}

.answer-area select {
  width: 100%;
  padding: 14px 12px;
  border-radius: 12px;
  border: 1px solid rgba(0,0,0,0.25);
  background: rgba(255,255,255,0.4);
  font-size: 16px;
  color: #2b2b2b;
}

.next-btn {
  margin-top: 60px;
  width: 100%;
  padding: 16px 0;
  border-radius: 999px;
  border: none;
  background: #F5EFE6;
  font-size: 16px;
  font-weight: 600;
  color: #2A1F24;
  letter-spacing: -0.2px;
}

</style>

<body>

<div class="saju-wrapper">
  <form id="sajuForm" method="POST" action="/saju/classic/result" class="question-box">
    <button type="button" class="back-btn" id="backBtn">
  ← 뒤로가기
</button>
    <!-- 🔒 기존 hidden 유지 -->
    <input type="hidden" name="gender" id="genderInput">
    <input type="hidden" name="birthType" id="birthTypeInput" value="양력">

    <!-- 🔒 실제 서버로 전송되는 input (기존 name 유지) -->
    <input type="hidden" name="name">
    <input type="hidden" name="birthdate" id="birthDateInput">
    <!-- birthTime은 select에 그대로 name 사용 -->

    <div class="question-text">
      <div class="q-title"></div>
      <div class="q-desc"></div>
    </div>

    <div class="answer-area"></div>

    <button type="button" class="next-btn" id="nextBtn">다음으로</button>

  </form>
</div>

<script>
/* ===============================
   질문 정의 (UI만 제어)
   🔒 key는 서버 전송용 name과 매핑
================================ */
const steps = [
  {
    key: "name",
    title: "먼저, 어떻게 불러드리면 될까요?",
    desc: "편하게 사용할 이름이면 됩니다.",
    render: () => `
      <input type="text" placeholder="이름을 입력해주세요">
    `,
    validate: () => {
      const v = document.querySelector('.answer-area input').value.trim();
      if (!v) return false;
      document.querySelector('input[name="name"]').value = v;
      return true;
    }
  },
  {
    key: "gender",
    title: "성별을 알려주세요",
    desc: "성별에 따라 해석 기준이 달라집니다.",
    render: () => `
      <div class="select-row">
        <button type="button" class="select-btn" data-value="남성">남성</button>
        <button type="button" class="select-btn" data-value="여성">여성</button>
      </div>
    `,
    validate: () => {
      return !!document.getElementById('genderInput').value;
    }
  },
  {
  key: "birthdate",
  title: "태어난 날을 알려주세요",
  desc: "YYYYMMDD 형식으로 입력해주세요.",
  render: () => `
    <input type="text" maxlength="8" placeholder="예) 19940517">
  `,
  validate: () => {
    const v = document.querySelector('.answer-area input').value.trim();
    if (!/^\d{8}$/.test(v)) return false;

    const formatted = `${v.slice(0, 4)}-${v.slice(4, 6)}-${v.slice(6, 8)}`;
    document.getElementById('birthDateInput').value = formatted;
    return true;
    }
  },
  {
    key: "birthTime",
    title: "태어난 시를 알고 계신가요?",
    desc: "모르셔도 괜찮습니다.",
    render: () => `
      <select name="birthTime">
        <option value="unknown">모름</option>
        <option value="00">조자 (00:00~01:29)</option>
        <option value="02">축 (01:30~03:29)</option>
        <option value="04">인 (03:30~05:29)</option>
        <option value="06">묘 (05:30~07:29)</option>
        <option value="08">진 (07:30~09:29)</option>
        <option value="10">사 (09:30~11:29)</option>
        <option value="12">오 (11:30~13:29)</option>
        <option value="14">미 (13:30~15:29)</option>
        <option value="16">신 (15:30~17:29)</option>
        <option value="18">유 (17:30~19:29)</option>
        <option value="20">술 (19:30~21:29)</option>
        <option value="22">해 (21:30~23:29)</option>
        <option value="24">야자 (23:30~23:59)</option>
      </select>
    `,
    validate: () => true
  },
 
];

let stepIndex = 0;

const qTitle = document.querySelector('.q-title');
const qDesc = document.querySelector('.q-desc');
const answerArea = document.querySelector('.answer-area');
const nextBtn = document.getElementById('nextBtn');
const backBtn = document.getElementById('backBtn');


function renderStep() {
  const step = steps[stepIndex];
  qTitle.textContent = step.title;
  qDesc.textContent = step.desc || '';
  answerArea.innerHTML = step.render();

    backBtn.style.display = stepIndex === 0 ? 'none' : 'block';


  document.querySelectorAll('.select-btn').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('.select-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('genderInput').value = btn.dataset.value;
    };
  });

  nextBtn.textContent = stepIndex === steps.length - 1
    ? '기록을 시작합니다'
    : '다음으로';
}

nextBtn.onclick = () => {
  if (!steps[stepIndex].validate()) {
    alert('값을 입력해주세요.');
    return;
  }

  if (stepIndex < steps.length - 1) {
    stepIndex++;
    renderStep();
  } else {
    document.getElementById('sajuForm').submit();
  }
};


renderStep();
backBtn.onclick = () => {
  if (stepIndex > 0) {
    stepIndex--;
    renderStep();
  }
};
</script>

</body>
</html>
