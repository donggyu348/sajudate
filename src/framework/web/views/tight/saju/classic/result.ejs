<!DOCTYPE html>
<html lang="ko">
   <style>
    :root{
      --tight-bg: #000000;
      --tight-card: #ffffff;
      --tight-border: rgba(0,0,0,.08);
      --tight-text: rgba(20,20,24,.92);
      --tight-sub: rgba(20,20,24,.62);
      --tight-soft: rgba(20,20,24,.06);
    }

    .saju-floating-btn {
  position: fixed;
  bottom: 16px;
  left: 50%;
  transform: translateX(-50%);
  width: 90%;
  max-width: 420px;
  z-index: 1000;

  background: linear-gradient(135deg, rgba(130,84,255,.22), rgba(255,70,165,.18));
  border: 1px solid rgba(180,140,255,.35);
  border-radius: 16px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  text-align: center;
  padding: 12px 14px;
  backdrop-filter: blur(10px);
}

.saju-floating-btn .btn-text {
  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif;
  font-size: 16px;
  font-weight: 800;
  color: #ffffff;
  background: none;
  border: none;
  cursor: pointer;
}

.tight-pill{
  display:inline-flex;
  align-items:center;
  gap:6px;
  padding:6px 10px;
  border-radius:999px;
  background: rgba(0,0,0,.04);
  border: 1px solid rgba(0,0,0,.06);
  color: rgba(20,20,24,.78);
  font-size: 12px;
  font-weight: 700;
}
.tight-card{
  background: var(--tight-card);
  border: 1px solid var(--tight-border);
  border-radius: 18px;
  overflow: hidden;
}
.tight-blur{
  filter: blur(7px);
  user-select: none;
  pointer-events: none;
}
.tight-fade{
  position: relative;
}
.tight-fade:after{
  /* 리스트가 잘려 짧아 보이는 문제 방지: 페이드 제거 */
  display:none;
}
.tight-countdown{
  font-variant-numeric: tabular-nums;
  letter-spacing: .02em;
}

.tight-story{
  position: relative;
  width: 100%;
  aspect-ratio: 9 / 16;
  border-radius: 0;
  overflow: hidden;
  background: #0c0c10;
  border: none;
  box-shadow: 0 18px 55px rgba(0,0,0,.35);
}
.tight-story::before{
  content:"";
  position:absolute;
  inset:0;
  /* 요청한 상/하 다크 그라데이션 */
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.8) 0%,
    rgba(0,0,0,0) 30%,
    rgba(0,0,0,0) 70%,
    rgba(0,0,0,0.8) 100%
  );
  z-index: 1;
  pointer-events:none;
}
.tight-story img{
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transform: scale(1.02);
}
.tight-story img:not(.story-bg-blur){
  /* 스토리 이미지 전체 블러 (텍스트는 z-index로 위에 있어 선명) */
  position: absolute;
  inset: 0;
  z-index: 0;
  filter: blur(7px);
  transform: scale(1.08);
}
.tight-story .story-bg-blur{
  position:absolute;
  inset:-28px;
  width: calc(100% + 56px);
  height: calc(100% + 56px);
  object-fit: cover;
  filter: blur(18px) saturate(1.05);
  opacity: .42;
  transform: scale(1.08);
  z-index: 0;
  /* 중앙은 최대한 깨끗하게, 위/아래로 갈수록 '서서히' 블러가 올라오게 (경계선 방지) */
  -webkit-mask-image: linear-gradient(
    180deg,
    rgba(0,0,0,1) 0%,
    rgba(0,0,0,.92) 12%,
    rgba(0,0,0,.55) 22%,
    rgba(0,0,0,.18) 34%,
    rgba(0,0,0,0) 48%,
    rgba(0,0,0,0) 52%,
    rgba(0,0,0,.18) 66%,
    rgba(0,0,0,.55) 78%,
    rgba(0,0,0,.92) 88%,
    rgba(0,0,0,1) 100%
  );
  mask-image: linear-gradient(
    180deg,
    rgba(0,0,0,1) 0%,
    rgba(0,0,0,.92) 12%,
    rgba(0,0,0,.55) 22%,
    rgba(0,0,0,.18) 34%,
    rgba(0,0,0,0) 48%,
    rgba(0,0,0,0) 52%,
    rgba(0,0,0,.18) 66%,
    rgba(0,0,0,.55) 78%,
    rgba(0,0,0,.92) 88%,
    rgba(0,0,0,1) 100%
  );
}
.tight-story .story-top,
.tight-story .story-bottom{
  position:absolute;
  left:0; right:0;
  padding: 18px 16px;
  color: rgba(255,255,255,.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  z-index: 2;
}
.tight-story .story-top{
  top:0;
  /* 텍스트 영역은 더 검게(블러해도 경계 덜 튐) */
  background: linear-gradient(180deg, rgba(0,0,0,.78) 0%, rgba(0,0,0,.48) 38%, rgba(0,0,0,0) 82%);
}
.tight-story .story-bottom{
  display:none;
}
.tight-story .story-center{
  position:absolute;
  left:0; right:0;
  top: 12.5%;
  height: 75%;
  padding: 22px 18px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  text-align:center;
  color: rgba(255,255,255,.95);
  z-index: 2;
}
.tight-story .story-center::before{
  content:"";
  position:absolute;
  left: 10px;
  right: 10px;
  top: 10px;
  bottom: 10px;
  background: linear-gradient(
    180deg,
    rgba(0,0,0,.62) 0%,
    rgba(0,0,0,.22) 32%,
    rgba(0,0,0,.22) 68%,
    rgba(0,0,0,.62) 100%
  );
  border-radius: 18px;
  z-index: -1;
  pointer-events:none;
}
.tight-story .story-title{
  font-weight: 900;
  font-size: 30px;
  line-height: 1.18;
  letter-spacing: -0.02em;
  color: #fff;
  text-shadow:
    0 2px 0 rgba(0,0,0,.75),
    0 12px 28px rgba(0,0,0,.92);
  -webkit-text-stroke: 0.6px rgba(0,0,0,.60);
}
.tight-story .story-list{
  margin-top: 14px;
  font-size: 14px;
  line-height: 1.85;
  color: rgba(255,255,255,.92);
  text-shadow:
    0 2px 0 rgba(0,0,0,.78),
    0 12px 28px rgba(0,0,0,.92);
}
.tight-story .story-kicker{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding: 7px 12px;
  border-radius: 999px;
  background: rgba(0,0,0,.45);
  border: 1px solid rgba(255,255,255,.14);
  color: rgba(255,255,255,.88);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .16em;
  text-transform: uppercase;
}
.tight-story .story-accent{
  /* 강한 배경 이미지가 많아: 그라데이션 대신 흰색+스트로크로 가독성 확보 */
  color: #ffffff;
}
.tight-story .story-accent-2{
  color: #ffffff;
}
.tight-story .story-lead{
  margin-top: 14px;
  font-size: 15px;
  line-height: 1.85;
  color: rgba(255,255,255,.90);
  text-shadow:
    0 2px 0 rgba(0,0,0,.78),
    0 12px 28px rgba(0,0,0,.92);
}
.tight-story .story-divider{
  width: 44px;
  height: 2px;
  margin: 14px auto 0;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,74,162,.95), rgba(255,255,255,0));
  opacity: .9;
}
.tight-story .story-sub{
  margin-top: 12px;
  font-size: 12px;
  line-height: 1.8;
  color: rgba(255,255,255,.88);
  text-shadow:
    0 2px 0 rgba(0,0,0,.78),
    0 10px 22px rgba(0,0,0,.90);
}
.tight-story .story-stack{
  max-width: 360px;
  margin: 0 auto;
}
.tight-story .story-meta{
  margin-top: 14px;
  font-size: 12px;
  line-height: 1.7;
  color: rgba(255,255,255,.88);
  text-shadow:
    0 2px 0 rgba(0,0,0,.78),
    0 12px 26px rgba(0,0,0,.92);
}
.tight-story .story-chiprow{
  margin-top: 14px;
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  justify-content:center;
}
.tight-story .story-chip{
  display:inline-flex;
  align-items:center;
  padding:6px 10px;
  border-radius: 999px;
  background: rgba(0,0,0,.38);
  border: 1px solid rgba(255,255,255,.16);
  color: rgba(255,255,255,.86);
  font-size: 12px;
  font-weight: 800;
  letter-spacing: -0.01em;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}
.tight-story .story-list > div{
  margin-top: 6px;
}
.tight-story .story-list > div:first-child{
  margin-top: 0;
}

/* 스토리(이미지)와 텍스트 섹션을 '붙여 보이게' */
.tight-bridge{
  margin-top: -44px;
  padding-top: 0;
}
.tight-bridge-title{
  font-size: 20px;
  font-weight: 900;
  letter-spacing: -0.02em;
  color: rgba(255,255,255,.96);
  text-shadow:
    0 2px 0 rgba(0,0,0,.82),
    0 14px 32px rgba(0,0,0,.92);
}

.saju-floating-btn::after {
  content: "";
  display: block;
  height: env(safe-area-inset-bottom);
}
</style>

<%- include('./../../common/header') %>

<body>

<div class="min-h-screen" style="background: #000;">
<div class="flex flex-col w-full max-w-[480px] mx-auto pb-28">
  <div class="flex justify-center flex-col items-center mx-auto max-w-7xl">

    <%- include('./../../common/common') %>

    <!-- ===== 상단 히어로(요약 카드/칩) ===== -->
    <div class="w-full px-5 pt-6">
      <div class="text-center">
        <p class="text-xs font-semibold tracking-wide" style="color: rgba(255,255,255,.78);">🌶️ 사주로 보는 나의 밤생활</p>
        <h1 class="mt-2 text-2xl font-extrabold" style="color:#fff;">29금 에로스 사주</h1>
      </div>

      <!-- 프로필 카드 -->
      <div class="mt-5 tight-card">
        <div class="px-5 py-5">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full flex items-center justify-center text-xl font-black"
                 style="background: linear-gradient(135deg, rgba(130,84,255,.18), rgba(255,70,165,.14)); border: 1px solid rgba(0,0,0,.06);">
              <span>🐑</span>
            </div>
            <div class="min-w-0">
              <div class="text-lg font-extrabold" style="color: var(--tight-text);"><%= userInfo.name %></div>
              <div class="mt-1 text-xs font-semibold" style="color: var(--tight-sub);">
                <%= (saju && saju.day && saju.dayGan) ? (saju.dayGan + " 일주") : "일주" %>
                · <%= (userInfo.birthDate || userInfo.birthdate || "") %>
                · <%= (userInfo.birthType || "") %>
                · <%= (userInfo.birthTime && userInfo.birthTime !== "unknown") ? (userInfo.birthTime + ":00") : "시간 미상" %>
                · <%= userInfo.gender || "" %>
              </div>
            </div>
          </div>

          <div class="mt-5 grid grid-cols-2 gap-3">
            <div class="tight-card px-4 py-4" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
              <div class="text-xs font-semibold" style="color: var(--tight-sub);">🔥 나는 상위 몇 %?</div>
              <div class="mt-1 text-base font-extrabold" style="color: var(--tight-text);">본능을 자극하는 야생의 기운</div>
            </div>
            <div class="tight-card px-4 py-4" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
              <div class="text-xs font-semibold" style="color: var(--tight-sub);">✨ 상위</div>
              <div class="mt-1 text-3xl font-black" style="color: var(--tight-text);">
                <%= (saju && saju.fiveElements) ? (Math.min(12, Math.max(3, Math.round((saju.fiveElements.화 + saju.fiveElements.목 * 0.6 + saju.fiveElements.수 * 0.4) * 1.8)))) : 8 %>%
              </div>
            </div>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <span class="tight-pill">🍒 매운맛</span>
            <span class="tight-pill">💖 속궁합</span>
            <span class="tight-pill">✨ 매력</span>
            <span class="tight-pill">🧩 케미</span>
            <span class="tight-pill">🗝️ 취향</span>
          </div>
        </div>
        <div class="px-5 py-4" style="background: rgba(0,0,0,.02); border-top: 1px solid rgba(0,0,0,.06);">
          <div class="text-sm font-semibold" style="color: var(--tight-text);">이런 내용이 궁금하다면? 🤫</div>
          <ul class="mt-3 space-y-2 text-sm" style="color: rgba(20,20,24,.72);">
            <li class="flex gap-2"><span style="opacity:.8;">•</span><span>이성이 몰래 보는 나의 은밀한 첫 인상</span></li>
            <li class="flex gap-2"><span style="opacity:.8;">•</span><span>끌리는 타입/끌어당기는 타입의 차이</span></li>
            <li class="flex gap-2"><span style="opacity:.8;">•</span><span>확 달아오르는 조건 vs 급속도로 식는 포인트</span></li>
            <li class="flex gap-2"><span style="opacity:.8;">•</span><span>안 해보고도 속궁합 케미를 보는 힌트</span></li>
          </ul>
        </div>
      </div>
      <div class="mt-5 flex items-center justify-center" style="color: rgba(255,255,255,.35);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 5v14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <path d="M7 14l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>

    <!-- (기존 상세 이미지 페이지는 제거됨) -->

    <!-- ===== 사주 원국(천간/지지) ===== -->
    <div class="w-full px-5 mt-4">
      <div class="tight-card px-5 py-5">
        <div class="flex items-end justify-between">
          <div>
            <div class="text-sm font-semibold" style="color: var(--tight-text);">🧾 사주 원국</div>
            <div class="mt-1 text-xl font-extrabold" style="color: var(--tight-text);">천간 · 지지</div>
          </div>
          <div class="text-right text-xs font-semibold" style="color: var(--tight-sub);">
            <div><%= userInfo.birthType || "" %> <%= (userInfo.birthDate || userInfo.birthdate || "") %></div>
            <div><%= (userInfo.birthTime && userInfo.birthTime !== "unknown") ? (userInfo.birthTime + "시") : "시간 미상" %></div>
          </div>
        </div>

        <div class="mt-4 grid grid-cols-4 gap-2">
          <div class="text-center text-xs font-semibold" style="color: var(--tight-sub);">시주</div>
          <div class="text-center text-xs font-semibold" style="color: var(--tight-sub);">일주</div>
          <div class="text-center text-xs font-semibold" style="color: var(--tight-sub);">월주</div>
          <div class="text-center text-xs font-semibold" style="color: var(--tight-sub);">년주</div>

          <div class="tight-card py-3" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
            <div class="text-center text-lg font-black" style="color: var(--tight-text);"><%= (saju && saju.hour && saju.hour.gan) ? saju.hour.gan : "-" %></div>
            <div class="mt-1 text-center text-xs font-semibold" style="color: var(--tight-sub);">천간</div>
          </div>
          <div class="tight-card py-3" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
            <div class="text-center text-lg font-black" style="color: var(--tight-text);"><%= (saju && saju.day && saju.day.gan) ? saju.day.gan : "-" %></div>
            <div class="mt-1 text-center text-xs font-semibold" style="color: var(--tight-sub);">천간</div>
          </div>
          <div class="tight-card py-3" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
            <div class="text-center text-lg font-black" style="color: var(--tight-text);"><%= (saju && saju.month && saju.month.gan) ? saju.month.gan : "-" %></div>
            <div class="mt-1 text-center text-xs font-semibold" style="color: var(--tight-sub);">천간</div>
          </div>
          <div class="tight-card py-3" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
            <div class="text-center text-lg font-black" style="color: var(--tight-text);"><%= (saju && saju.year && saju.year.gan) ? saju.year.gan : "-" %></div>
            <div class="mt-1 text-center text-xs font-semibold" style="color: var(--tight-sub);">천간</div>
          </div>

          <div class="tight-card py-3" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
            <div class="text-center text-lg font-black" style="color: var(--tight-text);"><%= (saju && saju.hour && saju.hour.ji) ? saju.hour.ji : "-" %></div>
            <div class="mt-1 text-center text-xs font-semibold" style="color: var(--tight-sub);">지지</div>
          </div>
          <div class="tight-card py-3" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
            <div class="text-center text-lg font-black" style="color: var(--tight-text);"><%= (saju && saju.day && saju.day.ji) ? saju.day.ji : "-" %></div>
            <div class="mt-1 text-center text-xs font-semibold" style="color: var(--tight-sub);">지지</div>
          </div>
          <div class="tight-card py-3" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
            <div class="text-center text-lg font-black" style="color: var(--tight-text);"><%= (saju && saju.month && saju.month.ji) ? saju.month.ji : "-" %></div>
            <div class="mt-1 text-center text-xs font-semibold" style="color: var(--tight-sub);">지지</div>
          </div>
          <div class="tight-card py-3" style="background: rgba(0,0,0,.03); border-color: rgba(0,0,0,.06);">
            <div class="text-center text-lg font-black" style="color: var(--tight-text);"><%= (saju && saju.year && saju.year.ji) ? saju.year.ji : "-" %></div>
            <div class="mt-1 text-center text-xs font-semibold" style="color: var(--tight-sub);">지지</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== 미리보기(블러/잠금) ===== -->
    <div class="w-full mt-2">
      <div style="background: transparent;">
        <div class="pt-5 pb-4 px-5">
          <div class="text-sm font-semibold" style="color: rgba(255,255,255,.85);">👀 미리보기</div>
          <div class="mt-2 text-2xl font-extrabold" style="color: #fff;">사주로 보는 나의 29금 매력</div>
        </div>
        <div class="pb-5 px-0">
          <%
            const previewChapters = [
              {
                title: "그 사람, 침대 위에서 모습은?",
                items: [
                  "본능 설계도: 사주 원국에 박힌 날것의 성적 에너지 분석.",
                  "은밀한 판타지: 입 밖으로 내지 못한 그 사람만의 금기된 성적 공상.",
                  "낮이밤이 vs 낮져밤져: 침대 위 주도권 싸움의 승자는 누구인가.",
                  "주도권 코드: 리드하려는 욕구와 맡기고 싶은 욕구의 균형."
                ]
              },
              {
                title: "관계를 뜨겁게 해줄 스릴있는 공간은 어디일까?",
                items: [
                  "섹슈얼 아우라: 상대의 뇌리에 박힌 당신의 치명적인 이미지.",
                  "발정 포인트: 그 사람을 즉각적으로 반응하게 만드는 당신만의 자극점.",
                  "유혹의 도파민: '함부로 할 수 없는' 혹은 '망가뜨리고 싶은' 매력 수치.",
                  "관계를 뜨겁게 해줄 스릴있는 공간 추천.",
                  "금지된 분위기: 위험하다고 느낄수록 더 끌리는 이유.",
