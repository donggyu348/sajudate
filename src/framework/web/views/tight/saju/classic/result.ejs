            <div class="instinct-ribbon">Instinct Moodboard</div>
            <div class="instinct-note">
              아래 지표와 그래픽은 <b>의학·실측이 아닌</b> 사주 명식 비율로 만든 장식용 요약입니다. 상세 리포트에서 본격 해석을 이어가요.
            </div>

            <section class="instinct-panel persona-card">
              <div class="instinct-h">본능 명함</div>
              <div class="persona-nick"><%= personaNick %></div>
              <div class="persona-line"><%= oneLiner %></div>
              <div class="beast-medal-row">
                <div class="beast-pill">
                  <span class="emoji"><%= beastPick.icon %></span>
                  <%= beastPick.t %>
                </div>
                <% badgePick.forEach((bg) => { %>
                  <div class="metal-badge">
                    <%= bg.k %>
                    <small><%= bg.ko %></small>
                  </div>
                <% }) %>
              </div>
            </section>

            <div class="instinct-panel">
              <div class="dash-row-split">
                <div class="radar-frame">
                  <div class="instinct-h">쾌락 레이더</div>
                  <div class="radar-svg-wrap">
                    <svg viewBox="-8 -8 216 216" role="img" aria-label="쾌락 레이더 차트">
                      <polygon class="radar-grid2" points="<%= radarGrid50 %>" />
                      <polygon class="radar-grid2" points="<%= radarGrid73 %>" />
                      <polygon class="radar-outline" points="<%= radarGrid %>" />
                      <polygon class="radar-fill" points="<%= radarPoly %>" />
                      <% radarLabels.forEach((L) => { %>
                        <text
                          x="<%= L.tx.toFixed(1) %>"
                          y="<%= L.ty.toFixed(1) %>"
                          text-anchor="middle"
                          dominant-baseline="middle"
                          fill="rgba(230,236,255,0.78)"
                          style="font-family: Outfit, sans-serif; font-size: 8.5px; font-weight: 700;"
                        ><%= L.label %></text>
                      <% }) %>
                    </svg>
                  </div>
                  <div class="radar-legend">
                    <% radarAxes.forEach((a) => { %>
                      <span><b><%= a.label %></b><span><%= String(a.val) + "%" %></span></span>
                    <% }) %>
                  </div>
                </div>
                <div class="heat-meter-block">
                  <div class="instinct-h">본능 온도계</div>
                  <span class="heat-val"><%= instinctTemp %>°</span>
                  <div class="heat-meter" aria-hidden="true">
                    <div class="heat-meter-fill" style="height: <%= String(instinctTemp) + '%' %>;"></div>
                  </div>
                  <div class="heat-cap"><%= tempCaption %> · 오늘의 온도 느낌</div>
                </div>
              </div>
            </div>

            <section class="instinct-panel">
              <div class="bio-chart">
                <div class="instinct-h">성감대 지도 · 에로틱 바이오리듬</div>
                <svg class="sil-svg" viewBox="0 0 220 340" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <defs>
                    <linearGradient id="silGradResult" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="rgba(255,252,251,0.14)" />
                      <stop offset="100%" stop-color="rgba(200,215,245,0.02)" />
                    </linearGradient>
                  </defs>
                  <ellipse cx="110" cy="42" rx="34" ry="42" fill="url(#silGradResult)" />
                  <path
                    fill="rgba(248,248,252,0.07)"
                    d="M110 94c42 14 74 116 92 246H18c18-136 54-238 92-246z"
                  />
                  <path
                    fill="none"
                    stroke="rgba(255,255,255,0.12)"
                    stroke-width="1.2"
                    d="M74 248c18 28 52 52 112 62M68 298c52 18 88 26 154 34"
                  />
                </svg>
                <div class="sil-hotspots">
                  <% zs.forEach((z) => { %>
                    <div class="hot-blob" style="left: <%= z.pctL %>%; top: <%= z.pctT %>%;"></div>
                    <span class="hot-label" style="left: <%= z.pctL %>%; top: <%= z.pctT %>%;"><%= z.label %></span>
                  <% }) %>
                </div>
              </div>
              <div class="stim-gauge">
                오늘은 평소보다 <strong><%= stimPrimary %></strong> 자극에 <strong><%= String(stimPct) + "%" %></strong> 더 민감하게 반응하는 흐름으로 잡았어요. (메타포)
              </div>
            </section>

            <section class="instinct-panel">
              <div class="instinct-h">19금 해시 클라우드</div>
              <div class="tag-cloud">
                <% tagCloud.forEach((tw, ti) => {
                  const scls = ["s1", "s2", "s3", "s4", "s5", "s6"][(vizSeed + ti * 17) % 6];
                %>
                  <span class="tc <%= scls %>"><%= /^#/.test(tw) ? tw : '#' + tw %></span>
                <% }) %>
              </div>
            </section>

            <section class="instinct-panel">
              <div class="instinct-h">오행 컬러 무드</div>
              <div class="mood-chip-row">
                <% moodChips.forEach((mc) => { %>
                  <div class="mood-chip" style="background: radial-gradient(circle at 80% -20%, <%= mc.hex %>33, transparent 65%), rgba(6,10,26,0.55); border-color: <%= mc.hex %>44;">
                    <div class="role"><%= mc.role %></div>
                    <div class="name-row">
                      <span class="dot" style="background: linear-gradient(145deg, <%= mc.hex %>, rgba(255,255,255,0.08));"></span>
                      <span class="mn"><%= mc.key %> · <%= mc.name %></span>
                    </div>
                    <div class="line"><%= mc.line %></div>
                  </div>
                <% }) %>
              </div>
            </section>
          </div>
      </div>
    </div>

    <!-- ===== 미리보기(블러/잠금) ===== -->
    <div class="w-full mt-2">
      <div style="background: transparent;">
        <div class="pt-5 pb-4 px-5">
          <div class="text-sm font-semibold" style="color: rgba(255,255,255,.85);">👀 미리보기</div>
          <div class="mt-2 text-2xl font-extrabold" style="color: #fff;">사주로 보는 나의 29금 매력</div>
        </div>
        <div class="pb-5 px-0">
          <%
            const previewChapters = [
              {
                title: "1장. 타고난 성격과 침대 위 본능",
                items: [
                  "사주에 박힌 S기: 내 사주 원국(도화/홍염 등)에 숨겨진 날것 그대로의 성적 에너지 분석.",
                  "결핍이 만든 욕망: 나에게 부족한 기운이 어떻게 뒤틀린 성적 갈증으로 나타나는지 탐구.",
                  "침대 위 주도권: 낮이밤이 vs 낮져밤져, 관계 속에서 드러나는 나의 진짜 포지션과 권력."
                ]
              },
              {
                title: "2장. 이성이 느끼는 나의 S적 매력",
                items: [
                  "첫눈에 홀리는 포인트: 상대의 뇌리에 박히는 나만의 치명적인 관능미와 아우라.",
                  "본능적 발정점: 이성을 즉각적으로 반응하게 만드는 내 몸의 신체적 강점과 자극 부위.",
                  "망가뜨리고 싶은 유혹: 상대를 안달 나게 하거나, 나를 소유하고 싶게 만드는 솔루션."
                ]
              },
              {
                title: "3장. 누구에게도 말 못한 은밀한 판타지",
                items: [
                  "금기된 공상: 애써 눌러왔던 내 안의 깊은 성적 판타지 파헤치기.",
                  "나만의 취향(Kink): 평범함을 거부하는 나만의 독특한 성향과 그 쾌락의 깊이 분석.",
                  "본능이 깨어나는 순간: 이성이 무너지고 본능이 한순간에 터지는 결정적 트리거."
                ]
              },
              {
                title: "4장. 상대를 미치게 만드는 19금 공략법",
                items: [
                  "마약 같은 중독: 상대를 내 몸에 중독시켜, 다른 누구에게서도 만족 못하게 만드는 법.",
                  "관계의 기술: 기술과 플레이만으로 관계의 주도권을 완전히 내 손바닥 위로 가져오는 기술.",
                  "집착 스위치: 나를 미친 듯이 소유하고 싶게 만드는 집착 유발 장치."
                ]
              },
              {
                title: "5장. 당신을 완성시킬 최상의 속궁합",
                items: [
                  "몸의 대화(싱크로율): 닿는 순간 전율이 오는 최적의 오행 조화와 파트너의 사주 특징.",
                  "관상으로 보는 파트너: 눈빛이나 특정 신체 부위만 봐도 ‘밤일 잘하겠다’ 싶은 상대를 찾는 법.",
                  "쾌락이 터지는 장소: 내 에너지가 가장 뜨겁게 해방되는 스릴 넘치는 장소와 타이밍 추천."
                ]
              },
              {
                title: "6장. 최고의 쾌락과 운명적 조우",
                items: [
                  "베스트 플레이: 내 쾌감을 극대화할 3가지 맞춤 체위와 상황, 그리고 은밀한 도구 제안.",
                  "몸정 vs 마음정: 나는 하룻밤의 화려한 불꽃인가, 아니면 영혼까지 좀먹는 지독한 중독인가.",
                  "폭발의 시기: 이 미친듯한 텐션이 현실에서 터지게 될 가장 가까운 운명적 날짜와 상대."
                ]
              }
            ];
          %>

          <div class="space-y-3">
            <% previewChapters.forEach(function(ch, idx){ %>
              <% const isStory = (idx === 0 || idx === 2 || idx === 5); %>
              <% if (isStory) { %>
                <%
                  const storyImg =
                    idx === 0 ? "/assets/images/tight/29/1.png" :
                    idx === 2 ? "/assets/images/tight/29/2.png" :
                    "/assets/images/tight/29/3.png";
                %>
                <div class="tight-story">
                  <img class="story-bg-blur" src="<%= storyImg %>" alt="" aria-hidden="true" />
                  <img src="<%= storyImg %>" alt="미리보기 이미지" />
                  <div class="story-center">
                    <% if (idx === 0) { %>
                      <div class="story-stack">
                        <div class="story-kicker">STEP 1</div>
                        <div class="mt-3 story-title">
                          <span class="story-accent">시작된 본능</span>
                        </div>
                        <div class="mt-3 story-title" style="font-size:22px; line-height:1.25;">
                          그 사람… 밤자리에서의 모습은…?
                        </div>
                        <div class="story-divider"></div>
                        <div class="story-lead" style="margin-top:12px;">
                          당신은 지배하려는 포식자인가,<br/>
                          정복당하고 싶은 먹잇감인가.
                        </div>
                        <div class="story-chiprow">
                          <span class="story-chip">사주 원국</span>
                          <span class="story-chip">성적 에너지</span>
                          <span class="story-chip">판타지 코드</span>
                          <span class="story-chip">BDSM</span>
                        </div>
                        <div class="story-meta">
                          당신을 결박하고 흔들어 깨울,<br/>
                          <span class="story-accent-2" style="font-weight:900;">가장 위험한 온도</span>
                        </div>
                      </div>
                    <% } else { %>
                      <%
                        const stepNo = (idx === 2 ? 2 : 3);
                        const parts = String(ch.title || "").split(":");
                        const head = (parts[0] || "").trim();
                        const tail = parts.slice(1).join(":").trim();
                        const chips = idx === 2
                          ? ["S/M 코드", "속궁합", "케미", "합(合)"]
                          : ["베스트 플레이", "중독성", "타이밍", "상대 타입"];
                      %>
                      <div class="story-stack">
                        <div class="story-kicker">STEP <%= stepNo %></div>
                        <div class="mt-3 story-title">
                          <span class="story-accent"><%= head || ch.title %></span>
                        </div>
                        <% if (tail) { %>
                          <div class="mt-3 story-title" style="font-size:22px; line-height:1.25;">
                            <%= tail %>
                          </div>
                        <% } %>
                        <div class="story-divider"></div>
                        <% if (ch.items && ch.items.length) { %>
                          <div class="story-lead" style="margin-top:12px;">
                            <%= ch.items[0] %>
                          </div>
                        <% } %>
                        <div class="story-chiprow">
                          <% chips.forEach(function(c){ %>
                            <span class="story-chip"><%= c %></span>
                          <% }); %>
                        </div>
                        <% if (ch.items && ch.items.length > 1) { %>
                          <div class="story-sub" style="margin-top:12px;">
                            <% ch.items.slice(1).forEach(function(it){ %>
                              <div><%= it %></div>
                            <% }); %>
                          </div>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% } else { %>
                <!-- 카드 없이: 배경 위에 텍스트만 -->
                <div class="px-5 pb-10 tight-bridge">
                  <div class="tight-bridge-title">
                    <%= ch.title %>
                  </div>
                  <div class="mt-2 tight-fade">
                    <!-- 텍스트 블러 유지 -->
                    <div class="tight-blur text-sm leading-7" style="color: rgba(255,255,255,.86);">
                      <ul class="space-y-1">
                        <% ch.items.forEach(function(it){ %>
                          <li class="flex gap-2">
                            <span style="opacity:.9;">-</span>
                            <span>
                              <%= it %>
                            </span>
                          </li>
                        <% }); %>
                      </ul>
                    </div>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>

          <div class="mt-5 mx-5" style="background: rgba(0,0,0,.55); border: 1px solid rgba(255,255,255,.12); border-radius: 18px;">
            <div class="px-4 py-4 flex items-center justify-between gap-3">
              <div class="text-sm font-semibold" style="color: rgba(255,255,255,.92);">🔒 15,000자 넘는 풀버전</div>
              <form method="POST" action="/saju/payment" class="shrink-0">
                <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
                <input type="hidden" name="sample" value='<%= JSON.stringify(sample) %>' />
                <input type="hidden" name="goodsType" value="CLASSIC" />
                <button type="submit" class="px-4 py-2 rounded-xl text-sm font-extrabold" style="background: linear-gradient(135deg, rgba(130,84,255,.92), rgba(255,70,165,.86)); color:#fff; border: 1px solid rgba(255,255,255,.18);">
                  잠금해제
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ===== 리뷰 ===== -->
    <div class="w-full px-5 mt-6 mb-8">
      <div class="flex items-end justify-between">
        <div>
          <div class="text-sm font-semibold" style="color: rgba(255,255,255,.78);">🗣️ 실제 리뷰</div>
          <div class="mt-1 text-xl font-extrabold" style="color:#fff;">확인한 사람들 반응</div>
        </div>
        <div class="text-xs font-semibold" style="color: rgba(255,255,255,.55);">최근 순</div>
      </div>

      <div class="mt-4 space-y-3">
        <% const reviews = [
          { name: "e***", stars: 5, badge: "29금 사주", text: "그냥 자극적인 내용이 아니라, 왜 그런 분위기가 나는지 이유가 있어서 더 무서웠어요. '딱 나'라는 말밖에…" },
          { name: "m***", stars: 5, badge: "29금 사주", text: "읽다가 혼자 웃었네요. 제 취향이랑 끌리는 타입을 너무 정확히 찔러서… 미리보기만 봤는데도 결제 각." },
          { name: "h***", stars: 4, badge: "29금 사주", text: "과장된 표현보다 포인트를 잘 정리해줘서 좋았어요. 상대 타입/케미 설명이 특히 현실적입니다." }
        ]; %>

        <% reviews.forEach(function(r){ %>
          <div class="tight-card px-4 py-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, rgba(130,84,255,.16), rgba(255,70,165,.12)); border:1px solid rgba(0,0,0,.06);">
                  <span class="text-xs font-extrabold" style="color: var(--tight-text);"><%= r.name.slice(0,1) %></span>
                </div>
                <div>
                  <div class="text-sm font-extrabold" style="color: var(--tight-text);"><%= r.name %></div>
                  <div class="text-xs font-semibold" style="color: var(--tight-sub);"><%= r.badge %></div>
                </div>
              </div>
              <div class="text-xs font-extrabold" style="color: rgba(20,20,24,.78);">
                <span style="letter-spacing:.08em;">
                  <%= "★★★★★".slice(0, r.stars) %><span style="opacity:.35;"><%= "★★★★★".slice(r.stars) %></span>
                </span>
              </div>
            </div>
            <p class="mt-3 text-sm leading-6" style="color: rgba(20,20,24,.74);"><%= r.text %></p>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- ===== 리뷰 아래 이미지 3장 ===== -->
    <div class="w-full mt-2">
      <img src="/assets/images/tight/29/result/1.png" alt="29금 결과 이미지 1" style="width:100%; height:auto; display:block;" />
      <img src="/assets/images/tight/29/result/2.png" alt="29금 결과 이미지 2" style="width:100%; height:auto; display:block;" />
      <img src="/assets/images/tight/29/result/3.png" alt="29금 결과 이미지 3" style="width:100%; height:auto; display:block;" />
    </div>

  </div>
</div>
<div class="saju-floating-btn">
  <div class="flex items-center justify-between gap-3">
    <div class="text-left">
      <div class="text-xs font-semibold" style="color: rgba(255,255,255,.75);">할인 종료까지 남은 시간</div>
      <div id="tightCountdown" class="tight-countdown text-lg font-black" style="color:#fff;">24:00:00</div>
    </div>
    <form method="POST" action="/saju/payment" class="shrink-0">
      <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
      <input type="hidden" name="sample" value='<%= JSON.stringify(sample) %>' />
      <input type="hidden" name="goodsType" value="CLASSIC" />
      <button type="submit" class="btn-text px-4 py-3 rounded-xl" style="background: linear-gradient(135deg, rgba(130,84,255,.92), rgba(255,70,165,.86)); border: 1px solid rgba(255,255,255,.18);">
        내 29금사주 확인하기
      </button>
    </form>
  </div>
</div>
<script>
  $(document).ready(function(){
    window.karrotPixel.track('Lead');
  });
</script>
<script>
  (function(){
    var el = document.getElementById('tightCountdown');
    if (!el) return;
    var endAt = Date.now() + (24 * 60 * 60 * 1000);

    function pad(n){ return String(n).padStart(2, '0'); }
    function tick(){
      var ms = Math.max(0, endAt - Date.now());
      var total = Math.floor(ms / 1000);
      var h = Math.floor(total / 3600);
      var m = Math.floor((total % 3600) / 60);
      var s = total % 60;
      el.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>

</body>
</html>
