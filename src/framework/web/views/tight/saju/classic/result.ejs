<%- include('./../../common/header') %>

<%
  const _vzSaju = typeof saju !== "undefined" && saju ? saju : {};
  function hashSeed(str) {
    let h = 2166136261;
    const s = String(str || "");
    for (let i = 0; i < s.length; i++) {
      h ^= s.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return Math.abs(h) >>> 0;
  }
  const vizSeed = hashSeed(
    String((userInfo && (userInfo.birthDate || userInfo.birthdate)) || "") +
      String((userInfo && userInfo.name) || "") +
      String((_vzSaju.day && _vzSaju.day.gan) || "") +
      String((_vzSaju.day && _vzSaju.day.ji) || "")
  );
  function pickViz(arr, salt) {
    return arr[(vizSeed + (salt >>> 0)) % arr.length];
  }
  function clampViz(n, a, b) {
    return Math.max(a, Math.min(b, Math.round(n)));
  }

  const fe = _vzSaju.fiveElements || { 목: 0, 화: 0, 토: 0, 금: 0, 수: 0 };
  const tg = _vzSaju.tenGod || {};
  const godList = [tg.year, tg.month, tg.day, tg.hour].filter(Boolean).map(String);
  const has관 = godList.filter((gx) => gx === "편관" || gx === "정관").length;
  const has식상 = godList.filter((gx) => gx === "식신" || gx === "상관").length;
  const has재 = godList.filter((gx) => gx === "편재" || gx === "정재").length;
  const has비겁 = godList.filter((gx) => gx === "비견" || gx === "겁재").length;
  const has인 = godList.filter((gx) => gx === "편인" || gx === "정인").length;

  const maxFE = Math.max(fe.목, fe.화, fe.토, fe.금, fe.수);
  const minFE = Math.min(fe.목, fe.화, fe.토, fe.금, fe.수);
  const spread = maxFE - minFE;

  const vitality = clampViz(42 + fe.화 * 9 + has식상 * 11 + (vizSeed % 7), 36, 97);
  const finesse = clampViz(40 + fe.수 * 8 + has인 * 9 + ((vizSeed >> 3) % 9), 36, 97);
  const conquer = clampViz(38 + fe.금 * 7 + has관 * 12 + ((vizSeed >> 5) % 8), 36, 97);
  const liberation = clampViz(44 + fe.목 * 8 + has식상 * 6 + ((vizSeed >> 7) % 6), 36, 97);
  const edge = clampViz(34 + spread * 9 + has비겁 * 5 + has재 * 4 + ((vizSeed >> 9) % 10), 34, 95);

  const radarAxes = [
    { label: "정력", val: vitality },
    { label: "기교", val: finesse },
    { label: "정복욕", val: conquer },
    { label: "해방감", val: liberation },
    { label: "변태성", val: edge },
  ];

  const cxR = 100, cyR = 100, maxR = 74;
  const nAx = radarAxes.length;
  const radarPoly = radarAxes
    .map((d, i) => {
      const ang = (-90 + (360 / nAx) * i) * (Math.PI / 180);
      const rr = maxR * (d.val / 100);
      return `${(cxR + rr * Math.cos(ang)).toFixed(2)},${(cyR + rr * Math.sin(ang)).toFixed(2)}`;
    })
    .join(" ");
  const radarGrid = radarAxes
    .map((_, i) => {
      const ang = (-90 + (360 / nAx) * i) * (Math.PI / 180);
      return `${(cxR + maxR * Math.cos(ang)).toFixed(2)},${(cyR + maxR * Math.sin(ang)).toFixed(2)}`;
    })
    .join(" ");
  const lrPad = maxR + 22;
  const radarLabels = radarAxes.map((d, i) => {
    const ang = (-90 + (360 / nAx) * i) * (Math.PI / 180);
    return {
      label: d.label,
      tx: cxR + lrPad * Math.cos(ang),
      ty: cyR + lrPad * Math.sin(ang),
    };
  });
  function pentPoints(scale) {
    return radarAxes
      .map((_, i) => {
        const ang = (-90 + (360 / nAx) * i) * (Math.PI / 180);
        const r = maxR * scale;
        return `${(cxR + r * Math.cos(ang)).toFixed(2)},${(cyR + r * Math.sin(ang)).toFixed(2)}`;
      })
      .join(" ");
  }
  const radarGrid50 = pentPoints(0.45);
  const radarGrid73 = pentPoints(0.72);

  const instinctTemp = clampViz(
    (vitality + liberation + finesse + conquer * 0.6) / 3.6 + (vizSeed % 6),
    55,
    99
  );
  let tempCaption = "달궈지기 시작한 온도";
  if (instinctTemp >= 94) tempCaption = "폭발 직전 화산";
  else if (instinctTemp >= 84) tempCaption = "이미 깊게 달궈진 상태";
  else if (instinctTemp >= 71) tempCaption = "금방 끓어오를 타이밍";

  const hotZonesCatalog = [
    { id: "neck", label: "목덜미", pctL: 56, pctT: 16 },
    { id: "wrist", label: "손목 라인", pctL: 18, pctT: 42 },
    { id: "spine", label: "등·척추 라인", pctL: 46, pctT: 36 },
    { id: "lip", label: "입술·턱 라인", pctL: 50, pctT: 10 },
    { id: "ear", label: "귓바퀴", pctL: 36, pctT: 12 },
    { id: "hip", label: "골반·허리", pctL: 48, pctT: 54 },
    { id: "calf", label: "종아리 라인", pctL: 44, pctT: 74 },
    { id: "palm", label: "손바닥·손등", pctL: 22, pctT: 48 },
  ];
  const zs = [];
  const zSeen = new Set();
  for (let z = 0; z < 5; z++) {
    const hz = hotZonesCatalog[(vizSeed + z * 13) % hotZonesCatalog.length];
    if (!zSeen.has(hz.id)) {
      zSeen.add(hz.id);
      zs.push(hz);
    }
    if (zs.length >= 3) break;
  }

  const stimLabels = ["시각적 신호", "청각·속삭임", "스치는 촉각", "잔향·후각", "시선 거리"];
  const stimPrimary = stimLabels[vizSeed % stimLabels.length];
  const stimPct = 118 + ((vizSeed >> 4) % 45);

  const beasts = [
    { icon: "🐺", t: "굶주린 늑대" },
    { icon: "🐈‍⬛", t: "영악한 고양이" },
    { icon: "🐎", t: "힘 넘치는 야생마" },
    { icon: "🦊", t: "잔망한 여우" },
    { icon: "🐯", t: "은밀한 범" },
    { icon: "🐍", t: "천천히 감는 뱀" },
    { icon: "🦅", t: "날카로운 매" },
    { icon: "🦌", t: "경계하는 숲 속 사슴" },
  ];
  const beastPick = beasts[vizSeed % beasts.length];

  const badgeDefs = [
    { k: "Dominant", ko: "지배자" },
    { k: "Addicted", ko: "탐닉자" },
    { k: "Seducer", ko: "유혹자" },
    { k: "Switch", ko: "스위치형" },
    { k: "Edge", ko: "에지" },
    { k: "Romantic", ko: "무드 장인" },
  ];
  const badgePick = [];
  const addBadge = (b) => {
    if (!badgePick.find((x) => x.k === b.k)) badgePick.push(b);
  };
  if (conquer >= finesse) addBadge(badgeDefs[0]);
  else addBadge(badgeDefs[2]);
  if (edge >= 72) addBadge(badgeDefs[4]);
  else addBadge(badgeDefs[5]);
  if (liberation >= vitality) addBadge(badgeDefs[3]);
  else addBadge(badgeDefs[1]);
  let saltB = 0;
  while (badgePick.length < 3)
    addBadge(badgeDefs[(vizSeed + saltB++) % badgeDefs.length]);

  const nickStem = pickViz(
    [
      "밤의 지배자",
      "은밀한 도화",
      "침묵 속 불꽃",
      "경계 너머",
      "심장 박동 수집가",
      "속삭임 전문가",
      "결의 온도계",
      "서리 장미",
      "달빛 포식자",
    ],
    101
  );
  const displayName =
    ((userInfo && (userInfo.nickname || userInfo.name)) || "당신").toString().trim();
  const personaNick = nickStem + " · " + displayName.slice(0, 8);

  const oneLiner = pickViz(
    [
      "겉은 차갑게 식어 보여도, 닿는 순간 가장 먼저 뜨거워지는 결을 가졌어요.",
      "말은 줄여도 몸의 언어는 솔직해서, 가까워질수록 밀도가 급상승하는 타입이에요.",
      "통제하려 들수록 오히려 더 깊이 스며드는, 역설적인 끌림을 품고 있어요.",
      "스위치가 켜지면 끊기 어려운, 끈적한 여운을 남기는 편이에요.",
      "처음은 느린데 한 번 깊어지면, 급격히 무게가 실리는 패턴이에요.",
      "예고 없는 온도 변화가 무기가 되어, 상대 방어를 허무는 타입이에요.",
    ],
    207
  );

  const tagPool = [
    "#집착",
    "#낮이밤이",
    "#속궁합백점",
    "#거친호흡",
