<% if (typeof needsReportPoll !== "undefined" && needsReportPoll && typeof shopOrderNo !== "undefined" && shopOrderNo) { %>
<div
  id="report-poll-toast"
  style="position:fixed;bottom:0;left:0;right:0;z-index:99999;padding:12px 16px;background:rgba(21,34,56,0.94);color:#fff;font-size:13px;line-height:1.5;text-align:center;font-family:'Noto Sans KR',sans-serif;box-shadow:0 -6px 24px rgba(0,0,0,0.2);"
  role="status"
  aria-live="polite"
>
  리포트를 생성 중입니다… 완료되는 즉시 이 페이지가 <strong>자동으로 새로고침</strong>됩니다.
</div>
<script>
(function () {
  var order = <%- JSON.stringify(shopOrderNo) %>;
  var n = 0;
  var max = 600;
  var ms = 3500;

  function check() {
    if (n++ >= max) return;
    fetch("/saju/report/check", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
      body: "shopOrderNo=" + encodeURIComponent(order),
    })
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        if (data && data.status === "DONE") {
          window.location.reload();
        }
      })
      .catch(function (e) {
        console.error("[report poll]", e);
      });
  }

  check();
  setInterval(check, ms);
})();
</script>
<% } %>
