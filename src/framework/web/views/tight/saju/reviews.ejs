<!DOCTYPE html>
<html lang="ko">

<%- include('./../common/header') %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&display=swap" rel="stylesheet">

<body class="min-h-screen bg-[#0a0a0b] text-white antialiased" style="font-family: 'Pretendard', -apple-system, sans-serif;">

  <div class="w-full max-w-[480px] mx-auto min-h-screen flex flex-col">
    <%- include('./../common/common') %>

    <section class="px-4 pt-20 pb-32">
      <a href="/saju" class="inline-flex items-center gap-2 text-zinc-400 text-sm mb-6 hover:text-amber-400 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        메인으로
