        function productMetaByTag(tag) {
          if (tag === '사자록') {
            return { href: '/saju/reaper/intro', img: '/assets/images/tight/reaper/sum.png', alt: '사자록', face: '💀' };
          }
          if (tag === '29금속궁합') {
            return { href: '/saju/adult/intro', img: '/assets/images/tight/products/product_adult.png', alt: '29금 궁합사주', face: '🐨' };
          }
          return { href: '/saju/romantic/intro', img: '/assets/images/tight/products/product_romantic.png', alt: '홍연 연애사주', face: '🦊' };
