      <style>
        .review-feed { display: flex; flex-direction: column; gap: 12px; }
        .review-card { display: flex; gap: 14px; padding: 12px; border-radius: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); }
        .review-card__poster { position: relative; flex-shrink: 0; width: 72px; align-self: stretch; min-height: 108px; border-radius: 10px; overflow: hidden; text-decoration: none; background: #1a1a1a; }
        .review-card__poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
        .review-card__main { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; padding: 2px 0; }
        .review-card__text { font-size: 13.5px; line-height: 1.65; color: rgba(255,255,255,0.88); margin: 0; letter-spacing: -0.15px; word-break: keep-all; }
        .review-card__byline { display: flex; align-items: center; flex-wrap: wrap; gap: 5px 6px; }
        .review-card__face { width: 22px; height: 22px; border-radius: 50%; background: rgba(255,255,255,0.07); display: flex; align-items: center; justify-content: center; font-size: 12px; line-height: 1; flex-shrink: 0; }
        .review-card__nick { font-size: 11px; font-weight: 500; color: rgba(255,255,255,0.38); letter-spacing: 0.2px; font-family: ui-monospace, 'Cascadia Code', 'Consolas', monospace; }
        .review-card__stars { font-size: 9px; letter-spacing: 0.5px; color: #FF2D55; line-height: 1; }
        .review-card__when { font-size: 10px; color: rgba(255,255,255,0.25); margin-left: auto; }
      </style>

      <div class="review-feed">
        <% REVIEWS.forEach(function (r) { const pm = productMetaByTag(r.tag); %>
        <article class="review-card">
          <a href="<%= pm.href %>" class="review-card__poster">
            <img src="<%= pm.img %>" alt="<%= pm.alt %>">
          </a>
          <div class="review-card__main">
            <p class="review-card__text"><%= r.text %></p>
            <div class="review-card__byline">
              <span class="review-card__face"><%= pm.face %></span>
              <span class="review-card__nick"><%= r.nick %></span>
              <span class="review-card__stars" aria-label="5점"><%= r.stars %></span>
              <span class="review-card__when"><%= r.date %></span>
            </div>
          </div>
        </article>
        <% }); %>
      </div>

      <div class="mt-10 pt-6 border-t border-white/5">
        <p class="text-zinc-500 text-sm text-center mb-4">이미 결제하신 분은 아래에서 리포트를 다시 볼 수 있어요.</p>
        <a href="/saju/review" class="block rounded-2xl bg-zinc-800 border border-white/10 text-zinc-300 text-center py-4 text-sm hover:bg-zinc-700 hover:text-white transition-colors">
          내 분석결과 다시보기
        </a>
