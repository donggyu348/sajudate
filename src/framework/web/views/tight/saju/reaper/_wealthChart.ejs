<% const wc = (typeof reaperCharts !== 'undefined' && reaperCharts) ? reaperCharts.wealth : null; %>
<% const isChartOnly = (typeof chartOnly !== 'undefined' && chartOnly); %>
<!-- 재물 흐름 그래프 (SVG) · 사주 기반 동적 값 -->
<% if (!isChartOnly) { %>
<p class="rr-eyebrow">財 物</p>
<p class="rr-secline">평생 한 번,<br><span class="rp-b">크게 터질 자리가 여기 있다.</span></p>
<% } %>
<div class="rp-flow<%= isChartOnly ? ' rp-flow--locked' : '' %>">
  <p class="rp-flow__title">네 재물(財) 그래프</p>
  <div class="rp-flow__chart">
    <% if (wc) { %>
    <svg viewBox="0 0 320 200" style="width:100%; display:block;" role="img" aria-label="재물 흐름 그래프">
      <defs>
        <linearGradient id="rrWealthGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#9cc9f5" />
          <stop offset="100%" stop-color="#2e78c0" />
        </linearGradient>
      </defs>
      <line x1="15" y1="170" x2="305" y2="170" stroke="#26364e" stroke-width="1" />
      <% if (reaperCharts.axisLabels) { reaperCharts.axisLabels.forEach(function(lbl, i) {
        const bar = wc.bars[i];
        const x = bar ? bar.x + bar.width / 2 : 28;
      %>
      <text x="<%= x %>" y="188" text-anchor="middle" fill="#5f6b7a" font-size="8"><%= isChartOnly ? '20◯◯' : lbl %></text>
      <% }); } %>
      <% wc.bars.forEach(function(bar) { %>
      <rect x="<%= bar.x %>" y="<%= bar.y %>" width="<%= bar.width %>" height="<%= bar.height %>" rx="2"
        fill="<%= bar.isPeak ? 'url(#rrWealthGrad)' : 'rgba(90,169,240,0.22)' %>" />
      <% if (bar.isPeak) { %>
      <rect x="<%= bar.x %>" y="<%= bar.y %>" width="<%= bar.width %>" height="<%= bar.height %>" rx="2"
        fill="none" stroke="#7fb5ef" stroke-width="1.5" />
      <circle cx="<%= bar.x + bar.width / 2 %>" cy="<%= bar.y %>" r="9" fill="#7fb5ef" opacity="0.28" />
      <circle cx="<%= bar.x + bar.width / 2 %>" cy="<%= bar.y %>" r="4.5" fill="#9cc9f5" />
      <% } %>
      <% }); %>
    </svg>
    <div class="rp-flow__peak" style="left:60%; top:14%;">
      <% if (isChartOnly) { %>
        <span class="star">★</span><span class="lock">🔒</span> 평생 한 번의 목돈
      <% } else { %>
        <span class="star">★</span>평생 한 번 · <%= wc.amountText %>
      <% } %>
    </div>
    <% } %>
  </div>
  <div class="rp-flow__legend">
    <div class="now">평소<br>겨우 먹고 산 흐름</div>
    <div class="then"><%= isChartOnly ? '🔒' : (wc ? wc.peak.label : '이 자리') %><br>평생 한 번 터질 목돈</div>
  </div>
  <% if (wc) { %>
  <% if (isChartOnly) { %>
    <p class="rp-flow__cap">정확한 금액과 시점은 명부를 열어야 보인다.</p>
  <% } else { %>
    <p class="rp-flow__cap rp-flow__cap--value">
      <b><%= wc.peak.label %></b> · <b><%= wc.amountText %></b> · <b><%= wc.peak.tenGod %></b> 기운 — 아래 명부 본문 수치와 동일하다.
    </p>
  <% } %>
  <% } %>
</div>
