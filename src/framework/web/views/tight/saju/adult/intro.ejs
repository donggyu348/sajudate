<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: #000;
    }

    .page {
      max-width: 584px;
      margin: 0 auto;
    }

    .landing-img {
      display: block;
      width: 100%;
      height: auto;
    }
  </style>
</head>

<body>
  <div class="page">
    <img
      class="landing-img"
      src="/assets/images/tight/29/intro/landing-full.png"
      alt="29금 정욕합 사주 — 천해랑이 읽어주는 욕망과 정욕합의 비밀"
      width="584"
      height="12711"
      loading="eager"
      decoding="async"
    >
  </div>

  <script>
    $(document).ready(function(){
      if(window.karrotPixel) window.karrotPixel.track('ViewContent');
    });
  </script>
</body>
</html>
