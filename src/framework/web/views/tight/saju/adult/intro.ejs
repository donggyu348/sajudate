<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: #000;
    }

    .page {
      max-width: 584px;
      margin: 0 auto;
      padding-bottom: 96px;
    }

    .intro-hero {
      position: relative;
      width: 100%;
      background: #000;
      --intro-black-height: clamp(200px, 42vw, 300px);
    }

    .intro-hero__visual {
      position: relative;
      width: 100%;
    }

    .intro-hero__gif {
      display: block;
      width: 100%;
      height: auto;
    }

    .intro-hero__black {
      width: 100%;
      height: var(--intro-black-height);
      background: #000;
    }

    .intro-hero__gradient {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      bottom: 0;
      pointer-events: none;
      z-index: 1;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        transparent 48%,
        rgba(0, 0, 0, 0.22) 58%,
        rgba(0, 0, 0, 0.52) 68%,
        rgba(0, 0, 0, 0.82) 78%,
        #000 88%,
        #000 100%
      );
    }

    .intro-hero__pont {
      position: absolute;
      top: 58%;
      right: 0;
      bottom: calc(-1 * var(--intro-black-height));
      width: auto;
      max-width: 42%;
      object-fit: contain;
      object-position: right bottom;
      transform: translateY(12px);
      pointer-events: none;
      z-index: 2;
    }

    .landing-img {
      display: block;
      width: 100%;
      height: auto;
    }

    .fixed-cta {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 584px;
      z-index: 100;
      padding: 16px 20px;
      padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      background: #000;
    }

    .cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      height: 56px;
      border: none;
      border-radius: 12px;
      background: #e91e7a;
      color: #fff;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-decoration: none;
      cursor: pointer;
      box-shadow:
        0 6px 20px rgba(0, 0, 0, 0.45),
        0 2px 10px rgba(233, 30, 122, 0.35);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .cta-btn:active {
      transform: scale(0.98);
      box-shadow:
        0 3px 12px rgba(0, 0, 0, 0.4),
        0 1px 6px rgba(233, 30, 122, 0.3);
    }

    .cta-btn__arrow {
      font-size: 1.12em;
      font-weight: 700;
      line-height: 1;
      opacity: 1;
      letter-spacing: -0.05em;
      margin-left: 4px;
    }

    .cta-btn__text {
      line-height: 1;
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="intro-hero">
      <div class="intro-hero__visual">
        <img
          class="intro-hero__gif"
          src="/assets/images/tight/29/intro/0702.gif"
          alt="29금 속궁합 사주 인트로"
          width="584"
          loading="eager"
          decoding="async"
        >
        <img
          class="intro-hero__pont"
          src="/assets/images/tight/29/intro/pont.png"
          alt=""
          aria-hidden="true"
          loading="eager"
          decoding="async"
        >
      </div>
      <div class="intro-hero__black" aria-hidden="true"></div>
      <div class="intro-hero__gradient" aria-hidden="true"></div>
    </div>

    <img
      class="landing-img"
      src="/assets/images/tight/29/intro/landing-full.png?v=1"
      alt="29금 속궁합 사주 — 천해랑이 읽어주는 욕망과 속궁합의 비밀"
      width="584"
      height="19934"
      loading="eager"
      decoding="async"
    >
  </div>

  <div class="fixed-cta">
    <a href="/saju/adult/input" class="cta-btn">
      <span class="cta-btn__text">S궁합 무료로 미리보기</span>
      <span class="cta-btn__arrow" aria-hidden="true">--></span>
    </a>
  </div>

  <script>
    $(document).ready(function(){
      if(window.karrotPixel) window.karrotPixel.track('ViewContent');
    });
  </script>
</body>
</html>
