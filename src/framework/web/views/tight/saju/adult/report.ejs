<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<%
  // 일간 한글 변환 매핑
  const STEM_TO_FILE = {
    "甲":"갑목","乙":"을목","丙":"병화","丁":"정화","戊":"무토",
    "己":"기토","庚":"경금","辛":"신금","壬":"임수","癸":"계수",
    "갑":"갑목","을":"을목","병":"병화","정":"정화","무":"무토",
    "기":"기토","경":"경금","신":"신금","임":"임수","계":"계수"
  };
  const myDayStem = STEM_TO_FILE[saju.day.gan] || "갑목";
  
  // 성별 변환
  const g = String(userInfo.gender).trim();
  let genderKey = (["여","여자","여성","female","woman"].includes(g)) ? "woman" : "man";
%>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;700&family=Montserrat:wght@500;700;800&display=swap');

  :root {
    --accent: #ff2d55;
    --accent2: #7c3aed;
    --ink: rgba(255, 255, 255, 0.88);
    --muted: rgba(255, 255, 255, 0.62);
    --panel: rgba(255,255,255,0.06);
    --panel2: rgba(255,255,255,0.03);
    --stroke: rgba(255,255,255,0.10);
    --stroke2: rgba(255,255,255,0.14);
    --shadow: 0 18px 60px rgba(0,0,0,0.50);
    --glow: 0 0 0 1px rgba(255,45,85,0.22), 0 14px 50px rgba(255,45,85,0.12);
  }

  .report-bg {
    background-color: #07070a;
    background-image:
      radial-gradient(1200px 700px at 10% 10%, rgba(255,45,85,0.14) 0%, transparent 55%),
      radial-gradient(900px 600px at 90% 18%, rgba(124,58,237,0.12) 0%, transparent 55%),
      radial-gradient(900px 700px at 50% 95%, rgba(255,255,255,0.04) 0%, transparent 55%),
      linear-gradient(180deg, rgba(255,255,255,0.04), transparent 26%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.018) 0 1px, transparent 1px 10px);
    min-height: 100vh;
    padding-top: 56px; /* fixed navbar(#main-navbar) 높이만큼 */
  }

  .top-hero {
    position: relative;
    padding: 18px 18px 10px;
  }
  .top-hero-card {
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(255,45,85,0.14), rgba(124,58,237,0.10));
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .top-hero-card::before {
    content: "";
    display: block;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.38), transparent);
  }
  .top-hero-inner {
    padding: 18px 16px 16px;
  }
  .hero-kicker {
    font-family: "Montserrat", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
    font-weight: 800;
    letter-spacing: 0.18em;
    font-size: 11px;
    color: rgba(255,255,255,0.72);
    text-transform: uppercase;
  }
  .hero-title {
    margin-top: 8px;
    font-family: "Noto Serif KR", serif;
    font-size: 22px;
    font-weight: 700;
    color: rgba(255,255,255,0.94);
    letter-spacing: -0.02em;
  }
  .hero-sub {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
  }
  .pill-row {
    margin-top: 14px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 999px;
    background: rgba(0,0,0,0.22);
    border: 1px solid rgba(255,255,255,0.12);
    color: rgba(255,255,255,0.78);
    font-size: 12px;
    line-height: 1;
    backdrop-filter: blur(8px);
  }
  .pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--accent);
    box-shadow: 0 0 14px rgba(255,45,85,0.55);
  }

  .chapter-progress-wrap {
    padding-top: 80px;
    padding-bottom: 40px;
    text-align: center;
  }

  .chapter-badge {
    display: inline-block;
    font-family: 'Noto Serif KR', serif;
    font-size: 12px;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.70);
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .chapter-title {
    font-family: 'Noto Serif KR', serif;
    font-size: 32px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .chapter-line {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    margin: 16px auto;
  }

  .content-card {
    position: relative;
    background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
    padding: 32px 24px;
    margin-bottom: 40px;
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
  }
  .content-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 22px;
    pointer-events: none;
    box-shadow: var(--glow);
    opacity: 0.38;
  }

  .report-title {
    font-family: 'Noto Serif KR', serif;
    font-size: 20px;
    font-weight: 700;
    color: rgba(255,255,255,0.92);
    margin-bottom: 20px;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .report-title::before {
    content: '';
    display: block;
    width: 4px;
    height: 20px;
    background: linear-gradient(180deg, var(--accent), var(--accent2));
    border-radius: 2px;
  }

  .report-content {
    font-size: 16px;
    line-height: 1.85;
    color: var(--ink);
    white-space: pre-line;
    word-break: keep-all;
  }

  .chapter-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    transition: all 0.3s ease;
  }

  .dot.active {
    background: var(--accent);
    transform: scale(1.5);
    box-shadow: 0 0 10px var(--accent);
  }

  .saju-summary-tool {
    background: linear-gradient(135deg, rgba(255,45,85,0.10), rgba(124,58,237,0.08));
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 22px;
    padding: 18px 16px;
    margin: 12px 18px 0;
    box-shadow: var(--shadow);
    font-family: 'Noto Serif KR', serif;
  }

  .preview-badge-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .preview-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(255,255,255,0.76);
    border: 1px solid rgba(255,255,255,0.18);
    padding: 2px 10px;
    border-radius: 99px;
    text-transform: uppercase;
  }

  .preview-main-title {
    font-size: 14px;
    color: rgba(255,255,255,0.86);
    font-weight: 400;
    letter-spacing: 1px;
    opacity: 0.92;
  }

  .element-section {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 30px;
  }

  .el-card {
    flex: 1;
    background: var(--card-bg);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 10px 4px;
    text-align: center;
  }

  .el-card.has-value { border-color: rgba(243, 230, 200, 0.28); background: rgba(243, 230, 200, 0.05); }

  .el-han { font-size: 12px; opacity: 0.65; display: block; }
  .el-val { font-size: 18px; font-weight: 700; margin: 4px 0; display: block; }

  .el-bar-container { height: 40px; width: 4px; background: rgba(255,255,255,0.1); margin: 0 auto; border-radius: 2px; position: relative; }
  .el-bar-fill { position: absolute; bottom: 0; width: 100%; border-radius: 2px; transition: height 1s ease-in-out; }

  .color-wood { color: #A8D5BA; } .bg-wood { background: #A8D5BA; }
  .color-fire { color: #FFB3BA; } .bg-fire { background: #FFB3BA; }
  .color-earth { color: #F3E6C8; } .bg-earth { background: #F3E6C8; }
  .color-metal { color: #E0E0E0; } .bg-metal { background: #E0E0E0; }
  .color-water { color: #B3CDE3; } .bg-water { background: #B3CDE3; }

  .saju-grid-title {
    font-size: 12px;
    color: var(--gold-bright);
    text-align: center;
    letter-spacing: 3px;
    margin-bottom: 15px;
    opacity: 0.82;
  }

  .saju-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .saju-node {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 15px 0;
    text-align: center;
  }

  .node-label { font-size: 10px; color: rgba(255,255,255,0.4); margin-bottom: 8px; display: block; }
  .hanja-text {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    color: rgba(255,255,255,0.92);
    text-shadow: 0 10px 24px rgba(0,0,0,0.45);
  }

  .is-me { border-color: var(--accent-color); background: rgba(255, 45, 85, 0.06); position: relative; }
  .is-me::after {
    content: '나'; position: absolute; top: -6px; right: -6px;
    background: var(--accent-color); color: #fff; font-size: 9px; padding: 2px 5px; border-radius: 4px;
  }
</style>

<body class="page-adult">
  <div class="flex flex-col w-full max-w-[480px] mx-auto report-bg min-h-screen">

    <%- include('./../../common/common') %>

    <div class="top-hero">
      <div class="top-hero-card">
        <div class="top-hero-inner">
          <div class="hero-kicker">REPORT • 29+</div>
          <div class="hero-title">오늘 밤, 당신의 본능은 어디로 흐를까</div>
          <div class="hero-sub">
            사주 명식으로 드러난 <b>흥분의 기울기</b>와 <b>관계의 트리거</b>를
            한 장씩 해체해드립니다.
          </div>
          <div class="pill-row">
            <div class="pill"><span class="dot"></span><span><%= userInfo.name %>님</span></div>
            <div class="pill"><span class="dot"></span><span><%= userInfo.birthdate %></span></div>
            <div class="pill"><span class="dot"></span><span><%= saju.day.gan %><%= saju.day.ji %> 일주</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="saju-summary-tool">
      <div class="preview-badge-wrap">
        <span class="preview-badge">29+</span>
        <span class="preview-main-title">사주 명식 미리보기</span>
      </div>

      <div class="element-section">
        <%
          const getPercent = (val) => (Math.min((val / 8) * 100, 100)) + '%';
        %>

        <div class="el-card <%= saju.fiveElements.목 > 0 ? 'has-value' : '' %>">
          <span class="el-han color-wood">木</span>
          <span class="el-val color-wood"><%= saju.fiveElements.목 %></span>
          <div class="el-bar-container"><div class="el-bar-fill bg-wood" data-height="<%= getPercent(saju.fiveElements.목) %>"></div></div>
        </div>
        <div class="el-card <%= saju.fiveElements.화 > 0 ? 'has-value' : '' %>">
          <span class="el-han color-fire">火</span>
          <span class="el-val color-fire"><%= saju.fiveElements.화 %></span>
          <div class="el-bar-container"><div class="el-bar-fill bg-fire" data-height="<%= getPercent(saju.fiveElements.화) %>"></div></div>
        </div>
        <div class="el-card <%= saju.fiveElements.토 > 0 ? 'has-value' : '' %>">
          <span class="el-han color-earth">土</span>
          <span class="el-val color-earth"><%= saju.fiveElements.토 %></span>
          <div class="el-bar-container"><div class="el-bar-fill bg-earth" data-height="<%= getPercent(saju.fiveElements.토) %>"></div></div>
        </div>
        <div class="el-card <%= saju.fiveElements.금 > 0 ? 'has-value' : '' %>">
          <span class="el-han color-metal">金</span>
          <span class="el-val color-metal"><%= saju.fiveElements.금 %></span>
          <div class="el-bar-container"><div class="el-bar-fill bg-metal" data-height="<%= getPercent(saju.fiveElements.금) %>"></div></div>
        </div>
        <div class="el-card <%= saju.fiveElements.수 > 0 ? 'has-value' : '' %>">
          <span class="el-han color-water">水</span>
          <span class="el-val color-water"><%= saju.fiveElements.수 %></span>
          <div class="el-bar-container"><div class="el-bar-fill bg-water" data-height="<%= getPercent(saju.fiveElements.수) %>"></div></div>
        </div>
      </div>

      <div class="saju-grid-title">八字四柱</div>
      <div class="saju-grid">
        <div class="saju-node">
          <span class="node-label">시주</span>
          <div class="hanja-text"><%= saju.hour.gan || " " %><br><%= saju.hour.ji || " " %></div>
        </div>
        <div class="saju-node is-me">
          <span class="node-label">일주</span>
          <div class="hanja-text"><%= saju.day.gan %><br><%= saju.day.ji %></div>
        </div>
        <div class="saju-node">
          <span class="node-label">월주</span>
          <div class="hanja-text"><%= saju.month.gan %><br><%= saju.month.ji %></div>
        </div>
        <div class="saju-node">
          <span class="node-label">년주</span>
          <div class="hanja-text"><%= saju.year.gan %><br><%= saju.year.ji %></div>
        </div>
      </div>
    </div>

    <script>
      (function () {
        const bars = document.querySelectorAll(".el-bar-fill[data-height]");
        bars.forEach((el) => {
          const h = el.getAttribute("data-height");
          if (h) el.style.height = h;
        });
      })();
    </script>

    <div id="container" class="pb-20">
      <%
        const chapters = [...new Set(reportInfo.map(r => r.chapter))];
        const totalChapters = chapters.length;
        let currentChapter = '';

        const maskWord = (text, word, maskChar = "x") => {
          if (!text || !word) return text;
          const escaped = String(word).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
          return String(text).replace(new RegExp(escaped, "gi"), (m) => {
            if (m.length <= 1) return maskChar;
            return m[0] + maskChar.repeat(Math.max(1, m.length - 1));
          });
        };

        const adultTone = (raw) => {
          if (!raw) return raw;
          let text = String(raw);

          // 1) 과도하게 노골적/직설적 단어는 x 마스킹 처리 (들어오는 경우에만)
          const maskList = [
            "섹스","sex","性交","성교","자위","오르가즘","orgasm",
            "애무","삽입","정액","사정","발기","콘돔","팬티","브라","유두",
            "야동","포르노","porn","porno","AV"
          ];
          maskList.forEach((w) => { text = maskWord(text, w, "x"); });

          // 2) 문장 가독성만 정리 (돌려말하기/과장 치환은 하지 않음)
          text = text
            .replace(/[ \t]+\n/g, "\n")
            .replace(/\n{4,}/g, "\n\n\n");

          return text;
        };
      %>

      <% reportInfo.forEach((item, index) => { %>
        <% if (item.chapter !== currentChapter) { %>
          <% currentChapter = item.chapter; %>
          <% const chapterIndex = chapters.indexOf(item.chapter); %>

          <div class="chapter-progress-wrap px-8">
            <div class="chapter-dots">
              <% for (let i = 0; i < totalChapters; i++) { %>
                <div class="dot <%= i === chapterIndex ? 'active' : '' %>"></div>
              <% } %>
            </div>
            <span class="chapter-badge">Chapter 0<%= chapterIndex + 1 %></span>
            <h2 class="chapter-title"><%= item.chapter %></h2>
            <div class="chapter-line"></div>
          </div>

          <div class="px-6 space-y-10">
        <% } %>

        <div class="content-card">
          <% if (item.title && item.title !== item.chapter) { %>
            <h3 class="report-title"><%= item.title %></h3>
          <% } %>
          <div class="report-content"><%= adultTone(item.content) %></div>
        </div>

        <%
          const nextItem = reportInfo[index + 1];
          if (!nextItem || nextItem.chapter !== currentChapter) {
        %>
          </div>
        <% } %>
      <% }); %>
    </div>
  </div>

</body>
</html>

