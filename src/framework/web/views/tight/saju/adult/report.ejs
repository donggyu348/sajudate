<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body.cheonhaerang-report {
    background: #030106;
    color: #f0e8e0;
    font-family: 'Noto Serif KR', 'Apple SD Gothic Neo', serif;
    overscroll-behavior: none;
    /* 데스크톱: 폰 프레임 바깥 배경 */
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
  }

  /* ── 전체 스테이지 ── */
  #stage {
    position: relative;
    width: 100%;
    max-width: 430px;
    height: 100dvh;
    overflow: hidden;
    flex-shrink: 0;
  }

  /* 데스크톱: 폰처럼 보이게 */
  @media (min-width: 600px) {
    body.cheonhaerang-report {
      background: #0a0010;
    }
    #stage {
      height: min(90dvh, 860px);
      border-radius: 40px;
      box-shadow:
        0 0 0 1px rgba(255,255,255,0.07),
        0 30px 80px rgba(0,0,0,0.7),
        0 0 120px rgba(180,60,90,0.08);
      overflow: hidden;
    }
  }

  /* ── 배경 이미지 ── */
  #bg-layer {
    position: absolute;
    inset: 0;
    background: #07020a;
    transition: opacity 0.6s ease;
  }
  #bg-layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* 파트별 배경 딤 오버레이 */
  #bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(7,2,10,0.15) 0%,
      rgba(7,2,10,0.25) 40%,
      rgba(7,2,10,0.82) 68%,
      rgba(7,2,10,0.97) 100%
    );
    transition: opacity 0.6s ease;
  }

  /* ── 진행 바 ── */
  #progress-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: rgba(255,255,255,0.08);
    z-index: 10;
  }
  #progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #b43c5a, #e8b4b8);
    transition: width 0.4s ease;
  }


  /* ── 콘텐츠 영역 ── */
  #content-area {
    position: absolute;
    inset: 0;
    z-index: 5;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #content-area::-webkit-scrollbar { display: none; }

  /* 섹션 풀스크린 모드 */
  #content-area.is-section {
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }

  /* ── 비주얼노벨 파트 도입 ── */
  .vn-slide-shell {
    min-height: 100%;
    position: relative;
    padding-bottom: calc(210px + env(safe-area-inset-bottom, 0px));
  }
  .vn-part-label {
    position: absolute;
    top: 52px;
    left: 0; right: 0;
    text-align: center;
    font-size: 10px;
    letter-spacing: 0.28em;
    color: rgba(255,255,255,0.55);
    text-transform: uppercase;
    z-index: 10;
    pointer-events: none;
  }

  /* 하단 대화창 */
  .vn-dialog {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 20px 22px calc(52px + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(to top, rgba(4,1,8,0.97) 0%, rgba(4,1,8,0.88) 60%, transparent 100%);
    backdrop-filter: blur(2px);
    z-index: 10;
  }
  .vn-name {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #d46482;
    border-bottom: 1px solid rgba(212,100,130,0.4);
    padding-bottom: 4px;
    margin-bottom: 10px;
  }
  .vn-text {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(248,240,232,0.95);
    word-break: keep-all;
    letter-spacing: -0.01em;
  }

  /* 레거시 대사 박스 (인트로·verdict용) */
  .char-speech {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 16px;
  }
  .char-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(180,60,90,0.5);
    background: rgba(180,60,90,0.12);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }
  .char-bubble {
    background: rgba(20,6,14,0.88);
    border: 1px solid rgba(180,60,90,0.3);
    border-top-left-radius: 2px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    padding: 10px 14px;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(240,232,224,0.92);
    backdrop-filter: blur(8px);
  }
  .char-name {
    font-size: 10px;
    color: rgba(232,180,184,0.8);
    letter-spacing: 0.15em;
    margin-bottom: 5px;
  }

  /* ── 섹션 풀스크린 레이아웃 ── */

  /* 상단 헤더 고정 영역 */
  .sec-header {
    flex-shrink: 0;
    padding: 52px 24px 20px;
    background: linear-gradient(to bottom, rgba(7,2,10,1) 0%, rgba(7,2,10,0.96) 70%, transparent 100%);
  }
  .sec-eyebrow {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 10px;
  }
  .sec-part-tag {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.28em;
    color: #d46482;
    text-transform: uppercase;
  }
  .sec-eyebrow-sep {
    width: 16px; height: 1px;
    background: rgba(212,100,130,0.35);
  }
  .sec-chapter-name {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.28);
    line-height: 1.4;
    word-break: keep-all;
  }
  .sec-title {
    font-family: 'Noto Serif KR', serif;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #f8ede0 0%, #f0bcc8 50%, #d9b87a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .sec-title-line {
    margin-top: 14px;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, rgba(180,60,90,0.5), rgba(201,169,98,0.2), transparent);
  }

  /* 본문 스크롤 영역 */
  .sec-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    padding: 20px 24px calc(100px + env(safe-area-inset-bottom, 0px));
    scrollbar-width: none;
  }
  .sec-body::-webkit-scrollbar { display: none; }

  .sec-text {
    font-size: 15px;
    line-height: 2.05;
    color: rgba(240,232,224,0.86);
    word-break: keep-all;
    white-space: pre-line;
    letter-spacing: -0.015em;
  }

  /* ── 목차 ── */
  .toc-wrap {
    min-height: 100%;
    padding: 52px 22px calc(88px + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(to bottom, rgba(7,2,10,0.98) 0%, rgba(7,2,10,1) 100%);
    touch-action: pan-y;
  }
  .toc-head {
    text-align: center;
    margin-bottom: 28px;
  }
  .toc-head__label {
    display: inline-block;
    font-size: 9px;
    letter-spacing: 0.32em;
    color: rgba(212,100,130,0.85);
    border: 1px solid rgba(212,100,130,0.35);
    padding: 4px 12px;
    border-radius: 99px;
    margin-bottom: 10px;
  }
  .toc-head__title {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #f8ede0 0%, #f0bcc8 50%, #d9b87a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .toc-chapter {
    margin-bottom: 26px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .toc-chapter:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .toc-chapter__title {
    font-size: 15px;
    font-weight: 700;
    color: rgba(248,240,232,0.95);
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .toc-chapter__subtitle {
    font-size: 12px;
    color: rgba(212,100,130,0.75);
    letter-spacing: -0.01em;
    margin-bottom: 14px;
    word-break: keep-all;
  }
  .toc-section {
    display: flex;
    gap: 10px;
    padding: 9px 0;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .toc-section:first-of-type { border-top: none; }
  .toc-section__no {
    flex-shrink: 0;
    min-width: 28px;
    font-size: 11px;
    font-weight: 700;
    color: rgba(212,100,130,0.65);
    letter-spacing: 0.02em;
    padding-top: 2px;
  }
  .toc-section__body { min-width: 0; }
  .toc-section__title {
    font-size: 13px;
    font-weight: 600;
    color: rgba(240,232,224,0.88);
    line-height: 1.45;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .toc-section__desc {
    font-size: 11px;
    color: rgba(255,255,255,0.38);
    line-height: 1.5;
    margin-top: 3px;
    word-break: keep-all;
  }

  /* ── 스와이프 안내 ── */
  #swipe-hint {
    position: absolute;
    bottom: calc(32px + env(safe-area-inset-bottom, 0px));
    left: 0;
    right: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.5s ease;
  }
  #swipe-hint.is-hidden {
    opacity: 0;
    visibility: hidden;
  }
  .swipe-hint__text {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.62);
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .swipe-hint__arrow {
    font-size: 15px;
    font-weight: 700;
    color: rgba(255, 160, 190, 1);
    animation: swipeHintBlink 1.4s ease-in-out infinite;
  }
  @keyframes swipeHintBlink {
    0%, 100% { opacity: 0.25; transform: translateX(0); }
    50% { opacity: 1; transform: translateX(4px); }
  }


  /* ── 화면 카운터 ── */
  #slide-counter {
    position: absolute;
    bottom: calc(10px + env(safe-area-inset-bottom, 0px));
    left: 20px;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.2);
    z-index: 10;
  }

  /* ── 탭 존 ── */
  #tap-prev {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 30%;
    z-index: 8;
    cursor: pointer;
  }
  #tap-next {
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 70%;
    z-index: 8;
    cursor: pointer;
  }

  /* ── 인트로 특별 스타일 ── */
  .intro-title {
    text-align: center;
    margin-bottom: 24px;
  }
  .intro-title .badge {
    display: inline-block;
    font-size: 9px;
    letter-spacing: 0.35em;
    color: rgba(180,60,90,0.9);
    border: 1px solid rgba(180,60,90,0.35);
    padding: 4px 12px;
    border-radius: 99px;
    margin-bottom: 12px;
  }
  .intro-title h1 {
    font-size: 22px;
    font-weight: 700;
    background: linear-gradient(135deg, #f0e0c8, #e8b4b8, #c9a962);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.35;
  }
  .intro-title p {
    font-size: 12px;
    color: rgba(240,232,224,0.5);
    margin-top: 8px;
    letter-spacing: 0.05em;
  }

  /* ── 상단 네비게이션 버튼 ── */
  #nav-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    z-index: 20;
    pointer-events: none;
  }
  .nav-btn {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: rgba(10,3,16,0.55);
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    pointer-events: all;
    transition: background 0.2s, opacity 0.2s;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-btn:active { background: rgba(180,60,90,0.35); }
  .nav-btn svg { width: 14px; height: 14px; fill: none; stroke: rgba(255,255,255,0.7); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  #nav-prev.hidden, #nav-next.hidden { opacity: 0; pointer-events: none; }

  /* ── 최종 선고 ── */
  .verdict-wrap {
    text-align: center;
    padding: 8px 0 16px;
  }
  .verdict-wrap .label {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: rgba(180,60,90,0.8);
    margin-bottom: 12px;
  }
  .verdict-wrap .verdict-text {
    font-size: 17px;
    line-height: 1.85;
    color: rgba(240,232,224,0.9);
    word-break: keep-all;
    margin-bottom: 24px;
  }
  .verdict-seal {
    width: 72px; height: 72px;
    margin: 0 auto 20px;
    border-radius: 50%;
    border: 1px solid rgba(180,60,90,0.4);
    background: radial-gradient(circle, rgba(180,60,90,0.15) 0%, transparent 70%);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32px;
  }
  .verdict-wrap .share-btn {
    display: inline-block;
    padding: 12px 28px;
    background: linear-gradient(135deg, #b43c5a, #d46482);
    border-radius: 99px;
    font-size: 13px;
    color: #fff;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    border: none;
    box-shadow: 0 4px 20px rgba(180,60,90,0.35);
  }

  /* ── 슬라이드 트랜지션 ── */
  #slide-wrapper {
    position: absolute;
    inset: 0;
    z-index: 4;
  }
  .slide-enter {
    animation: slideIn 0.35s ease forwards;
  }
  .slide-exit {
    animation: slideOut 0.35s ease forwards;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(18px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes slideOut {
    from { opacity: 1; transform: translateX(0); }
    to   { opacity: 0; transform: translateX(-18px); }
  }

  /* ── 파트 전환 배경 이미지 없을 때 패턴 ── */
  .no-img-bg {
    background:
      radial-gradient(ellipse 100% 60% at 50% 0%, rgba(180,60,90,0.18) 0%, transparent 55%),
      radial-gradient(ellipse 70% 40% at 80% 90%, rgba(201,169,98,0.1) 0%, transparent 50%),
      #07020a;
  }
</style>

<body class="cheonhaerang-report">
<%
  /* ── 데이터 준비 ── */
  const g = String(userInfo.gender || '').trim();
  const isFemale = ["여","여자","여성","female","woman"].includes(g.toLowerCase());

  /* reportInfo: [{ chapter, title, content }] */
  /* 장(chapter)별로 그룹핑 */
  const chapterMap = {};
  const chapterOrder = [];
  (reportInfo || []).forEach(item => {
    if (!chapterMap[item.chapter]) {
      chapterMap[item.chapter] = [];
      chapterOrder.push(item.chapter);
    }
    chapterMap[item.chapter].push(item);
  });

  /* 파트 아이콘 & 연출 지문 */
  const partMeta = [
    { icon: '🩸', bgClass: 'no-img-bg' },
    { icon: '🐍', bgClass: 'no-img-bg' },
    { icon: '🖤', bgClass: 'no-img-bg' },
    { icon: '🕯️', bgClass: 'no-img-bg' },
    { icon: '⛧', bgClass: 'no-img-bg' },
  ];

  /* 목차 (고정) */
  const reportToc = [
    {
      num: 1,
      chapter: '욕망의 해부학',
      subtitle: '네 안에 숨겨진 본능은 무엇인가',
      sections: [
        { no: '1', title: '정욕합이 들어맞는 사람', desc: '당신의 욕망을 깨우는 상대의 특징' },
        { no: '2', title: '너도 몰랐던 숨겨진 욕망들', desc: '무의식 속 끌림 분석' },
        { no: '3', title: 'SM 성향 분석', desc: '두 사람의 관계 속 본능적 위치' },
        { no: '추가', title: '시선이 오래 머무는 이유', desc: '당신이 유독 약한 성적 포인트' },
      ],
    },
    {
      num: 2,
      chapter: '본능은 누구에게 반응하는가',
      subtitle: '너에게 가장 위험한 사람',
      sections: [
        { no: '1', title: '너에게 먹히는 스타일링', desc: '당신만의 시각적 최음제 분석' },
        { no: '2', title: '첫눈에 꽂히는 상대', desc: '외모·분위기·성향 분석' },
        { no: '3', title: '본능을 자극하는 행동', desc: '당신을 흔드는 결정적 요소' },
        { no: '추가', title: '절대 피할 수 없는 끌림', desc: '사주가 강하게 반응하는 상대' },
      ],
    },
    {
      num: 3,
      chapter: '몸정일까 마음정일까',
      subtitle: '둘의 정욕합 심층 분석',
      sections: [
        { no: '1', title: '손만 닿아도 전류가 흐르는 정욕합', desc: '둘 사이의 화학 반응' },
        { no: '2', title: '서로가 굴복하는 지점', desc: '관계 속 약점과 치명적 포인트' },
        { no: '3', title: '둘만의 주도권', desc: '누가 끌고 누가 따라가는가' },
        { no: '추가', title: '한 번 스치면 잊히지 않는 이유', desc: '강한 잔상을 남기는 요소' },
      ],
    },
    {
      num: 4,
      chapter: '스파크가 튀는 순간',
      subtitle: '언제, 어디서 가장 강해지는가',
      sections: [
        { no: '1', title: '발정 시기 분석', desc: '서로의 사주가 동시에 성적으로 폭발하는 시기' },
        { no: '2', title: '스파크 튀는 장소 스팟', desc: '관계 만족도가 폭발하는 공간' },
        { no: '3', title: '둘이 만나면 강해지는 시간대', desc: '끌림이 극대화되는 타이밍' },
        { no: '추가', title: '천해랑의 위험 경고', desc: '성욕이 폭주하는 순간' },
      ],
    },
    {
      num: 5,
      chapter: '중독의 기술',
      subtitle: '왜 자꾸 밤마다 생각나는가',
      sections: [
        { no: '1', title: '당신의 성적 필살기', desc: '상대를 사로잡는 무기' },
        { no: '2', title: '서로의 바람기 분석', desc: '새로운 자극에 흔들리는 정도' },
        { no: '3', title: '헤어지게 되도 못잊게 만드는 방법', desc: '' },
        { no: '추가', title: '천해랑의 결론', desc: '둘의 정욕합은 운명인가, 중독인가' },
      ],
    },
  ];

  /* ── 슬라이드 배열 생성 ── */
  /* 슬라이드 타입: intro | chapter-title | section | verdict */
  const slides = [];

  /* 0. 인트로 */
  slides.push({
    type: 'intro',
    partIdx: 0,
    name: userInfo.name || '당신'
  });

  slides.push({ type: 'toc' });

  /* 파트별 슬라이드 생성 */
  chapterOrder.forEach((chapter, ci) => {
    const meta = partMeta[ci] || partMeta[0];
    const sections = chapterMap[chapter];

    /* 파트 도입 */
    slides.push({
      type: 'chapter-title',
      partIdx: ci,
      chapter,
      meta,
      partNum: ci + 1
    });

    /* 섹션별 슬라이드 */
    sections.forEach(sec => {
      slides.push({
        type: 'section',
        partIdx: ci,
        chapter,
        meta,
        title: sec.title,
        content: sec.content
      });
    });
  });

  /* 최종 선고 */
  slides.push({ type: 'verdict', partIdx: chapterOrder.length });

  const totalSlides = slides.length;
%>

<div id="stage">
  <!-- 진행 바 -->
  <div id="progress-bar"><div id="progress-fill"></div></div>

  <!-- 배경 레이어 -->
  <div id="bg-layer" class="no-img-bg">
    <img id="bg-img" src="" alt="" style="display:none; width:100%; height:100%; object-fit:cover; object-position:top center;">
  </div>
  <div id="bg-overlay"></div>

  <!-- 상단 네비게이션 -->
  <div id="nav-bar">
    <button class="nav-btn" id="nav-prev" aria-label="이전">
      <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="nav-btn" id="nav-next" aria-label="다음">
      <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
    </button>
  </div>

  <!-- 탭 존 -->
  <div id="tap-prev"></div>
  <div id="tap-next"></div>

  <!-- 슬라이드 콘텐츠 -->
  <div id="slide-wrapper">
    <div id="content-area"></div>
  </div>

  <!-- 하단 카운터만 -->
  <div id="slide-counter"></div>

  <!-- 스와이프 안내 -->
  <div id="swipe-hint">
    <span class="swipe-hint__text">옆으로 넘겨 읽어보세요</span>
    <span class="swipe-hint__arrow" aria-hidden="true">=&gt;</span>
  </div>
</div>

<script>
(function () {
  /* ── 슬라이드 데이터 (EJS → JS) ── */
  const SLIDES = <%- JSON.stringify(slides) %>;
  const REPORT_TOC = <%- JSON.stringify(reportToc) %>;
  const TOTAL = SLIDES.length;

  let current = 0;
  let isAnimating = false;
  let swipeHintHidden = false;

  /* ── 이미지 경로 (파트별 1장 + 인트로 1장, 총 7장) ── */
  /* 이미지 준비되면 아래 경로만 교체하면 됨 */
  const PART_IMGS = [
    '/assets/images/tight/29/report/intro.png',   // 인트로
    '/assets/images/tight/29/report/part1.png',   // PART 1
    '/assets/images/tight/29/report/part2.png',   // PART 2
    '/assets/images/tight/29/report/part3.png',   // PART 3
    '/assets/images/tight/29/report/part4.png',   // PART 4
    '/assets/images/tight/29/report/part5.png',   // PART 5
    '/assets/images/tight/29/report/part6.png',   // PART 6
  ];

  /* ── DOM refs ── */
  const $progress   = document.getElementById('progress-fill');
  const $bgLayer    = document.getElementById('bg-layer');
  const $bgOverlay  = document.getElementById('bg-overlay');
  const $bgImg      = document.getElementById('bg-img');
  const $content    = document.getElementById('content-area');
  const $counter    = document.getElementById('slide-counter');
  const $swipeHint  = document.getElementById('swipe-hint');

  function hideSwipeHint() {
    if (swipeHintHidden) return;
    swipeHintHidden = true;
    $swipeHint.classList.add('is-hidden');
  }

  function updateSwipeHint(idx) {
    if (swipeHintHidden) {
      $swipeHint.classList.add('is-hidden');
      return;
    }
    const s = SLIDES[idx];
    const show = s.type !== 'verdict' && idx < TOTAL - 1;
    $swipeHint.classList.toggle('is-hidden', !show);
  }

  /* ── 슬라이드 렌더 ── */
  function render(idx, dir) {
    const s = SLIDES[idx];

    /* 진행 바 */
    $progress.style.width = ((idx + 1) / TOTAL * 100) + '%';

    /* 카운터 */
    $counter.textContent = (idx + 1) + ' / ' + TOTAL;

    /* 파트 라벨 */

    /* ── 배경 이미지: 인트로·파트 도입·최종 선고만 표시 ── */
    const showImg = s.type === 'intro' || s.type === 'chapter-title' || s.type === 'verdict';
    if (s.type === 'toc') {
      $bgImg.src = '';
      $bgImg.style.display = 'none';
      $bgLayer.className = 'no-img-bg';
      $bgOverlay.style.background = 'none';
    } else if (showImg) {
      let imgSrc;
      if (s.type === 'intro') imgSrc = PART_IMGS[0];
      else if (s.type === 'verdict') imgSrc = '/assets/images/tight/29/report/outro.png';
      else imgSrc = PART_IMGS[s.partIdx + 1] || PART_IMGS[0];
      /* outro 없으면 intro 이미지 재활용 */
      const img = new Image();
      img.onload = () => { $bgImg.src = imgSrc; };
      img.onerror = () => { $bgImg.src = PART_IMGS[0]; };
      img.src = imgSrc;
      $bgImg.src = imgSrc;
      $bgImg.style.display = 'block';
      $bgLayer.className = '';
      $bgOverlay.style.background = 'linear-gradient(to bottom, rgba(7,2,10,0.1) 0%, rgba(7,2,10,0.2) 35%, rgba(7,2,10,0.75) 65%, rgba(7,2,10,0.97) 100%)';
    } else {
      $bgImg.src = '';
      $bgImg.style.display = 'none';
      $bgLayer.className = 'no-img-bg';
      $bgOverlay.style.background = 'none';
    }

    /* 콘텐츠 HTML */
    let html = '';

    if (s.type === 'intro') {
      html = renderIntro(s);
      $content.classList.remove('is-section');
    } else if (s.type === 'toc') {
      html = renderToc();
      $content.classList.remove('is-section');
    } else if (s.type === 'chapter-title') {
      html = renderChapterTitle(s);
      $content.classList.remove('is-section');
    } else if (s.type === 'section') {
      html = renderSection(s);
      $content.classList.add('is-section');
    } else if (s.type === 'verdict') {
      html = renderVerdict();
      $content.classList.remove('is-section');
    }

    /* 애니메이션 */
    $content.style.opacity = '0';
    $content.style.transform = 'translateX(' + (dir > 0 ? '14px' : '-14px') + ')';
    $content.innerHTML = html;
    $content.scrollTop = 0;
    const secBody = $content.querySelector('.sec-body');
    if (secBody) secBody.scrollTop = 0;

    requestAnimationFrame(() => {
      $content.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      $content.style.opacity = '1';
      $content.style.transform = 'translateX(0)';
    });

    /* nav 버튼 상태 업데이트 */
    updateNavBtns();
    updateTapZones(idx);
    updateSwipeHint(idx);
  }

  /* ── 목차 ── */
  function renderToc() {
    const chapters = REPORT_TOC.map(function(ch) {
      const sections = ch.sections.map(function(sec) {
        const descHtml = sec.desc
          ? `<p class="toc-section__desc">${sec.desc}</p>`
          : '';
        return `
          <div class="toc-section">
            <span class="toc-section__no">${sec.no}</span>
            <div class="toc-section__body">
              <p class="toc-section__title">${sec.title}</p>
              ${descHtml}
            </div>
          </div>
        `;
      }).join('');

      return `
        <section class="toc-chapter">
          <h3 class="toc-chapter__title">제${ch.num}장: ${ch.chapter}</h3>
          <p class="toc-chapter__subtitle">${ch.subtitle}</p>
          ${sections}
        </section>
      `;
    }).join('');

    return `
      <div class="toc-wrap">
        <div class="toc-head">
          <span class="toc-head__label">CONTENTS</span>
          <h2 class="toc-head__title">목차</h2>
        </div>
        ${chapters}
      </div>
    `;
  }

  /* ── 인트로 ── */
  function renderIntro(s) {
    return `
      <div class="vn-slide-shell">
        <div class="vn-part-label">29금 · 성인 사주 리포트</div>
        <div class="vn-dialog">
          <div class="vn-name">천해랑</div>
          <div class="vn-text">
            ${s.name}님, 오셨군요.<br>
            오늘 밤 당신 사주 다 들여다볼 거예요.<br>
            각오는 됐죠?
          </div>
        </div>
      </div>
    `;
  }

  /* ── 파트 도입 ── */
  function renderChapterTitle(s) {
    const partRoman = ['Ⅰ','Ⅱ','Ⅲ','Ⅳ','Ⅴ','Ⅵ'][s.partIdx] || s.partIdx + 1;
    return `
      <div class="vn-slide-shell">
        <div class="vn-part-label">PART ${partRoman} · ${s.chapter}</div>
        <div class="vn-dialog">
          <div class="vn-name">천해랑</div>
          <div class="vn-text">${chapterIntro(s.partIdx)}</div>
        </div>
      </div>
    `;
  }

  /* ── 섹션 본문 (풀스크린) ── */
  function renderSection(s) {
    const partRoman = ['Ⅰ','Ⅱ','Ⅲ','Ⅳ','Ⅴ','Ⅵ'][s.partIdx] || '';
    return `
      <div class="sec-header">
        <div class="sec-eyebrow">
          <span class="sec-part-tag">PART ${partRoman}</span>
          <div class="sec-eyebrow-sep"></div>
          <span class="sec-chapter-name">${s.chapter}</span>
        </div>
        <div class="sec-title">${s.title}</div>
        <div class="sec-title-line"></div>
      </div>
      <div class="sec-body">
        <div class="sec-text">${formatContent(s.content)}</div>
      </div>
    `;
  }

  /* ── 최종 선고 ── */
  function renderVerdict() {
    return `
      <div class="vn-slide-shell">
        <div class="vn-part-label">天海娘 · 최종 선고</div>
        <div class="vn-dialog">
          <div class="vn-name">천해랑</div>
          <div class="vn-text">
            여기까지 다 읽었군요.<br>
            당신 사주, 생각보다 훨씬 강렬했어요.<br><br>
            이 이야기가 당신 안에 오래 남기를.<br>
            그리고… 잘 써먹길 바랄게요.
          </div>
          <button class="share-btn" onclick="goTo(0,-1)" style="margin-top:20px;width:100%;">처음부터 다시 보기</button>
        </div>
      </div>
    `;
  }

  /* ── 파트별 캐릭터 도입 대사 ── */
  function chapterIntro(idx) {
    const lines = [
      '당신 사주에서 제일 먼저 보인 게 뭔지 알아요?\n욕망이에요. 둘 다요.',
      '본능은 거짓말을 안 해요.\n누구에게 반응하는지, 이미 사주에 다 나와 있거든요.',
      '몸이 먼저 알아요, 아니면 마음이 먼저?\n둘의 정욕합을 제가 직접 들여다볼게요.',
      '스파크가 튀는 순간이 있어요.\n언제, 어디서 가장 위험한지 알려드릴게요.',
      '마지막이에요.\n왜 자꾸 생각나는지, 이게 운명인지 중독인지 제가 판정 내릴게요.',
    ];
    return (lines[idx] || '이제 다음 이야기로 넘어가요.').replace(/\n/g, '<br>');
  }

  /* ── 본문 포맷 ── */
  function formatContent(text) {
    if (!text) return '';
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\n/g, '<br>');
  }

  /* ── 이동 (전역 노출 — verdict 버튼에서 사용) ── */
  window.goTo = function goTo(idx, dir) {
    if (isAnimating) return;
    if (idx < 0 || idx >= TOTAL) return;
    if (dir > 0 && idx > current) hideSwipeHint();
    isAnimating = true;
    current = idx;
    render(current, dir);
    setTimeout(() => { isAnimating = false; }, 350);
  }

  /* ── 탭 이벤트 ── */
  document.getElementById('tap-next').addEventListener('click', () => goTo(current + 1, 1));
  document.getElementById('tap-prev').addEventListener('click', () => goTo(current - 1, -1));

  /* ── 상단 nav 버튼 ── */
  const $navPrev = document.getElementById('nav-prev');
  const $navNext = document.getElementById('nav-next');
  $navPrev.addEventListener('click', () => goTo(current - 1, -1));
  $navNext.addEventListener('click', () => goTo(current + 1, 1));

  function updateNavBtns() {
    $navPrev.classList.toggle('hidden', current === 0);
    $navNext.classList.toggle('hidden', current >= TOTAL - 1);
  }

  function updateTapZones(idx) {
    const s = SLIDES[idx];
    const scrollMode = s.type === 'section' || s.type === 'toc';
    document.getElementById('tap-prev').style.pointerEvents = scrollMode ? 'none' : 'auto';
    document.getElementById('tap-next').style.pointerEvents = scrollMode ? 'none' : 'auto';
    $content.style.zIndex = scrollMode ? '9' : '5';
  }

  /* ── 스와이프 (가로만) ── */
  let touchStartX = 0;
  let touchStartY = 0;
  document.getElementById('stage').addEventListener('touchstart', e => {
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });
  document.getElementById('stage').addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    const dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
    dx < 0 ? goTo(current + 1, 1) : goTo(current - 1, -1);
  }, { passive: true });

  /* ── 키보드 ── */
  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === ' ') goTo(current + 1, 1);
    if (e.key === 'ArrowLeft') goTo(current - 1, -1);
  });

  /* ── 초기 렌더 ── */
  $content.style.transition = 'none';
  render(0, 1);
})();
</script>
</body>
</html>
