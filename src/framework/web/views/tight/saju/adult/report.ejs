<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body.cheonhaerang-report {
    background: #07020a;
    color: #f0e8e0;
    font-family: 'Noto Serif KR', 'Apple SD Gothic Neo', serif;
    overscroll-behavior: none;
  }

  /* ── 전체 스테이지 ── */
  #stage {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
  }

  /* ── 배경 이미지 ── */
  #bg-layer {
    position: absolute;
    inset: 0;
    background: #07020a;
    transition: opacity 0.6s ease;
  }
  #bg-layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* 파트별 배경 딤 오버레이 */
  #bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(7,2,10,0.15) 0%,
      rgba(7,2,10,0.25) 40%,
      rgba(7,2,10,0.82) 68%,
      rgba(7,2,10,0.97) 100%
    );
    transition: opacity 0.6s ease;
  }

  /* ── 진행 바 ── */
  #progress-bar {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: rgba(255,255,255,0.08);
    z-index: 10;
  }
  #progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #b43c5a, #e8b4b8);
    transition: width 0.4s ease;
  }

  /* ── 상단 파트 표시 ── */
  #part-label {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    letter-spacing: 0.3em;
    color: rgba(232,180,184,0.7);
    z-index: 10;
    white-space: nowrap;
  }

  /* ── 콘텐츠 영역 ── */
  #content-area {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 0 20px 32px;
    z-index: 5;
    max-height: 62dvh;
    overflow-y: auto;
    scrollbar-width: none;
  }
  #content-area::-webkit-scrollbar { display: none; }

  /* ── 캐릭터 대사 박스 ── */
  .char-speech {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 16px;
  }
  .char-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgba(180,60,90,0.5);
    background: rgba(180,60,90,0.12);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }
  .char-bubble {
    background: rgba(20,6,14,0.88);
    border: 1px solid rgba(180,60,90,0.3);
    border-top-left-radius: 2px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
    padding: 10px 14px;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(240,232,224,0.92);
    backdrop-filter: blur(8px);
  }
  .char-name {
    font-size: 10px;
    color: rgba(232,180,184,0.8);
    letter-spacing: 0.15em;
    margin-bottom: 5px;
  }

  /* ── 섹션 카드 ── */
  .sec-card {
    background: linear-gradient(160deg, rgba(28,8,18,0.92) 0%, rgba(14,4,10,0.96) 100%);
    border: 1px solid rgba(180,60,90,0.22);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.04);
    margin-bottom: 12px;
  }

  /* 카드 상단 컬러 바 */
  .sec-card-bar {
    height: 3px;
    background: linear-gradient(90deg, #b43c5a, #d46482, #c9a962);
    opacity: 0.85;
  }

  .sec-card-head {
    padding: 18px 20px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .sec-card-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .sec-card-part {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.25em;
    color: rgba(212,100,130,0.75);
    text-transform: uppercase;
  }
  .sec-card-dot {
    width: 3px; height: 3px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    flex-shrink: 0;
  }
  .sec-card-chapter {
    font-size: 9px;
    letter-spacing: 0.15em;
    color: rgba(255,255,255,0.3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sec-card-title {
    font-family: 'Noto Serif KR', serif;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.35;
    background: linear-gradient(135deg, #f5e6d0 0%, #eec0c8 55%, #d4ae7a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.01em;
  }

  /* 카드 본문 */
  .sec-card-body {
    padding: 16px 20px 20px;
  }
  .sec-card-content {
    font-size: 14px;
    line-height: 2;
    color: rgba(240,232,224,0.82);
    word-break: keep-all;
    white-space: pre-line;
    letter-spacing: -0.01em;
  }

  /* 카드 하단 스크롤 힌트 */
  .sec-card-footer {
    padding: 0 20px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sec-card-footer-line {
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.06);
  }
  .sec-card-footer-txt {
    font-size: 10px;
    color: rgba(255,255,255,0.18);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  /* ── 하단 탭 안내 ── */
  #tap-hint {
    position: absolute;
    bottom: 10px;
    right: 20px;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: rgba(255,255,255,0.25);
    z-index: 10;
    pointer-events: none;
    transition: opacity 0.4s;
  }

  /* ── 화면 카운터 ── */
  #slide-counter {
    position: absolute;
    bottom: 10px;
    left: 20px;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.2);
    z-index: 10;
  }

  /* ── 탭 존 ── */
  #tap-prev {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 30%;
    z-index: 8;
    cursor: pointer;
  }
  #tap-next {
    position: absolute;
    right: 0; top: 0; bottom: 0;
    width: 70%;
    z-index: 8;
    cursor: pointer;
  }

  /* ── 인트로 특별 스타일 ── */
  .intro-title {
    text-align: center;
    margin-bottom: 24px;
  }
  .intro-title .badge {
    display: inline-block;
    font-size: 9px;
    letter-spacing: 0.35em;
    color: rgba(180,60,90,0.9);
    border: 1px solid rgba(180,60,90,0.35);
    padding: 4px 12px;
    border-radius: 99px;
    margin-bottom: 12px;
  }
  .intro-title h1 {
    font-size: 22px;
    font-weight: 700;
    background: linear-gradient(135deg, #f0e0c8, #e8b4b8, #c9a962);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.35;
  }
  .intro-title p {
    font-size: 12px;
    color: rgba(240,232,224,0.5);
    margin-top: 8px;
    letter-spacing: 0.05em;
  }

  /* ── 최종 선고 ── */
  .verdict-wrap {
    text-align: center;
    padding: 8px 0 16px;
  }
  .verdict-wrap .label {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: rgba(180,60,90,0.8);
    margin-bottom: 12px;
  }
  .verdict-wrap .verdict-text {
    font-size: 17px;
    line-height: 1.85;
    color: rgba(240,232,224,0.9);
    word-break: keep-all;
    margin-bottom: 24px;
  }
  .verdict-wrap .share-btn {
    display: inline-block;
    padding: 12px 28px;
    background: linear-gradient(135deg, #b43c5a, #d46482);
    border-radius: 99px;
    font-size: 13px;
    color: #fff;
    font-weight: 600;
    letter-spacing: 0.05em;
    cursor: pointer;
    border: none;
    box-shadow: 0 4px 20px rgba(180,60,90,0.35);
  }

  /* ── 슬라이드 트랜지션 ── */
  #slide-wrapper {
    position: absolute;
    inset: 0;
    z-index: 4;
  }
  .slide-enter {
    animation: slideIn 0.35s ease forwards;
  }
  .slide-exit {
    animation: slideOut 0.35s ease forwards;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(18px); }
    to   { opacity: 1; transform: translateX(0); }
  }
  @keyframes slideOut {
    from { opacity: 1; transform: translateX(0); }
    to   { opacity: 0; transform: translateX(-18px); }
  }

  /* ── 파트 전환 배경 이미지 없을 때 패턴 ── */
  .no-img-bg {
    background:
      radial-gradient(ellipse 100% 60% at 50% 0%, rgba(180,60,90,0.18) 0%, transparent 55%),
      radial-gradient(ellipse 70% 40% at 80% 90%, rgba(201,169,98,0.1) 0%, transparent 50%),
      #07020a;
  }
</style>

<body class="cheonhaerang-report">
<%
  /* ── 데이터 준비 ── */
  const g = String(userInfo.gender || '').trim();
  const isFemale = ["여","여자","여성","female","woman"].includes(g.toLowerCase());

  /* reportInfo: [{ chapter, title, content }] */
  /* 장(chapter)별로 그룹핑 */
  const chapterMap = {};
  const chapterOrder = [];
  (reportInfo || []).forEach(item => {
    if (!chapterMap[item.chapter]) {
      chapterMap[item.chapter] = [];
      chapterOrder.push(item.chapter);
    }
    chapterMap[item.chapter].push(item);
  });

  /* 파트 아이콘 & 연출 지문 */
  const partMeta = [
    { icon: '🪄', pose: '붉은 부채를 펼치며 윙크', bgClass: 'no-img-bg' },
    { icon: '🌙', pose: '엽전을 손가락으로 굴리며', bgClass: 'no-img-bg' },
    { icon: '🔮', pose: '은색 방울을 흔들며', bgClass: 'no-img-bg' },
    { icon: '🕯️', pose: '촛불 앞에서 턱을 괴며', bgClass: 'no-img-bg' },
    { icon: '💀', pose: '차갑게 미소를 지으며', bgClass: 'no-img-bg' },
    { icon: '⛧', pose: '붉은 실을 감으며', bgClass: 'no-img-bg' },
  ];

  /* ── 슬라이드 배열 생성 ── */
  /* 슬라이드 타입: intro | chapter-title | section | verdict */
  const slides = [];

  /* 0. 인트로 */
  slides.push({
    type: 'intro',
    partIdx: 0,
    name: userInfo.name || '당신'
  });

  /* 파트별 슬라이드 생성 */
  chapterOrder.forEach((chapter, ci) => {
    const meta = partMeta[ci] || partMeta[0];
    const sections = chapterMap[chapter];

    /* 파트 도입 */
    slides.push({
      type: 'chapter-title',
      partIdx: ci,
      chapter,
      meta,
      partNum: ci + 1
    });

    /* 섹션별 슬라이드 */
    sections.forEach(sec => {
      slides.push({
        type: 'section',
        partIdx: ci,
        chapter,
        meta,
        title: sec.title,
        content: sec.content
      });
    });
  });

  /* 최종 선고 */
  slides.push({ type: 'verdict', partIdx: chapterOrder.length });

  const totalSlides = slides.length;
%>

<div id="stage">
  <!-- 진행 바 -->
  <div id="progress-bar"><div id="progress-fill"></div></div>

  <!-- 파트 라벨 -->
  <div id="part-label"></div>

  <!-- 배경 레이어 -->
  <div id="bg-layer" class="no-img-bg">
    <img id="bg-img" src="" alt="" style="display:none; width:100%; height:100%; object-fit:cover; object-position:top center;">
  </div>
  <div id="bg-overlay"></div>

  <!-- 탭 존 -->
  <div id="tap-prev"></div>
  <div id="tap-next"></div>

  <!-- 슬라이드 콘텐츠 -->
  <div id="slide-wrapper">
    <div id="content-area"></div>
  </div>

  <!-- 하단 UI -->
  <div id="slide-counter"></div>
  <div id="tap-hint">탭하여 넘기기</div>
</div>

<script>
(function () {
  /* ── 슬라이드 데이터 (EJS → JS) ── */
  const SLIDES = <%- JSON.stringify(slides) %>;
  const TOTAL = SLIDES.length;

  let current = 0;
  let isAnimating = false;

  /* ── 이미지 경로 (파트별 1장 + 인트로 1장, 총 7장) ── */
  /* 이미지 준비되면 아래 경로만 교체하면 됨 */
  const PART_IMGS = [
    '/assets/images/cheonhaerang/intro.png',   // 인트로
    '/assets/images/cheonhaerang/part1.png',   // PART 1
    '/assets/images/cheonhaerang/part2.png',   // PART 2
    '/assets/images/cheonhaerang/part3.png',   // PART 3
    '/assets/images/cheonhaerang/part4.png',   // PART 4
    '/assets/images/cheonhaerang/part5.png',   // PART 5
    '/assets/images/cheonhaerang/part6.png',   // PART 6
  ];

  /* ── DOM refs ── */
  const $progress   = document.getElementById('progress-fill');
  const $partLabel  = document.getElementById('part-label');
  const $bgLayer    = document.getElementById('bg-layer');
  const $bgOverlay  = document.getElementById('bg-overlay');
  const $bgImg      = document.getElementById('bg-img');
  const $content    = document.getElementById('content-area');
  const $counter    = document.getElementById('slide-counter');
  const $tapHint    = document.getElementById('tap-hint');

  /* ── 슬라이드 렌더 ── */
  function render(idx, dir) {
    const s = SLIDES[idx];

    /* 진행 바 */
    $progress.style.width = ((idx + 1) / TOTAL * 100) + '%';

    /* 카운터 */
    $counter.textContent = (idx + 1) + ' / ' + TOTAL;

    /* 파트 라벨 */
    const partNames = ['PART Ⅰ','PART Ⅱ','PART Ⅲ','PART Ⅳ','PART Ⅴ','PART Ⅵ'];
    if (s.type === 'intro') {
      $partLabel.textContent = '천해랑의 은밀한 정욕합 사주';
    } else if (s.type === 'verdict') {
      $partLabel.textContent = '天海娘 · 최종 선고';
    } else {
      $partLabel.textContent = (partNames[s.partIdx] || '') + ' · ' + (s.chapter || '');
    }

    /* ── 배경 이미지: 인트로·파트 도입만 표시, 나머지는 숨김 ── */
    const showImg = s.type === 'intro' || s.type === 'chapter-title';
    if (showImg) {
      const imgSrc = s.type === 'intro'
        ? PART_IMGS[0]
        : PART_IMGS[s.partIdx + 1] || PART_IMGS[0];
      $bgImg.src = imgSrc;
      $bgImg.style.display = 'block';
      $bgLayer.className = '';
      /* 이미지 초입: 딤을 살짝 밝게 */
      $bgOverlay.style.background = 'linear-gradient(to bottom, rgba(7,2,10,0.1) 0%, rgba(7,2,10,0.2) 35%, rgba(7,2,10,0.75) 65%, rgba(7,2,10,0.97) 100%)';
    } else {
      $bgImg.src = '';
      $bgImg.style.display = 'none';
      $bgLayer.className = 'no-img-bg';
      /* 본문: 오버레이 필요 없음 */
      $bgOverlay.style.background = 'none';
    }

    /* 콘텐츠 HTML */
    let html = '';

    if (s.type === 'intro') {
      html = renderIntro(s);
    } else if (s.type === 'chapter-title') {
      html = renderChapterTitle(s);
    } else if (s.type === 'section') {
      html = renderSection(s);
    } else if (s.type === 'verdict') {
      html = renderVerdict();
    }

    /* 애니메이션 */
    $content.style.opacity = '0';
    $content.style.transform = 'translateX(' + (dir > 0 ? '14px' : '-14px') + ')';
    $content.innerHTML = html;
    $content.scrollTop = 0;

    requestAnimationFrame(() => {
      $content.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
      $content.style.opacity = '1';
      $content.style.transform = 'translateX(0)';
    });

    /* 탭 힌트 마지막 슬라이드에서 숨김 */
    $tapHint.style.opacity = idx >= TOTAL - 1 ? '0' : '1';
  }

  /* ── 인트로 ── */
  function renderIntro(s) {
    return `
      <div class="intro-title">
        <div class="badge">29금 · 성인 사주 리포트</div>
        <h1>천해랑의<br>은밀한 정욕합 사주</h1>
        <p>${s.name}님의 사주로 읽어드립니다</p>
      </div>
      <div class="char-speech">
        <div class="char-avatar">🪄</div>
        <div class="char-bubble">
          <div class="char-name">천해랑 天海娘</div>
          어서 오세요. 오늘 밤 당신의 사주를 들여다보겠어요.<br>
          마음의 준비가 되셨나요? 탭하여 시작하세요.
        </div>
      </div>
    `;
  }

  /* ── 파트 도입 ── */
  function renderChapterTitle(s) {
    const roman = ['壹','貳','參','肆','伍','陸'];
    const num = roman[s.partIdx] || String(s.partIdx + 1);
    return `
      <div class="char-speech">
        <div class="char-avatar">${s.meta.icon}</div>
        <div class="char-bubble">
          <div class="char-name">천해랑 天海娘</div>
          ${chapterIntro(s.partIdx, s.chapter)}
        </div>
      </div>
      <div class="section-eyebrow">PART ${['Ⅰ','Ⅱ','Ⅲ','Ⅳ','Ⅴ','Ⅵ'][s.partIdx] || s.partIdx + 1}</div>
      <div class="section-title">${s.chapter}</div>
      <div class="section-divider"></div>
      <div class="section-content" style="color:rgba(240,232,224,0.55);font-size:13px;">
        ${s.meta.pose}… 옷깃을 여미며 이야기를 시작합니다.
      </div>
    `;
  }

  /* ── 섹션 본문 (카드형) ── */
  function renderSection(s) {
    const partRoman = ['Ⅰ','Ⅱ','Ⅲ','Ⅳ','Ⅴ','Ⅵ'][s.partIdx] || '';
    return `
      <div class="sec-card">
        <div class="sec-card-bar"></div>
        <div class="sec-card-head">
          <div class="sec-card-eyebrow">
            <span class="sec-card-part">PART ${partRoman}</span>
            <span class="sec-card-dot"></span>
            <span class="sec-card-chapter">${s.chapter}</span>
          </div>
          <div class="sec-card-title">${s.title}</div>
        </div>
        <div class="sec-card-body">
          <div class="sec-card-content">${formatContent(s.content)}</div>
        </div>
        <div class="sec-card-footer">
          <div class="sec-card-footer-line"></div>
          <span class="sec-card-footer-txt">탭하여 다음으로</span>
          <div class="sec-card-footer-line"></div>
        </div>
      </div>
    `;
  }

  /* ── 최종 선고 ── */
  function renderVerdict() {
    return `
      <div class="char-speech">
        <div class="char-avatar">⛧</div>
        <div class="char-bubble">
          <div class="char-name">천해랑 天海娘</div>
          이걸로 당신의 사주를 다 읽었어요.<br>
          이 이야기가 당신 안에 오래 남기를 바라겠습니다.
        </div>
      </div>
      <div class="verdict-wrap">
        <div class="label">天海娘 · 최종 선고</div>
        <div class="verdict-text">
          당신의 욕망은 운명이 아니에요.<br>
          하지만 사주는 그 욕망이<br>어디서 왔는지 알고 있습니다.
        </div>
        <button class="share-btn" onclick="window.scrollTo(0,0)">처음부터 다시 보기</button>
      </div>
    `;
  }

  /* ── 파트별 캐릭터 도입 대사 ── */
  function chapterIntro(idx, chapter) {
    const lines = [
      '첫 번째 이야기예요. 당신 안에 잠든 본능부터 꺼내볼게요.',
      '이번엔 밤을 지배하는 기운을 읽어드리겠어요. 눈 감아도 괜찮아요.',
      '당신이 상대를 홀리는 방식을 알려드릴게요. 꽤 흥미롭더군요.',
      '침대 위의 권력 이야기예요. 긴장하지 않아도 되지만… 아마 긴장하실 거예요.',
      '궁합의 진실이에요. 쾌락이 일치하는 상대와, 그렇지 않은 상대.',
      '마지막이에요. 묘월무녀가 직접 드리는 비책이니까 잘 새겨두세요.',
    ];
    return lines[idx] || chapter + '에 대해 이야기할게요.';
  }

  /* ── 본문 포맷 ── */
  function formatContent(text) {
    if (!text) return '';
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\n/g, '<br>');
  }

  /* ── 이동 ── */
  function goTo(idx, dir) {
    if (isAnimating) return;
    if (idx < 0 || idx >= TOTAL) return;
    isAnimating = true;
    current = idx;
    render(current, dir);
    setTimeout(() => { isAnimating = false; }, 350);
  }

  /* ── 탭 이벤트 ── */
  document.getElementById('tap-next').addEventListener('click', () => goTo(current + 1, 1));
  document.getElementById('tap-prev').addEventListener('click', () => goTo(current - 1, -1));

  /* ── 스와이프 ── */
  let touchStartX = 0;
  document.getElementById('stage').addEventListener('touchstart', e => {
    touchStartX = e.touches[0].clientX;
  }, { passive: true });
  document.getElementById('stage').addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) {
      dx < 0 ? goTo(current + 1, 1) : goTo(current - 1, -1);
    }
  }, { passive: true });

  /* ── 키보드 ── */
  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === ' ') goTo(current + 1, 1);
    if (e.key === 'ArrowLeft') goTo(current - 1, -1);
  });

  /* ── 초기 렌더 ── */
  $content.style.transition = 'none';
  render(0, 1);
})();
</script>
</body>
</html>
