<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<body>

<div class="flex flex-col w-full max-w-[480px] mx-auto result-page">
  <%- include('./../../common/common') %>

  <main id="container" class="pb-32">

<%
  const _el = sample?.fiveElements?.elements || sampleInfo?.fiveElements?.elements || { 목:0, 화:0, 토:0, 금:0, 수:0 };
  const _tbl = sample?.tenGodTable || sampleInfo?.tenGodTable || {};
  const _data = _tbl.data || [];
  const _g = String(userInfo?.gender || '').trim().toLowerCase();
  const _isFemale = ['여','여자','여성','female','f','woman'].some(v => _g === v);

  // 일주 천간 → 이미지 파일명 매핑
  const _stemKrMap = {
    '甲':'갑목','乙':'을목','丙':'병화','丁':'정화','戊':'무토',
    '己':'기토','庚':'경금','辛':'신금','壬':'임수','癸':'계수'
  };
  const _dayStemHanja = _data[1] ? (_data[1][1] || '') : '';
  const _stemKr = _stemKrMap[_dayStemHanja] || '갑목';
  // 첫 입력자(userInfo) 성별 기준: 여자→남자 이미지, 남자→여자 이미지
  const _faceGender = _isFemale ? 'man' : 'woman';
  const _manFiles   = ['Rectangle 157.png','Rectangle 159.png','Rectangle 160.png','Rectangle 161.png','Rectangle 162.png'];
  const _womanFiles = ['Rectangle 152.png','Rectangle 153.png','Rectangle 154.png','Rectangle 155.png','Rectangle 156.png'];
  const _faceFiles  = _isFemale ? _manFiles : _womanFiles;
  const _faceFile   = _faceFiles[Math.floor(Math.random() * _faceFiles.length)];
  const _faceImg    = `/assets/images/tight/romantic/result/${_faceGender}/${_faceFile}`;

  // adultPreview 텍스트 (라우터에서 넘어옴, 없으면 기본값)
  const _ap = adultPreview || {};
  const _visible1  = _ap.preview1Visible  || `${userInfo.name}님은 특정 분위기에서만 몸이 뜨겁게 반응하는 패턴이 보입니다.`;
  const _blurred1  = _ap.preview1Blurred  || '특히 특정 자극에 매우 강하게 반응하는 포인트가 숨어있습니다.';
  const _visible2  = _ap.preview2Visible  || '두 사람의 일주 조합에서 속궁합 점수가 나왔습니다.';
  const _blurred2  = _ap.preview2Blurred  || '더 구체적인 분석이 이어집니다.';
%>

    <!-- part1: 이름 오버레이 -->
    <div class="result-img-wrap">
      <img src="/assets/images/tight/29/result/part1.png" alt="" class="result-img" />
      <div class="name-overlay p1-name"><%= userInfo.name %>님은</div>
    </div>

    <!-- 미리보기 텍스트 블록 -->
    <div class="preview-text-block">
      <p class="ptb-visible"><%- _visible1 %></p>
      <div class="ptb-blur-wrap" data-submit>
        <p class="ptb-blurred"><%- _blurred1 %></p>
        <div class="ptb-lock">
          <span class="ptb-lock-icon">🔒</span>
          <span class="ptb-lock-label">잠금 해제하기</span>
        </div>
      </div>
      <div class="ptb-divider"></div>
      <p class="ptb-visible2"><%- _visible2 %></p>
      <div class="ptb-blur-wrap" data-submit>
        <p class="ptb-blurred"><%- _blurred2 %></p>
        <div class="ptb-lock">
          <span class="ptb-lock-icon">🔒</span>
          <span class="ptb-lock-label">잠금 해제하기</span>
        </div>
      </div>
    </div>

    <!-- part2 -->
    <img src="/assets/images/tight/29/result/part2.png" alt="" class="result-img" />

    <!-- part3: 상대 얼굴 이미지 오버레이 (여자→남자, 남자→여자) -->
    <div class="result-img-wrap">
      <img src="/assets/images/tight/29/result/part3.png" alt="" class="result-img" />
      <div class="p3-face-wrap">
        <img src="<%= _faceImg %>" alt="" class="p3-face-img" />
      </div>
    </div>

    <!-- 결제 CTA 트리거 -->
    <div id="result10-button" class="h-4"></div>

    <form method="POST" action="<%= (userInfo.name === '관리자' || userInfo.name === '테스트') ? '/saju/skip-payment' : '/saju/payment' %>" class="w-full hidden">
      <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
      <input type="hidden" name="goodsType" value="ADULT" />
    </form>
  </main>

  <div id="floating-btn" class="floating-banner">
    <span class="floating-banner-text">지금 바로 확인하러 가기</span>
  </div>
</div>

<style>
.result-page {
  background: #0a0008;
  min-height: 100vh;
}
.result-img {
  width: 100%;
  height: auto;
  display: block;
  vertical-align: top;
}
.result-img-wrap {
  position: relative;
  width: 100%;
  line-height: 0;
}
.name-overlay {
  position: absolute;
  font-weight: 700;
  color: #ffffff;
  font-family: 'Noto Serif KR', serif;
  letter-spacing: 0.04em;
  white-space: nowrap;
  text-shadow: 0 1px 6px rgba(0,0,0,0.7);
  pointer-events: none;
}
/* part1: "남은" 자리 */
.p1-name {
  top: 5.2%;
  left: 50%;
  transform: translateX(-50%);
  font-size: clamp(13px, 3.5vw, 16px);
}
/* part2: "더 자세한 [이름] 님의" — 이름만 */
.p2-name {
  top: 3.5%;
  left: 50%;
  transform: translateX(-18%);
  font-size: clamp(13px, 3.8vw, 17px);
}
/* ── 미리보기 텍스트 블록 ── */
.preview-text-block {
  background: #0a0008;
  padding: 24px 20px 28px;
  border-top: 1px solid rgba(180,40,40,0.2);
  border-bottom: 1px solid rgba(180,40,40,0.2);
}
.ptb-visible {
  font-size: 13px;
  line-height: 1.85;
  color: rgba(240,232,224,0.9);
  word-break: keep-all;
  margin: 0 0 16px;
  letter-spacing: 0.01em;
}
/* strong 태그 → 빨간색 */
.ptb-visible strong,
.ptb-visible2 strong {
  color: #e03040;
  font-weight: 700;
}
.ptb-blur-wrap {
  position: relative;
  border: 1px solid rgba(180,40,40,0.3);
  border-radius: 12px;
  padding: 14px 16px;
  background: rgba(20,4,8,0.7);
  margin-bottom: 16px;
  cursor: pointer;
  overflow: hidden;
}
.ptb-blurred {
  font-size: 12px;
  line-height: 1.8;
  color: rgba(220,200,200,0.7);
  filter: blur(4px);
  user-select: none;
  margin: 0;
}
.ptb-lock {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background: rgba(10,0,8,0.35);
}
.ptb-lock-icon { font-size: 16px; }
.ptb-lock-label {
  font-size: 13px;
  font-weight: 700;
  color: #e03040;
  letter-spacing: 0.06em;
}
.ptb-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(180,40,40,0.4), transparent);
  margin: 4px 0 16px;
}
.ptb-visible2 {
  font-size: 13px;
  line-height: 1.85;
  color: rgba(240,232,224,0.9);
  word-break: keep-all;
  margin: 0 0 16px;
  letter-spacing: 0.01em;
}

/* part3: 얼굴 이미지 오버레이 */
.p3-face-wrap {
  position: absolute;
  top: 9%;
  left: 50%;
  transform: translateX(-50%);
  width: 54%;
  aspect-ratio: 3/4;
  overflow: hidden;
  border-radius: 4px;
}
.p3-face-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  filter: blur(6px);
}

/* part2: 하단 빨간 박스 텍스트 */
.p2-textbox {
  position: absolute;
  bottom: 3%;
  left: 5%;
  right: 5%;
  font-size: clamp(11px, 2.8vw, 13px);
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.88);
  font-family: 'Noto Serif KR', serif;
  letter-spacing: 0.02em;
  word-break: keep-all;
  pointer-events: none;
  text-shadow: 0 1px 4px rgba(0,0,0,0.8);
}
#floating-btn {
  position: fixed;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 480px;
  z-index: 9999;
  transition: transform 0.3s ease, opacity 0.3s ease;
  padding: 16px 24px;
  background: linear-gradient(135deg, rgba(230,194,122,0.95) 0%, rgba(180,140,80,0.95) 100%);
  border-top: 1px solid rgba(255,255,255,0.2);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 -4px 24px rgba(0,0,0,0.25);
}
#floating-btn.hide {
  transform: translateX(-50%) translateY(100%);
  opacity: 0;
  pointer-events: none;
}
.floating-banner-text {
  font-size: 16px;
  font-weight: 700;
  color: #1a1812;
  letter-spacing: 0.04em;
  font-family: 'Noto Serif KR', serif;
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var form = document.querySelector("form");
  var floatingBtn = document.getElementById("floating-btn");
  var target = document.getElementById("result10-button");

  if (floatingBtn && target) {
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) floatingBtn.classList.add("hide");
        else floatingBtn.classList.remove("hide");
      });
    }, { threshold: 0.1 });
    observer.observe(target);
  }

  if (floatingBtn) {
    floatingBtn.addEventListener("click", function () {
      if (form) form.submit();
    });
  }

  if (window.karrotPixel) window.karrotPixel.track("Lead");
});
</script>

</body>
</html>
