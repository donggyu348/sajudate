<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<body>

<% 
// 한자 변환 (천간/지지)
const STEM_TO_HANJA = {
  '갑':'甲','을':'乙','병':'丙','정':'丁','무':'戊',
  '기':'己','경':'庚','신':'辛','임':'壬','계':'癸'
};
const BRANCH_TO_HANJA = {
  '자':'子','축':'丑','인':'寅','묘':'卯','진':'辰','사':'巳',
  '오':'午','미':'未','신':'申','유':'酉','술':'戌','해':'亥'
};
function H(v) {
  if (!v || v === '-') return '－';
  return STEM_TO_HANJA[v] || BRANCH_TO_HANJA[v] || v;
}

const tbl = sample?.tenGodTable || sampleInfo?.tenGodTable || {};
const headers = tbl.headerRows || ['시주','일주','월주','년주'];
const data = tbl.data || [];
const el = sample?.fiveElements?.elements || sampleInfo?.fiveElements?.elements || { 목:0, 화:0, 토:0, 금:0, 수:0 };
const getPercent = (val) => (Math.min((Number(val) || 0) / 8 * 100, 100)) + '%';

const g = String(userInfo?.gender || '').trim();
let genderKey = 'man';
if (['여','여자','여성','female','F','woman'].includes(g)) genderKey = 'woman';
if (['남','남자','남성','male','M','man'].includes(g)) genderKey = 'man';

const dayStem = (data[1] && data[1][1]) ? H(data[1][1]) : null;
const STEM_TO_KR_KEY = {
  "甲":"갑목","乙":"을목","丙":"병화","丁":"정화","戊":"무토",
  "己":"기토","庚":"경금","辛":"신금","壬":"임수","癸":"계수"
};
const stemKey = dayStem ? STEM_TO_KR_KEY[dayStem] : null;

const dayMasterImages = stemKey ? [`/assets/images/tight/romantic/result/${genderKey}1/${stemKey}.png`] : [];
const secondImagePath = stemKey ? `/assets/images/tight/romantic/result/${genderKey}/${stemKey}.png` : null;

// 오행 비율로 가장 높은 기운 (미리보기 텍스트용)
const elList = [
  { key: '목', hanja: '木', val: Number(el.목) || 0, body: '눈·어깨·허리 라인', style: '그린·민트·실크·린넨, 자연스러운 노출' },
  { key: '화', hanja: '火', val: Number(el.화) || 0, body: '입술·가슴골·손목', style: '레드·오렌지·시스루·핫핑크' },
  { key: '토', hanja: '土', val: Number(el.토) || 0, body: '허벅지·엉덩이·피부 톤', style: '베이지·네이비·레더·정돈된 실루엣' },
  { key: '금', hanja: '金', val: Number(el.금) || 0, body: '목선·등·락골', style: '골드·실버·메탈·미니멀 컷' },
  { key: '수', hanja: '水', val: Number(el.수) || 0, body: '귀·목덜미·종아리', style: '블랙·네이비·실크·깊은 V넥' }
];
const topEl = elList.slice().sort((a, b) => b.val - a.val)[0];
const dayPillar = (data[1] && data[1][1] && data[1][2]) ? (H(data[1][1]) + H(data[1][2])) : '일주';
// 사주 기반 성욕 점수(55~98) & 상위 % (8~42)
const libidoScore = Math.min(98, Math.max(55, 55 + (Number(el.화) || 0) * 4 + (Number(el.목) || 0) * 2 + (Number(el.금) || 0)));
const libidoTopPercent = Math.min(42, Math.max(8, 8 + (Number(el.화) || 0) * 2 + (Number(el.목) || 0) + (Number(el.금) || 0)));
%>

<div class="flex flex-col w-full max-w-[480px] mx-auto result-page">
  <%- include('./../../common/common') %>

  <main id="container" class="pb-32">
    <!-- ─── 맨 처음 인트로 이미지 ─── -->
    <section class="result-intro">
      <img src="/assets/images/tight/adult/intro.png" alt="" class="result-intro-img" />
    </section>

    <!-- ─── 랜딩: 천간지지 ─── -->
    <section class="landing-cheongan px-4 pt-8 pb-10">
      <p class="text-center text-amber-400/90 text-sm tracking-[0.2em] uppercase mb-1">Your Saju</p>
      <h1 class="text-center text-white text-2xl font-semibold mb-2" style="font-family: 'Noto Serif KR', serif;"><%= userInfo.name %></h1>
      <p class="text-center text-white/60 text-sm mb-8">사주팔자로 읽는 당신의 기운</p>

      <div class="cheongan-grid">
        <% for (let i = 0; i < 4; i++) { %>
          <div class="cheongan-card">
            <span class="cheongan-label"><%= headers[i] || '-' %></span>
            <div class="cheongan-hanja">
              <span><%= data[i] && data[i][1] ? H(data[i][1]) : '－' %></span>
              <span><%= data[i] && data[i][2] ? H(data[i][2]) : '－' %></span>
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <!-- ─── 랜딩: 오행 ─── -->
    <section class="landing-ohang px-4 py-8">
      <h2 class="ohang-title">오행</h2>
      <p class="ohang-desc">당신 사주에 담긴 다섯 기운</p>
      <div class="ohang-list">
        <div class="ohang-item">
          <span class="ohang-hanja color-wood">木</span>
          <span class="ohang-num"><%= el.목 != null ? el.목 : 0 %></span>
          <div class="ohang-bar-wrap"><div class="ohang-bar bg-wood" style="height: <%= getPercent(el.목) %>"></div></div>
        </div>
        <div class="ohang-item">
          <span class="ohang-hanja color-fire">火</span>
          <span class="ohang-num"><%= el.화 != null ? el.화 : 0 %></span>
          <div class="ohang-bar-wrap"><div class="ohang-bar bg-fire" style="height: <%= getPercent(el.화) %>"></div></div>
        </div>
        <div class="ohang-item">
          <span class="ohang-hanja color-earth">土</span>
          <span class="ohang-num"><%= el.토 != null ? el.토 : 0 %></span>
          <div class="ohang-bar-wrap"><div class="ohang-bar bg-earth" style="height: <%= getPercent(el.토) %>"></div></div>
        </div>
        <div class="ohang-item">
          <span class="ohang-hanja color-metal">金</span>
          <span class="ohang-num"><%= el.금 != null ? el.금 : 0 %></span>
          <div class="ohang-bar-wrap"><div class="ohang-bar bg-metal" style="height: <%= getPercent(el.금) %>"></div></div>
        </div>
        <div class="ohang-item">
          <span class="ohang-hanja color-water">水</span>
          <span class="ohang-num"><%= el.수 != null ? el.수 : 0 %></span>
          <div class="ohang-bar-wrap"><div class="ohang-bar bg-water" style="height: <%= getPercent(el.수) %>"></div></div>
        </div>
      </div>
    </section>

    <!-- ─── 사주로 보는 성욕 점수 & 상위 % (천간지지·오행 밑) ─── -->
    <section class="libido-rank px-4 pt-6 pb-8">
      <h2 class="libido-rank-heading">사주로 보는 당신의 성욕</h2>
      <div class="libido-rank-card">
        <div class="libido-rank-row">
          <div class="libido-rank-item">
            <p class="libido-rank-label">성욕 점수</p>
            <p class="libido-rank-score"><strong><%= libidoScore %></strong>점</p>
          </div>
          <div class="libido-rank-divider"></div>
          <div class="libido-rank-item">
            <p class="libido-rank-label">상위</p>
            <p class="libido-rank-value"><strong><%= libidoTopPercent %></strong>%</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─── 천간지지·오행 전체 미리보기 (블러 없음, 29금 톤) ─── -->
    <section class="overview-preview px-4 py-6">
      <h2 class="overview-preview-title">천간지지·오행으로 보는 전체 미리보기</h2>
      <div class="overview-preview-card">
        <p class="overview-preview-text">
          당신의 사주는 <strong>시주 <%= data[0] && data[0][1] ? H(data[0][1]) + H(data[0][2]) : '－' %></strong>, 
          <strong>일주 <%= data[1] && data[1][1] ? H(data[1][1]) + H(data[1][2]) : '－' %></strong>, 
          <strong>월주 <%= data[2] && data[2][1] ? H(data[2][1]) + H(data[2][2]) : '－' %></strong>, 
          <strong>년주 <%= data[3] && data[3][1] ? H(data[3][1]) + H(data[3][2]) : '－' %></strong>로 이루어져 있습니다.<br>
          오행 비율은 목 <%= el.목 != null ? el.목 : 0 %>, 화 <%= el.화 != null ? el.화 : 0 %>, 토 <%= el.토 != null ? el.토 : 0 %>, 금 <%= el.금 != null ? el.금 : 0 %>, 수 <%= el.수 != null ? el.수 : 0 %>로,
          <strong><%= topEl.key %>(<%= topEl.hanja %>)</strong> 기운이 가장 높은 편입니다.
        </p>
        <p class="overview-preview-text">
          이 조합은 당신만의 <strong>감성과 몸이 반응하는 방식</strong>, 이성이 무의식적으로 끌리는 포인트와 연결됩니다. 천간지지와 오행은 단순한 성격 해석을 넘어, <strong>상대가 당신의 어떤 부분에 흥분하는지</strong>, 밤에 어떤 스타일로 다가오면 통하는지까지 읽어냅니다. 수백 년간 쌓인 명리 이론과 데이터 패턴을 바탕으로, 당신의 사주가 품은 <strong>매력·욕망·쾌락</strong>의 지도를 미리보기로 엿볼 수 있습니다.
        </p>
      </div>
    </section>

    <!-- ─── 본격 미리보기 타이틀 ─── -->
    <section class="preview-intro px-4 pt-6 pb-4">
      <h2 class="preview-intro-title">본격 미리보기</h2>
      <p class="preview-intro-desc">아래에서 더 많은 해석을 엿볼 수 있어요</p>
    </section>

    <!-- ─── 미리보기 1: 이성이 볼 때 나의 성적인 신체 부위 (마네킹 + 부위 표시) ─── -->
    <section class="preview-block px-4 pb-6">
      <h3 class="preview-block-title">이성이 볼 때 나의 성적인 신체 부위</h3>
      <div class="preview-card preview-card--mannequin">
        <div class="preview-card-inner preview-card-inner--mannequin-img">
          <img src="/assets/images/tight/adult/mannequin.png" alt="마네킹" class="mannequin-img" />
          <div class="mannequin-markers" aria-hidden="true">
            <span class="mannequin-marker mannequin-marker--1"></span>
            <span class="mannequin-marker mannequin-marker--2"></span>
            <span class="mannequin-marker mannequin-marker--3"></span>
            <span class="mannequin-marker mannequin-marker--4"></span>
            <span class="mannequin-marker mannequin-marker--5"></span>
          </div>
        </div>
        <div class="preview-caption">
          <div class="preview-caption-lock-wrap" data-submit>
            <span class="preview-caption-lock-icon" aria-hidden="true"></span>
            <span class="preview-caption-lock-label">잠금</span>
            <span class="preview-caption-unlock">해제하기</span>
          </div>
          <p class="preview-caption-text">
            <span class="preview-caption-visible">
              당신의 오행은 木·火·土·金·水 중 <strong><%= topEl.key %>(<%= topEl.hanja %>)</strong> 기운이 가장 높습니다(비율 <%= topEl.val %>). 
              이 기운이 강한 분은 이성에게 <strong><%= topEl.body %></strong> 같은 부위가 특히 잘 통하는 편입니다. 
              이 장점을 살리려면 <strong><%= topEl.style %></strong>이 이성의 성적인 요소를 자극하는 데 도움이 됩니다.
            </span>
            <span class="preview-caption-blurred">
              천간지지와 오행에 맞춘 신체 부위별 상세 해석에서는 어떤 컬러와 소재가 당신의 매력을 극대화하는지, 상대가 무의식적으로 시선을 두는 포인트와 옷 스타일링·액세서리 추천, 그리고 그 부위를 강조할 때 이성이 반응하는 방식까지 구체적으로 이어집니다. 당신의 시주·일주·월주·년주가 만드는 조합별로 어울리는 노출 포인트와 피해야 할 스타일, 첫인상에서부터 밤까지 이어지는 매력 곡선, 상대의 오행과 맞닿을 때 시너지가 나는 포인트와 상극일 때 주의할 점, 실제로 입어볼 만한 아이템과 컬러 팔레트, 향과 악세서리까지 한 편의 해석이 이어져요.
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 미리보기 2: 일주로 보는 나의 침대에 모습 (텍스트만) ─── -->
    <section class="preview-block px-4 pb-6">
      <h3 class="preview-block-title">일주로 보는 나의 침대에 모습</h3>
      <div class="preview-card preview-card--text-only">
        <div class="preview-caption preview-caption--standalone">
          <div class="preview-caption-lock-wrap" data-submit>
            <span class="preview-caption-lock-icon" aria-hidden="true"></span>
            <span class="preview-caption-lock-label">잠금</span>
            <span class="preview-caption-unlock">해제하기</span>
          </div>
          <p class="preview-caption-text">
            <span class="preview-caption-visible">
              당신의 <strong>일주 <%= dayPillar %></strong>는 밤과 쾌락의 성향을 읽는 핵심입니다. 이 기운은 침대 위에서 당신이 어떤 방식으로 반응하는지, 주도할 때와 맡길 때 중 어느 쪽이 더 자연스러운지, 그리고 상대를 녹이는 말과 손길의 스타일까지 드러냅니다.
            </span>
            <span class="preview-caption-blurred">
              일주가 말해주는 당신만의 밤의 모습—숨겨진 욕망과 몸이 반응하는 포인트, 상대와 에너지가 맞는 순간과 피해야 할 트리거까지. 일주·시주 조합에 따른 침대 위 성향과 상대와의 케미, 실제로 적용할 수 있는 밤의 시나리오와 대화법, 당신이 편하게 몸을 맡기는 순간과 주도할 때의 포인트, 상대의 반응을 읽는 법과 쾌감이 더해지는 타이밍, 말로 풀어낼 때와 침묵이 통할 때, 다음날까지 기억에 남는 한 줄과 피해야 할 한 마디, 오행과 일주의 조합으로 보는 상대별 궁합과 밤의 스타일까지 상세한 해석이 이어져요.
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 미리보기 3: 당신의 판타지 (텍스트만) ─── -->
    <section class="preview-block px-4 pb-6">
      <h3 class="preview-block-title">당신의 판타지</h3>
      <div class="preview-card preview-card--text-only">
        <div class="preview-caption preview-caption--standalone">
          <div class="preview-caption-lock-wrap" data-submit>
            <span class="preview-caption-lock-icon" aria-hidden="true"></span>
            <span class="preview-caption-lock-label">잠금</span>
            <span class="preview-caption-unlock">해제하기</span>
          </div>
          <p class="preview-caption-text">
            <span class="preview-caption-visible">
              일간과 오행, 십성으로 읽는 당신만의 판타지. 머릿속에만 그리던 장면이 사주에서는 어떤 기운으로 잡히는지, 그걸 현실에 가깝게 만드는 조건은 무엇인지
            </span>
            <span class="preview-caption-blurred">
              구체적인 시나리오와 상대의 유형, 말과 분위기, 그리고 당신의 오행을 채우는 순간이 어떻게 쾌감으로 터지는지까지 상세 해석이 이어져요. 숨겨둔 욕망의 형태와 그것을 깨우는 트리거, 상대가 해주면 좋은 말과 행동, 피해야 할 실수, 단계별로 풀어가는 법과 한 번에 터뜨리는 법, 당신의 사주가 원하는 밤의 마무리까지.
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 미리보기 4: 나의 오행을 채워주며 쾌감을 폭발시킬 상대 (텍스트만) ─── -->
    <section class="preview-block px-4 pb-6">
      <h3 class="preview-block-title">나의 오행을 채워주며 쾌감을 폭발시킬 상대</h3>
      <div class="preview-card preview-card--text-only">
        <div class="preview-caption preview-caption--standalone">
          <div class="preview-caption-lock-wrap" data-submit>
            <span class="preview-caption-lock-icon" aria-hidden="true"></span>
            <span class="preview-caption-lock-label">잠금</span>
            <span class="preview-caption-unlock">해제하기</span>
          </div>
          <p class="preview-caption-text">
            <span class="preview-caption-visible">
              당신의 오행 <strong><%= topEl.key %>(<%= topEl.hanja %>)</strong>를 채워주고, 부족한 기운을 보완해 쾌감이 폭발하는 상대의 사주·성향. 그런 사람은 어떤 천간지지와 오행 조합일까요.
            </span>
            <span class="preview-caption-blurred">
              당신과 궁합이 맞아 에너지가 오갈 때 쾌감이 배가 되는 상대의 일주·시주 유형, 그 사람의 말과 스타일, 접근 방식, 그리고 실제로 만났을 때 당신의 몸이 반응하는 포인트와 피해야 할 상극 유형까지. 나의 오행을 채워주며 쾌감을 폭발시킬 상대를 만나는 조건과 그런 사람이 나타날 때의 신호, 관계 안에서 욕망이 터지는 순간과 유지하는 법까지 이어져요.
            </span>
          </p>
        </div>
      </div>
    </section>

    <!-- ─── 29 result 이미지 1~4 순서 ─── -->
    <section class="result-images px-4 pb-6">
      <img src="/assets/images/tight/29/result/1.png" alt="" class="result-seq-img" />
      <img src="/assets/images/tight/29/result/2.png" alt="" class="result-seq-img" />
      <img src="/assets/images/tight/29/result/3.png" alt="" class="result-seq-img" />
      <img src="/assets/images/tight/29/result/4.png" alt="" class="result-seq-img" />
    </section>

    <!-- 결제 CTA (플로팅 버튼 숨김 타깃) -->
    <div id="result10-button" class="h-4"></div>

    <form method="POST" action="<%= (userInfo.name === '관리자' || userInfo.name === '테스트') ? '/saju/skip-payment' : '/saju/payment' %>" class="w-full hidden">
      <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
      <input type="hidden" name="sample" value='<%= JSON.stringify(sample) %>' />
