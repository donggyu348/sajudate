<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<head>
  <style>
    :root {
      --gold: #d4af37;
      --white-soft: rgba(255,255,255,0.6);
      --white-dim: rgba(255,255,255,0.35);
    }

    body {
      margin: 0;
      background: #000;
      color: #fff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont;
      overflow: auto;
    }

    .stage {
      max-width: 480px;
      height: 100vh;
      margin: 0 auto;
      position: relative;
      background: linear-gradient(
        180deg,
        #060101 0%,
        #090202 25%,
        #070101 50%,
        #050000 75%,
        #030000 100%
      );
    }

    .stage::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.8) 100%);
    }

    .question-layer {
      position: absolute;
      top: 38%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      padding: 0 24px;
      text-align: center;
      z-index: 5;
    }

    .question-sub {
      font-size: 11px;
      letter-spacing: 0.22em;
      opacity: 0.55;
      margin-bottom: 10px;
    }

    .question-title {
      font-size: 24px;
      font-weight: 600;
      line-height: 1.5;
      letter-spacing: -0.01em;
    }

    .step { display: none; }
    .step.active { display: block; }

    .input-area {
      position: absolute;
      top: 56%;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 420px;
      z-index: 5;
      animation: fadeUp 0.5s ease;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translate(-50%, 14px); }
      to { opacity: 1; transform: translate(-50%, 0); }
    }

    .input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--white-dim);
      padding: 10px 6px;
      font-size: 20px;
      color: #fff;
      outline: none;
      text-align: center;
      letter-spacing: 0.02em;
      transition: border-color 0.3s ease;
    }

    .input::placeholder { color: rgba(255,255,255,0.35); }
    .input:focus { border-bottom-color: var(--gold); }

    select.input {
      appearance: none;
      text-align-last: center;
      cursor: pointer;
    }

    select option { background-color: #111; color: #fff; }

    .choice-btn {
      width: 100%;
      background: transparent;
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 12px;
      color: var(--white-soft);
      font-size: 16px;
      text-align: center;
      transition: all 0.25s ease;
    }

    .choice-btn.active {
      border-color: var(--gold);
      color: var(--gold);
      box-shadow: 0 0 14px rgba(212,175,55,0.25);
      font-weight: 700;
    }

    .next-btn {
      position: absolute;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 420px;
      height: 52px;
      border-radius: 26px;
      border: 1px solid var(--gold);
      background: transparent;
      color: var(--gold);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.12em;
      z-index: 5;
      transition: all 0.3s ease;
    }

    .next-btn:hover { background: var(--gold); color: #000; }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0px 1000px rgba(10,10,10,0.6) inset;
      -webkit-text-fill-color: #fff;
    }

    .stage { height: 100svh; }
    .next-btn {
      position: fixed;
      bottom: calc(20px + env(safe-area-inset-bottom));
      left: 50%;
      transform: translateX(-50%);
    }
    @supports (height: 100dvh) { .stage { height: 100dvh; } }
  </style>
</head>

<body>
<div class="stage">
  <div class="question-layer">
    <p class="question-sub">29금 사주</p>
    <h1 id="questionTitle" class="question-title">당신의 이름은?</h1>
  </div>

  <div id="loading" class="hidden fixed inset-0 z-50 flex flex-col items-center justify-center">
    <div class="w-10 h-10 border-4 border-white border-t-transparent rounded-full animate-spin"></div>
    <p id="loading-title" class="mt-4 text-sm">사주를 분석중입니다</p>
  </div>

  <form id="sajuForm" method="POST" action="/saju/adult/result">
    <input type="hidden" name="gender" id="genderInput">
    <input type="hidden" name="birthType" id="birthTypeInput">

    <section class="step active">
      <div class="input-area">
        <input name="name" type="text" class="input" placeholder="이름을 입력하세요">
      </div>
    </section>

    <section class="step">
      <div class="input-area">
        <button type="button" class="choice-btn" data-gender="남성">남성</button>
        <button type="button" class="choice-btn" data-gender="여성">여성</button>
      </div>
    </section>

    <section class="step">
      <div class="input-area">
        <select id="birthTypeInputSelect" class="input" style="margin-bottom:14px">
          <option value="양력">양력</option>
          <option value="음력">음력</option>
        </select>
        <input name="birthdate" class="input" placeholder="YYYYMMDD">
      </div>
    </section>

    <section class="step">
      <div class="input-area">
        <select name="birthTime" class="input">
          <option selected value="unknown">모름</option>
          <option value="00">조자/朝子 (00:00~01:29)</option>
          <option value="02">축/丑 (01:30~03:29)</option>
          <option value="04">인/寅 (03:30~05:29)</option>
          <option value="06">묘/卯 (05:30~07:29)</option>
          <option value="08">진/辰 (07:30~09:29)</option>
          <option value="10">사/巳 (09:30~11:29)</option>
          <option value="12">오/午 (11:30~13:29)</option>
          <option value="14">미/未 (13:30~15:29)</option>
          <option value="16">신/申 (15:30~17:29)</option>
          <option value="18">유/酉 (17:30~19:29)</option>
          <option value="20">술/戌 (19:30~21:29)</option>
          <option value="22">해/亥 (21:30~23:29)</option>
          <option value="24">야자/夜子 (23:30~23:59)</option>
        </select>
      </div>
    </section>

    <button type="button" id="nextBtn" class="next-btn">다음으로</button>
  </form>
</div>

<script>
  let step = 0;
  const steps = document.querySelectorAll(".step");
  const questionTitle = document.getElementById("questionTitle");
  const urlParams = new URLSearchParams(window.location.search);
  const ticketCode = urlParams.get('ticket');
  const questions = [
    "이름을 알려주세요",
    "성별을 선택해주세요",
    "생년월일을 입력해주세요",
    "몇시에 태어나셨나요?"
  ];

  function showStep() {
    steps.forEach((s, i) => s.classList.toggle("active", i === step));
    questionTitle.innerText = questions[step];
  }

  function validateStep() {
    if (step === 0) {
      const nameInput = document.querySelector("input[name='name']");
      if (!nameInput.value.trim()) {
        shake(nameInput);
        nameInput.focus();
        return false;
      }
    }
    if (step === 1) {
      if (!$("#genderInput").val()) {
        shake(document.querySelector(".input-area"));
        return false;
      }
    }
    if (step === 2) {
      const birthdate = $("input[name='birthdate']").val()?.trim();
      if (!/^\d{8}$/.test(birthdate)) {
        const input = document.querySelector("input[name='birthdate']");
        shake(input);
        input.focus();
        return false;
      }
    }
    return true;
  }

  function shake(target) {
    target.animate(
      [
        { transform: "translateX(0)" },
        { transform: "translateX(-6px)" },
        { transform: "translateX(6px)" },
        { transform: "translateX(0)" }
      ],
      { duration: 300 }
    );
  }

  document.getElementById("nextBtn").onclick = () => {
    if (!validateStep()) return;
    if (step < steps.length - 1) {
      step++;
      showStep();
    } else {
      submitForm();
    }
  };

  $(".choice-btn").on("click", function () {
    $(".choice-btn").removeClass("active");
    $(this).addClass("active");
    $("#genderInput").val($(this).data("gender"));
  });

  $("#birthTypeInputSelect").on("change", function () {
    $("#birthTypeInput").val(this.value);
  }).trigger("change");

  function submitForm() {
    const data = {
      name: $("input[name='name']").val()?.trim(),
      gender: $("#genderInput").val(),
      birthdate: $("input[name='birthdate']").val()?.trim(),
      birthTime: $("select[name='birthTime']").val(),
      birthType: $("#birthTypeInput").val(),
      ticket: ticketCode
    };

    if (!data.name || !data.gender || !/^\d{8}$/.test(data.birthdate)) return;

    var action = "/saju/adult/result";
    var appendTicket = ticketCode ? "?ticket=" + encodeURIComponent(ticketCode) : "";

    if (data.name === "테스트" || data.name === "관리자") {
      var $form = $("#sajuForm");
      $form.find('input[name="userInfo"]').remove();
      $form.find('input[name="sample"]').remove();
      $form.find('input[name="goodsType"]').remove();
      $form.attr("action", "/saju/skip-payment");
      $('<input>').attr({ type: 'hidden', name: 'userInfo', value: JSON.stringify(data) }).appendTo($form);
      $('<input>').attr({ type: 'hidden', name: 'sample', value: '{}' }).appendTo($form);
      $('<input>').attr({ type: 'hidden', name: 'goodsType', value: 'ADULT' }).appendTo($form);
      $form[0].submit();
      return;
    }

    if (ticketCode) {
      $("#sajuForm").attr("action", "/saju/adult/result?ticket=" + encodeURIComponent(ticketCode));
    }
    document.getElementById("sajuForm").submit();
  }

  document.addEventListener("keydown", function (e) {
    if (e.key === "Enter") {
      if (document.activeElement.tagName === "SELECT") return;
      e.preventDefault();
      document.getElementById("nextBtn").click();
    }
  });
</script>
</body>
</html>
