<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  <style>
    :root {
      --accent: #ff5722;
      --text-dim: rgba(255, 255, 255, 0.45);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #000;
      color: #fff;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .stage {
      position: relative;
      max-width: 480px;
      min-height: 100dvh;
      margin: 0 auto;
      padding: 20px 24px calc(96px + env(safe-area-inset-bottom, 0px));
      background: #000 url('/assets/images/tight/29/input/bg.png') no-repeat center top / cover;
      overflow-x: hidden;
    }

    .stage::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.72) 0%,
        rgba(0, 0, 0, 0.55) 35%,
        rgba(0, 0, 0, 0.45) 55%,
        rgba(0, 0, 0, 0.82) 100%
      );
      pointer-events: none;
    }

    .stage-inner {
      position: relative;
      z-index: 1;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 44px;
      padding: 0;
      border: none;
      background: transparent;
      color: rgba(255, 255, 255, 0.88);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      letter-spacing: -0.02em;
      cursor: pointer;
      font-family: inherit;
    }

    .back-btn svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .form-header h1 {
      margin: 0 0 36px;
      font-size: clamp(28px, 7.5vw, 34px);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.04em;
    }

    .form-header p {
      margin: 0 0 36px;
      font-size: 15px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.72);
      letter-spacing: -0.02em;
    }

    .form-header strong {
      color: var(--accent);
      font-weight: 800;
    }

    .name-input {
      width: 100%;
      margin-bottom: 8px;
      padding: 14px 0;
      border: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      background: transparent;
      color: #fff;
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
      outline: none;
    }

    .name-input::placeholder {
      color: var(--text-dim);
      font-weight: 500;
    }

    .name-input:focus {
      border-bottom-color: rgba(255, 255, 255, 0.35);
    }

    .form-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 22px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .form-row__label {
      flex: 1;
      min-width: 0;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #fff;
    }

    .form-row__input {
      flex: 1;
      min-width: 0;
      padding: 0;
      border: none;
      background: transparent;
      color: #fff;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.03em;
      outline: none;
    }

    .form-row__input::placeholder {
      color: rgba(255, 255, 255, 0.35);
    }

    .pill-group {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }

    .pill-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 58px;
      height: 34px;
      padding: 0 14px;
      border: none;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.42);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: -0.02em;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .pill-btn.active {
      background: #fff;
      color: #111;
      border: none;
    }

    .time-picker {
      position: relative;
      flex-shrink: 0;
    }

    .time-picker select {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
      color: #111;
      color-scheme: light;
    }

    .time-picker select option {
      color: #111;
      background-color: #fff;
    }

    .gender-row {
      display: flex;
      gap: 12px;
      margin-top: 36px;
    }

    .gender-btn {
      flex: 1;
      height: 54px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 999px;
      background: transparent;
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .gender-btn.active {
      background: #fff;
      border: 1px solid #fff;
      color: #111;
    }

    .step-indicator {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 28px;
    }

    .step-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .step-dot.active {
      background: #fff;
      border: none;
      transform: scale(1.15);
    }

    .step-label {
      font-size: 13px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.55);
      letter-spacing: -0.02em;
    }

  /* main.css 전역 .active(흰 배경)와 충돌 방지 — romantic/input에는 form-step 없음 */
    .form-step {
      display: none;
      background: transparent;
      border: none;
      color: inherit;
    }

    .form-step.active {
      display: block;
      background: transparent;
      border: none;
      color: inherit;
    }

    .stage .pill-btn,
    .stage .gender-btn,
    .stage .submit-btn,
    .stage .back-btn {
      -webkit-appearance: none;
      appearance: none;
    }

    .submit-btn {
      position: fixed;
      left: 50%;
      bottom: calc(20px + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      z-index: 10;
      width: calc(100% - 48px);
      max-width: 432px;
      height: 54px;
      border: none;
      border-radius: 999px;
      background: #fff;
      color: #111;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
      cursor: pointer;
    }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0 1000px #000 inset;
      -webkit-text-fill-color: #fff;
      transition: background-color 5000s ease-in-out 0s;
    }

  /* ── 사주 원국 로딩 오버레이 (MZ ver.) ── */
  #saju-loading {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #0e0014;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
    overflow: hidden;
  }
  #saju-loading.show { display: flex; }

  /* 배경 블러 원 */
  .ld-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    animation: blobPulse 3s ease-in-out infinite alternate;
  }
  .ld-blob-1 { width: 260px; height: 260px; background: rgba(168,85,247,0.25); top: -60px; left: -60px; animation-delay: 0s; }
  .ld-blob-2 { width: 200px; height: 200px; background: rgba(236,72,153,0.2);  bottom: -40px; right: -40px; animation-delay: 1s; }
  .ld-blob-3 { width: 150px; height: 150px; background: rgba(59,130,246,0.15); top: 40%; left: 50%; transform: translate(-50%,-50%); animation-delay: 0.5s; }
  @keyframes blobPulse { from { opacity: 0.7; transform: scale(1); } to { opacity: 1; transform: scale(1.12); } }

  .loading-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 340px;
    padding: 0 24px;
    text-align: center;
  }

  /* 상단 태그 */
  .ld-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(168,85,247,0.15);
    border: 1px solid rgba(168,85,247,0.35);
    border-radius: 99px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 700;
    color: #c084fc;
    letter-spacing: 0.05em;
    margin-bottom: 18px;
  }
  .ld-tag-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #c084fc;
    animation: dotBlink 1s ease-in-out infinite;
  }
  @keyframes dotBlink { 0%,100%{opacity:1} 50%{opacity:0.2} }

  /* 이름 */
  .ld-name {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.2;
    margin-bottom: 6px;
    background: linear-gradient(135deg, #f0abfc, #a78bfa, #60a5fa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .ld-sub {
    font-size: 13px;
    font-weight: 500;
    color: rgba(255,255,255,0.38);
    margin-bottom: 28px;
    letter-spacing: -0.01em;
  }

  /* 4기둥 카드 */
  .pillar-row {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }
  .pillar-card {
    flex: 1;
    max-width: 72px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 18px;
    padding: 14px 6px;
    text-align: center;
    opacity: 0;
    transform: translateY(16px) scale(0.92);
    transition: opacity 0.45s cubic-bezier(.34,1.56,.64,1), transform 0.45s cubic-bezier(.34,1.56,.64,1);
  }
  .pillar-card.visible { opacity: 1; transform: translateY(0) scale(1); }
  .pillar-card.is-me {
    background: linear-gradient(145deg, rgba(168,85,247,0.18), rgba(236,72,153,0.12));
    border-color: rgba(192,132,252,0.5);
    box-shadow: 0 0 24px rgba(168,85,247,0.2), inset 0 1px 0 rgba(255,255,255,0.06);
  }

  .pillar-label {
    font-size: 9px;
    font-weight: 700;
    color: rgba(255,255,255,0.3);
    letter-spacing: 0.1em;
    margin-bottom: 10px;
    display: block;
    text-transform: uppercase;
  }
  .pillar-card.is-me .pillar-label { color: rgba(192,132,252,0.7); }

  .pillar-hanja {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.55;
    color: rgba(255,255,255,0.75);
    font-family: 'Noto Serif KR', serif;
  }
  .pillar-card.is-me .pillar-hanja {
    background: linear-gradient(135deg, #f0abfc, #a78bfa);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* 메시지 */
  .loading-msg-wrap {
    position: relative;
    min-height: 40px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .loading-msg {
    font-size: 13px;
    font-weight: 600;
    color: rgba(255,255,255,0.45);
    letter-spacing: -0.02em;
    width: 100%;
    margin: 0;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease, visibility 0s linear;
  }
  .loading-msg.fade {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
  }

  /* 이름 라벨 */
  .ld-person-label {
    font-size: 12px;
    font-weight: 700;
    color: rgba(192,132,252,0.8);
    letter-spacing: 0.05em;
    margin-bottom: 8px;
    text-align: left;
  }
  .ld-person-label.partner { color: rgba(251,146,186,0.8); }

  /* vs 구분 */
  .ld-vs {
    font-size: 12px;
    font-weight: 800;
    color: rgba(255,255,255,0.25);
    letter-spacing: 0.1em;
    margin: 2px 0 10px;
    text-align: center;
  }

  /* 상대방 일주 강조 */
  .pillar-card.is-partner {
    background: linear-gradient(145deg, rgba(236,72,153,0.18), rgba(251,146,186,0.1));
    border-color: rgba(251,146,186,0.5);
    box-shadow: 0 0 24px rgba(236,72,153,0.2), inset 0 1px 0 rgba(255,255,255,0.06);
  }
  .pillar-card.is-partner .pillar-label { color: rgba(251,146,186,0.7); }
  .pillar-card.is-partner .pillar-hanja {
    background: linear-gradient(135deg, #fda4af, #f472b6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* 진행 바 */
  .loading-bar-wrap {
    width: 100%;
    height: 3px;
    background: rgba(255,255,255,0.07);
    border-radius: 99px;
    overflow: hidden;
  }
  .loading-bar-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #a78bfa, #f0abfc, #60a5fa);
    border-radius: 99px;
    transition: width linear;
  }
  </style>
</head>

<body>

<div class="stage">
  <div class="stage-inner">

    <button type="button" id="navBackBtn" class="back-btn" aria-label="뒤로가기">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
      뒤로가기
    </button>

    <div class="step-indicator" aria-hidden="true">
      <div style="display:flex;gap:8px;">
        <span class="step-dot active" id="stepDot0"></span>
        <span class="step-dot" id="stepDot1"></span>
      </div>
      <p class="step-label" id="stepLabel">1 / 2 · 내 정보</p>
    </div>

    <div class="form-header">
      <h1 id="formTitle">내 이름을 입력해주세요</h1>
      <p id="formDesc">속궁합 분석을 위해 먼저 본인 정보를 입력해 주세요.</p>
    </div>

    <form id="sajuForm" method="POST" action="/saju/adult/result">
      <div class="form-step active" id="step0">
        <input type="hidden" name="gender" id="genderInput">
        <input type="hidden" name="birthType" id="birthTypeInput" value="양력">

        <input name="name" type="text" class="name-input" placeholder="자신 이름" autocomplete="name">

        <div class="form-row">
          <span class="form-row__label" id="timeDisplay">시간모름</span>
          <div class="time-picker">
            <span class="pill-btn active" id="timePill">시간모름</span>
            <select name="birthTime" id="birthTimeSelect" aria-label="태어난 시">
              <option selected value="unknown">시간모름</option>
              <option value="00">조자/朝子 (00:00~01:29)</option>
              <option value="02">축/丑 (01:30~03:29)</option>
              <option value="04">인/寅 (03:30~05:29)</option>
              <option value="06">묘/卯 (05:30~07:29)</option>
              <option value="08">진/辰 (07:30~09:29)</option>
              <option value="10">사/巳 (09:30~11:29)</option>
              <option value="12">오/午 (11:30~13:29)</option>
              <option value="14">미/未 (13:30~15:29)</option>
              <option value="16">신/申 (15:30~17:29)</option>
              <option value="18">유/酉 (17:30~19:29)</option>
              <option value="20">술/戌 (19:30~21:29)</option>
              <option value="22">해/亥 (21:30~23:29)</option>
              <option value="24">야자/夜子 (23:30~23:59)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <input name="birthdate" id="birthdateInput" class="form-row__input" placeholder="2001.01.01" inputmode="numeric" maxlength="8" autocomplete="bday">
          <div class="pill-group" role="group" aria-label="양력/음력">
            <button type="button" class="pill-btn active" data-birth-type="양력" data-target="me">양력</button>
            <button type="button" class="pill-btn" data-birth-type="음력" data-target="me">음력</button>
          </div>
        </div>

        <div class="gender-row" id="genderRowMe" role="group" aria-label="성별">
          <button type="button" class="gender-btn active" data-gender="남성" data-target="me">남자</button>
          <button type="button" class="gender-btn" data-gender="여성" data-target="me">여자</button>
        </div>
      </div>

      <div class="form-step" id="step1">
        <input type="hidden" name="partnerGender" id="partnerGenderInput">
        <input type="hidden" name="partnerBirthType" id="partnerBirthTypeInput" value="양력">

        <input name="partnerName" type="text" class="name-input" placeholder="상대 이름" autocomplete="off">

        <div class="form-row">
          <span class="form-row__label" id="partnerTimeDisplay">시간모름</span>
          <div class="time-picker">
            <span class="pill-btn active" id="partnerTimePill">시간모름</span>
            <select name="partnerBirthTime" id="partnerBirthTimeSelect" aria-label="상대방 태어난 시">
              <option selected value="unknown">시간모름</option>
              <option value="00">조자/朝子 (00:00~01:29)</option>
              <option value="02">축/丑 (01:30~03:29)</option>
              <option value="04">인/寅 (03:30~05:29)</option>
              <option value="06">묘/卯 (05:30~07:29)</option>
              <option value="08">진/辰 (07:30~09:29)</option>
              <option value="10">사/巳 (09:30~11:29)</option>
              <option value="12">오/午 (11:30~13:29)</option>
              <option value="14">미/未 (13:30~15:29)</option>
              <option value="16">신/申 (15:30~17:29)</option>
              <option value="18">유/酉 (17:30~19:29)</option>
              <option value="20">술/戌 (19:30~21:29)</option>
              <option value="22">해/亥 (21:30~23:29)</option>
              <option value="24">야자/夜子 (23:30~23:59)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <input name="partnerBirthdate" id="partnerBirthdateInput" class="form-row__input" placeholder="2001.01.01" inputmode="numeric" maxlength="8">
          <div class="pill-group" role="group" aria-label="상대방 양력/음력">
            <button type="button" class="pill-btn active" data-birth-type="양력" data-target="partner">양력</button>
            <button type="button" class="pill-btn" data-birth-type="음력" data-target="partner">음력</button>
          </div>
        </div>

        <div class="gender-row" id="genderRowPartner" role="group" aria-label="상대방 성별">
          <button type="button" class="gender-btn active" data-gender="여성" data-target="partner">여자</button>
          <button type="button" class="gender-btn" data-gender="남성" data-target="partner">남자</button>
        </div>
      </div>

      <button type="button" id="submitBtn" class="submit-btn">다음으로</button>
    </form>
  </div>
</div>

<!-- 사주 원국 로딩 오버레이 (MZ ver.) -->
<div id="saju-loading">
  <div class="ld-blob ld-blob-1"></div>
  <div class="ld-blob ld-blob-2"></div>
  <div class="ld-blob ld-blob-3"></div>
  <div class="loading-inner">
    <div class="ld-tag"><span class="ld-tag-dot"></span>사주 분석 중</div>

    <!-- 나 -->
    <div class="ld-person-label" id="loading-name-me">나</div>
    <div class="pillar-row">
      <div class="pillar-card" id="pc-hour">
        <span class="pillar-label">시주</span>
        <div class="pillar-hanja" id="ph-hour">－<br>－</div>
      </div>
      <div class="pillar-card is-me" id="pc-day">
        <span class="pillar-label">일주 ✦</span>
        <div class="pillar-hanja" id="ph-day">－<br>－</div>
      </div>
      <div class="pillar-card" id="pc-month">
        <span class="pillar-label">월주</span>
        <div class="pillar-hanja" id="ph-month">－<br>－</div>
      </div>
      <div class="pillar-card" id="pc-year">
        <span class="pillar-label">년주</span>
        <div class="pillar-hanja" id="ph-year">－<br>－</div>
      </div>
    </div>

    <!-- vs 구분선 -->
    <div class="ld-vs">💞 vs</div>

    <!-- 상대방 -->
    <div class="ld-person-label partner" id="loading-name-partner">상대방</div>
    <div class="pillar-row">
      <div class="pillar-card partner-card" id="ppc-hour">
        <span class="pillar-label">시주</span>
        <div class="pillar-hanja" id="pph-hour">－<br>－</div>
      </div>
      <div class="pillar-card partner-card is-partner" id="ppc-day">
        <span class="pillar-label">일주 ✦</span>
        <div class="pillar-hanja" id="pph-day">－<br>－</div>
      </div>
      <div class="pillar-card partner-card" id="ppc-month">
        <span class="pillar-label">월주</span>
        <div class="pillar-hanja" id="pph-month">－<br>－</div>
      </div>
      <div class="pillar-card partner-card" id="ppc-year">
        <span class="pillar-label">년주</span>
        <div class="pillar-hanja" id="pph-year">－<br>－</div>
      </div>
    </div>

    <div class="loading-msg-wrap">
      <div class="loading-msg" id="loading-msg"></div>
    </div>
    <div class="loading-bar-wrap">
      <div class="loading-bar-fill" id="loading-bar"></div>
    </div>
  </div>
</div>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const ticketCode = urlParams.get('ticket');

  let currentStep = 0;

  const genderInput = document.getElementById('genderInput');
  const birthTypeInput = document.getElementById('birthTypeInput');
  const birthdateInput = document.getElementById('birthdateInput');
  const birthTimeSelect = document.getElementById('birthTimeSelect');
  const timeDisplay = document.getElementById('timeDisplay');
  const timePill = document.getElementById('timePill');

  const partnerGenderInput = document.getElementById('partnerGenderInput');
  const partnerBirthTypeInput = document.getElementById('partnerBirthTypeInput');
  const partnerBirthdateInput = document.getElementById('partnerBirthdateInput');
  const partnerBirthTimeSelect = document.getElementById('partnerBirthTimeSelect');
  const partnerTimeDisplay = document.getElementById('partnerTimeDisplay');
  const partnerTimePill = document.getElementById('partnerTimePill');

  genderInput.value = '남성';
  partnerGenderInput.value = '여성';

  function setupBirthdateInput(input) {
    input.addEventListener('input', function () {
      input.value = input.value.replace(/\D/g, '').slice(0, 8);
    });
    input.addEventListener('blur', function () {
      const digits = input.value.replace(/\D/g, '');
      if (/^\d{8}$/.test(digits)) {
        input.value = digits.slice(0, 4) + '.' + digits.slice(4, 6) + '.' + digits.slice(6, 8);
      }
    });
    input.addEventListener('focus', function () {
      input.value = input.value.replace(/\D/g, '');
    });
  }

  setupBirthdateInput(birthdateInput);
  setupBirthdateInput(partnerBirthdateInput);

  document.querySelectorAll('.gender-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const target = btn.dataset.target;
      const row = target === 'partner' ? document.getElementById('genderRowPartner') : document.getElementById('genderRowMe');
      row.querySelectorAll('.gender-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      if (target === 'partner') {
        partnerGenderInput.value = btn.dataset.gender;
      } else {
        genderInput.value = btn.dataset.gender;
      }
    });
  });

  document.querySelectorAll('[data-birth-type]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const target = btn.dataset.target;
      const group = btn.closest('.pill-group');
      group.querySelectorAll('[data-birth-type]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      if (target === 'partner') {
        partnerBirthTypeInput.value = btn.dataset.birthType;
      } else {
        birthTypeInput.value = btn.dataset.birthType;
      }
    });
  });

  function updateTimeDisplay(select, display, pill) {
    const option = select.options[select.selectedIndex];
    const label = option.textContent.trim();
    display.textContent = label;
    pill.textContent = label.length > 8 ? '시간선택' : label;
  }

  birthTimeSelect.addEventListener('change', function () {
    updateTimeDisplay(birthTimeSelect, timeDisplay, timePill);
  });
  partnerBirthTimeSelect.addEventListener('change', function () {
    updateTimeDisplay(partnerBirthTimeSelect, partnerTimeDisplay, partnerTimePill);
  });
  updateTimeDisplay(birthTimeSelect, timeDisplay, timePill);
  updateTimeDisplay(partnerBirthTimeSelect, partnerTimeDisplay, partnerTimePill);

  function shake(target) {
    target.animate(
      [
        { transform: 'translateX(0)' },
        { transform: 'translateX(-6px)' },
        { transform: 'translateX(6px)' },
        { transform: 'translateX(0)' }
      ],
      { duration: 300 }
    );
  }

  function renderStep() {
    document.getElementById('step0').classList.toggle('active', currentStep === 0);
    document.getElementById('step1').classList.toggle('active', currentStep === 1);
    document.getElementById('stepDot0').classList.toggle('active', currentStep === 0);
    document.getElementById('stepDot1').classList.toggle('active', currentStep === 1);

    const title = document.getElementById('formTitle');
    const desc = document.getElementById('formDesc');
    const label = document.getElementById('stepLabel');
    const submitBtn = document.getElementById('submitBtn');

    if (currentStep === 0) {
      title.textContent = '내 이름을 입력해주세요';
      desc.textContent = '속궁합 분석을 위해 먼저 본인 정보를 입력해 주세요.';
      label.textContent = '1 / 2 · 내 정보';
      submitBtn.textContent = '다음으로';
    } else {
      title.textContent = '상대방 이름을 입력해주세요';
      desc.textContent = '궁합을 볼 상대방의 생년월일·성별을 입력해 주세요.';
      label.textContent = '2 / 2 · 상대방 정보';
      submitBtn.textContent = '속궁합 보기';
    }
  }

  function validateStep0() {
    const name = document.querySelector("input[name='name']").value.trim();
    if (!name) {
      shake(document.querySelector('#step0 .name-input'));
      document.querySelector('#step0 .name-input').focus();
      return false;
    }
    const birthDigits = birthdateInput.value.replace(/\D/g, '');
    if (!/^\d{8}$/.test(birthDigits)) {
      shake(birthdateInput);
      birthdateInput.focus();
      return false;
    }
    if (!genderInput.value) {
      shake(document.getElementById('genderRowMe'));
      return false;
    }
    return true;
  }

  function validateStep1() {
    const name = document.querySelector("input[name='partnerName']").value.trim();
    if (!name) {
      shake(document.querySelector('#step1 .name-input'));
      document.querySelector('#step1 .name-input').focus();
      return false;
    }
    const birthDigits = partnerBirthdateInput.value.replace(/\D/g, '');
    if (!/^\d{8}$/.test(birthDigits)) {
      shake(partnerBirthdateInput);
      partnerBirthdateInput.focus();
      return false;
    }
    if (!partnerGenderInput.value) {
      shake(document.getElementById('genderRowPartner'));
      return false;
    }
    return true;
  }

  function buildUserData() {
    return {
      name: document.querySelector("input[name='name']").value.trim(),
      gender: genderInput.value,
      birthdate: birthdateInput.value.replace(/\D/g, ''),
      birthTime: birthTimeSelect.value,
      birthType: birthTypeInput.value,
      partnerInfo: {
        name: document.querySelector("input[name='partnerName']").value.trim(),
        gender: partnerGenderInput.value,
        birthdate: partnerBirthdateInput.value.replace(/\D/g, ''),
        birthTime: partnerBirthTimeSelect.value,
        birthType: partnerBirthTypeInput.value,
      },
      ticket: ticketCode
    };
  }

  /* ── 60갑자 간단 계산 ── */
  const GAN  = ['甲','乙','丙','丁','戊','己','庚','辛','壬','癸'];
  const JI   = ['子','丑','寅','卯','辰','巳','午','未','申','酉','戌','亥'];
  const TIME_JI = { '00':'子','02':'丑','04':'寅','06':'卯','08':'辰','10':'巳','12':'午','14':'未','16':'申','18':'酉','20':'戌','22':'亥','24':'子','unknown':'－' };

  function getGanJi(offset) {
    return { gan: GAN[((offset % 10) + 10) % 10], ji: JI[((offset % 12) + 12) % 12] };
  }

  function calcPillars(birthdate, birthTime) {
    // birthdate: "YYYYMMDD"
    const y = parseInt(birthdate.slice(0,4));
    const m = parseInt(birthdate.slice(4,6));
    const d = parseInt(birthdate.slice(6,8));

    // 년주: 1984=甲子 기준, offset=(year-4)%60
    const yearOffset = y - 4;
    const yearGJ = getGanJi(yearOffset);

    // 월주: 년간에 따른 월간 기준 오프셋 (오호둔법)
    const yearGanIdx = ((yearOffset % 10) + 10) % 10;
    const monthGanBase = [2,4,6,8,0,2,4,6,8,0][yearGanIdx]; // 甲己년=丙寅월시작
    // 절기 대신 월(m)로 근사: 월지 인=1월
    const monthJiIdx = ((m + 1) % 12);
    const monthGanIdx = (monthGanBase + (m - 1)) % 10;
    const monthGJ = { gan: GAN[monthGanIdx], ji: JI[monthJiIdx] };

    // 일주: 1900.1.1=甲戌(gan=0,ji=11) 기준 경과일수
    function daysSince1900(yr, mo, dy) {
      const d0 = new Date(1900, 0, 1);
      const d1 = new Date(yr, mo - 1, dy);
      return Math.round((d1 - d0) / 86400000);
    }
    const daysFromBase = daysSince1900(y, m, d);
    const dayGJ = getGanJi(daysFromBase); // 甲戌=offset 0

    // 시주: 일간에 따른 시간 (자시=子)
    const dayGanIdx = ((daysFromBase % 10) + 10) % 10;
    const hourGanBase = [0,2,4,6,8,0,2,4,6,8][dayGanIdx];
    const timeJi = TIME_JI[birthTime] || '－';
    const timeJiIdx = JI.indexOf(timeJi);
    const hourGan = timeJi === '－' ? '－' : GAN[(hourGanBase + (timeJiIdx >= 0 ? timeJiIdx : 0)) % 10];
    const hourGJ = { gan: hourGan, ji: timeJi };

    return { year: yearGJ, month: monthGJ, day: dayGJ, hour: hourGJ };
  }

  /* ── 로딩 오버레이 표시 후 폼 제출 ── */
  const LOADING_MSGS = [
    '사주 원국을 읽어내는 중이에요… 🔮',
    '오행 균형 분석 중… 근데 좀 복잡하네요 👀',
    '일주 기운이 심상치 않은데요? 🫣',
    '천해랑이 당신 사주 들여다보는 중… 🕯️',
    '거의 다 됐어요! 각오 단단히 하세요 😈',
  ];

  function showLoadingAndSubmit(submitCallback) {
    const data = buildUserData();
    const birthdate = data.birthdate.replace(/\D/g,'');
    const pillars = /^\d{8}$/.test(birthdate)
      ? calcPillars(birthdate, data.birthTime)
      : null;

    // 이름 표시
    document.getElementById('loading-name-me').textContent = (data.name || '나') + ' 사주';
    document.getElementById('loading-name-partner').textContent = (data.partnerInfo.name || '상대방') + ' 사주';

    // 내 기둥 채우기
    if (pillars) {
      document.getElementById('ph-year').innerHTML  = pillars.year.gan  + '<br>' + pillars.year.ji;
      document.getElementById('ph-month').innerHTML = pillars.month.gan + '<br>' + pillars.month.ji;
      document.getElementById('ph-day').innerHTML   = pillars.day.gan   + '<br>' + pillars.day.ji;
      document.getElementById('ph-hour').innerHTML  = pillars.hour.gan  + '<br>' + pillars.hour.ji;
    }

    // 상대방 기둥 채우기
    const partnerBirthdate = (data.partnerInfo.birthdate || '').replace(/\D/g,'');
    const partnerPillars = /^\d{8}$/.test(partnerBirthdate)
      ? calcPillars(partnerBirthdate, data.partnerInfo.birthTime)
      : null;
    if (partnerPillars) {
      document.getElementById('pph-year').innerHTML  = partnerPillars.year.gan  + '<br>' + partnerPillars.year.ji;
      document.getElementById('pph-month').innerHTML = partnerPillars.month.gan + '<br>' + partnerPillars.month.ji;
      document.getElementById('pph-day').innerHTML   = partnerPillars.day.gan   + '<br>' + partnerPillars.day.ji;
      document.getElementById('pph-hour').innerHTML  = partnerPillars.hour.gan  + '<br>' + partnerPillars.hour.ji;
    }

    // 오버레이 표시
    document.getElementById('saju-loading').classList.add('show');

    // 내 기둥 순서대로 등장
    const cards = ['pc-hour','pc-day','pc-month','pc-year'];
    cards.forEach(function(id, i) {
      setTimeout(function() {
        document.getElementById(id).classList.add('visible');
      }, 200 + i * 180);
    });

    // 상대방 기둥 순서대로 등장 (내 기둥 다 뜬 후)
    const partnerCards = ['ppc-hour','ppc-day','ppc-month','ppc-year'];
    partnerCards.forEach(function(id, i) {
      setTimeout(function() {
        document.getElementById(id).classList.add('visible');
      }, 900 + i * 180);
    });

    // 메시지 순환: 사라짐 → 0.2초 공백 → 다음 텍스트
    const MSG_FADE_MS = 300;
    const MSG_GAP_MS = 200;
    const msgEl = document.getElementById('loading-msg');
    msgEl.textContent = LOADING_MSGS[0];
    msgEl.classList.remove('fade');

    function switchLoadingMsg(text) {
      msgEl.classList.add('fade');
      setTimeout(function() {
        msgEl.textContent = '';
        setTimeout(function() {
          msgEl.textContent = text;
          msgEl.classList.remove('fade');
        }, MSG_GAP_MS);
      }, MSG_FADE_MS);
    }

    for (let i = 1; i < LOADING_MSGS.length; i++) {
      setTimeout(function() {
        switchLoadingMsg(LOADING_MSGS[i]);
      }, i * 1000);
    }

    // 진행 바 (5초)
    const bar = document.getElementById('loading-bar');
    setTimeout(function() {
      bar.style.transition = 'width 5s linear';
      bar.style.width = '100%';
    }, 50);

    // 5초 후 폼 제출
    setTimeout(submitCallback, 5000);
  }

  function submitForm() {
    const data = buildUserData();
    birthdateInput.value = data.birthdate;
    partnerBirthdateInput.value = data.partnerInfo.birthdate;

    if (data.name === '테스트' || data.name === '관리자') {
      const $form = $('#sajuForm');
      $form.find('input[name="userInfo"]').remove();
      $form.find('input[name="sample"]').remove();
      $form.find('input[name="goodsType"]').remove();
      $form.attr('action', '/saju/skip-payment');
      $('<input>').attr({ type: 'hidden', name: 'userInfo', value: JSON.stringify(data) }).appendTo($form);
      $('<input>').attr({ type: 'hidden', name: 'sample', value: '{}' }).appendTo($form);
      $('<input>').attr({ type: 'hidden', name: 'goodsType', value: 'ADULT' }).appendTo($form);
      $form[0].submit();
      return;
    }

    if (ticketCode) {
      $('#sajuForm').attr('action', '/saju/adult/result?ticket=' + encodeURIComponent(ticketCode));
    }

    document.getElementById('sajuForm').submit();
  }

  document.getElementById('navBackBtn').addEventListener('click', function () {
    if (currentStep > 0) {
      currentStep = 0;
      renderStep();
      return;
    }
    window.location.href = '/saju/adult/intro';
  });

  document.getElementById('submitBtn').addEventListener('click', function () {
    if (currentStep === 0) {
      if (!validateStep0()) return;
      currentStep = 1;
      renderStep();
      document.querySelector('#step1 .name-input').focus();
      return;
    }
    if (!validateStep1()) return;
    showLoadingAndSubmit(submitForm);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && document.activeElement.tagName !== 'SELECT') {
      e.preventDefault();
      document.getElementById('submitBtn').click();
    }
  });

  renderStep();
</script>

</body>
</html>
