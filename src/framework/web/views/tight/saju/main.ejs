          <p class="text-zinc-500 text-xs mt-2">연애운 · j***</p>
        </div>
        <div class="rounded-2xl bg-zinc-900/80 border border-white/5 p-5 shadow-lg">
          <div class="flex items-center justify-between mb-3">
            <span class="flex items-center gap-1.5 text-amber-400 text-sm">★★★★★</span>
            <span class="text-zinc-500 text-xs">2025.02.15</span>
          </div>
