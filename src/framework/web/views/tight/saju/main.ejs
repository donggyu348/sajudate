  <script>
    function zwPH(img) {
      img.style.display = 'none';
      var p = img.parentElement;
      p.style.position = 'relative';
      p.style.background = 'linear-gradient(160deg,#090B12 0%,#1a1710 52%,#5a4620 100%)';
      if (!p.querySelector('.zw-ph')) {
        var s = document.createElement('span');
        s.className = 'zw-ph';
        s.innerHTML = '<b>자미두수</b><i>紫微斗數</i>';
        p.appendChild(s);
      }
    }
  </script>

