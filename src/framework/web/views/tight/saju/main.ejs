    }
    .review-section__more:hover {
      border-color: rgba(255,255,255,0.22);
      color: rgba(255,255,255,0.65);
    }

    .review-feed {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .review-card {
      display: flex;
      gap: 14px;
      padding: 12px;
      border-radius: 16px;
