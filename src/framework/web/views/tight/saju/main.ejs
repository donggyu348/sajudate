    .review-card__nick {
      font-size: 11px;
      font-weight: 500;
      color: rgba(255,255,255,0.38);
      letter-spacing: 0.2px;
      font-family: ui-monospace, 'Cascadia Code', 'Consolas', monospace;
    }
    .review-card__stars {
      font-size: 9px;
      letter-spacing: 0.5px;
      color: #FF2D55;
      line-height: 1;
    }
    .review-card__when {
      font-size: 10px;
      color: rgba(255,255,255,0.25);
      margin-left: auto;
    }

    /* ── 제품 나열 ── */
    .product-row {
      margin-top: 0;
      padding: 40px 44px 48px;
      border-top: 1px solid rgba(255,255,255,0.08);
      background: #080808;
    }
    .product-row__title {
      font-size: 18px;
      font-weight: 800;
      color: #fff;
      margin: 0 0 20px;
      padding: 0 4px;
      letter-spacing: -0.4px;
    }
    .product-row__list {
      display: flex;
      flex-direction: column;
      gap: 32px;
      padding: 8px 0;
    }
    .product-row__item {
      display: block;
      text-decoration: none;
      border-radius: 18px;
      overflow: hidden;
      background: #161616;
      box-shadow:
        0 4px 20px rgba(0,0,0,0.35),
        0 0 0 1px rgba(255,255,255,0.04);
    }
    .product-row__thumb {
      position: relative;
      width: 100%;
      aspect-ratio: 5 / 6;
      overflow: hidden;
      background: #161616;
    }
    .product-row__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      display: block;
    }

    /* ── 푸터 구역 ── */
    .main-page-footer {
      margin-top: 0;
      padding-top: 12px;
      border-top: 1px solid rgba(255,255,255,0.1);
      background: #111;
    }
    .main-page-footer .footer {
      background: transparent !important;
    }

    /* ── 데스크톱: 모든 fixed 요소를 480px 컬럼 안으로 ── */
    @media (min-width: 500px) {
      #main-navbar {
        left:   max(0px, calc(50% - 240px)) !important;
        right:  max(0px, calc(50% - 240px)) !important;
      }
      .page-wrapper {
        border-left:  1px solid rgba(255,255,255,0.07);
        border-right: 1px solid rgba(255,255,255,0.07);
        box-shadow: 0 0 60px rgba(0,0,0,0.8);
      }
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var slides = document.querySelectorAll('.heroSwiper .swiper-slide');
      var totalSlides = slides.length;
      var counter = document.getElementById('hero-counter');

      function updateHeroDepth(swiper) {
        swiper.slides.forEach(function(slide) {
          var card = slide.querySelector('.hero-card');
          if (!card) return;
          var dist = Math.min(Math.abs(slide.progress || 0), 1);
          /* 가운데 1.0, 양옆 0.78 — 메인이 옆보다 확실히 큼 */
          var scale = 1 - dist * 0.22;
          var bright = 1 - dist * 0.38;
          card.style.transform = 'scale(' + scale.toFixed(3) + ')';
          card.style.filter = 'brightness(' + bright.toFixed(3) + ')';
          slide.style.zIndex = String(100 - Math.round(dist * 80));
        });
      }

      new Swiper(".heroSwiper", {
        loop: true,
        slidesPerView: 'auto',
        centeredSlides: true,
        spaceBetween: 12,
        loopedSlides: 2,
        grabCursor: true,
        watchSlidesProgress: true,
        autoplay: { delay: 4500, disableOnInteraction: false },
        on: {
          init: function(swiper) {
            updateHeroDepth(swiper);
          },
          progress: function(swiper) {
            updateHeroDepth(swiper);
          },
          setTransition: function(swiper, duration) {
            swiper.slides.forEach(function(slide) {
              var card = slide.querySelector('.hero-card');
              if (card) card.style.transitionDuration = duration + 'ms';
            });
          },
          slideChange: function(swiper) {
            if (counter) {
              counter.textContent = (swiper.realIndex + 1) + ' / ' + totalSlides;
            }
          }
        }
      });

    });
  </script>
</body>
</html>
