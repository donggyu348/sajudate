  <!-- 하단 네비게이션 바 -->
  <nav id="bottom-nav-bar" style="position:fixed; bottom:0; left:0; right:0; z-index:50; background:#111; border-top:1px solid rgba(255,255,255,0.06);">
    <div style="max-width:480px; margin:0 auto; display:flex; justify-content:space-around; align-items:center; height:68px; padding:0 8px;">

      <!-- 홈 (활성) -->
      <a href="/saju" style="display:flex; flex-direction:column; align-items:center; gap:4px; text-decoration:none; color:#fff; flex:1;">
