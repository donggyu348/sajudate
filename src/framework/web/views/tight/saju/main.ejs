          <div style="border-radius:12px; overflow:hidden; position:relative; aspect-ratio:2/3; background:#161616;">
            <img src="/assets/images/tight/romantic/index_banner1.png" style="width:100%; height:100%; object-fit:cover; display:block;" alt="연애사주"
              onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#2a0a3e,#6e1a8e)';">
            <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.82) 0%, transparent 55%);"></div>
            <div style="position:absolute; bottom:0; left:0; right:0; padding:12px 11px;">
