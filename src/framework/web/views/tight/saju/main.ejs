<!DOCTYPE html>
<html lang="ko">

<%- include('./../common/header') %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />

<body style="background:#0a0a0a; color:#fff; font-family:'Pretendard',-apple-system,sans-serif; padding-bottom:80px; margin:0;">

  <div class="page-wrapper w-full max-w-[480px] mx-auto min-h-screen flex flex-col">
    <%- include('./../common/common') %>

    <!-- 히어로 슬라이더 -->
    <section class="hero-section">
      <div id="hero-counter">1 / 2</div>
      <div class="swiper heroSwiper">
        <div class="swiper-wrapper">

          <!-- 슬라이드 1: 홍연 연애사주 -->
          <div class="swiper-slide">
            <a href="/saju/romantic/intro" class="hero-card" style="text-decoration:none;">
              <img src="/assets/images/tight/products/product_romantic.png" alt="홍연 연애사주"
                onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#3d1a2e,#7b2d5e)';">
            </a>
          </div>

          <!-- 슬라이드 2: 29금 궁합사주 -->
          <div class="swiper-slide">
            <a href="/saju/adult/intro" class="hero-card" style="text-decoration:none;">
              <img src="/assets/images/tight/products/product_adult.png" alt="29금 궁합사주"
                onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#2d0a0a,#7b1515)';">
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- SNS에서 핫한 사주 -->
    <section style="padding:28px 16px 0;">
      <h2 style="font-size:19px; font-weight:800; color:#fff; margin:0 0 14px; letter-spacing:-0.3px;">SNS에서 핫한 사주</h2>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">

        <a href="/saju/romantic/intro" style="text-decoration:none;">
          <div style="border-radius:12px; overflow:hidden; aspect-ratio:2/3; background:#161616;">
            <img src="/assets/images/tight/products/product_romantic.png" style="width:100%; height:100%; object-fit:cover; display:block;" alt="홍연 연애사주"
              onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#3d1a2e,#7b2d5e)';">
          </div>
        </a>

        <a href="/saju/adult/intro" style="text-decoration:none;">
          <div style="border-radius:12px; overflow:hidden; aspect-ratio:2/3; background:#161616;">
            <img src="/assets/images/tight/products/product_adult.png" style="width:100%; height:100%; object-fit:cover; display:block;" alt="29금 궁합사주"
              onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#2d0a0a,#7b1515)';">
          </div>
        </a>

      </div>
    </section>

    <!-- 이용 후기 -->
    <section class="review-section">
      <div class="review-section__head">
        <h2 class="review-section__title">방금 올라온 후기</h2>
        <span class="review-section__live"><span class="review-section__dot"></span>실시간</span>
      </div>

      <div class="review-feed">

        <article class="review-card">
          <a href="/saju/romantic/intro" class="review-card__poster">
            <img src="/assets/images/tight/products/product_romantic.png" alt="홍연 연애사주">
          </a>
          <div class="review-card__main">
            <p class="review-card__text">썸남 때문에 너무 답답해서 홧김에 신청했는데 생각보다 훨씬 디테일해서 놀랐어요... 연락 텀이 긴 이유도 설명해주고 제가 왜 계속 불안해하는지도 나와 있어서 읽으면서 계속 "헐 맞아..." 이러면서 봤어요ㅋㅋ</p>
            <div class="review-card__byline">
              <span class="review-card__face">🦊</span>
              <span class="review-card__nick">yn******</span>
              <span class="review-card__stars" aria-label="5점">★★★★★</span>
              <span class="review-card__when">1시간 전</span>
            </div>
          </div>
        </article>

        <article class="review-card">
          <a href="/saju/adult/intro" class="review-card__poster">
            <img src="/assets/images/tight/products/product_adult.png" alt="29금 궁합사주">
          </a>
          <div class="review-card__main">
            <p class="review-card__text">남친이랑 같이 봤는데 진짜 둘 다 보면서 계속 웃었어요ㅋㅋㅋ "이거 누가 우리 보고 쓴 거 아냐?" 이 말만 몇 번 했는지 모르겠어요🤣 서로 표현하는 방식이 왜 달랐는지도 이해하게 됐어요</p>
            <div class="review-card__byline">
              <span class="review-card__face">🐨</span>
              <span class="review-card__nick">hj******</span>
              <span class="review-card__stars" aria-label="5점">★★★★★</span>
              <span class="review-card__when">3시간 전</span>
            </div>
          </div>
        </article>

        <article class="review-card">
          <a href="/saju/romantic/intro" class="review-card__poster">
            <img src="/assets/images/tight/products/product_romantic.png" alt="홍연 연애사주">
          </a>
          <div class="review-card__main">
            <p class="review-card__text">저 원래 사주 엄청 좋아해서 여기저기 많이 봤는데 여기가 제일 현실적이었어요!! 특히 제가 연애하면 상대한테 올인하는 성향이라고 나온 부분이 진짜 너무 맞아서 놀랐어요ㅋㅋㅋ</p>
            <div class="review-card__byline">
              <span class="review-card__face">🐸</span>
              <span class="review-card__nick">sr******</span>
              <span class="review-card__stars" aria-label="5점">★★★★★</span>
              <span class="review-card__when">5시간 전</span>
            </div>
          </div>
        </article>

      </div>

      <a href="/saju/reviews" class="review-section__more">후기 더보기</a>
    </section>

    <!-- 제품 나열 -->
    <section class="product-row">
      <h2 class="product-row__title">전체 사주 보기</h2>
      <div class="product-row__list">
        <a href="/saju/romantic/intro" class="product-row__item">
          <div class="product-row__thumb">
            <img src="/assets/images/tight/products/product_romantic.png" alt="홍연 연애사주"
              onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#3d1a2e,#7b2d5e)';">
          </div>
        </a>
        <a href="/saju/adult/intro" class="product-row__item">
          <div class="product-row__thumb">
            <img src="/assets/images/tight/products/product_adult.png" alt="29금 궁합사주"
              onerror="this.style.display='none'; this.parentElement.style.background='linear-gradient(135deg,#2d0a0a,#7b1515)';">
          </div>
        </a>
      </div>
    </section>

    <div class="main-page-footer">
      <%- include('./../common/footer') %>
    </div>

  </div>

  <!-- 하단 네비게이션 바 -->
  <nav id="bottom-nav-bar" style="position:fixed; bottom:0; left:0; right:0; z-index:50; background:#111; border-top:1px solid rgba(255,255,255,0.06);">
    <div style="max-width:480px; margin:0 auto; display:flex; justify-content:space-around; align-items:center; height:68px; padding:0 8px;">

      <!-- 홈 (활성) -->
      <a href="/saju" style="display:flex; flex-direction:column; align-items:center; gap:4px; text-decoration:none; color:#fff; flex:1;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
      </a>

      <!-- 채팅 -->
      <a href="javascript:void(0)" style="display:flex; flex-direction:column; align-items:center; gap:4px; text-decoration:none; color:rgba(255,255,255,0.35); flex:1;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
      </a>

      <!-- 검색 -->
      <a href="javascript:void(0)" style="display:flex; flex-direction:column; align-items:center; gap:4px; text-decoration:none; color:rgba(255,255,255,0.35); flex:1;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>

      <!-- 박스 -->
      <a href="javascript:void(0)" style="display:flex; flex-direction:column; align-items:center; gap:4px; text-decoration:none; color:rgba(255,255,255,0.35); flex:1;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
        </svg>
      </a>

    </div>
  </nav>

  <style>
    section div::-webkit-scrollbar { display: none; }

    /* ── 히어로: 가운데 크게 + 양옆 제품 피킹 ── */
    .hero-section {
      position: relative;
      padding: calc(3.5rem + 20px) 0 12px;
      overflow: hidden;
    }
    #hero-counter {
      position: absolute;
      top: calc(3.5rem + 12px);
      right: 15%;
      color: rgba(255,255,255,0.75);
      font-size: 12px;
      font-weight: 600;
      z-index: 20;
      pointer-events: none;
      background: rgba(0,0,0,0.55);
      padding: 4px 10px;
      border-radius: 999px;
      backdrop-filter: blur(4px);
    }
    .heroSwiper {
      width: 100%;
      overflow: hidden;
    }
    .heroSwiper .swiper-wrapper {
      align-items: center;
    }
    .heroSwiper .swiper-slide {
      width: 72%;
      height: auto;
      z-index: 1;
    }
    .heroSwiper .swiper-slide-active {
      z-index: 10;
    }

    .hero-card {
      display: block;
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      padding-bottom: 150%;
      background: #1a1a1a;
      text-decoration: none;
      transform-origin: center center;
      transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1),
                  filter 0.45s ease,
                  box-shadow 0.45s ease;
      box-shadow:
        0 4px 14px rgba(0,0,0,0.4),
        0 12px 32px rgba(0,0,0,0.45);
    }
    .heroSwiper .swiper-slide-active .hero-card {
      box-shadow:
        0 10px 24px rgba(0,0,0,0.5),
        0 28px 64px rgba(0,0,0,0.55),
        0 0 0 1px rgba(255,255,255,0.1);
    }
    .heroSwiper .swiper-slide:not(.swiper-slide-active) .hero-card {
      box-shadow:
        0 2px 8px rgba(0,0,0,0.35),
        0 6px 16px rgba(0,0,0,0.3);
    }

    .hero-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    section div::-webkit-scrollbar { display: none; }

    /* ── 리뷰 섹션 ── */
    .review-section {
      padding: 36px 16px 40px;
      margin-top: 28px;
      border-top: 1px solid rgba(255,255,255,0.08);
      background: #0a0a0a;
    }
    .review-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }
    .review-section__title {
      font-size: 18px;
      font-weight: 800;
      color: #fff;
      margin: 0;
      letter-spacing: -0.4px;
    }
    .review-section__live {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
      color: rgba(255,255,255,0.45);
    }
    .review-section__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #34d399;
      box-shadow: 0 0 6px rgba(52,211,153,0.6);
      animation: review-pulse 2s ease-in-out infinite;
    }
    @keyframes review-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .review-section__more {
      display: block;
      margin-top: 16px;
      padding: 13px;
      border-radius: 12px;
      border: 1px dashed rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.42);
      font-size: 13px;
      font-weight: 500;
      text-align: center;
      text-decoration: none;
      transition: border-color 0.2s, color 0.2s;
    }
    .review-section__more:hover {
      border-color: rgba(255,255,255,0.22);
      color: rgba(255,255,255,0.65);
    }

    .review-feed {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .review-card {
      display: flex;
      gap: 14px;
      padding: 12px;
      border-radius: 16px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.06);
    }
    .review-card__poster {
      position: relative;
      flex-shrink: 0;
      width: 72px;
      align-self: stretch;
      min-height: 108px;
      border-radius: 10px;
      overflow: hidden;
      text-decoration: none;
      background: #1a1a1a;
    }
    .review-card__poster img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .review-card__main {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
      padding: 2px 0;
    }
    .review-card__text {
      font-size: 13.5px;
      line-height: 1.65;
      color: rgba(255,255,255,0.88);
      margin: 0;
      letter-spacing: -0.15px;
      word-break: keep-all;
    }
    .review-card__byline {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 5px 6px;
    }
    .review-card__face {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(255,255,255,0.07);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      line-height: 1;
      flex-shrink: 0;
    }
    .review-card__nick {
      font-size: 11px;
      font-weight: 500;
      color: rgba(255,255,255,0.38);
      letter-spacing: 0.2px;
      font-family: ui-monospace, 'Cascadia Code', 'Consolas', monospace;
    }
    .review-card__stars {
      font-size: 9px;
      letter-spacing: 0.5px;
      color: #FF2D55;
      line-height: 1;
    }
    .review-card__when {
      font-size: 10px;
      color: rgba(255,255,255,0.25);
      margin-left: auto;
    }

    /* ── 제품 나열 ── */
    .product-row {
      margin-top: 0;
      padding: 40px 44px 48px;
      border-top: 1px solid rgba(255,255,255,0.08);
      background: #080808;
    }
    .product-row__title {
      font-size: 18px;
      font-weight: 800;
      color: #fff;
      margin: 0 0 20px;
      padding: 0 4px;
      letter-spacing: -0.4px;
    }
    .product-row__list {
      display: flex;
      flex-direction: column;
      gap: 32px;
      padding: 8px 0;
    }
    .product-row__item {
      display: block;
      text-decoration: none;
      border-radius: 18px;
      overflow: hidden;
      background: #161616;
      box-shadow:
        0 4px 20px rgba(0,0,0,0.35),
        0 0 0 1px rgba(255,255,255,0.04);
    }
    .product-row__thumb {
      position: relative;
      width: 100%;
      aspect-ratio: 5 / 6;
      overflow: hidden;
      background: #161616;
    }
    .product-row__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      display: block;
    }

    /* ── 푸터 구역 ── */
    .main-page-footer {
      margin-top: 0;
      padding-top: 12px;
      border-top: 1px solid rgba(255,255,255,0.1);
      background: #111;
    }
    .main-page-footer .footer {
      background: transparent !important;
    }

    /* ── 데스크톱: 모든 fixed 요소를 480px 컬럼 안으로 ── */
    @media (min-width: 500px) {
      #main-navbar {
        left:   max(0px, calc(50% - 240px)) !important;
        right:  max(0px, calc(50% - 240px)) !important;
      }
      #bottom-nav-bar {
        left:   max(0px, calc(50% - 240px)) !important;
        right:  max(0px, calc(50% - 240px)) !important;
        border-radius: 0 0 12px 12px;
      }
      .page-wrapper {
        border-left:  1px solid rgba(255,255,255,0.07);
        border-right: 1px solid rgba(255,255,255,0.07);
        box-shadow: 0 0 60px rgba(0,0,0,0.8);
      }
    }
  </style>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var slides = document.querySelectorAll('.heroSwiper .swiper-slide');
      var totalSlides = slides.length;
      var counter = document.getElementById('hero-counter');

      function updateHeroDepth(swiper) {
        swiper.slides.forEach(function(slide) {
          var card = slide.querySelector('.hero-card');
          if (!card) return;
          var dist = Math.min(Math.abs(slide.progress || 0), 1);
          /* 가운데 1.0, 양옆 0.78 — 메인이 옆보다 확실히 큼 */
          var scale = 1 - dist * 0.22;
          var bright = 1 - dist * 0.38;
          card.style.transform = 'scale(' + scale.toFixed(3) + ')';
          card.style.filter = 'brightness(' + bright.toFixed(3) + ')';
          slide.style.zIndex = String(100 - Math.round(dist * 80));
        });
      }

      new Swiper(".heroSwiper", {
        loop: true,
        slidesPerView: 'auto',
        centeredSlides: true,
        spaceBetween: 12,
        loopedSlides: 2,
        grabCursor: true,
        watchSlidesProgress: true,
        autoplay: { delay: 4500, disableOnInteraction: false },
        on: {
          init: function(swiper) {
            updateHeroDepth(swiper);
          },
          progress: function(swiper) {
            updateHeroDepth(swiper);
          },
          setTransition: function(swiper, duration) {
            swiper.slides.forEach(function(slide) {
              var card = slide.querySelector('.hero-card');
              if (card) card.style.transitionDuration = duration + 'ms';
            });
          },
          slideChange: function(swiper) {
            if (counter) {
              counter.textContent = (swiper.realIndex + 1) + ' / ' + totalSlides;
            }
          }
        }
      });

    });
  </script>
</body>
</html>
