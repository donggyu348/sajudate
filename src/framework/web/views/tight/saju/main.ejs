      <div class="space-y-5">
        <a href="/saju/classic/intro" class="block group">
          <div class="relative rounded-2xl overflow-hidden bg-zinc-900 shadow-xl shadow-black/40 min-h-[280px] border border-white/5">
            <img src="/assets/images/tight/classic/신년사주.png" alt="신년운" class="w-full h-full min-h-[280px] object-cover transition-transform duration-500 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
            <span class="absolute top-4 left-4 px-2.5 py-1 rounded-lg bg-amber-500/90 text-xs font-bold text-black">HOT</span>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h2 class="text-2xl font-bold text-white tracking-tight drop-shadow-lg" style="font-family: 'Noto Serif KR', serif;">신년운</h2>
              <p class="text-zinc-400 mt-1.5">올해의 운세, 한 해를 미리 읽어드립니다</p>
              <p class="text-zinc-500 text-sm mt-2">조회 12.3만</p>
            </div>
