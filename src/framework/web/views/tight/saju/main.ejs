        <button data-cat="wealth" onclick="selectCat(this)" style="flex-shrink:0; padding:6px 16px; border-radius:999px; background:transparent; color:rgba(255,255,255,0.5); font-size:13px; font-weight:500; border:none; cursor:pointer;">재물</button>
        <button data-cat="compat" onclick="selectCat(this)" style="flex-shrink:0; padding:6px 16px; border-radius:999px; background:transparent; color:rgba(255,255,255,0.5); font-size:13px; font-weight:500; border:none; cursor:pointer;">궁합</button>
