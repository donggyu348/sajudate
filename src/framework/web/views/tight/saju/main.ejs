  <style>
    section div::-webkit-scrollbar { display: none; }

    /* ── 자미두수 썸네일 플레이스홀더 (이미지 없을 때) ── */
    .zw-ph {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      color: #D8B16D;
      pointer-events: none;
    }
    .zw-ph b { font-size: 20px; font-weight: 800; letter-spacing: 2px; }
    .zw-ph i { font-size: 11px; font-style: normal; letter-spacing: 5px; text-indent: 5px; color: rgba(216,177,109,0.7); }

    /* ── 히어로: 가운데 크게 + 양옆 제품 피킹 ── */
    .hero-section {
      position: relative;
      padding: calc(3.5rem + 20px) 0 12px;
      overflow: hidden;
    }
    #hero-counter {
      position: absolute;
      top: calc(3.5rem + 12px);
      right: 15%;
      color: rgba(255,255,255,0.75);
      font-size: 12px;
      font-weight: 600;
      z-index: 20;
      pointer-events: none;
      background: rgba(0,0,0,0.55);
      padding: 4px 10px;
      border-radius: 999px;
      backdrop-filter: blur(4px);
    }
    .heroSwiper {
      width: 100%;
      overflow: hidden;
    }
    .heroSwiper .swiper-wrapper {
      align-items: center;
    }
    .heroSwiper .swiper-slide {
      width: 72%;
      height: auto;
      z-index: 1;
    }
    .heroSwiper .swiper-slide-active {
      z-index: 10;
    }

    .hero-card {
      display: block;
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      padding-bottom: 150%;
      background: #1a1a1a;
      text-decoration: none;
      transform-origin: center center;
      transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1),
                  filter 0.45s ease,
                  box-shadow 0.45s ease;
      box-shadow:
        0 4px 14px rgba(0,0,0,0.4),
        0 12px 32px rgba(0,0,0,0.45);
    }
    .heroSwiper .swiper-slide-active .hero-card {
      box-shadow:
        0 10px 24px rgba(0,0,0,0.5),
        0 28px 64px rgba(0,0,0,0.55),
        0 0 0 1px rgba(255,255,255,0.1);
    }
    .heroSwiper .swiper-slide:not(.swiper-slide-active) .hero-card {
      box-shadow:
        0 2px 8px rgba(0,0,0,0.35),
        0 6px 16px rgba(0,0,0,0.3);
    }

    .hero-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    section div::-webkit-scrollbar { display: none; }

    /* ── 리뷰 섹션 ── */
    .review-section {
      padding: 36px 16px 40px;
      margin-top: 28px;
      border-top: 1px solid rgba(255,255,255,0.08);
      background: #0a0a0a;
    }
    .review-section__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }
    .review-section__title {
      font-size: 18px;
      font-weight: 800;
      color: #fff;
      margin: 0;
      letter-spacing: -0.4px;
    }
    .review-section__live {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 600;
