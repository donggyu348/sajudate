      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 10px;
      padding: 2px 0;
    }
    .review-card__text {
      font-size: 13.5px;
      line-height: 1.65;
      color: rgba(255,255,255,0.88);
