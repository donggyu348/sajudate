        <a href="/saju/romantic/intro" class="block group">
          <div class="relative rounded-2xl overflow-hidden bg-zinc-900 shadow-xl shadow-black/40 min-h-[280px] border border-white/5">
            <img src="/assets/images/tight/romantic/연애사주.png" alt="연애운" class="w-full h-full min-h-[280px] object-cover transition-transform duration-500 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
            <span class="absolute top-4 left-4 px-2.5 py-1 rounded-lg bg-purple-500/90 text-xs font-bold text-white">신규</span>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h2 class="text-2xl font-bold text-white tracking-tight drop-shadow-lg" style="font-family: 'Noto Serif KR', serif;">연애운</h2>
              <p class="text-zinc-400 mt-1.5">인연과 연애운, 진짜 나의 타입을 알아봅니다</p>
              <p class="text-zinc-500 text-sm mt-2">조회 8.1만</p>
            </div>
          </div>
        </a>
        <a href="/saju/adult/intro" class="block group">
          <div class="relative rounded-2xl overflow-hidden bg-zinc-900 shadow-xl shadow-black/40 min-h-[280px] border border-white/5">
            <img src="/assets/images/tight/29/29금.png" alt="29금사주" class="w-full h-full min-h-[280px] object-cover transition-transform duration-500 group-hover:scale-105">
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
            <span class="absolute top-4 left-4 px-2.5 py-1 rounded-lg bg-rose-500/90 text-xs font-bold text-white">19+</span>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <h2 class="text-2xl font-bold text-white tracking-tight drop-shadow-lg" style="font-family: 'Noto Serif KR', serif;">29금사주</h2>
