<!DOCTYPE html>
<html lang="ko">

<%- include('./../common/header') %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;600;700&display=swap" rel="stylesheet">

<body class="min-h-screen bg-[#0a0a0b] text-white antialiased" style="font-family: 'Pretendard', -apple-system, sans-serif;">

  <div class="w-full max-w-[480px] mx-auto min-h-screen flex flex-col">
    <%- include('./../common/common') %>

    <!-- ================= 히어로 슬라이드 (전체 꽉 채움, 페이드) ================= -->
    <section class="relative w-full aspect-[9/16] max-h-[70vh] flex-shrink-0 overflow-hidden">
      <div class="swiper heroSwiper absolute inset-0 w-full h-full">
        <div class="swiper-wrapper">
          <!-- 1번: 신년 -->
          <div class="swiper-slide">
            <img src="/assets/images/tight/classic/신년사주 히어로.png" class="absolute inset-0 w-full h-full object-cover z-0" alt="">
            <div class="absolute inset-0 z-[1] bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 z-[2] flex flex-col justify-end p-6 pb-12">
              <p class="font-serif text-amber-400/90 text-sm tracking-widest uppercase mb-2" style="font-family: 'Noto Serif KR', serif;">신년운세</p>
              <h2 class="text-2xl font-bold leading-tight tracking-tight text-white drop-shadow-lg" style="font-family: 'Noto Serif KR', serif;">올해의 운을 열어드립니다<br>신년 사주</h2>
              <p class="text-white/70 text-sm mt-2">한 해의 길운과 흐름을 미리 읽어드립니다</p>
            </div>
          </div>
          <!-- 2번: 연애 -->
          <div class="swiper-slide">
            <img src="/assets/images/tight/romantic/연애사주 히어로.png" class="absolute inset-0 w-full h-full object-cover z-0" alt="">
            <div class="absolute inset-0 z-[1] bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute inset-0 z-[2] flex flex-col justify-end p-6 pb-12">
              <p class="font-serif text-purple-300/90 text-sm tracking-widest uppercase mb-2" style="font-family: 'Noto Serif KR', serif;">연애운</p>
              <h2 class="text-2xl font-bold leading-tight tracking-tight text-white drop-shadow-lg" style="font-family: 'Noto Serif KR', serif;">인연과 연애운을 읽어드립니다<br>연애 사주</h2>
              <p class="text-white/70 text-sm mt-2">진짜 나의 타입과 맞춤 연애운</p>
            </div>
          </div>
          <!-- 3번: 29금 사주 -->
          <div class="swiper-slide">
            <img src="/assets/images/tight/29/29금 히어로.png" class="absolute inset-0 w-full h-full object-cover z-0" alt="">
