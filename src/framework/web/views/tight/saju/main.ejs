            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
          </div>
          <span class="text-xs text-zinc-400 font-medium">29금사주</span>
        </a>
      </div>
    </section>

    <!-- ================= 지금 가장 핫한 운세 (큰 카드 세로 배치) ================= -->
    <section class="mt-8 px-4">
      <h3 class="text-lg font-semibold text-white mb-5 flex items-center gap-2" style="font-family: 'Noto Serif KR', serif;">
        <span class="w-1 h-5 bg-amber-500 rounded-full"></span>
