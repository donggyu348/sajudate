<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  /*
   * 재회사주 9섹션 세일즈 퍼널.
   * 캘린더·사주팔자표·그래프·레이더는 전부 reunionSajuService의 실계산값(reunion)이다.
   */
  const name = reunion.me.name;
  const partnerName = reunion.partner.name;

  /*
   * 배경 일러스트 — public/assets/images/tight/return/1~6.png (퍼널 등장 순서)
   *   1 훅(빗물 창문) · 2,3 공감 2컷 · 4 금기 · 5 신뢰(카페 분할컷) · 6 마무리(지하철)
   *   #4·#6·#7·#8은 UI 전용이라 이미지가 없다.
   */
  const scene = (n) => `/assets/images/tight/return/${n}.png`;

  /* 리포트 목차 — 4장 구성 */
  const CHAPTERS = [
    {
      title: '무엇이 우리를 어긋나게 했을까',
      sub: '두 사람의 사주 원국 정밀 대조',
      items: [
        `${name}님과 ${partnerName}님의 원국 전체 풀이`,
        '두 사람의 오행 균형과 부딪히는 지점',
        '헤어진 그날의 일진이 말해주는 것',
        '관계를 무너뜨린 결정적 요인 3가지',
      ],
      more: 1,
    },
    {
      title: '그 사람은 지금 무슨 생각을 할까',
      sub: `${partnerName}님의 속마음 해부`,
      items: [
        `이별을 결정하던 순간 ${partnerName}님의 마음`,
        `지금 이 순간 ${partnerName}님의 감정 상태`,
        `${partnerName}님 원국에 나를 향한 기운이 남아 있는지`,
        '앞으로 한 달, 그 마음이 어떻게 움직이는지',
      ],
      more: 2,
    },
    {
      title: '정말 다시 만나게 될까',
      sub: '재회 가능성과 그 시점',
      items: [
        '두 사람의 재회 확률과 그렇게 나온 근거',
        `${partnerName}님이 먼저 연락해올 시기`,
        '내가 먼저 다가가야 할 정확한 날짜',
      ],
      more: 1,
    },
    {
      title: '무엇을 하고, 무엇을 하지 말아야 하나',
      sub: '재회 실전 전략',
      items: [
        '지금부터 지켜야 할 기본 태도',
        '다시 마주했을 때 통하는 인상과 화법',
        '연락운을 끌어올리는 개운법과 답장 요령',
        `[주의] ${partnerName}님이 등을 돌리게 만드는 행동`,
      ],
      more: 3,
    },
  ];
%>

<head>
  <%- include('./_bubbleStyles') %>
  <%- include('./_landingStyles') %>
</head>

<body>
  <div class="page">

    <!-- ═══════════ #1 훅 — 재회 확률 + 실시간 카톡 ═══════════ -->
    <section class="rs rs--scene rs--hook" id="sec1">
      <img class="rs__bg" src="<%= scene(1) %>" alt="" onerror="this.remove()" loading="eager" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner rs-hook">

        <!-- 상단: 두 사람 이름 + 재회 확률 -->
        <div class="rs-hook__top">
          <p class="rs-hook__who"><%= name %>님과 <%= partnerName %>님의</p>
          <p class="rs-hook__label">재회 확률</p>
          <p class="rs-hook__num"><%= reunion.probability %><small>%</small></p>
        </div>

        <!-- 하단: 답장 없는 카톡. 내 메시지는 하나씩 뜨고, 상대는 썼다 지웠다만 반복한다 -->
        <div class="kt" id="ktHero">
          <!-- 첫 메시지는 진입 즉시 보이도록 is-in을 처음부터 붙여둔다 -->
          <div class="kt-row kt-row--right is-in" data-kt="0">
            <span class="kt-time">오후 11:47</span>
            <div class="kt-msg kt-msg--me">뭐해...?</div>
          </div>

          <div class="kt-row kt-row--right" data-kt="1">
            <span class="kt-time">오후 11:52</span>
            <div class="kt-msg kt-msg--me">자...?</div>
          </div>

          <div class="kt-row kt-row--right" data-kt="2">
            <span class="kt-time">오전 12:14</span>
            <div class="kt-msg kt-msg--me">아직도 네 생각 나</div>
          </div>

          <div class="kt-row kt-row--left kt-typing" data-kt-typing>
            <div class="kt-msg kt-msg--them"><i></i><i></i><i></i></div>
          </div>
        </div>

        <div class="rs-hook__scroll" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ═══════════ #2 공감 (2컷) ═══════════ -->
    <section class="rs" id="sec2">
      <div class="rs-cut">
        <img class="rs__bg" src="<%= scene(2) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
        <div class="rs__scrim"></div>
        <div class="rs__inner">
          <div class="rs-lines">
            <p class="rs-line" data-line>이게 진짜<br>마지막이었을까요?</p>
          </div>
        </div>
      </div>

      <div class="rs-cut rs-cut--memory" data-memory-cut>
        <img class="rs__bg" src="<%= scene(3) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
        <div class="rs__scrim"></div>
        <%- include('./_memories') %>
        <div class="rs__inner">
          <div class="rs-lines">
            <p class="rs-line rs-line--right" data-line><%= name %>님,<br>잠깐 이야기 좀 할까요</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ #3 금기 / 호기심 갭 ═══════════ -->
    <section class="rs rs--scene" id="sec3">
      <img class="rs__bg" src="<%= scene(4) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner">
        <div class="rs-lines">
          <p class="rs-line rs-line--warn" data-line>지금 연락하면,<br>오히려 멀어져요</p>
          <p class="rs-line rs-line--sm" data-line>이 <span class="rs-blur"><%= reunion.silenceRule %></span> 지키면<br>재회할 수 있습니다</p>
        </div>
      </div>
    </section>

    <!-- ═══════════ #4 재회 캘린더 (UI) ═══════════ -->
    <section class="rs rs--ui" id="sec4">
      <p class="rs__eyebrow">Contact Timeline</p>
      <h2 class="rs__title">우리 둘의 연락운 타임라인</h2>
      <div class="rs-lines" style="margin-bottom:22px;">
        <p class="rs-line rs-line--sm" data-line><%= name %>님, 그 사람은 언제쯤 마음을 열까요?</p>
      </div>
      <%- include('./_calendar') %>
    </section>

    <!-- ═══════════ #5 신뢰 소스 — 두 사람의 사주팔자 (UI 전용) ═══════════ -->
    <section class="rs rs--ui" id="sec5">
      <div class="rs-lines" style="margin-bottom:22px;">
        <p class="rs-line" data-line>두 사람의 사주,<br>숫자로 확인해보세요</p>
      </div>
      <%- include('./_pillarTable', { table: reunion.me.table, locked: false }) %>
      <%- include('./_pillarTable', { table: reunion.partner.table, locked: false }) %>
    </section>

    <!-- ═══════════ #6 클라이맥스 + 락 ═══════════ -->
    <section class="rs rs--ui" id="sec6">
      <div class="rs-lines" style="margin-bottom:20px;">
        <p class="rs-line" data-line>두 사람, 다시 이어질 확률은<br><strong><%= reunion.probability %>%</strong>로 나왔어요.</p>
        <p class="rs-line rs-line--sm" data-line>
          <span class="rs-blur"><%= reunion.boost.action %></span>
          확률이 <strong><%= reunion.boost.percent %>%</strong> 올라갑니다.
        </p>
      </div>

      <div class="rs-lock" data-reveal>
        <p class="rs-lock__text">
          <%= name %>님의 일주는 <b><%= reunion.me.table.dayPillarHanja %>(<%= reunion.me.dayPillar %>)</b>,
          <%= partnerName %>님은 <b><%= reunion.partner.table.dayPillarHanja %>(<%= reunion.partner.dayPillar %>)</b>입니다.
          두 일지 사이에 <b><%= reunion.keyword %></b>의 기운이 잡혀 있고,
          이게 두 사람이 끝까지 서로를 놓지 못하는 이유이자 동시에 매번 같은 지점에서 어긋났던 원인입니다.
        </p>
        <div class="rs-lock__fade" aria-hidden="true">
          <%= partnerName %>님의 <%= reunion.partner.table.strength %> 원국에서 이 시기에 들어오는 기운은
          <%= reunion.regretTenGod || '관성' %>이며, <%= reunion.regretYear || '' %>년을 전후로 마음의 방향이 한 번 크게 바뀝니다.
          이때 <%= name %>님이 먼저 해야 할 행동과 절대 하면 안 되는 말, 그리고
          연락을 다시 이어붙일 정확한 문장까지 리포트 본문에서 순서대로 정리해 드립니다.
          두 사람의 대운이 교차하는 지점과 그 시기에 나타나는 신호도 함께 확인할 수 있습니다.
          <div class="rs-lock__veil">
            <span class="rs-lock__icon">🔒</span>
            <button type="button" class="rs-lock__cta" data-cta>막힌 내용, 리포트에서 이어서 보기</button>
          </div>
        </div>
      </div>

      <div class="rs-discount">
        <span>할인 마감까지</span>
        <b id="rsDiscountTime">--:--</b>
      </div>
    </section>

    <!-- ═══════════ #9 리포트 목차 (배경 이미지 없이 단독) ═══════════ -->
    <section class="rs rs--ui" id="sec9">
      <div class="rs-lines" style="margin-bottom:26px;">
        <p class="rs-line" data-line>리포트 안에 뭐가 들어있는지<br>보여드릴게요</p>
        <p class="rs-line rs-line--sm" data-line>왜 자꾸 어긋났던 걸까요?</p>
      </div>

      <% CHAPTERS.forEach(function (ch, i) { %>
      <div class="rs-ch" data-reveal>
        <p class="rs-ch__no">CHAPTER <%= String(i + 1).padStart(2, '0') %></p>
        <h3 class="rs-ch__title"><%= ch.title %></h3>
        <p class="rs-ch__sub"><%= ch.sub %></p>

        <ul class="rs-ch__list">
          <% ch.items.forEach(function (item, j) { %>
          <li class="rs-ch__item">
            <span class="rs-ch__idx">풀이 <%= j + 1 %></span>
            <span><%= item %></span>
          </li>
          <% }); %>
        </ul>

        <p class="rs-ch__more">그 외 <%= ch.more %>가지 풀이 추가 제공</p>
      </div>
      <% }); %>
    </section>

    <!-- ═══════════ #9-2 마무리 씬 ═══════════ -->
    <section class="rs rs--scene" id="sec9b" style="min-height:auto;padding-top:64px;padding-bottom:44px;">
      <img class="rs__bg" src="<%= scene(6) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner">
        <div class="rs-lines">
          <p class="rs-line" data-line>상대방 쪽 풀이도<br>하나 더 얹어드려요</p>
        </div>
      </div>
    </section>

    <!-- 스크롤 앵커: 여기 도달하면 플로팅 CTA 숨김 -->
    <div id="rsBottomAnchor" style="height:4px;"></div>
  </div>

  <!-- 실시간 구매 알림 토스트 -->
  <div class="rs-toast" id="rsToast">
    <span class="rs-toast__dot"></span>
    <span id="rsToastText"></span>
  </div>

  <!-- 결제 폼 (기존 상품과 동일한 규약) -->
  <form method="POST" action="<%= reunion.me.name === '관리자' ? '/saju/skip-payment' : '/saju/payment' %>" class="hidden" id="rsForm">
    <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
    <input type="hidden" name="sample" value='<%= JSON.stringify(reunion.snapshot) %>' />
    <input type="hidden" name="goodsType" value="REUNION" />
  </form>

  <div class="rs-cta" id="rsCta">
    <button type="button" class="rs-cta__btn" data-cta>
      <span><%= name %>님의 재회 리포트 확인하기</span>
      <span aria-hidden="true">--&gt;</span>
    </button>
  </div>

  <div class="rs-notice">AI 분석 기반 참고용 콘텐츠입니다. 의사결정의 근거로 사용하지 마세요.</div>

  <script>
    (function () {
      /* ── 등장 애니메이션 ── */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

      document.querySelectorAll('[data-line], [data-reveal]').forEach(function (el) { io.observe(el); });

      /* 한 씬에 문장이 여럿이면 순서대로 뜨게 지연을 준다 */
      document.querySelectorAll('.rs-lines').forEach(function (group) {
        group.querySelectorAll('[data-line]').forEach(function (el, i) {
          el.style.transitionDelay = (i * 420) + 'ms';
        });
      });

      /* ── 히어로 카톡 ──
         내가 보낸 메시지는 하나씩 차례로 뜨고,
         상대는 끝내 답장 없이 '입력 중…'만 켜졌다 꺼졌다(썼다 지웠다) 반복한다. */
      (function playHeroChat() {
        var wrap = document.getElementById('ktHero');
        if (!wrap) return;

        var msgs = wrap.querySelectorAll('[data-kt]');
        var typing = wrap.querySelector('[data-kt-typing]');

        // 첫 메시지는 마크업에서 이미 떠 있으므로 두 번째부터 순차 등장시킨다
        var t = 1100;
        msgs.forEach(function (msg, i) {
          if (i === 0) return;
          setTimeout(function () { msg.classList.add('is-in'); }, t);
          t += 1100;
        });

        if (!typing) return;

        // 썼다 지웠다 — 켜져 있는 시간과 꺼져 있는 시간을 조금씩 다르게 줘 망설이는 느낌을 낸다
        var onMs  = [1700, 1100, 2300, 900];
        var offMs = [1200, 1900, 900, 1500];
        var i = 0;

        function loop() {
          setTimeout(function () {
            typing.classList.add('is-in');
            setTimeout(function () {
              typing.classList.remove('is-in');
              i++;
              loop();
            }, onMs[i % onMs.length]);
          }, offMs[i % offMs.length]);
        }

        // 내 메시지가 다 뜬 뒤부터 시작
        setTimeout(loop, t);
      })();

      /* ── 회상: 저절로 잊혀진다 ──
         씬이 눈에 들어오면 --p가 0 → 1로 천천히 흘러가고,
         기억은 --gone 순서대로 하나씩 색이 빠지며 흩어진다.
         스크롤과 무관하게 한 번만 흐르고, 끝나면 돌아오지 않는다. */
      (function playForgetting() {
        var cut = document.querySelector('[data-memory-cut]');
        if (!cut) return;

        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;   // 모션을 줄인 환경에서는 기억을 그대로 둔다

        var HOLD_MS = 1800;    // 잠시 온전히 머무는 시간
        var FADE_MS = 11000;   // 전부 잊히기까지

        var started = false;

        function run(startedAt) {
          var elapsed = performance.now() - startedAt - HOLD_MS;
          var p = elapsed <= 0 ? 0 : Math.min(1, elapsed / FADE_MS);

          // 처음엔 더디게, 갈수록 걷잡을 수 없이 흐려진다
          var eased = p * p * (3 - 2 * p);
          cut.style.setProperty('--p', eased.toFixed(3));

          if (p < 1) requestAnimationFrame(function () { run(startedAt); });
        }

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting || started) return;
            started = true;
            io.disconnect();
            var t0 = performance.now();
            requestAnimationFrame(function () { run(t0); });
          });
        }, { threshold: 0.35 });

        io.observe(cut);
      })();

      /* ── 할인 카운트다운 (#6) ── */
      var DEADLINE_MIN = 15;
      var endAt = Date.now() + DEADLINE_MIN * 60 * 1000;
      var discTime = document.getElementById('rsDiscountTime');

      function pad(n) { return String(n).padStart(2, '0'); }
      function tick() {
        var left = Math.max(0, endAt - Date.now());
        var m = Math.floor(left / 60000);
        var s = Math.floor((left % 60000) / 1000);
        if (discTime) discTime.textContent = pad(m) + ':' + pad(s);
      }
      tick();
      setInterval(tick, 1000);

      /* ── 구매 알림 토스트 ── */
      var toast = document.getElementById('rsToast');
      var toastText = document.getElementById('rsToastText');
      var NAMES = ['김O은', '이O진', '박O연', '최O우', '정O아', '한O림', '조O윤', '유O빈'];
      var toastIdx = 0;
      function showToast() {
        if (!toast || !toastText) return;
        toastText.textContent = NAMES[toastIdx % NAMES.length] + '님, 방금 결제를 완료했어요';
        toastIdx++;
        toast.classList.add('is-on');
        setTimeout(function () { toast.classList.remove('is-on'); }, 3600);
      }
      setTimeout(function () {
        showToast();
        setInterval(showToast, 14000);
      }, 6000);

      /* ── CTA ── */
      var form = document.getElementById('rsForm');
      document.querySelectorAll('[data-cta]').forEach(function (btn) {
        btn.addEventListener('click', function () { if (form) form.submit(); });
      });

      /* ── 하단 도달 시 플로팅 CTA 숨김 처리 없이 유지 (전환 우선) ── */
      if (window.karrotPixel) window.karrotPixel.track('Lead');
    })();
  </script>
</body>
</html>
