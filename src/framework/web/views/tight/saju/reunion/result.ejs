<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  /*
   * 재회사주 9섹션 세일즈 퍼널.
   * 캘린더·사주팔자표·그래프·레이더는 전부 reunionSajuService의 실계산값(reunion)이다.
   */
  const name = reunion.me.name;
  const partnerName = reunion.partner.name;

  /*
   * 배경 일러스트 — public/assets/images/tight/return/1~6.png (퍼널 등장 순서)
   *   1 훅(빗물 창문) · 2,3 공감 2컷 · 4 금기 · 5 신뢰(카페 분할컷) · 6 마무리(지하철)
   *   #4·#6·#7·#8은 UI 전용이라 이미지가 없다.
   */
  const scene = (n) => `/assets/images/tight/return/${n}.png`;

  const TOC = [
    '두 사람이 왜 어긋났는지 — 사주로 본 이별의 진짜 이유',
    `${partnerName}님이 지금 마음속으로 하고 있는 생각`,
    '재회 확률을 끌어올리는 연락 타이밍 전체 일정',
    '절대 하면 안 되는 행동 7가지',
    '다시 만났을 때 같은 이유로 헤어지지 않는 법',
    '두 사람의 궁합·결혼운 종합 풀이',
    `${partnerName}님 쪽 사주 단독 풀이`,
  ];
%>

<head>
  <%- include('./_bubbleStyles') %>
  <%- include('./_landingStyles') %>
</head>

<body>
  <!-- 상단 고정 카운트다운 (#2부터 노출) -->
  <div class="rs-topbar" id="rsTopbar">
    <span class="rs-topbar__text"><%= name %>님께 지금만 열려있는 특별 혜택</span>
    <span class="rs-topbar__time" id="rsTopbarTime">--:--</span>
  </div>

  <div class="page">

    <!-- ═══════════ #1 훅 — 재회 확률 + 실시간 카톡 ═══════════ -->
    <section class="rs rs--scene rs--hook" id="sec1">
      <img class="rs__bg" src="<%= scene(1) %>" alt="" onerror="this.remove()" loading="eager" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner rs-hook">

        <!-- 상단: 재회 확률 -->
        <div class="rs-hook__top">
          <p class="rs-hook__label">재회 확률</p>
          <p class="rs-hook__num"><%= reunion.probability %><small>%</small></p>
        </div>

        <!-- 하단: 실시간으로 오가는 카톡 -->
        <div class="kt" id="ktHero">
          <div class="kt-row kt-row--left" data-kt="0">
            <div class="kt-msg kt-msg--them">아직도... 그 사람 생각나</div>
            <span class="kt-time">오후 11:47</span>
          </div>

          <div class="kt-row kt-row--left kt-typing" data-kt-typing>
            <div class="kt-msg kt-msg--them"><i></i><i></i><i></i></div>
          </div>

          <div class="kt-row kt-row--right" data-kt="1">
            <span class="kt-time">오후 11:48</span>
            <div class="kt-msg kt-msg--me">두 사람이 다시 만날 확률, 지금 계산됐어요</div>
          </div>
        </div>

        <div class="rs-hook__scroll" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ═══════════ #2 공감 (2컷) ═══════════ -->
    <section class="rs" id="sec2">
      <div class="rs-cut">
        <img class="rs__bg" src="<%= scene(2) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
        <div class="rs__scrim"></div>
        <div class="rs__inner">
          <div class="rb-thread">
            <%- include('./_chatBubble', { text: '이게 진짜 마지막이었을까요?', size: 'lg' }) %>
          </div>
        </div>
      </div>

      <div class="rs-cut">
        <img class="rs__bg" src="<%= scene(3) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
        <div class="rs__scrim"></div>
        <div class="rs__inner">
          <div class="rb-thread">
            <%- include('./_chatBubble', { side: 'right', tone: 'pink', text: `${name}님, 잠깐 이야기 좀 할까요` }) %>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ #3 금기 / 호기심 갭 ═══════════ -->
    <section class="rs rs--scene" id="sec3">
      <img class="rs__bg" src="<%= scene(4) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner">
        <div class="rb-thread">
          <%- include('./_chatBubble', { tone: 'warn', text: '지금 연락하면, 오히려 멀어져요', size: 'lg' }) %>
          <%- include('./_chatBubble', {
                tone: 'warn',
                delay: 260,
                text: `이 타이밍 하나만 지키면 <span class="rb-blur">${reunion.keyword}</span>`
              }) %>
        </div>
      </div>
    </section>

    <!-- ═══════════ #4 재회 캘린더 (UI) ═══════════ -->
    <section class="rs rs--ui" id="sec4">
      <p class="rs__eyebrow">Contact Timeline</p>
      <h2 class="rs__title">우리 둘의 연락운 타임라인</h2>
      <div class="rb-thread" style="margin-bottom:20px;">
        <%- include('./_chatBubble', { text: `${name}님, 그 사람은 언제쯤 마음을 열까요?` }) %>
      </div>
      <%- include('./_calendar') %>
    </section>

    <!-- ═══════════ #5 신뢰 소스 — 두 사람의 사주팔자 ═══════════ -->
    <section class="rs rs--scene" id="sec5" style="min-height:auto;padding-top:44px;">
      <img class="rs__bg" src="<%= scene(5) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner">
        <div class="rb-thread" style="margin-bottom:20px;">
          <%- include('./_chatBubble', { text: '두 사람의 사주, 숫자로 확인해보세요' }) %>
        </div>
        <%- include('./_pillarTable', { table: reunion.me.table }) %>
        <%- include('./_pillarTable', { table: reunion.partner.table }) %>
      </div>
    </section>

    <!-- ═══════════ #6 클라이맥스 + 락 ═══════════ -->
    <section class="rs rs--ui" id="sec6">
      <div class="rb-thread" style="margin-bottom:18px;">
        <%- include('./_chatBubble', {
              side: 'right', tone: 'pink', size: 'lg',
              text: `"두 사람, 다시 이어질 확률은 <strong>${reunion.probability}%</strong>로 나왔어요."`
            }) %>
      </div>

      <div class="rs-lock" data-reveal>
        <p class="rs-lock__text">
          <%= name %>님의 일주는 <b><%= reunion.me.table.dayPillarHanja %>(<%= reunion.me.dayPillar %>)</b>,
          <%= partnerName %>님은 <b><%= reunion.partner.table.dayPillarHanja %>(<%= reunion.partner.dayPillar %>)</b>입니다.
          두 일지 사이에 <b><%= reunion.keyword %></b>의 기운이 잡혀 있고,
          이게 두 사람이 끝까지 서로를 놓지 못하는 이유이자 동시에 매번 같은 지점에서 어긋났던 원인입니다.
        </p>
        <div class="rs-lock__fade" aria-hidden="true">
          <%= partnerName %>님의 <%= reunion.partner.table.strength %> 원국에서 이 시기에 들어오는 기운은
          <%= reunion.regretTenGod || '관성' %>이며, <%= reunion.regretYear || '' %>년을 전후로 마음의 방향이 한 번 크게 바뀝니다.
          이때 <%= name %>님이 먼저 해야 할 행동과 절대 하면 안 되는 말, 그리고
          연락을 다시 이어붙일 정확한 문장까지 리포트 본문에서 순서대로 정리해 드립니다.
          두 사람의 대운이 교차하는 지점과 그 시기에 나타나는 신호도 함께 확인할 수 있습니다.
          <div class="rs-lock__veil">
            <span class="rs-lock__icon">🔒</span>
            <button type="button" class="rs-lock__cta" data-cta>막힌 내용, 리포트에서 이어서 보기</button>
          </div>
        </div>
      </div>

      <div class="rs-discount">
        <span>할인 마감까지</span>
        <b id="rsDiscountTime">--:--</b>
      </div>

      <h3 class="rs__title" style="margin-top:34px;margin-bottom:0;">이 리포트를 믿어도 되는 3가지 이유</h3>
    </section>

    <!-- ═══════════ #7 권위 — 인포그래픽 ═══════════ -->
    <section class="rs rs--ui" id="sec7" style="padding-top:18px;">
      <div class="rs-reasons">
        <div class="rs-reason" data-reveal>
          <span class="rs-reason__no">1</span>
          <div>
            <p class="rs-reason__t">18명의 역술 전문가가 함께 검토했어요</p>
            <p class="rs-reason__d">사주 원국 해석 기준과 재회운 산출 규칙을 전문가 검토를 거쳐 정리했습니다.</p>
          </div>
        </div>
        <div class="rs-reason" data-reveal>
          <span class="rs-reason__no">2</span>
          <div>
            <p class="rs-reason__t">복잡한 걸 한눈에 보이게</p>
            <p class="rs-reason__d">천간·지지·십성·십이운성을 그래프와 캘린더로 바꿔, 뭘 해야 하는지가 바로 보입니다.</p>
          </div>
        </div>
        <div class="rs-reason" data-reveal>
          <span class="rs-reason__no">3</span>
          <div>
            <p class="rs-reason__t">두 사람의 실제 생년월일시로 계산했어요</p>
            <p class="rs-reason__d">예시나 평균값이 아니라 <%= name %>님과 <%= partnerName %>님의 원국에서 직접 뽑은 값입니다.</p>
          </div>
        </div>
      </div>

      <div style="margin-top:18px;">
        <%- include('./_timelineChart') %>
      </div>
    </section>

    <!-- ═══════════ #8 비교우위 / 사회적 증거 ═══════════ -->
    <section class="rs rs--ui" id="sec8">
      <%- include('./_radarChart') %>

      <h3 class="rs__title" style="margin-top:30px;">비슷한 서비스보다 부담 없는 가격으로</h3>
      <div class="rs-price">
        <div class="rs-price__card" data-reveal>
          <span class="rs-price__label">오프라인 사주 상담 (1회)</span>
          <span class="rs-price__amt">80,000원~</span>
        </div>
        <div class="rs-price__card" data-reveal>
          <span class="rs-price__label">전화 재회 상담 (30분)</span>
          <span class="rs-price__amt">55,000원~</span>
        </div>
        <div class="rs-price__card rs-price__card--mine" data-reveal>
          <span class="rs-price__label">확실하게 준비한 재회 리포트</span>
          <span class="rs-price__amt">
            <%= goodsInfo.price.toLocaleString('ko-KR') %>원
            <del><%= goodsInfo.originalPrice.toLocaleString('ko-KR') %>원</del>
          </span>
        </div>
      </div>

      <h3 class="rs__title" style="margin-top:30px;margin-bottom:10px;">실제로 써본 5만 명이 남긴 결과</h3>
      <div class="rs-stats">
        <div class="rs-stat" data-reveal><b>52,847</b><span>누적 리포트</span></div>
        <div class="rs-stat" data-reveal><b>4.8</b><span>평균 만족도</span></div>
        <div class="rs-stat" data-reveal><b>93%</b><span>재구매 의향</span></div>
      </div>
    </section>

    <!-- ═══════════ #9 마무리 / 목차 ═══════════ -->
    <section class="rs rs--scene" id="sec9" style="min-height:auto;padding-top:44px;padding-bottom:40px;">
      <img class="rs__bg" src="<%= scene(6) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner">
        <div class="rb-thread" style="margin-bottom:20px;">
          <%- include('./_chatBubble', { text: '리포트 안에 뭐가 들어있는지 보여드릴게요' }) %>
          <%- include('./_chatBubble', { side: 'right', tone: 'pink', text: '왜 자꾸 어긋났던 걸까요?', delay: 220 }) %>
        </div>

        <div class="rs-toc">
          <% TOC.forEach(function (item, i) { %>
          <div class="rs-toc__item" data-reveal>
            <span class="rs-toc__no"><%= String(i + 1).padStart(2, '0') %></span>
            <span><%= item %></span>
          </div>
          <% }); %>
        </div>

        <div class="rb-thread" style="margin-top:20px;">
          <%- include('./_chatBubble', { text: '상대방 쪽 풀이도 하나 더 얹어드려요' }) %>
        </div>
      </div>
    </section>

    <!-- 스크롤 앵커: 여기 도달하면 플로팅 CTA 숨김 -->
    <div id="rsBottomAnchor" style="height:4px;"></div>
  </div>

  <!-- 실시간 구매 알림 토스트 -->
  <div class="rs-toast" id="rsToast">
    <span class="rs-toast__dot"></span>
    <span id="rsToastText"></span>
  </div>

  <!-- 결제 폼 (기존 상품과 동일한 규약) -->
  <form method="POST" action="<%= reunion.me.name === '관리자' ? '/saju/skip-payment' : '/saju/payment' %>" class="hidden" id="rsForm">
    <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
    <input type="hidden" name="sample" value='<%= JSON.stringify(reunion.snapshot) %>' />
    <input type="hidden" name="goodsType" value="REUNION" />
  </form>

  <div class="rs-cta" id="rsCta">
    <button type="button" class="rs-cta__btn" data-cta>
      <span><%= name %>님의 재회 리포트 확인하기</span>
      <span aria-hidden="true">--&gt;</span>
    </button>
  </div>

  <div class="rs-notice">AI 분석 기반 참고용 콘텐츠입니다. 의사결정의 근거로 사용하지 마세요.</div>

  <script>
    (function () {
      /* ── 등장 애니메이션 ── */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

      document.querySelectorAll('[data-bubble], [data-reveal]').forEach(function (el) { io.observe(el); });

      /* ── 히어로 카톡: 실시간으로 오가는 것처럼 순차 재생 ── */
      (function playHeroChat() {
        var wrap = document.getElementById('ktHero');
        if (!wrap) return;

        var msgs = wrap.querySelectorAll('[data-kt]');
        var typing = wrap.querySelector('[data-kt-typing]');
        if (typing) typing.style.display = 'none';

        var t = 700;
        // 첫 메시지
        setTimeout(function () { if (msgs[0]) msgs[0].classList.add('is-in'); }, t);

        // 입력 중…
        t += 900;
        setTimeout(function () {
          if (!typing) return;
          typing.style.display = '';
          typing.classList.add('is-in');
        }, t);

        // 답장
        t += 1600;
        setTimeout(function () {
          if (typing) typing.style.display = 'none';
          if (msgs[1]) msgs[1].classList.add('is-in');
        }, t);
      })();

      /* ── 카운트다운 (#2 상단바 · #6 할인) ── */
      var DEADLINE_MIN = 15;
      var endAt = Date.now() + DEADLINE_MIN * 60 * 1000;
      var topTime = document.getElementById('rsTopbarTime');
      var discTime = document.getElementById('rsDiscountTime');

      function pad(n) { return String(n).padStart(2, '0'); }
      function tick() {
        var left = Math.max(0, endAt - Date.now());
        var m = Math.floor(left / 60000);
        var s = Math.floor((left % 60000) / 1000);
        var text = pad(m) + ':' + pad(s);
        if (topTime) topTime.textContent = text;
        if (discTime) discTime.textContent = text;
      }
      tick();
      setInterval(tick, 1000);

      /* ── 상단바: #2 진입 이후 노출 ── */
      var topbar = document.getElementById('rsTopbar');
      var sec2 = document.getElementById('sec2');
      if (topbar && sec2) {
        var barIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            topbar.classList.toggle('is-on', e.boundingClientRect.top < 0 || e.isIntersecting);
          });
        }, { threshold: 0 });
        barIo.observe(sec2);
      }

      /* ── 구매 알림 토스트 ── */
      var toast = document.getElementById('rsToast');
      var toastText = document.getElementById('rsToastText');
      var NAMES = ['김O은', '이O진', '박O연', '최O우', '정O아', '한O림', '조O윤', '유O빈'];
      var toastIdx = 0;
      function showToast() {
        if (!toast || !toastText) return;
        toastText.textContent = NAMES[toastIdx % NAMES.length] + '님, 방금 결제를 완료했어요';
        toastIdx++;
        toast.classList.add('is-on');
        setTimeout(function () { toast.classList.remove('is-on'); }, 3600);
      }
      setTimeout(function () {
        showToast();
        setInterval(showToast, 14000);
      }, 6000);

      /* ── CTA ── */
      var form = document.getElementById('rsForm');
      document.querySelectorAll('[data-cta]').forEach(function (btn) {
        btn.addEventListener('click', function () { if (form) form.submit(); });
      });

      /* ── 하단 도달 시 플로팅 CTA 숨김 처리 없이 유지 (전환 우선) ── */
      if (window.karrotPixel) window.karrotPixel.track('Lead');
    })();
  </script>
</body>
</html>
