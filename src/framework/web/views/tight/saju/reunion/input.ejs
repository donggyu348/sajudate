<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<head>
  <style>
    :root {
      --red: #c0392b;
      --gold: #c9a84c;
      --white-dim: rgba(255,255,255,0.35);
    }

    body {
      margin: 0;
      background: #000;
      color: #fff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont;
      overflow: hidden;
    }

    .stage {
      max-width: 480px;
      height: 100dvh;
      margin: 0 auto;
      position: relative;
      background: linear-gradient(180deg, #0a0000 0%, #070000 50%, #030000 100%);
      overflow: hidden;
    }

    html, body {
      background: #000 !important;
    }

    .stage::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.8) 100%);
    }

    /* 진행바 */
    .progress-bar {
      position: absolute;
      top: 0; left: 0;
      height: 3px;
      background: var(--red);
      transition: width 0.4s ease;
      z-index: 10;
    }

    /* 질문 */
    .question-layer {
      position: absolute;
      top: 36%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      padding: 0 24px;
      text-align: center;
      z-index: 5;
      transition: all 0.4s ease;
    }

    .question-layer.card-mode {
      top: 13%;
    }

    .question-sub {
      font-size: 11px;
      letter-spacing: 0.22em;
      opacity: 0.45;
      margin-bottom: 10px;
    }

    .question-title {
      font-size: 24px;
      font-weight: 600;
      line-height: 1.5;
      letter-spacing: -0.01em;
      white-space: pre-line;
    }

    /* 스텝 */
    .step { display: none; }
    .step.active { display: block; }

    /* 입력 영역 */
    .input-area {
      position: absolute;
      top: 54%;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 420px;
      z-index: 5;
      animation: fadeUp 0.45s ease;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translate(-50%, 14px); }
      to   { opacity: 1; transform: translate(-50%, 0); }
    }

    .input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--white-dim);
      padding: 10px 6px;
      font-size: 20px;
      color: #fff;
      outline: none;
      text-align: center;
      letter-spacing: 0.02em;
      transition: border-color 0.3s ease;
      box-sizing: border-box;
    }

    .input::placeholder { color: rgba(255,255,255,0.3); }
    .input:focus { border-bottom-color: var(--red); }

    select.input {
      appearance: none;
      text-align-last: center;
      cursor: pointer;
    }

    select option { background-color: #111; color: #fff; }

    /* 다음 버튼 */
    .next-btn {
      position: fixed;
      bottom: calc(20px + env(safe-area-inset-bottom));
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 420px;
      height: 52px;
      border-radius: 26px;
      border: 1px solid var(--red);
      background: transparent;
      color: var(--red);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.12em;
      z-index: 10;
      transition: all 0.3s ease;
      cursor: pointer;
    }

    .next-btn:hover { background: var(--red); color: #fff; }

    /* ===== 카드 선택 스텝 ===== */
    .card-step {
      display: none;
      position: absolute;
      top: 22%;
      left: 0; right: 0;
      bottom: 90px;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 0 14px 20px;
      z-index: 5;
      background: transparent;
      animation: fadeUp2 0.45s ease;
      outline: none !important;
      border: none !important;
      box-shadow: none !important;
    }

    .card-step::-webkit-scrollbar { display: none; }
    .card-step:focus { outline: none !important; border: none !important; box-shadow: none !important; }
    .card-grid { outline: none !important; border: none !important; box-shadow: none !important; }
    .col-left, .col-right { outline: none !important; border: none !important; }

    .card-step.active { display: block; }

    @keyframes fadeUp2 {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .card-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      align-items: start;
    }

    /* 오른쪽 열 아래로 오프셋 */
    .col-right { margin-top: 44px; }

    /* 카드 아이템 */
    .card-item {
      position: relative;
      cursor: pointer;
      transition: box-shadow 0.25s ease, opacity 0.25s ease;
    }

    .card-item img {
      width: 100%;
      display: block;
    }

    .card-item.selected {
      box-shadow: 0 0 24px rgba(201,168,76,0.6);
      opacity: 1;
    }

    .card-item:not(.selected) {
      opacity: 0.85;
    }

    /* 떠다니는 애니메이션 */
    @keyframes floatA {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-8px); }
    }
    @keyframes floatB {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-6px); }
    }
    @keyframes floatC {
      0%, 100% { transform: translateY(0px); }
      50%       { transform: translateY(-10px); }
    }

    .float-a { animation: floatA 3.2s ease-in-out infinite; }
    .float-b { animation: floatB 3.8s ease-in-out infinite 0.6s; }
    .float-c { animation: floatC 4.1s ease-in-out infinite 1.2s; }
    .float-d { animation: floatA 3.5s ease-in-out infinite 0.3s; }
    .float-e { animation: floatB 4.3s ease-in-out infinite 0.9s; }
    .float-f { animation: floatC 3.7s ease-in-out infinite 1.5s; }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0px 1000px rgba(10,0,0,0.8) inset;
      -webkit-text-fill-color: #fff;
    }
  </style>
</head>

<body>
<div class="stage">

  <div class="progress-bar" id="progressBar" style="width:20%"></div>

  <div class="question-layer" id="questionLayer">
    <p class="question-sub">재회 사주</p>
    <h1 id="questionTitle" class="question-title">당신의 이름은?</h1>
  </div>

  <form id="sajuForm" method="POST" action="/saju/reunion/result">
    <input type="hidden" name="birthType"        id="birthTypeInput">
    <input type="hidden" name="partnerBirthType" id="partnerBirthTypeInput">
    <input type="hidden" name="relationStatus"   id="relationStatusInput">

    <!-- STEP 1: 내 이름 -->
    <section class="step active">
      <div class="input-area">
        <input name="name" type="text" class="input" placeholder="이름을 입력하세요" autocomplete="off">
      </div>
    </section>

    <!-- STEP 2: 상대방 이름 -->
    <section class="step">
      <div class="input-area">
        <input name="partnerName" type="text" class="input" placeholder="상대방 이름을 입력하세요" autocomplete="off">
      </div>
    </section>

    <!-- STEP 3: 내 생년월일 -->
    <section class="step">
      <div class="input-area">
        <select id="birthTypeSelect" class="input" style="margin-bottom:14px">
          <option value="양력">양력</option>
          <option value="음력">음력</option>
        </select>
        <input name="birthdate" class="input" placeholder="YYYYMMDD" maxlength="8" inputmode="numeric">
      </div>
    </section>

    <!-- STEP 4: 상대방 생년월일 -->
    <section class="step">
      <div class="input-area">
        <select id="partnerBirthTypeSelect" class="input" style="margin-bottom:14px">
          <option value="양력">양력</option>
          <option value="음력">음력</option>
        </select>
        <input name="partnerBirthdate" class="input" placeholder="YYYYMMDD" maxlength="8" inputmode="numeric">
      </div>
    </section>

    <button type="button" id="nextBtn" class="next-btn">다음으로</button>
  </form>

  <!-- STEP 5: 카드 선택 (form 바깥, 별도 레이어) -->
  <div class="card-step" id="cardStep" tabindex="-1">
    <div class="card-grid">

      <!-- 왼쪽 열 -->
      <div class="col-left">
        <div class="card-item float-a" data-value="붉은 실" onclick="selectCard(this)">
          <img src="/assets/images/tight/reunion/card1.png" alt="붉은 실">
        </div>
        <div style="height:12px"></div>
        <div class="card-item float-c" data-value="꺼진 등불" onclick="selectCard(this)">
          <img src="/assets/images/tight/reunion/card3.png" alt="꺼진 등불">
        </div>
        <div style="height:12px"></div>
        <div class="card-item float-e" data-value="돌아오지 않은 편지" onclick="selectCard(this)">
          <img src="/assets/images/tight/reunion/card5.png" alt="돌아오지 않은 편지">
        </div>
      </div>

      <!-- 오른쪽 열 (아래 오프셋) -->
      <div class="col-right">
        <div class="card-item float-b" data-value="닫힌 문" onclick="selectCard(this)">
          <img src="/assets/images/tight/reunion/card2.png" alt="닫힌 문">
        </div>
        <div style="height:12px"></div>
        <div class="card-item float-d" data-value="깨진 거울" onclick="selectCard(this)">
          <img src="/assets/images/tight/reunion/card4.png" alt="깨진 거울">
        </div>
        <div style="height:12px"></div>
        <div class="card-item float-f" data-value="흐르는 강" onclick="selectCard(this)">
          <img src="/assets/images/tight/reunion/card6.png" alt="흐르는 강">
        </div>
      </div>

    </div>
  </div>

  <!-- 카드 스텝용 고정 버튼 -->
  <button type="button" id="cardNextBtn" class="next-btn" style="display:none;" onclick="submitForm()">
    나의 재회운 보기
  </button>

</div>

<script>
  let step = 0;
  const steps = document.querySelectorAll(".step");
  const questionTitle  = document.getElementById("questionTitle");
  const questionLayer  = document.getElementById("questionLayer");
  const progressBar    = document.getElementById("progressBar");
  const cardStep       = document.getElementById("cardStep");
  const nextBtn        = document.getElementById("nextBtn");
  const cardNextBtn    = document.getElementById("cardNextBtn");
  const TOTAL_STEPS    = 5; // 4 input steps + 1 card step

  const questions = [
    "당신의 이름은?",
    "상대방의 이름은?",
    "당신의 생년월일을\n입력해주세요",
    "상대방의 생년월일을\n입력해주세요",
    "지금 상대방과의\n상태는?"
  ];

  function showStep() {
    const isCardStep = step === 4;

    steps.forEach((s, i) => s.classList.toggle("active", !isCardStep && i === step));
    questionTitle.innerText = questions[step];
    progressBar.style.width = ((step + 1) / TOTAL_STEPS * 100) + "%";

    if (isCardStep) {
      cardStep.classList.add("active");
      nextBtn.style.display = "none";
      cardNextBtn.style.display = "block";
      questionLayer.classList.add("card-mode");
      document.body.style.overflow = "hidden";
    } else {
      cardStep.classList.remove("active");
      nextBtn.style.display = "block";
      cardNextBtn.style.display = "none";
      questionLayer.classList.remove("card-mode");
      const activeInput = document.querySelector(".step.active input");
      if (activeInput) setTimeout(() => activeInput.focus(), 100);
    }
  }

  function shake(target) {
    target.animate(
      [{ transform:"translateX(0)" },{ transform:"translateX(-6px)" },{ transform:"translateX(6px)" },{ transform:"translateX(0)" }],
      { duration: 300 }
    );
  }

  function validateStep() {
    if (step === 0) {
      const v = document.querySelector("input[name='name']").value.trim();
      if (!v) { shake(document.querySelector("input[name='name']")); return false; }
    }
    if (step === 1) {
      const v = document.querySelector("input[name='partnerName']").value.trim();
      if (!v) { shake(document.querySelector("input[name='partnerName']")); return false; }
    }
    if (step === 2) {
      const v = document.querySelector("input[name='birthdate']").value.trim();
      if (!/^\d{8}$/.test(v)) { shake(document.querySelector("input[name='birthdate']")); return false; }
    }
    if (step === 3) {
      const v = document.querySelector("input[name='partnerBirthdate']").value.trim();
      if (!/^\d{8}$/.test(v)) { shake(document.querySelector("input[name='partnerBirthdate']")); return false; }
    }
    return true;
  }

  nextBtn.onclick = () => {
    if (!validateStep()) return;
    step++;
    showStep();
  };

  function selectCard(el) {
    document.querySelectorAll(".card-item").forEach(c => c.classList.remove("selected"));
    el.classList.add("selected");
    document.getElementById("relationStatusInput").value = el.dataset.value;
  }

  function submitForm() {
    if (!document.getElementById("relationStatusInput").value) {
      const grid = document.querySelector(".card-grid");
      grid.animate(
        [{ transform:"translateX(0)" },{ transform:"translateX(-6px)" },{ transform:"translateX(6px)" },{ transform:"translateX(0)" }],
        { duration: 300 }
      );
      return;
    }
    document.getElementById("sajuForm").submit();
  }

  document.getElementById("birthTypeSelect").addEventListener("change", function () {
    document.getElementById("birthTypeInput").value = this.value;
  });
  document.getElementById("birthTypeSelect").dispatchEvent(new Event("change"));

  document.getElementById("partnerBirthTypeSelect").addEventListener("change", function () {
    document.getElementById("partnerBirthTypeInput").value = this.value;
  });
  document.getElementById("partnerBirthTypeSelect").dispatchEvent(new Event("change"));

  // 카드 영역 포커스 아웃라인 강제 제거
  const cardStepEl = document.getElementById("cardStep");
  cardStepEl.addEventListener("focus", () => { cardStepEl.blur(); }, true);

  document.addEventListener("keydown", function (e) {
    if (e.key === "Enter") {
      if (document.activeElement.tagName === "SELECT") return;
      if (step === 4) return;
      e.preventDefault();
      nextBtn.click();
    }
  });
</script>

</body>
</html>
