<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  /*
   * 이별 정황 3문항. 사주 계산에는 쓰이지 않고, 리포트 본문에서
   * "왜 어긋났는지 / 지금 뭘 해야 하는지"를 사용자 상황에 맞춰 쓰기 위한 입력이다.
   */
  const QUESTIONS = [
    {
      field: 'breakupReason',
      eyebrow: '이별의 사유',
      title: '우리는 <em>왜 멀어졌던</em> 걸까요?',
      options: [
        '썸붕 및 고백 실패',
        '성격 차이와 잦은 다툼',
        '집착 및 이성 문제',
        '상대방의 잠수이별 및 통보',
        '상대방의 바람 및 외도',
      ],
    },
    {
      field: 'contactStatus',
      eyebrow: '지금의 거리',
      title: '지금 두 사람은 <em>어떤 상태</em>인가요?',
      options: [
        '연락이 완전히 끊겼어요',
        '제가 연락하면 답은 와요',
        '가끔 안부 정도는 주고받아요',
        '차단당한 상태예요',
        '아직 종종 만나고 있어요',
      ],
    },
    {
      field: 'mainConcern',
      eyebrow: '가장 알고 싶은 것',
      title: '리포트에서 <em>무엇을</em> 가장 알고 싶으세요?',
      options: [
        '다시 만날 수 있을지',
        '언제 연락해야 할지',
        '그 사람의 속마음',
        '내가 뭘 잘못했는지',
        '다시 만나도 잘 지낼 수 있을지',
      ],
    },
  ];
%>
<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  <style>
    :root {
      --accent: #ff5722;
      --text-dim: rgba(255, 255, 255, 0.45);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #000;
      color: #fff;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .stage {
      position: relative;
      max-width: 480px;
      min-height: 100dvh;
      margin: 0 auto;
      padding: 20px 24px calc(40px + env(safe-area-inset-bottom, 0px));
      background: #000;
      overflow-x: hidden;
    }

    .stage::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: 0;
      width: 140%;
      height: 52%;
      transform: translateX(-50%);
      background: radial-gradient(ellipse at center bottom, rgba(212, 155, 55, 0.28) 0%, rgba(120, 70, 20, 0.08) 38%, transparent 72%);
      pointer-events: none;
    }

    .stage-inner {
      position: relative;
      z-index: 1;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 44px;
      color: rgba(255, 255, 255, 0.88);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      letter-spacing: -0.02em;
      background: none;
      border: none;
      padding: 0;
      font-family: inherit;
      cursor: pointer;
    }

    .back-btn svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .form-header h1 {
      margin: 0 0 36px;
      font-size: clamp(28px, 7.5vw, 34px);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.04em;
      word-break: keep-all;   /* '알려주/세요'처럼 단어 중간에서 끊기지 않게 */
    }

    .form-header p {
      margin: 0 0 36px;
      font-size: 15px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.72);
      letter-spacing: -0.02em;
    }

    .form-header strong {
      color: var(--accent);
      font-weight: 800;
    }

    /* 재회사주는 두 사람 사주가 필요해 단계로 나눈다 (그 외 디자인은 연애사주와 동일) */
    .form-step { display: none; }
    .form-step.is-active { display: block; }

    /* 이별 정황 선택 단계 — 전역 .active 규칙을 피해 is-on을 쓴다 */
    .form-header em {
      font-style: normal;
      color: var(--accent);
    }

    .q-eyebrow {
      margin: 0 0 10px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: rgba(255, 255, 255, 0.45);
    }

    .q-options {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .q-opt {
      max-width: 100%;
      padding: 14px 22px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.06);
      color: rgba(255, 255, 255, 0.88);
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -0.02em;
      text-align: left;
      word-break: keep-all;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    /* ── 직접 작성 ── */
    .free-input {
      width: 100%;
      padding: 15px 16px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 14px;
      background: rgba(0, 0, 0, 0.28);
      color: #fff;
      font-family: inherit;
      font-size: 15.5px;
      line-height: 1.72;
      letter-spacing: -0.02em;
      resize: none;
      outline: none;
      transition: border-color 0.2s ease;
    }
    .free-input::placeholder { color: rgba(255, 255, 255, 0.32); line-height: 1.72; }
    .free-input:focus { border-color: rgba(255, 87, 34, 0.6); }

    .free-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-top: 10px;
    }
    .free-hint {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.42);
      letter-spacing: -0.02em;
      word-break: keep-all;
    }
    .free-count {
      flex: none;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.32);
      font-variant-numeric: tabular-nums;
    }
    .free-count b { color: rgba(255, 255, 255, 0.6); font-weight: 700; }

    .free-skip {
      display: block;
      margin: 26px auto 0;
      padding: 6px 4px;
      border: none;
      background: none;
      color: rgba(255, 255, 255, 0.4);
      font-family: inherit;
      font-size: 13px;
      letter-spacing: -0.02em;
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .q-opt.is-on {
      background: #fff;
      border-color: #fff;
      color: #111;
      font-weight: 800;
    }

    .name-input {
      width: 100%;
      margin-bottom: 8px;
      padding: 14px 0;
      border: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      background: transparent;
      color: #fff;
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
      outline: none;
    }

    .name-input::placeholder {
      color: var(--text-dim);
      font-weight: 500;
    }

    .name-input:focus {
      border-bottom-color: rgba(255, 255, 255, 0.35);
    }

    .form-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 22px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .form-row__label {
      flex: 1;
      min-width: 0;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #fff;
    }

    .form-row__input {
      flex: 1;
      min-width: 0;
      padding: 0;
      border: none;
      background: transparent;
      color: #fff;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.03em;
      outline: none;
    }

    .form-row__input::placeholder {
      color: rgba(255, 255, 255, 0.35);
    }

    .pill-group {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }

    .pill-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 58px;
      height: 34px;
      padding: 0 14px;
      border: none;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.42);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: -0.02em;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .pill-btn.active {
      background: #fff;
      color: #111;
    }

    .time-picker {
      position: relative;
      flex-shrink: 0;
    }

    .time-picker select {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
      color: #111;
      color-scheme: light;
    }

    .time-picker select option {
      color: #111;
      background-color: #fff;
    }

    .gender-row {
      display: flex;
      gap: 12px;
      margin-top: 36px;
    }

    .gender-btn {
      flex: 1;
      height: 54px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 999px;
      background: transparent;
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .gender-btn.active {
      background: #fff;
      border-color: #fff;
      color: #111;
    }

    /* 화면 하단 고정 대신 콘텐츠 바로 아래에 붙인다 (빈 여백 제거) */
    .submit-btn {
      display: block;
      width: 100%;
      margin: 40px 0 0;
      height: 54px;
      border: none;
      border-radius: 999px;
      background: #fff;
      color: #111;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    .submit-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0 1000px #000 inset;
      -webkit-text-fill-color: #fff;
      transition: background-color 5000s ease-in-out 0s;
    }

    /* ===== 로딩 오버레이 ===== */
    .loading-overlay {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: linear-gradient(180deg, #060101 0%, #090202 45%, #050000 100%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    .loading-overlay.is-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .loading-overlay::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, transparent 35%, rgba(0,0,0,0.75) 100%);
      pointer-events: none;
    }

    .loading-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 320px;
    }

    /* 깨진 하트가 다시 붙는 연출 */
    .heart-mend {
      width: min(46vw, 168px);
      margin-bottom: 26px;
      filter: drop-shadow(0 0 14px rgba(230, 45, 55, 0.4));
    }

    .heart-mend svg { display: block; width: 100%; height: auto; }

    .heart-mend__half {
      transform-box: fill-box;
      transform-origin: center;
    }
    .heart-mend__half--l { animation: mendLeft 3.4s cubic-bezier(0.34, 1.3, 0.4, 1) infinite; }
    .heart-mend__half--r { animation: mendRight 3.4s cubic-bezier(0.34, 1.3, 0.4, 1) infinite; }

    @keyframes mendLeft {
      0%           { transform: translate(-13px, 7px) rotate(-11deg); opacity: 0.5; }
      52%, 88%     { transform: translate(0, 0) rotate(0deg);         opacity: 1; }
      100%         { transform: translate(-13px, 7px) rotate(-11deg); opacity: 0.5; }
    }
    @keyframes mendRight {
      0%           { transform: translate(13px, 7px) rotate(11deg);   opacity: 0.5; }
      52%, 88%     { transform: translate(0, 0) rotate(0deg);         opacity: 1; }
      100%         { transform: translate(13px, 7px) rotate(11deg);   opacity: 0.5; }
    }

    /* 두 조각이 맞물리는 순간의 빛 */
    .heart-mend__spark {
      transform-box: fill-box;
      transform-origin: center;
      animation: mendSpark 3.4s ease-out infinite;
    }
    @keyframes mendSpark {
      0%, 44%  { opacity: 0; transform: scale(0.5); }
      56%      { opacity: 0.9; transform: scale(1.25); }
      72%, 100%{ opacity: 0; transform: scale(1.5); }
    }

    .loading-title {
      font-family: 'Noto Serif KR', serif;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: rgba(255, 255, 255, 0.88);
      text-align: center;
      min-height: 1.5em;
      transition: opacity 0.25s ease;
    }

    .loading-title.is-fading { opacity: 0; }

    .loading-sub {
      margin-top: 8px;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: rgba(243, 230, 200, 0.45);
      text-transform: uppercase;
    }

    .loading-bar {
      width: 160px;
      height: 2px;
      margin-top: 28px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    .loading-bar-fill {
      width: 40%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, transparent, #e6c27a, #ff6b9d, transparent);
      animation: barShimmer 4.5s ease-in-out infinite;
    }

    @keyframes barShimmer {
      0%   { transform: translateX(-120%); }
      100% { transform: translateX(320%); }
    }
  </style>
</head>

<body>

<div class="stage">
  <div class="stage-inner">

    <button type="button" id="backBtn" class="back-btn" aria-label="뒤로가기">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
      뒤로가기
    </button>

    <div id="loading" class="loading-overlay" aria-live="polite" aria-busy="false">
      <div class="loading-inner">
        <div class="heart-mend" aria-hidden="true">
          <svg viewBox="0 0 100 100" role="presentation">
            <defs>
              <linearGradient id="mendGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%"   stop-color="#ff8fb4"/>
                <stop offset="100%" stop-color="#e02b46"/>
              </linearGradient>
              <radialGradient id="sparkGrad">
                <stop offset="0%"   stop-color="#fff8e7" stop-opacity="0.95"/>
                <stop offset="100%" stop-color="#ffb0c6" stop-opacity="0"/>
              </radialGradient>
            </defs>

            <!-- 왼쪽 조각 -->
            <path class="heart-mend__half heart-mend__half--l" fill="url(#mendGrad)"
                  d="M50,88 C30,72 8,52 8,34 C8,20 22,11 34,17 C42,21 48,27 50,34 Z"/>
            <!-- 오른쪽 조각 -->
            <path class="heart-mend__half heart-mend__half--r" fill="url(#mendGrad)"
                  d="M50,88 C70,72 92,52 92,34 C92,20 78,11 66,17 C58,21 52,27 50,34 Z"/>

            <!-- 맞물리는 순간의 빛 -->
            <circle class="heart-mend__spark" cx="50" cy="52" r="17" fill="url(#sparkGrad)"/>
          </svg>
        </div>
        <p id="loading-title" class="loading-title">두 사람의 사주를 겹쳐 보고 있습니다</p>
        <p class="loading-sub">REUNION</p>
        <div class="loading-bar" aria-hidden="true">
          <div class="loading-bar-fill"></div>
        </div>
      </div>
    </div>

    <form id="sajuForm" method="POST" action="/saju/reunion/result">

      <!-- 이별 정황 3문항 — 리포트 조언의 근거가 된다 -->
      <% QUESTIONS.forEach(function (q, qi) { %>
      <div class="form-step<%= qi === 0 ? ' is-active' : '' %>" id="q<%= qi %>" data-question="<%= q.field %>">
        <input type="hidden" name="<%= q.field %>" id="<%= q.field %>Input">
        <div class="form-header">
          <p class="q-eyebrow"><%= q.eyebrow %></p>
          <h1><%- q.title %></h1>
        </div>
        <div class="q-options" role="radiogroup" aria-label="<%= q.eyebrow %>">
          <% q.options.forEach(function (opt) { %>
          <button type="button" class="q-opt" data-field="<%= q.field %>" data-value="<%= opt %>"><%= opt %></button>
          <% }); %>
        </div>
      </div>
      <% }); %>

      <!-- 직접 작성 — 리포트 전반에 반영된다 (GptService가 userInfo.worry를 프롬프트에 주입) -->
      <div class="form-step" id="qFree">
        <div class="form-header">
          <p class="q-eyebrow">직접 작성</p>
          <h1>이 리포트에서<br><em>어떤 걸</em> 알고 싶으신가요?</h1>
        </div>

        <textarea
          class="free-input"
          id="worryInput"
          name="worry"
          rows="6"
          maxlength="500"
          placeholder="예) 마지막에 심하게 다투고 헤어졌어요. 제가 먼저 연락하면 받아줄지, 아니면 기다리는 게 나을지 모르겠어요."></textarea>

        <div class="free-meta">
          <span class="free-hint">적어주신 내용은 리포트 전체에 반영됩니다</span>
          <span class="free-count"><b id="worryCount">0</b> / 500</span>
        </div>

        <button type="button" class="free-skip" id="worrySkip">잘 모르겠어요, 건너뛸게요</button>
      </div>

      <!-- 내 정보 -->
      <div class="form-step" id="step0">
        <div class="form-header">
          <h1>이름을 입력해주세요</h1>
        </div>

        <input type="hidden" name="gender" id="genderInput">
        <input type="hidden" name="birthType" id="birthTypeInput" value="양력">

        <input name="name" type="text" class="name-input" placeholder="홍길동" autocomplete="name">

        <div class="form-row">
          <span class="form-row__label" id="timeDisplay">시간모름</span>
          <div class="time-picker">
            <span class="pill-btn active" id="timePill">시간모름</span>
            <select name="birthTime" id="birthTimeSelect" aria-label="태어난 시">
              <option selected value="unknown">시간모름</option>
              <option value="00">조자/朝子 (00:00~01:29)</option>
              <option value="02">축/丑 (01:30~03:29)</option>
              <option value="04">인/寅 (03:30~05:29)</option>
              <option value="06">묘/卯 (05:30~07:29)</option>
              <option value="08">진/辰 (07:30~09:29)</option>
              <option value="10">사/巳 (09:30~11:29)</option>
              <option value="12">오/午 (11:30~13:29)</option>
              <option value="14">미/未 (13:30~15:29)</option>
              <option value="16">신/申 (15:30~17:29)</option>
              <option value="18">유/酉 (17:30~19:29)</option>
              <option value="20">술/戌 (19:30~21:29)</option>
              <option value="22">해/亥 (21:30~23:29)</option>
              <option value="24">야자/夜子 (23:30~23:59)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <input name="birthdate" id="birthdateInput" class="form-row__input" placeholder="2001.01.01" inputmode="numeric" maxlength="10" autocomplete="bday">
          <div class="pill-group" role="group" aria-label="양력/음력">
            <button type="button" class="pill-btn active" data-birth-type="양력" data-target="me">양력</button>
            <button type="button" class="pill-btn" data-birth-type="음력" data-target="me">음력</button>
          </div>
        </div>

        <div class="gender-row" id="genderRowMe" role="group" aria-label="성별">
          <button type="button" class="gender-btn active" data-gender="남성" data-target="me">남자</button>
          <button type="button" class="gender-btn" data-gender="여성" data-target="me">여자</button>
        </div>
      </div>

      <!-- 그 사람 정보 -->
      <div class="form-step" id="step1">
        <div class="form-header">
          <h1>그 사람 정보를<br>알려주세요</h1>
        </div>

        <input type="hidden" name="partnerGender" id="partnerGenderInput">
        <input type="hidden" name="partnerBirthType" id="partnerBirthTypeInput" value="양력">

        <input name="partnerName" type="text" class="name-input" placeholder="그 사람 이름" autocomplete="off">

        <div class="form-row">
          <span class="form-row__label" id="partnerTimeDisplay">시간모름</span>
          <div class="time-picker">
            <span class="pill-btn active" id="partnerTimePill">시간모름</span>
            <select name="partnerBirthTime" id="partnerBirthTimeSelect" aria-label="상대방 태어난 시">
              <option selected value="unknown">시간모름</option>
              <option value="00">조자/朝子 (00:00~01:29)</option>
              <option value="02">축/丑 (01:30~03:29)</option>
              <option value="04">인/寅 (03:30~05:29)</option>
              <option value="06">묘/卯 (05:30~07:29)</option>
              <option value="08">진/辰 (07:30~09:29)</option>
              <option value="10">사/巳 (09:30~11:29)</option>
              <option value="12">오/午 (11:30~13:29)</option>
              <option value="14">미/未 (13:30~15:29)</option>
              <option value="16">신/申 (15:30~17:29)</option>
              <option value="18">유/酉 (17:30~19:29)</option>
              <option value="20">술/戌 (19:30~21:29)</option>
              <option value="22">해/亥 (21:30~23:29)</option>
              <option value="24">야자/夜子 (23:30~23:59)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <input name="partnerBirthdate" id="partnerBirthdateInput" class="form-row__input" placeholder="2001.01.01" inputmode="numeric" maxlength="10">
          <div class="pill-group" role="group" aria-label="양력/음력">
            <button type="button" class="pill-btn active" data-birth-type="양력" data-target="partner">양력</button>
            <button type="button" class="pill-btn" data-birth-type="음력" data-target="partner">음력</button>
          </div>
        </div>

        <div class="gender-row" id="genderRowPartner" role="group" aria-label="상대방 성별">
          <button type="button" class="gender-btn active" data-gender="남성" data-target="partner">남자</button>
          <button type="button" class="gender-btn" data-gender="여성" data-target="partner">여자</button>
        </div>
      </div>

      <button type="button" id="submitBtn" class="submit-btn">다음으로</button>
    </form>
  </div>
</div>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const ticketCode = urlParams.get('ticket');

  const genderInput = document.getElementById('genderInput');
  const birthTypeInput = document.getElementById('birthTypeInput');
  const birthdateInput = document.getElementById('birthdateInput');
  const birthTimeSelect = document.getElementById('birthTimeSelect');
  const timeDisplay = document.getElementById('timeDisplay');
  const timePill = document.getElementById('timePill');

  const partnerGenderInput = document.getElementById('partnerGenderInput');
  const partnerBirthTypeInput = document.getElementById('partnerBirthTypeInput');
  const partnerBirthdateInput = document.getElementById('partnerBirthdateInput');
  const partnerBirthTimeSelect = document.getElementById('partnerBirthTimeSelect');
  const partnerTimeDisplay = document.getElementById('partnerTimeDisplay');
  const partnerTimePill = document.getElementById('partnerTimePill');

  const submitBtn = document.getElementById('submitBtn');

  genderInput.value = '남성';
  partnerGenderInput.value = '남성';

  document.querySelectorAll('.gender-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const target = btn.dataset.target;
      const rowId = target === 'me' ? 'genderRowMe' : 'genderRowPartner';
      document.querySelectorAll('#' + rowId + ' .gender-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      (target === 'me' ? genderInput : partnerGenderInput).value = btn.dataset.gender;
    });
  });

  document.querySelectorAll('[data-birth-type]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const target = btn.dataset.target;
      document.querySelectorAll('[data-birth-type][data-target="' + target + '"]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      (target === 'me' ? birthTypeInput : partnerBirthTypeInput).value = btn.dataset.birthType;
    });
  });

  window.setupBirthdateInput(birthdateInput);
  window.setupBirthdateInput(partnerBirthdateInput);

  function bindTimeDisplay(select, display, pill) {
    function update() {
      const label = select.options[select.selectedIndex].textContent.trim();
      display.textContent = label;
      pill.textContent = label.length > 8 ? '시간선택' : label;
    }
    select.addEventListener('change', update);
    update();
  }
  bindTimeDisplay(birthTimeSelect, timeDisplay, timePill);
  bindTimeDisplay(partnerBirthTimeSelect, partnerTimeDisplay, partnerTimePill);

  function shake(target) {
    target.animate(
      [
        { transform: 'translateX(0)' },
        { transform: 'translateX(-6px)' },
        { transform: 'translateX(6px)' },
        { transform: 'translateX(0)' }
      ],
      { duration: 300 }
    );
  }

  /* ── 이별 정황 선택 ── */
  document.querySelectorAll('.q-opt').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const field = btn.dataset.field;
      document.querySelectorAll('.q-opt[data-field="' + field + '"]').forEach(function (b) {
        b.classList.remove('is-on');
      });
      btn.classList.add('is-on');
      document.getElementById(field + 'Input').value = btn.dataset.value;
    });
  });

  /* ── 직접 작성 ── */
  (function () {
    const ta = document.getElementById('worryInput');
    const counter = document.getElementById('worryCount');
    const skip = document.getElementById('worrySkip');
    if (!ta) return;

    ta.addEventListener('input', function () {
      if (counter) counter.textContent = ta.value.length;
    });

    // 건너뛰기 — 비워둔 채 다음 단계로
    if (skip) {
      skip.addEventListener('click', function () {
        ta.value = '';
        if (counter) counter.textContent = '0';
        submitBtn.click();
      });
    }
  })();

  /* ── 단계 ── */
  const STEPS = ['q0', 'q1', 'q2', 'qFree', 'step0', 'step1'];
  let step = 0;

  function renderStep() {
    STEPS.forEach(function (id, i) {
      document.getElementById(id).classList.toggle('is-active', i === step);
    });
    submitBtn.textContent = step === STEPS.length - 1 ? '재회 확률 확인하기' : '다음으로';
    window.scrollTo({ top: 0 });
  }

  document.getElementById('backBtn').addEventListener('click', function () {
    if (step > 0) {
      step--;
      renderStep();
      return;
    }
    location.href = '/saju/reunion/intro';
  });

  function validateStep(nameSelector, dateEl, genderEl, genderRowId) {
    const nameEl = document.querySelector(nameSelector);
    if (!nameEl.value.trim()) {
      shake(nameEl);
      nameEl.focus();
      return false;
    }
    if (!/^\d{8}$/.test(dateEl.value.replace(/\D/g, ''))) {
      shake(dateEl);
      dateEl.focus();
      return false;
    }
    if (!genderEl.value) {
      shake(document.getElementById(genderRowId));
      return false;
    }
    return true;
  }

  /* ── 로딩 후 제출 ── */
  let isSubmitting = false;
  let loadingMsgTimer = null;
  const LOADING_MIN_MS = 4500;
  const loadingMessages = [
    '두 사람의 사주를 겹쳐 보고 있습니다',
    '일지의 합과 충을 대조하는 중…',
    '연락운이 열리는 날을 찾는 중…'
  ];
  let loadingMsgIndex = 0;

  function showLoadingOverlay() {
    const overlay = document.getElementById('loading');
    const title = document.getElementById('loading-title');

    loadingMsgIndex = 0;
    title.textContent = loadingMessages[0];
    title.classList.remove('is-fading');
    overlay.classList.add('is-visible');
    overlay.setAttribute('aria-busy', 'true');
    submitBtn.disabled = true;

    overlay.querySelectorAll('.heart-mend__half, .heart-mend__spark').forEach(function (el) {
      el.style.animation = 'none';
      void el.getBoundingClientRect();
      el.style.animation = '';
    });

    if (loadingMsgTimer) clearInterval(loadingMsgTimer);
    loadingMsgTimer = setInterval(function () {
      loadingMsgIndex = (loadingMsgIndex + 1) % loadingMessages.length;
      title.classList.add('is-fading');
      setTimeout(function () {
        title.textContent = loadingMessages[loadingMsgIndex];
        title.classList.remove('is-fading');
      }, 220);
    }, 2200);
  }

  function submitReunionForm() {
    if (isSubmitting) return;
    isSubmitting = true;
    showLoadingOverlay();

    setTimeout(function () {
      // 서버는 숫자 8자리만 파싱한다
      birthdateInput.value = birthdateInput.value.replace(/\D/g, '');
      partnerBirthdateInput.value = partnerBirthdateInput.value.replace(/\D/g, '');

      if (ticketCode) {
        const $form = $('#sajuForm');
        $form.find('input[name="ticket"]').remove();
        $('<input>', { type: 'hidden', name: 'ticket', value: ticketCode }).appendTo($form);
      }

      document.getElementById('sajuForm').submit();
    }, LOADING_MIN_MS);
  }

  function validateCurrentStep() {
    const id = STEPS[step];

    // 이별 정황 문항 — 하나는 골라야 넘어간다
    const stepEl = document.getElementById(id);
    const field = stepEl.dataset.question;
    if (field) {
      if (!document.getElementById(field + 'Input').value) {
        shake(stepEl.querySelector('.q-options'));
        return false;
      }
      return true;
    }

    // 직접 작성은 선택 입력 — 비워도 넘어간다
    if (id === 'qFree') return true;

    if (id === 'step0') {
      return validateStep("input[name='name']", birthdateInput, genderInput, 'genderRowMe');
    }
    if (id === 'step1') {
      return validateStep("input[name='partnerName']", partnerBirthdateInput, partnerGenderInput, 'genderRowPartner');
    }
    return true;
  }

  submitBtn.addEventListener('click', function () {
    if (!validateCurrentStep()) return;

    if (step < STEPS.length - 1) {
      step++;
      renderStep();
      return;
    }
    submitReunionForm();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && document.activeElement.tagName !== 'SELECT') {
      e.preventDefault();
      submitBtn.click();
    }
  });

  renderStep();
</script>

</body>
</html>
