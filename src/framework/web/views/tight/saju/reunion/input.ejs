<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<head>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  <style>
    :root {
      --accent: #ff5722;
      --text-dim: rgba(255, 255, 255, 0.45);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #000;
      color: #fff;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .stage {
      position: relative;
      max-width: 480px;
      min-height: 100dvh;
      margin: 0 auto;
      padding: 20px 24px calc(96px + env(safe-area-inset-bottom, 0px));
      background: #000;
      overflow-x: hidden;
    }

    .stage::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: 0;
      width: 140%;
      height: 52%;
      transform: translateX(-50%);
      background: radial-gradient(ellipse at center bottom, rgba(212, 155, 55, 0.28) 0%, rgba(120, 70, 20, 0.08) 38%, transparent 72%);
      pointer-events: none;
    }

    .stage-inner {
      position: relative;
      z-index: 1;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 44px;
      color: rgba(255, 255, 255, 0.88);
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      letter-spacing: -0.02em;
      background: none;
      border: none;
      padding: 0;
      font-family: inherit;
      cursor: pointer;
    }

    .back-btn svg {
      width: 18px;
      height: 18px;
      flex-shrink: 0;
    }

    .form-header h1 {
      margin: 0 0 36px;
      font-size: clamp(28px, 7.5vw, 34px);
      font-weight: 800;
      line-height: 1.25;
      letter-spacing: -0.04em;
    }

    .form-header p {
      margin: 0 0 36px;
      font-size: 15px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.72);
      letter-spacing: -0.02em;
    }

    .form-header strong {
      color: var(--accent);
      font-weight: 800;
    }

    /* 재회사주는 두 사람 사주가 필요해 단계로 나눈다 (그 외 디자인은 연애사주와 동일) */
    .form-step { display: none; }
    .form-step.is-active { display: block; }

    .name-input {
      width: 100%;
      margin-bottom: 8px;
      padding: 14px 0;
      border: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
      background: transparent;
      color: #fff;
      font-size: 22px;
      font-weight: 600;
      letter-spacing: -0.02em;
      outline: none;
    }

    .name-input::placeholder {
      color: var(--text-dim);
      font-weight: 500;
    }

    .name-input:focus {
      border-bottom-color: rgba(255, 255, 255, 0.35);
    }

    .form-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 22px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .form-row__label {
      flex: 1;
      min-width: 0;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.03em;
      color: #fff;
    }

    .form-row__input {
      flex: 1;
      min-width: 0;
      padding: 0;
      border: none;
      background: transparent;
      color: #fff;
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.03em;
      outline: none;
    }

    .form-row__input::placeholder {
      color: rgba(255, 255, 255, 0.35);
    }

    .pill-group {
      display: flex;
      gap: 8px;
      flex-shrink: 0;
    }

    .pill-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 58px;
      height: 34px;
      padding: 0 14px;
      border: none;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.42);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: -0.02em;
      cursor: pointer;
      transition: background 0.2s ease, color 0.2s ease;
    }

    .pill-btn.active {
      background: #fff;
      color: #111;
    }

    .time-picker {
      position: relative;
      flex-shrink: 0;
    }

    .time-picker select {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
      color: #111;
      color-scheme: light;
    }

    .time-picker select option {
      color: #111;
      background-color: #fff;
    }

    .gender-row {
      display: flex;
      gap: 12px;
      margin-top: 36px;
    }

    .gender-btn {
      flex: 1;
      height: 54px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 999px;
      background: transparent;
      color: #fff;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .gender-btn.active {
      background: #fff;
      border-color: #fff;
      color: #111;
    }

    .submit-btn {
      position: fixed;
      left: 50%;
      bottom: calc(20px + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      z-index: 10;
      width: calc(100% - 48px);
      max-width: 432px;
      height: 54px;
      border: none;
      border-radius: 999px;
      background: #fff;
      color: #111;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }

    .submit-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0 1000px #000 inset;
      -webkit-text-fill-color: #fff;
      transition: background-color 5000s ease-in-out 0s;
    }

    /* ===== 로딩 오버레이 ===== */
    .loading-overlay {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: linear-gradient(180deg, #060101 0%, #090202 45%, #050000 100%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    .loading-overlay.is-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .loading-overlay::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, transparent 35%, rgba(0,0,0,0.75) 100%);
      pointer-events: none;
    }

    .loading-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 320px;
    }

    .thread-visual {
      width: min(82vw, 300px);
      margin-bottom: 24px;
      position: relative;
    }

    .thread-img {
      display: block;
      width: 100%;
      height: auto;
      filter: drop-shadow(0 0 8px rgba(230, 45, 55, 0.35));
      -webkit-mask-image: linear-gradient(128deg, #000 42%, transparent 58%);
      mask-image: linear-gradient(128deg, #000 42%, transparent 58%);
      -webkit-mask-size: 260% 260%;
      mask-size: 260% 260%;
      -webkit-mask-position: 88% 8%;
      mask-position: 88% 8%;
      animation: threadReveal 4.5s ease-in-out forwards;
    }

    @keyframes threadReveal {
      0%   { -webkit-mask-position: 88% 8%;  mask-position: 88% 8%; }
      100% { -webkit-mask-position: 8% 92%; mask-position: 8% 92%; }
    }

    .loading-flower {
      font-size: 22px;
      line-height: 1;
      margin-bottom: 14px;
      animation: flowerFloat 2.2s ease-in-out infinite;
    }

    @keyframes flowerFloat {
      0%, 100% { transform: translateY(0) scale(1); opacity: 0.75; }
      50%      { transform: translateY(-4px) scale(1.06); opacity: 1; }
    }

    .loading-title {
      font-family: 'Noto Serif KR', serif;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: rgba(255, 255, 255, 0.88);
      text-align: center;
      min-height: 1.5em;
      transition: opacity 0.25s ease;
    }

    .loading-title.is-fading { opacity: 0; }

    .loading-sub {
      margin-top: 8px;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: rgba(243, 230, 200, 0.45);
      text-transform: uppercase;
    }

    .loading-bar {
      width: 160px;
      height: 2px;
      margin-top: 28px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    .loading-bar-fill {
      width: 40%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, transparent, #e6c27a, #ff6b9d, transparent);
      animation: barShimmer 4.5s ease-in-out infinite;
    }

    @keyframes barShimmer {
      0%   { transform: translateX(-120%); }
      100% { transform: translateX(320%); }
    }
  </style>
</head>

<body>

<div class="stage">
  <div class="stage-inner">

    <button type="button" id="backBtn" class="back-btn" aria-label="뒤로가기">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 18l-6-6 6-6"/>
      </svg>
      뒤로가기
    </button>

    <div class="form-header">
      <h1 id="formTitle">이름을 입력해주세요</h1>
    </div>

    <div id="loading" class="loading-overlay" aria-live="polite" aria-busy="false">
      <div class="loading-inner">
        <div class="loading-flower" aria-hidden="true">🌸</div>
        <div class="thread-visual" aria-hidden="true">
          <img class="thread-img" src="/assets/images/tight/romantic/loading/red-thread.png" alt="" width="300" height="188">
        </div>
        <p id="loading-title" class="loading-title">두 사람의 사주를 겹쳐 보고 있습니다</p>
        <p class="loading-sub">REUNION</p>
        <div class="loading-bar" aria-hidden="true">
          <div class="loading-bar-fill"></div>
        </div>
      </div>
    </div>

    <form id="sajuForm" method="POST" action="/saju/reunion/result">

      <!-- 1단계: 내 정보 -->
      <div class="form-step is-active" id="step0">
        <input type="hidden" name="gender" id="genderInput">
        <input type="hidden" name="birthType" id="birthTypeInput" value="양력">

        <input name="name" type="text" class="name-input" placeholder="홍길동" autocomplete="name">

        <div class="form-row">
          <span class="form-row__label" id="timeDisplay">시간모름</span>
          <div class="time-picker">
            <span class="pill-btn active" id="timePill">시간모름</span>
            <select name="birthTime" id="birthTimeSelect" aria-label="태어난 시">
              <option selected value="unknown">시간모름</option>
              <option value="00">조자/朝子 (00:00~01:29)</option>
              <option value="02">축/丑 (01:30~03:29)</option>
              <option value="04">인/寅 (03:30~05:29)</option>
              <option value="06">묘/卯 (05:30~07:29)</option>
              <option value="08">진/辰 (07:30~09:29)</option>
              <option value="10">사/巳 (09:30~11:29)</option>
              <option value="12">오/午 (11:30~13:29)</option>
              <option value="14">미/未 (13:30~15:29)</option>
              <option value="16">신/申 (15:30~17:29)</option>
              <option value="18">유/酉 (17:30~19:29)</option>
              <option value="20">술/戌 (19:30~21:29)</option>
              <option value="22">해/亥 (21:30~23:29)</option>
              <option value="24">야자/夜子 (23:30~23:59)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <input name="birthdate" id="birthdateInput" class="form-row__input" placeholder="2001.01.01" inputmode="numeric" maxlength="10" autocomplete="bday">
          <div class="pill-group" role="group" aria-label="양력/음력">
            <button type="button" class="pill-btn active" data-birth-type="양력" data-target="me">양력</button>
            <button type="button" class="pill-btn" data-birth-type="음력" data-target="me">음력</button>
          </div>
        </div>

        <div class="gender-row" id="genderRowMe" role="group" aria-label="성별">
          <button type="button" class="gender-btn active" data-gender="남성" data-target="me">남자</button>
          <button type="button" class="gender-btn" data-gender="여성" data-target="me">여자</button>
        </div>
      </div>

      <!-- 2단계: 그 사람 정보 -->
      <div class="form-step" id="step1">
        <input type="hidden" name="partnerGender" id="partnerGenderInput">
        <input type="hidden" name="partnerBirthType" id="partnerBirthTypeInput" value="양력">

        <input name="partnerName" type="text" class="name-input" placeholder="그 사람 이름" autocomplete="off">

        <div class="form-row">
          <span class="form-row__label" id="partnerTimeDisplay">시간모름</span>
          <div class="time-picker">
            <span class="pill-btn active" id="partnerTimePill">시간모름</span>
            <select name="partnerBirthTime" id="partnerBirthTimeSelect" aria-label="상대방 태어난 시">
              <option selected value="unknown">시간모름</option>
              <option value="00">조자/朝子 (00:00~01:29)</option>
              <option value="02">축/丑 (01:30~03:29)</option>
              <option value="04">인/寅 (03:30~05:29)</option>
              <option value="06">묘/卯 (05:30~07:29)</option>
              <option value="08">진/辰 (07:30~09:29)</option>
              <option value="10">사/巳 (09:30~11:29)</option>
              <option value="12">오/午 (11:30~13:29)</option>
              <option value="14">미/未 (13:30~15:29)</option>
              <option value="16">신/申 (15:30~17:29)</option>
              <option value="18">유/酉 (17:30~19:29)</option>
              <option value="20">술/戌 (19:30~21:29)</option>
              <option value="22">해/亥 (21:30~23:29)</option>
              <option value="24">야자/夜子 (23:30~23:59)</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <input name="partnerBirthdate" id="partnerBirthdateInput" class="form-row__input" placeholder="2001.01.01" inputmode="numeric" maxlength="10">
          <div class="pill-group" role="group" aria-label="양력/음력">
            <button type="button" class="pill-btn active" data-birth-type="양력" data-target="partner">양력</button>
            <button type="button" class="pill-btn" data-birth-type="음력" data-target="partner">음력</button>
          </div>
        </div>

        <div class="gender-row" id="genderRowPartner" role="group" aria-label="상대방 성별">
          <button type="button" class="gender-btn active" data-gender="남성" data-target="partner">남자</button>
          <button type="button" class="gender-btn" data-gender="여성" data-target="partner">여자</button>
        </div>
      </div>

      <button type="button" id="submitBtn" class="submit-btn">다음으로</button>
    </form>
  </div>
</div>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const ticketCode = urlParams.get('ticket');

  const genderInput = document.getElementById('genderInput');
  const birthTypeInput = document.getElementById('birthTypeInput');
  const birthdateInput = document.getElementById('birthdateInput');
  const birthTimeSelect = document.getElementById('birthTimeSelect');
  const timeDisplay = document.getElementById('timeDisplay');
  const timePill = document.getElementById('timePill');

  const partnerGenderInput = document.getElementById('partnerGenderInput');
  const partnerBirthTypeInput = document.getElementById('partnerBirthTypeInput');
  const partnerBirthdateInput = document.getElementById('partnerBirthdateInput');
  const partnerBirthTimeSelect = document.getElementById('partnerBirthTimeSelect');
  const partnerTimeDisplay = document.getElementById('partnerTimeDisplay');
  const partnerTimePill = document.getElementById('partnerTimePill');

  const submitBtn = document.getElementById('submitBtn');
  const formTitle = document.getElementById('formTitle');

  genderInput.value = '남성';
  partnerGenderInput.value = '남성';

  document.querySelectorAll('.gender-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const target = btn.dataset.target;
      const rowId = target === 'me' ? 'genderRowMe' : 'genderRowPartner';
      document.querySelectorAll('#' + rowId + ' .gender-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      (target === 'me' ? genderInput : partnerGenderInput).value = btn.dataset.gender;
    });
  });

  document.querySelectorAll('[data-birth-type]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const target = btn.dataset.target;
      document.querySelectorAll('[data-birth-type][data-target="' + target + '"]').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      (target === 'me' ? birthTypeInput : partnerBirthTypeInput).value = btn.dataset.birthType;
    });
  });

  window.setupBirthdateInput(birthdateInput);
  window.setupBirthdateInput(partnerBirthdateInput);

  function bindTimeDisplay(select, display, pill) {
    function update() {
      const label = select.options[select.selectedIndex].textContent.trim();
      display.textContent = label;
      pill.textContent = label.length > 8 ? '시간선택' : label;
    }
    select.addEventListener('change', update);
    update();
  }
  bindTimeDisplay(birthTimeSelect, timeDisplay, timePill);
  bindTimeDisplay(partnerBirthTimeSelect, partnerTimeDisplay, partnerTimePill);

  function shake(target) {
    target.animate(
      [
        { transform: 'translateX(0)' },
        { transform: 'translateX(-6px)' },
        { transform: 'translateX(6px)' },
        { transform: 'translateX(0)' }
      ],
      { duration: 300 }
    );
  }

  /* ── 단계 ── */
  let step = 0;

  function renderStep() {
    document.getElementById('step0').classList.toggle('is-active', step === 0);
    document.getElementById('step1').classList.toggle('is-active', step === 1);
    formTitle.textContent = step === 0 ? '이름을 입력해주세요' : '헤어진 그 사람의 정보를 알려주세요';
    submitBtn.textContent = step === 0 ? '다음으로' : '재회 확률 확인하기';
    window.scrollTo({ top: 0 });
  }

  document.getElementById('backBtn').addEventListener('click', function () {
    if (step === 1) {
      step = 0;
      renderStep();
      return;
    }
    location.href = '/saju/reunion/intro';
  });

  function validateStep(nameSelector, dateEl, genderEl, genderRowId) {
    const nameEl = document.querySelector(nameSelector);
    if (!nameEl.value.trim()) {
      shake(nameEl);
      nameEl.focus();
      return false;
    }
    if (!/^\d{8}$/.test(dateEl.value.replace(/\D/g, ''))) {
      shake(dateEl);
      dateEl.focus();
      return false;
    }
    if (!genderEl.value) {
      shake(document.getElementById(genderRowId));
      return false;
    }
    return true;
  }

  /* ── 로딩 후 제출 ── */
  let isSubmitting = false;
  let loadingMsgTimer = null;
  const LOADING_MIN_MS = 4500;
  const loadingMessages = [
    '두 사람의 사주를 겹쳐 보고 있습니다',
    '일지의 합과 충을 대조하는 중…',
    '연락운이 열리는 날을 찾는 중…'
  ];
  let loadingMsgIndex = 0;

  function showLoadingOverlay() {
    const overlay = document.getElementById('loading');
    const title = document.getElementById('loading-title');

    loadingMsgIndex = 0;
    title.textContent = loadingMessages[0];
    title.classList.remove('is-fading');
    overlay.classList.add('is-visible');
    overlay.setAttribute('aria-busy', 'true');
    submitBtn.disabled = true;

    const threadImg = overlay.querySelector('.thread-img');
    if (threadImg) {
      threadImg.style.animation = 'none';
      void threadImg.offsetWidth;
      threadImg.style.animation = '';
    }

    if (loadingMsgTimer) clearInterval(loadingMsgTimer);
    loadingMsgTimer = setInterval(function () {
      loadingMsgIndex = (loadingMsgIndex + 1) % loadingMessages.length;
      title.classList.add('is-fading');
      setTimeout(function () {
        title.textContent = loadingMessages[loadingMsgIndex];
        title.classList.remove('is-fading');
      }, 220);
    }, 2200);
  }

  function submitReunionForm() {
    if (isSubmitting) return;
    isSubmitting = true;
    showLoadingOverlay();

    setTimeout(function () {
      // 서버는 숫자 8자리만 파싱한다
      birthdateInput.value = birthdateInput.value.replace(/\D/g, '');
      partnerBirthdateInput.value = partnerBirthdateInput.value.replace(/\D/g, '');

      if (ticketCode) {
        const $form = $('#sajuForm');
        $form.find('input[name="ticket"]').remove();
        $('<input>', { type: 'hidden', name: 'ticket', value: ticketCode }).appendTo($form);
      }

      document.getElementById('sajuForm').submit();
    }, LOADING_MIN_MS);
  }

  submitBtn.addEventListener('click', function () {
    if (step === 0) {
      if (!validateStep("input[name='name']", birthdateInput, genderInput, 'genderRowMe')) return;
      step = 1;
      renderStep();
      return;
    }
    if (!validateStep("input[name='partnerName']", partnerBirthdateInput, partnerGenderInput, 'genderRowPartner')) return;
    submitReunionForm();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && document.activeElement.tagName !== 'SELECT') {
      e.preventDefault();
      submitBtn.click();
    }
  });

  renderStep();
</script>

</body>
</html>
