<%
/*
 * #4 재회 캘린더 — 접속한 달 하나만 보여준다.
 * 오늘부터 revealDays일까지만 라벨을 공개하고 나머지 날짜는 흐리게 잠근다.
 */
const cal = reunion.calendar;
const mo = cal.month;
const WD = ['일','월','화','수','목','금','토'];
%>
<div class="rs-cal" data-reveal>
  <% if (cal.nextGolden && !cal.nextGolden.locked) { %>
  <div class="rs-cal__dday">
    <div>
      <b><%= cal.ddayText %></b>
      <span> · 가장 먼저 열리는 골든타임</span>
    </div>
    <span><%= cal.nextGolden.date.replace(/-/g, '.') %></span>
  </div>
  <% } else { %>
  <div class="rs-cal__dday">
    <div>
      <b>🔒</b>
      <span> · 다음 골든타임은 리포트에서</span>
    </div>
    <span>이번 달 <%= cal.goldenCount %>일</span>
  </div>
  <% } %>

  <div class="rs-cal__month">
    <p class="rs-cal__mlabel"><%= mo.label %></p>
    <table class="rs-cal__grid">
      <thead>
        <tr><% WD.forEach(function (w) { %><th><%= w %></th><% }); %></tr>
      </thead>
      <tbody>
        <% mo.weeks.forEach(function (week) { %>
        <tr>
          <% week.forEach(function (cell) { %>
          <td>
            <% if (!cell) { %>
              <div class="rs-cal__cell"></div>
            <% } else if (cell.past) { %>
              <div class="rs-cal__cell"><%= cell.day %></div>
            <% } else { %>
              <div class="rs-cal__cell rs-cal__cell--in<%= cell.tone ? ' rs-cal__cell--' + cell.tone : '' %><%= cell.locked ? ' rs-cal__cell--locked' : '' %><%= cell.isToday ? ' rs-cal__cell--today' : '' %>"
                   <% if (!cell.locked) { %>title="<%= cell.ganji %><%= cell.labelText ? ' · ' + cell.labelText : '' %>"<% } %>>
                <%= cell.day %>
              </div>
            <% } %>
          </td>
          <% }); %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="rs-cal__legend">
    <% cal.legend.forEach(function (lg) { %>
    <div class="rs-cal__leg">
      <span class="rs-cal__dot rs-cal__dot--<%= lg.tone %>"></span>
      <%= lg.text %>
    </div>
    <% }); %>
  </div>

  <div class="rs-cal__lockbar">
    🔒 <%= cal.revealDays %>일 이후 <%= cal.lockedCount %>일의 연락운은 리포트에서 공개
  </div>
</div>
