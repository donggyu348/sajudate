<%
/* #4 재회 캘린더 — reunion.calendar (reunionSajuService.buildContactCalendar) */
const cal = reunion.calendar;
const WD = ['일','월','화','수','목','금','토'];
%>
<div class="rs-cal" data-reveal>
  <% if (cal.nextGolden) { %>
  <div class="rs-cal__dday">
    <div>
      <b><%= cal.ddayText %></b>
      <span> · 가장 먼저 열리는 골든타임</span>
    </div>
    <span><%= cal.nextGolden.date.replace(/-/g, '.') %> (<%= cal.nextGolden.ganjiHanja %>)</span>
  </div>
  <% } %>

  <% cal.months.forEach(function (mo) { %>
  <div class="rs-cal__month">
    <p class="rs-cal__mlabel"><%= mo.label %></p>
    <table class="rs-cal__grid">
      <thead>
        <tr><% WD.forEach(function (w) { %><th><%= w %></th><% }); %></tr>
      </thead>
      <tbody>
        <% mo.weeks.forEach(function (week) { %>
        <tr>
          <% week.forEach(function (cell) { %>
          <td>
            <% if (!cell) { %>
              <div class="rs-cal__cell"></div>
            <% } else if (cell.outOfRange) { %>
              <div class="rs-cal__cell"><%= cell.day %></div>
            <% } else { %>
              <div class="rs-cal__cell rs-cal__cell--in<%= cell.tone ? ' rs-cal__cell--' + cell.tone : '' %><%= cell.isToday ? ' rs-cal__cell--today' : '' %>"
                   title="<%= cell.ganji %><%= cell.labelText ? ' · ' + cell.labelText : '' %>">
                <%= cell.day %>
              </div>
            <% } %>
          </td>
          <% }); %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% }); %>

  <div class="rs-cal__legend">
    <% cal.legend.forEach(function (lg) { %>
    <div class="rs-cal__leg">
      <span class="rs-cal__dot rs-cal__dot--<%= lg.tone %>"></span>
      <%= lg.text %>
    </div>
    <% }); %>
  </div>
</div>
