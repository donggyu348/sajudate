<%
  // 재회사주 리포트 목차 — 장(章) + 풀이 구조 (상세페이지 하단용 파티셜)
  const rtocChapters = [
    {
      no: "1장",
      title: "상대의 속마음과 남은 인연",
      items: [
        { ko: "아직 남아 있는 인연", han: "情絲未斷", desc: "두 사람의 감정과 인연이 완전히 끝난 것인지 살펴봅니다." },
        { ko: "상대방의 현재 속마음", han: "彼心秘錄", desc: "지금 당신을 어떻게 생각하는지, 미련과 후회가 남아 있는지." },
        { ko: "상대가 연락하지 않는 이유", han: "無信之由", desc: "마음이 남아 있어도 연락하지 못하는 이유와 재회의 장애물." },
      ],
    },
    {
      no: "2장",
      title: "재회 가능성과 다가서는 법",
      items: [
        { ko: "재회 가능성과 시기", han: "月下復緣", desc: "다시 이어질 가능성과 연락·만남이 들어오는 시기." },
        { ko: "재회를 위한 행동", han: "回心之法", desc: "지금 연락해야 할지, 어떤 방식으로 다가서야 할지." },
      ],
    },
    {
      no: "3장",
      title: "재회 그 후, 그리고 새로운 인연",
      items: [
        { ko: "재회 후 관계의 미래", han: "再會終緣錄", desc: "다시 만난 뒤 오래 이어질지, 같은 이별이 반복될지." },
        { ko: "새로운 사람과의 운명", han: "新緣天命", desc: "새 인연이 들어오는 시기와 그 성향·관계의 가능성." },
        { ko: "두 사람의 최종 인연", han: "終緣之書", desc: "재회와 새 인연 중 어떤 선택이 더 좋은 미래로 이어지는지." },
      ],
    },
  ];
%>
<style>
  .rtoc {
    max-width: 430px; margin: 0 auto;
    padding: 48px 20px 40px; box-sizing: border-box;
    background: #050202; color: #f4ede5;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  }
  .rtoc-head { text-align: center; margin-bottom: 34px; }
  .rtoc-eyebrow { font-size: 11px; letter-spacing: 0.34em; color: #c99a45; margin: 0 0 14px; padding-left: 0.34em; }
  .rtoc-title { font-family: 'Noto Serif KR', serif; font-size: 23px; font-weight: 700; color: #fff; margin: 0 0 12px; letter-spacing: 0.01em; }
  .rtoc-sub { font-size: 13.5px; line-height: 1.8; color: #a79b90; margin: 0; word-break: keep-all; }

  .rtoc-ch { margin-bottom: 12px; }
  .rtoc-ch + .rtoc-ch { margin-top: 26px; }
  .rtoc-ch-no {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.06em;
    color: #fff3e6; background: linear-gradient(135deg, #8b1a1a, #b3261e);
    border: 1px solid rgba(224,184,102,0.5); border-radius: 14px; padding: 4px 13px;
  }
  .rtoc-ch-title {
    font-family: 'Noto Serif KR', serif; font-size: 20px; font-weight: 700;
    color: #fff; margin: 12px 0 6px; line-height: 1.4;
  }
  .rtoc-items { list-style: none; padding: 0; margin: 0; }
  .rtoc-item {
    display: flex; gap: 13px; align-items: flex-start;
    padding: 15px 2px; border-top: 1px solid rgba(201,154,69,0.16);
  }
  .rtoc-pn {
    flex: 0 0 auto; min-width: 38px; padding-top: 2px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.04em; color: #c99a45; opacity: 0.85;
  }
  .rtoc-it-title { font-size: 15px; font-weight: 600; color: #f4ede5; line-height: 1.4; }
  .rtoc-it-title .han { color: #e0b866; font-weight: 500; font-size: 13.5px; margin-left: 5px; letter-spacing: 0.02em; }
  .rtoc-it-desc { font-size: 12.5px; line-height: 1.6; color: #8f857b; margin-top: 6px; word-break: keep-all; }

  .rtoc-cta {
    margin-top: 38px; text-align: center;
    background: linear-gradient(180deg, rgba(179,38,30,0.10), rgba(18,10,10,0.55));
    border: 1px solid rgba(224,184,102,0.28); border-radius: 22px; padding: 28px 22px;
  }
  .rtoc-cta h3 { font-family: 'Noto Serif KR', serif; font-size: 18px; font-weight: 700; color: #fff; margin: 0 0 12px; line-height: 1.45; word-break: keep-all; }
  .rtoc-cta p { font-size: 13px; line-height: 1.8; color: #a79b90; margin: 0 0 20px; word-break: keep-all; }
  .rtoc-btn {
    display: block; width: 100%; box-sizing: border-box; padding: 17px 0; border-radius: 18px;
    border: 1px solid rgba(224,184,102,0.6);
    background: linear-gradient(135deg, #8b1a1a 0%, #b3261e 55%, #d9362b 100%);
    color: #fff7ea; font-size: 16.5px; font-weight: 700; letter-spacing: 0.03em;
    text-decoration: none; text-align: center;
    box-shadow: 0 0 22px rgba(179,38,30,0.5), inset 0 1px 0 rgba(255,255,255,0.12);
  }
</style>

<section class="rtoc">
  <div class="rtoc-head">
    <p class="rtoc-eyebrow">月下續緣錄</p>
    <h2 class="rtoc-title">재회 사주 리포트 목차</h2>
    <p class="rtoc-sub">두 사람의 인연 흐름을 장(章)별로<br>차례차례 풀어드립니다.</p>
  </div>

  <% rtocChapters.forEach(function (ch) { %>
    <div class="rtoc-ch">
      <span class="rtoc-ch-no"><%= ch.no %></span>
      <h3 class="rtoc-ch-title"><%= ch.title %></h3>
      <ul class="rtoc-items">
        <% ch.items.forEach(function (it, i) { %>
          <li class="rtoc-item">
            <span class="rtoc-pn">풀이 <%= i + 1 %></span>
            <div>
              <div class="rtoc-it-title"><%= it.ko %><span class="han">《<%= it.han %>》</span></div>
              <div class="rtoc-it-desc"><%= it.desc %></div>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  <% }); %>

  <% if (typeof showTocCta === 'undefined' ? true : showTocCta) { %>
  <div class="rtoc-cta">
    <h3>지금 두 사람의 인연 흐름을 확인해보세요</h3>
    <p>이별의 이유부터 상대의 현재 마음, 재회 가능성과<br>그 후의 미래까지 순서대로 확인할 수 있습니다.</p>
    <a href="/saju/reunion/input" class="rtoc-btn">재회 사주 확인하기</a>
  </div>
  <% } %>
</section>
