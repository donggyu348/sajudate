<%
/*
 * 회상 연출 — 배경(홀로 앉아 있는 컷)과 한 장면으로 묶인다.
 *
 * 스크롤을 내릴수록 --p(0→1)가 커지고,
 *   · 기억은 --gone 임계값 순서대로 하나씩 색이 빠지며 위로 흩어져 사라진다
 *   · 사라진 만큼 따뜻한 빛이 걷히고 차가운 어둠이 방을 채운다
 * 즉 "행복했던 기억이 빠져나가고 혼자 남는" 흐름이 스크롤과 함께 진행된다.
 *
 * 에셋: public/assets/images/tight/return/happy/1~3.png
 */
/*
 * 배경 인물은 화면 중앙(높이 38% 아래)에 있다.
 * 사진이 얼굴을 덮지 않도록 머리 위 빈 공간(상단 30% 이내)에만 가로로 늘어놓는다.
 */
const MEMORIES = [
  { n: 1, top: '4%', left: '2%',  w: '26%', rot: '-8deg', gone: 0.34, float: '0s'   },
  { n: 2, top: '2%', left: '36%', w: '25%', rot: '4deg',  gone: 0.58, float: '1.3s' },
  { n: 3, top: '5%', left: '69%', w: '26%', rot: '-4deg', gone: 0.82, float: '2.6s' },
];
%>
<!-- 기억이 남아 있는 동안 방에 도는 온기 -->
<div class="rs-warm" aria-hidden="true"></div>

<div class="rs-memories" aria-hidden="true">
  <% MEMORIES.forEach(function (m) { %>
  <figure class="rs-mem"
          style="top:<%= m.top %>; left:<%= m.left %>; width:<%= m.w %>; --rot:<%= m.rot %>; --gone:<%= m.gone %>;">
    <img src="/assets/images/tight/return/happy/<%= m.n %>.png" alt=""
         style="animation-delay:<%= m.float %>;"
         loading="lazy" decoding="async"
         onerror="this.closest('.rs-mem').remove()">
  </figure>
  <% }); %>
</div>

<!-- 기억이 빠져나간 자리에 내려앉는 냉기 -->
<div class="rs-cold" aria-hidden="true"></div>
