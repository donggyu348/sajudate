<%
/*
 * 회상 연출 — 함께 행복했던 순간들이 폴라로이드처럼 떠올랐다 흐려진다.
 * 에셋: public/assets/images/tight/return/happy/1~3.png
 *       (없으면 onerror로 조용히 사라지므로 배치 전에도 화면이 깨지지 않는다)
 */
/* 배경 인물이 가리지 않도록 상단 여백 쪽에만 모아 배치한다 */
const MEMORIES = [
  { n: 1, top: '5%',  left: '4%',  w: '33%', rot: '-7deg', delay: '0s'   },
  { n: 2, top: '9%',  left: '55%', w: '31%', rot: '6deg',  delay: '2.6s' },
  { n: 3, top: '19%', left: '27%', w: '32%', rot: '-3deg', delay: '5.2s' },
];
%>
<div class="rs-memories" aria-hidden="true">
  <% MEMORIES.forEach(function (m) { %>
  <figure class="rs-mem"
          style="top:<%= m.top %>; left:<%= m.left %>; width:<%= m.w %>; --rot:<%= m.rot %>; animation-delay:<%= m.delay %>;">
    <img src="/assets/images/tight/return/happy/<%= m.n %>.png" alt=""
         loading="lazy" decoding="async"
         onerror="this.closest('.rs-mem').remove()">
  </figure>
  <% }); %>
</div>
