<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  /* 실제 수집된 재회사주 후기 — 문구는 원문 그대로 */
  const REVIEWS = [
    { nick: 'j***',  when: '1시간 전',  text: '이별 후유증으로 이것저것 다 봐봤는데 여기 사주가 제일 정확했어요. 무엇보다 큰 위로가 됐고, 여기가 정답이라고 생각하기로 했습니다.' },
    { nick: 'dl***', when: '3시간 전',  text: '진짜 사주 맛집이에요.' },
    { nick: 's***',  when: '5시간 전',  text: '다른 데서는 짧게 끝나는 경우가 많았는데 여기는 정말 길게 써주시더라고요. 조언이랑 재회 타이밍까지 자세히 알려주셔서 좋았습니다.' },
    { nick: 'rn***', when: '9시간 전',  text: '스레드에서 본 저렴한 재회사주들이랑 비교가 안 될 정도로 자세했어요. 타이트하게 풀어주시니까 신뢰가 가더라고요.' },
    { nick: 'm***',  when: '14시간 전', text: '구체적으로 시기를 딱 집어주셔서 다른 업체들이랑 달랐어요. 읽으면서 납득이 가고 조금이나마 위로가 됐습니다.' },
    { nick: 'wl***', when: '1일 전',    text: '여기서 나온 대로만 되면 정말 좋겠어요. 아직 맞는지 모르지만 적어도 마음이 편해지긴 하더라고요.' },
    { nick: 'h***',  when: '2일 전',    text: '헤어진 지 한 달 정도 됐는데 재회사주 보고 나서 연락을 조금씩 해봤어요. 답장은 오는데 상대방도 생각이 많은 느낌이더라고요.' },
    { nick: 'sk***', when: '3일 전',    text: '간단한 안부만 묻고 있는데도 보고 싶은 마음이 커지네요. 아직 저에 대한 마음이 남아 있다고 하니 긍정적으로 보려 합니다.' },
    { nick: 'y***',  when: '4일 전',    text: '이별한 지 4개월 가까이 됐는데 계속 연락하고 우울하게 지냈어요. 리포트 보고 나서 처음으로 마음이 좀 정리됐습니다.' },
    { nick: 'ck***', when: '6일 전',    text: '그냥 사주만 봐주는 게 아니라 공감도 해주셔서 위로받는 느낌이었어요. 이제부터는 제 삶을 우선으로 살려고요.' },
    { nick: 'gy***', when: '1주 전',    text: '몸도 많이 빠지고 고생 심했는데 여기 리포트가 큰 도움이 됐어요. 하염없이 기다리기보다 멋있게 살아가기로 마음먹었습니다.' }
  ];
%>

<head>
  <style>
    /*
     * 리디바탕 — main.css의 전역 @font-face는 '/public/assets/fonts/...'를 가리켜 404(→302)가 난다.
     * express가 public을 루트로 서빙하므로 실제 경로는 '/assets/fonts/...'. 여기서 직접 선언한다.
     */
    @font-face {
      font-family: 'RIDIBatangIntro';
      src: url('/assets/fonts/RIDIBatang.woff') format('woff');
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --serif: 'RIDIBatangIntro', 'Noto Serif KR', 'Apple SD Gothic Neo', serif;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: #000;
    }

    /* DaisyUI(:root) 밝은테마 배경이 html을 덮어써 데스크톱에서 흰 여백이 생기는 것 방지 */
    html:root { background: #000; }
    body { min-height: 100dvh; }

    .page {
      max-width: 584px;
      margin: 0 auto;
      padding-bottom: 108px;
      background: #000;
    }

    /* ── 상단 바 ── */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .topbar__title {
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 3px;
    }
    .topbar__btn {
      position: absolute;
      top: 0;
      height: 52px;
      width: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .topbar__btn--back { left: 4px; }

    /* ── 히어로 (이미지 + 타이틀 오버레이) ── */
    .intro-hero {
      position: relative;
      width: 100%;
      background: #000;
      overflow: hidden;
    }

    .intro-hero__img {
      display: block;
      width: 100%;
      height: auto;
    }

    .intro-hero__gradient {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 62%;
      pointer-events: none;
      z-index: 1;
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.15) 35%,
        rgba(0, 0, 0, 0.55) 62%,
        rgba(0, 0, 0, 0.88) 84%,
        #000 100%
      );
    }

    /* 두 사람 사이 하늘 여백에 얹는 독백 */
    .intro-hero__whisper {
      position: absolute;
      left: 0;
      right: 0;
      top: 24%;
      z-index: 2;
      margin: 0;
      padding: 0 24px;
      text-align: center;
      font-family: var(--serif);
      font-size: clamp(23px, 6.4vw, 34px);
      font-weight: 400;
      line-height: 1.7;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.9);
      text-shadow:
        0 2px 20px rgba(0, 0, 0, 0.8),
        0 0 42px rgba(0, 0, 0, 0.55);
      pointer-events: none;
      opacity: 0;
      animation: whisperIn 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
    }

    @keyframes whisperIn {
      from { opacity: 0; transform: translateY(10px); filter: blur(3px); }
      to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
    }

    .intro-hero__title {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 26px;
      z-index: 2;
      padding: 0 24px;
      text-align: center;
      pointer-events: none;
      opacity: 0;
      animation: whisperIn 2.2s cubic-bezier(0.22, 1, 0.36, 1) 1.1s forwards;
    }

    .intro-hero__label {
      display: block;
      margin-bottom: 12px;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.32em;
      text-indent: 0.32em;
      color: rgba(180, 168, 255, 0.75);
    }

    .intro-hero__main {
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(29px, 8.6vw, 42px);
      font-weight: 400;
      color: #fff;
      letter-spacing: -0.01em;
      line-height: 1.4;
      text-shadow: 0 4px 26px rgba(0, 0, 0, 0.8);
    }

    /* ── 후기 ── */
    .reviews {
      padding: 22px 0 4px 16px;
    }
    .reviews__head {
      display: flex;
      align-items: center;
      gap: 7px;
      margin: 0 0 14px;
      padding-right: 16px;
    }
    .reviews__title {
      margin: 0;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .reviews__live {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 700;
      color: #8b7cff;
    }
    .reviews__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #8b7cff;
      box-shadow: 0 0 0 0 rgba(139, 124, 255, 0.6);
      animation: rvpulse 1.6s infinite;
    }
    @keyframes rvpulse {
      0%   { box-shadow: 0 0 0 0 rgba(139, 124, 255, 0.55); }
      70%  { box-shadow: 0 0 0 6px rgba(139, 124, 255, 0); }
      100% { box-shadow: 0 0 0 0 rgba(139, 124, 255, 0); }
    }

    .reviews__scroll {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding: 2px 16px 2px 0;
      margin: 0;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .reviews__scroll::-webkit-scrollbar { display: none; }

    .rv-card {
      flex: 0 0 78%;
      max-width: 300px;
      scroll-snap-align: start;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 14px;
      padding: 14px 15px 15px;
      display: flex;
      flex-direction: column;
      gap: 9px;
    }
    .rv-card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .rv-card__nick {
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 12px;
      font-weight: 700;
    }
    .rv-card__when {
      color: rgba(255, 255, 255, 0.38);
      font-size: 11px;
    }
    .rv-card__stars {
      color: #8b7cff;
      font-size: 11px;
      letter-spacing: 1px;
    }
    .rv-card__text {
      margin: 0;
      color: rgba(255, 255, 255, 0.82);
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 12.5px;
      line-height: 1.55;
      letter-spacing: -0.01em;
      word-break: keep-all;
    }

    /* ── 고정 CTA ── */
    .fixed-cta {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 584px;
      z-index: 100;
      padding: 16px 20px;
      padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      background: linear-gradient(to top, #000 72%, rgba(0, 0, 0, 0));
    }

    /* 재회사주는 연애·29금(핑크) 계열과 구분되도록 바이올렛 */
    .cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      height: 56px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #6a5af9 0%, #4d3ddb 100%);
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-decoration: none;
      cursor: pointer;
      box-shadow:
        0 6px 20px rgba(0, 0, 0, 0.45),
        0 2px 10px rgba(106, 90, 249, 0.42);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .cta-btn:active {
      transform: scale(0.98);
      box-shadow:
        0 3px 12px rgba(0, 0, 0, 0.4),
        0 1px 6px rgba(106, 90, 249, 0.35);
    }

    .cta-btn__arrow {
      font-size: 1.12em;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.05em;
      margin-left: 2px;
    }

    .cta-btn__text {
      line-height: 1;
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="topbar">
      <button type="button" class="topbar__btn topbar__btn--back" aria-label="뒤로" onclick="history.back()">&#8249;</button>
      <span class="topbar__title">월하점</span>
    </div>

    <div class="intro-hero">
      <img
        class="intro-hero__img"
        src="/assets/images/tight/return/intro.png"
        alt="재회사주 — 헤어진 그 사람과 다시 만날 확률"
        width="584"
        loading="eager"
        decoding="async"
      >
      <div class="intro-hero__gradient" aria-hidden="true"></div>

      <p class="intro-hero__whisper">우리, 많이 사랑했잖아…</p>

      <div class="intro-hero__title">
        <span class="intro-hero__label">재회사주</span>
        <h1 class="intro-hero__main">다시 만날 수 있을까?</h1>
      </div>
    </div>

    <section class="reviews">
      <div class="reviews__head">
        <h2 class="reviews__title">방금 올라온 후기</h2>
        <span class="reviews__live"><span class="reviews__dot"></span>실시간</span>
      </div>

      <div class="reviews__scroll">
        <% REVIEWS.forEach(function (r) { %>
        <article class="rv-card">
          <div class="rv-card__head">
            <span class="rv-card__nick"><%= r.nick %></span>
            <span class="rv-card__when"><%= r.when %></span>
          </div>
          <span class="rv-card__stars" aria-label="5점">★★★★★</span>
          <p class="rv-card__text"><%= r.text %></p>
        </article>
        <% }); %>
      </div>
    </section>
  </div>

  <div class="fixed-cta">
    <a href="/saju/reunion/input" class="cta-btn">
      <span class="cta-btn__text">재회 가능성 바로 확인하기</span>
      <span class="cta-btn__arrow" aria-hidden="true">--></span>
    </a>
  </div>

  <script>
    $(document).ready(function(){
      if(window.karrotPixel) window.karrotPixel.track('ViewContent');
    });
  </script>
</body>
</html>
