<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  /* 실제 수집된 재회사주 후기 — 문구는 원문 그대로 */
  const REVIEWS = [
    {
      nick: 'j***', when: '3시간 전',
      text: '이별 후유증 때문에 이사주부터 저사주, 웹툰사주, 타로까지 이것저것 다 봐보면서 돈을 진짜 많이 날렸거든요. 그중에서 여기 사주가 제일 정확하게 맞았고, 무엇보다 가장 큰 위로가 됐어요. 다른 곳에서 본 사주풀이랑 갑신신 같은 부분이 조금 달랐는데, 어디가 진짜인지 알 수가 없으니까 저는 그냥 위로받은 여기가 정답이라고 생각하기로 했어요. 여기 진짜 사주 맛집입니다.'
    },
    {
      nick: 's***', when: '9시간 전',
      text: '솔직히 스레드에서 1인 2만원짜리 재회운도 봤고, 2인 1만4천원짜리 재회사주도 봤는데… 여기 타이트 사주가 진짜 길게, 비교가 안 될 정도로 자세하게 써줬어요. 조언도 많이 해주시고, 재회하기 좋은 타이밍까지 알려주시니까 너무 좋더라고요.'
    },
    {
      nick: 'm***', when: '1일 전',
      text: '너무 좋았어요. 조금이나마 위로가 되기도 하고요. 다른 사주 업체들이랑 다르게 구체적으로 시기를 딱 집어줘서 그게 제일 마음에 들었어요. 여기서 나온 대로만 되면 진짜 좋겠어요… 맞을지 안 맞을지는 아직 모르겠지만, 적어도 읽으면서 납득이 가긴 하더라고요.'
    },
    {
      nick: 'h***', when: '3일 전',
      text: '재회사주 보고 나니까 마음이 좀 편해진 것 같아요. 헤어진 지 한 달 조금 넘었는데, 얼마 전부터 조금씩 연락을 보냈어요. 답장은 계속 오긴 하는데, 상대방도 제 연락에 대해 많이 생각하는 느낌이더라고요. 제 착각일 수도 있지만요. 제 연락이 너무 성급했을 수도 있다는 생각도 들지만, 그냥 간단한 안부만 묻고 있거든요. 그런데도 점점 더 보고 싶은 마음이 커지네요. 그래도 아직 상대방 마음속에 제가 남아 있다고 하니까, 긍정적으로 바라보려고 해요.'
    },
    {
      nick: 'y***', when: '6일 전',
      text: '이별한 지 한 4개월 정도 됐는데, 이별을 받아들이지 못해서 계속 상대방한테 연락하고 우울감에 빠져 지냈어요. 몸무게도 많이 빠지고 마음고생이 심했는데, 재회사주 리포트 보고 나서 마음이 한결 편안해졌어요. 그냥 사주만 봐주는 게 아니라 제가 적어둔 내용들을 바탕으로 공감도 해주셔서 위로받는 느낌이 들더라고요. 리포트 보고 처음으로 정리가 됐어요. 이제부터는 그 사람 연락을 하염없이 기다리는 대신, 제 삶을 우선으로 멋있게 살아가려고요.'
    }
  ];
%>

<head>
  <style>
    /*
     * 리디바탕 — main.css의 전역 @font-face는 '/public/assets/fonts/...'를 가리켜 404(→302)가 난다.
     * express가 public을 루트로 서빙하므로 실제 경로는 '/assets/fonts/...'. 여기서 직접 선언한다.
     */
    @font-face {
      font-family: 'RIDIBatangIntro';
      src: url('/assets/fonts/RIDIBatang.woff') format('woff');
      font-weight: normal;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --serif: 'RIDIBatangIntro', 'Noto Serif KR', 'Apple SD Gothic Neo', serif;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: #000;
    }

    /* DaisyUI(:root) 밝은테마 배경이 html을 덮어써 데스크톱에서 흰 여백이 생기는 것 방지 */
    html:root { background: #000; }
    body { min-height: 100dvh; }

    .page {
      max-width: 584px;
      margin: 0 auto;
      padding-bottom: 108px;
      background: #000;
    }

    /* ── 상단 바 ── */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.55);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    .topbar__title {
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 3px;
    }
    .topbar__btn {
      position: absolute;
      top: 0;
      height: 52px;
      width: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      color: #fff;
      font-size: 20px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .topbar__btn--back { left: 4px; }

    /* ── 히어로 (이미지 + 타이틀 오버레이) ── */
    .intro-hero {
      position: relative;
      width: 100%;
      background: #000;
      overflow: hidden;
    }

    .intro-hero__img {
      display: block;
      width: 100%;
      height: auto;
    }

    .intro-hero__gradient {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 62%;
      pointer-events: none;
      z-index: 1;
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0) 0%,
        rgba(0, 0, 0, 0.15) 35%,
        rgba(0, 0, 0, 0.55) 62%,
        rgba(0, 0, 0, 0.88) 84%,
        #000 100%
      );
    }

    /* 두 사람 사이 하늘 여백에 얹는 독백 */
    .intro-hero__whisper {
      position: absolute;
      left: 0;
      right: 0;
      top: 24%;
      z-index: 2;
      margin: 0;
      padding: 0 24px;
      text-align: center;
      font-family: var(--serif);
      font-size: clamp(17px, 4.7vw, 25px);
      font-weight: 400;
      line-height: 1.85;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.9);
      text-shadow:
        0 2px 20px rgba(0, 0, 0, 0.8),
        0 0 42px rgba(0, 0, 0, 0.55);
      pointer-events: none;
      opacity: 0;
      animation: whisperIn 2.4s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
    }

    @keyframes whisperIn {
      from { opacity: 0; transform: translateY(10px); filter: blur(3px); }
      to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
    }

    .intro-hero__title {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 26px;
      z-index: 2;
      padding: 0 24px;
      text-align: center;
      pointer-events: none;
      opacity: 0;
      animation: whisperIn 2.2s cubic-bezier(0.22, 1, 0.36, 1) 1.1s forwards;
    }

    .intro-hero__label {
      display: block;
      margin-bottom: 12px;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.32em;
      text-indent: 0.32em;
      color: rgba(180, 168, 255, 0.75);
    }

    .intro-hero__main {
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(29px, 8.6vw, 42px);
      font-weight: 400;
      color: #fff;
      letter-spacing: -0.01em;
      line-height: 1.4;
      text-shadow: 0 4px 26px rgba(0, 0, 0, 0.8);
    }

    /* ── 후기 ── */
    .reviews {
      padding: 22px 0 4px 16px;
    }
    .reviews__head {
      display: flex;
      align-items: center;
      gap: 7px;
      margin: 0 0 14px;
      padding-right: 16px;
    }
    .reviews__title {
      margin: 0;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
    }
    .reviews__live {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 700;
      color: #8b7cff;
    }
    .reviews__dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #8b7cff;
      box-shadow: 0 0 0 0 rgba(139, 124, 255, 0.6);
      animation: rvpulse 1.6s infinite;
    }
    @keyframes rvpulse {
      0%   { box-shadow: 0 0 0 0 rgba(139, 124, 255, 0.55); }
      70%  { box-shadow: 0 0 0 6px rgba(139, 124, 255, 0); }
      100% { box-shadow: 0 0 0 0 rgba(139, 124, 255, 0); }
    }

    .reviews__scroll {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      padding: 2px 16px 2px 0;
      margin: 0;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .reviews__scroll::-webkit-scrollbar { display: none; }

    .rv-card {
      flex: 0 0 78%;
      max-width: 300px;
      scroll-snap-align: start;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.07);
      border-radius: 14px;
      padding: 14px 15px 15px;
      display: flex;
      flex-direction: column;
      gap: 9px;
    }
    .rv-card__head {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .rv-card__nick {
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 12px;
      font-weight: 700;
    }
    .rv-card__when {
      color: rgba(255, 255, 255, 0.38);
      font-size: 11px;
    }
    .rv-card__stars {
      color: #8b7cff;
      font-size: 11px;
      letter-spacing: 1px;
    }
    .rv-card__text {
      margin: 0;
      color: rgba(255, 255, 255, 0.82);
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 12.5px;
      line-height: 1.55;
      letter-spacing: -0.01em;
      word-break: keep-all;
    }

    /* ── 고정 CTA ── */
    .fixed-cta {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 584px;
      z-index: 100;
      padding: 16px 20px;
      padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      background: linear-gradient(to top, #000 72%, rgba(0, 0, 0, 0));
    }

    /* 재회사주는 연애·29금(핑크) 계열과 구분되도록 바이올렛 */
    .cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      height: 56px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #6a5af9 0%, #4d3ddb 100%);
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-decoration: none;
      cursor: pointer;
      box-shadow:
        0 6px 20px rgba(0, 0, 0, 0.45),
        0 2px 10px rgba(106, 90, 249, 0.42);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .cta-btn:active {
      transform: scale(0.98);
      box-shadow:
        0 3px 12px rgba(0, 0, 0, 0.4),
        0 1px 6px rgba(106, 90, 249, 0.35);
    }

    .cta-btn__arrow {
      font-size: 1.12em;
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.05em;
      margin-left: 2px;
    }

    .cta-btn__text {
      line-height: 1;
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="topbar">
      <button type="button" class="topbar__btn topbar__btn--back" aria-label="뒤로" onclick="history.back()">&#8249;</button>
      <span class="topbar__title">월하점</span>
    </div>

    <div class="intro-hero">
      <img
        class="intro-hero__img"
        src="/assets/images/tight/return/intro.png"
        alt="재회사주 — 헤어진 그 사람과 다시 만날 확률"
        width="584"
        loading="eager"
        decoding="async"
      >
      <div class="intro-hero__gradient" aria-hidden="true"></div>

      <p class="intro-hero__whisper">우리, 많이 사랑했잖아…</p>

      <div class="intro-hero__title">
        <span class="intro-hero__label">재회사주</span>
        <h1 class="intro-hero__main">다시 만날 수 있을까?</h1>
      </div>
    </div>

    <section class="reviews">
      <div class="reviews__head">
        <h2 class="reviews__title">방금 올라온 후기</h2>
        <span class="reviews__live"><span class="reviews__dot"></span>실시간</span>
      </div>

      <div class="reviews__scroll">
        <% REVIEWS.forEach(function (r) { %>
        <article class="rv-card">
          <div class="rv-card__head">
            <span class="rv-card__nick"><%= r.nick %></span>
            <span class="rv-card__when"><%= r.when %></span>
          </div>
          <span class="rv-card__stars" aria-label="5점">★★★★★</span>
          <p class="rv-card__text"><%= r.text %></p>
        </article>
        <% }); %>
      </div>
    </section>
  </div>

  <div class="fixed-cta">
    <a href="/saju/reunion/input" class="cta-btn">
      <span class="cta-btn__text">재회 가능성 바로 확인하기</span>
      <span class="cta-btn__arrow" aria-hidden="true">--></span>
    </a>
  </div>

  <script>
    $(document).ready(function(){
      if(window.karrotPixel) window.karrotPixel.track('ViewContent');
    });
  </script>
</body>
</html>
