<%
/* 재회사주 9섹션 랜딩 스타일 — result.ejs <head>에서 한 번만 include */
%>
<style>
  * { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    background: #100c14;
    color: #ece7f0;
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
    -webkit-tap-highlight-color: transparent;
  }

  .page {
    max-width: 393px;
    margin: 0 auto;
    padding-bottom: 104px;
    overflow-x: hidden;
  }

  /* ── 섹션 공통 ── */
  .rs {
    position: relative;
    width: 100%;
  }
  .rs--ui {
    padding: 40px 20px;
  }
  .rs--scene {
    min-height: 78vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 18px 34px;
    /* 이미지 미배치 상태 폴백 — 교체 시에도 그대로 아래에 깔린다 */
    background:
      radial-gradient(120% 70% at 50% 12%, rgba(90, 40, 80, 0.5) 0%, rgba(16, 12, 20, 0.95) 62%),
      linear-gradient(180deg, #17101c 0%, #100c14 100%);
    background-size: cover;
    background-position: center;
  }
  /* 한 섹션 안에 배경컷을 여러 장 쌓을 때 (#2 공감 2컷) */
  .rs-cut {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 66vh;
    padding: 0 18px 30px;
    overflow: hidden;
    background:
      radial-gradient(120% 70% at 50% 12%, rgba(90, 40, 80, 0.5) 0%, rgba(16, 12, 20, 0.95) 62%),
      linear-gradient(180deg, #17101c 0%, #100c14 100%);
  }

  .rs__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* 상하 블랙 페이드 */
  .rs__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg,
      rgba(16,12,20,0.92) 0%, rgba(16,12,20,0.28) 26%,
      rgba(16,12,20,0.42) 62%, rgba(16,12,20,0.96) 100%);
  }
  .rs__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .rs__eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #e37fb0;
    text-transform: uppercase;
  }
  .rs__title {
    margin: 0 0 18px;
    font-size: 21px;
    font-weight: 800;
    line-height: 1.42;
    letter-spacing: -0.03em;
    word-break: keep-all;
  }
  .rs__sub {
    margin: -8px 0 20px;
    font-size: 14px;
    line-height: 1.6;
    color: #a79fb2;
    word-break: keep-all;
  }

  /* ── #1 훅 — 위(확률) · 아래(카톡) · 맨아래(스크롤) 3단 ── */
  .rs--hook {
    min-height: 76vh;
    justify-content: stretch;
    padding-top: 88px;   /* 확률 블록을 화면 상단에서 조금 내린다 */
    padding-bottom: 22px;
  }
  .rs-hook {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: inherit;
  }
  .rs-hook__top { text-align: center; }

  /* "{나}님과 {상대}님의" */
  .rs-hook__who {
    margin: 0 0 9px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.72);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.8);
  }
  .rs-hook__label {
    margin: 0 0 10px;
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.8);
  }
  .rs-hook__num {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 2px;
    margin: 0;
    font-size: clamp(92px, 28vw, 126px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    color: #fff;
    text-shadow: 0 0 34px rgba(233, 30, 122, 0.55), 0 6px 24px rgba(0, 0, 0, 0.7);
  }
  .rs-hook__num small {
    font-size: clamp(34px, 10vw, 46px);
    font-weight: 800;
    color: #f18ab8;
  }

  /* 위아래 auto — 카톡은 확률과 스크롤 사이 중간쯤에, 스크롤은 맨 아래로 */
  .rs-hook .kt {
    margin-top: auto;
    margin-bottom: auto;
  }

  .rs-hook__scroll {
    margin: 0 auto;
    width: 22px;
    height: 34px;
    border: 1.5px solid rgba(255,255,255,0.35);
    border-radius: 12px;
    position: relative;
    flex: none;
  }
  .rs-hook__scroll::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 7px;
    width: 3px;
    height: 6px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: #fff;
    animation: rsScroll 1.5s ease-in-out infinite;
  }
  @keyframes rsScroll { 0%{opacity:0;transform:translateY(0)} 40%{opacity:1} 100%{opacity:0;transform:translateY(12px)} }

  /*
   * 리디바탕 — main.css의 전역 @font-face가 '/public/assets/fonts/...'라 302로 튕긴다.
   * express가 public을 루트로 서빙하므로 실제 경로는 '/assets/fonts/...'.
   */
  @font-face {
    font-family: 'RIDIBatangRs';
    src: url('/assets/fonts/RIDIBatang.woff') format('woff');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* ── 씬 위에 얹는 문장 (말풍선 대신) ── */
  .rs-lines {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .rs-line {
    margin: 0;
    font-family: 'RIDIBatangRs', 'Noto Serif KR', 'Apple SD Gothic Neo', serif;
    font-size: clamp(20px, 5.6vw, 27px);
    font-weight: 400;
    line-height: 1.72;
    letter-spacing: -0.01em;
    color: rgba(255, 255, 255, 0.95);
    word-break: keep-all;
    text-shadow:
      0 2px 18px rgba(0, 0, 0, 0.85),
      0 0 44px rgba(0, 0, 0, 0.6);

    opacity: 0;
    transform: translateY(14px);
    filter: blur(4px);
    transition: opacity 0.9s ease, transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.9s ease;
  }
  .rs-line.is-in { opacity: 1; transform: translateY(0); filter: blur(0); }

  .rs-line--sm {
    font-size: clamp(15px, 4.1vw, 18px);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.68);
  }

  .rs-line--warn { color: #ff9d92; }

  .rs-line--center { text-align: center; }
  .rs-line--right  { text-align: right; }

  .rs-line strong {
    font-weight: 400;
    color: #ff9dc6;
  }

  /* ── 문장 안 핵심 단어 강조 ──
     문장을 늘리는 대신 결정적인 단어에만 색을 준다. 한 문장에 하나만. */
  .rs-hl {
    color: #ff8ec0;
    font-weight: 500;
    text-shadow:
      0 2px 18px rgba(0, 0, 0, 0.85),
      0 0 26px rgba(233, 30, 122, 0.45);
  }

  /* 경고 단어 */
  .rs-hl--warn {
    color: #ff7a6e;
    text-shadow:
      0 2px 18px rgba(0, 0, 0, 0.85),
      0 0 26px rgba(255, 92, 92, 0.42);
  }

  /* 밑줄로 한 번 더 눌러주는 변형 */
  .rs-hl--line {
    background-image: linear-gradient(transparent 62%, rgba(233, 30, 122, 0.32) 62%);
    background-repeat: no-repeat;
    padding: 0 2px;
  }

  /* 블러 키워드 (#3) */
  .rs-blur {
    display: inline-block;
    padding: 1px 12px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.12);
    color: transparent;
    text-shadow: 0 0 12px rgba(255, 236, 236, 0.95);
    user-select: none;
  }

  /* ── 회상 — 시간이 흐르며 기억이 잊히고 방이 차가워진다 ── */
  /* --p: 0(기억이 선명) → 1(모두 잊힘). 씬이 눈에 들어오면 JS가 시간에 따라 흘려보낸다 */
  .rs-cut { --p: 0; }

  /* 기억이 빠져나갈수록 배경(혼자 앉아 있는 컷)도 온기를 잃는다 */
  .rs-cut--memory .rs__bg {
    filter:
      saturate(calc(1 - var(--p) * 0.4))
      brightness(calc(1.08 - var(--p) * 0.26));
    transform: scale(calc(1 + var(--p) * 0.035));
  }

  .rs-memories {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  /* 기억이 남아 있는 동안만 도는 온기 — 사라질수록 함께 걷힌다 */
  .rs-warm {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(66% 42% at 50% 22%, rgba(255, 198, 132, 0.34) 0%, transparent 72%),
      radial-gradient(40% 30% at 22% 12%, rgba(255, 176, 120, 0.2) 0%, transparent 70%);
    opacity: clamp(0, calc((1 - var(--p)) * 1.15), 1);
    mix-blend-mode: screen;
  }

  /* 기억이 빠져나간 자리를 채우는 냉기 */
  .rs-cold {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(90% 70% at 50% 60%, transparent 0%, rgba(8, 10, 24, 0.72) 100%),
      linear-gradient(180deg, rgba(10, 14, 32, 0.5) 0%, rgba(6, 8, 20, 0.72) 100%);
    opacity: clamp(0, calc(var(--p) * 1.25 - 0.12), 1);
  }

  .rs-mem {
    position: absolute;
    margin: 0;
    padding: 0;
    /* 사진이 작아졌으므로 폴라로이드 테두리도 함께 얇게 */
    border: 4px solid #f4ece0;
    border-bottom-width: 13px;
    border-radius: 2px;
    background: #f4ece0;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.6);

    /* --gone 임계값에 다다르면 그 기억부터 색이 빠지며 위로 흩어진다 */
    opacity: clamp(0, calc((var(--gone) - var(--p)) / 0.16), 1);
    transform:
      rotate(var(--rot))
      translateY(calc(var(--p) * -72px))
      scale(calc(1 - var(--p) * 0.08));
    filter:
      sepia(0.18)
      saturate(calc(1 - var(--p) * 0.85))
      brightness(calc(1.04 + var(--p) * 0.16))
      blur(calc(var(--p) * 5px));
  }

  /* 사진 자체는 아주 느리게 숨 쉰다 (스크롤을 멈춰도 정지 화면이 되지 않게) */
  .rs-mem img {
    display: block;
    width: 100%;
    height: auto;
    animation: memBreathe 5.6s ease-in-out infinite;
  }
  @keyframes memBreathe {
    0%, 100% { transform: translateY(0)   scale(1); }
    50%      { transform: translateY(-5px) scale(1.012); }
  }

  @media (prefers-reduced-motion: reduce) {
    .rs-mem img { animation: none; }
  }

  /* ── 잠금(티저) 처리 ── */
  .rs-locked { position: relative; overflow: hidden; border-radius: 14px; }
  .rs-locked__body {
    filter: blur(7px);
    opacity: 0.72;
    user-select: none;
    pointer-events: none;
  }
  .rs-locked__veil {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 12px;
    text-align: center;
    background: radial-gradient(70% 60% at 50% 50%, rgba(16,12,20,0.55) 0%, rgba(16,12,20,0.85) 100%);
  }
  .rs-locked__icon { font-size: 20px; }
  .rs-locked__text {
    margin: 0;
    font-size: 12.5px;
    font-weight: 700;
    color: #efe7f2;
    letter-spacing: -0.02em;
    word-break: keep-all;
  }
  .rs-locked__sub {
    margin: 0;
    font-size: 11px;
    color: #9d94a6;
  }

  /* 잠긴 날짜 — 개별 셀만 흐리게 */
  .rs-cal__cell--locked {
    filter: blur(3.6px);
    opacity: 0.85;
  }

  .rs-cal__lockbar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
    padding: 10px;
    border-radius: 10px;
    background: rgba(233, 30, 122, 0.1);
    border: 1px solid rgba(233, 30, 122, 0.28);
    font-size: 12px;
    font-weight: 700;
    color: #ffb3d5;
    letter-spacing: -0.02em;
  }

  /* ── #4 캘린더 ── */
  .rs-cal {
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: 16px;
    background: rgba(255,255,255,0.035);
    padding: 16px 14px;
  }
  .rs-cal__dday {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    padding: 11px 13px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(233,30,122,0.2), rgba(233,30,122,0.06));
    border: 1px solid rgba(233,30,122,0.34);
  }
  .rs-cal__dday b { font-size: 20px; font-weight: 900; color: #ff8ec0; letter-spacing: -0.02em; }
  .rs-cal__dday span { font-size: 12.5px; color: #d8ccdf; }
  .rs-cal__month { margin-bottom: 18px; }
  .rs-cal__month:last-child { margin-bottom: 0; }
  .rs-cal__mlabel { margin: 0 0 9px; font-size: 13.5px; font-weight: 800; color: #efe7f2; }
  .rs-cal__grid { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .rs-cal__grid th {
    padding-bottom: 6px;
    font-size: 10.5px;
    font-weight: 700;
    color: #7e7488;
  }
  .rs-cal__grid td { padding: 1.5px; text-align: center; }
  .rs-cal__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    border-radius: 9px;
    font-size: 12.5px;
    font-weight: 600;
    color: #6f6678;
  }
  .rs-cal__cell--in { color: #cfc7d6; background: rgba(255,255,255,0.045); }
  .rs-cal__cell--golden  { background: rgba(233,30,122,0.9); color: #fff; font-weight: 800; box-shadow: 0 0 14px rgba(233,30,122,0.5); }
  .rs-cal__cell--silence { background: rgba(70,72,84,0.85); color: #9aa0ae; text-decoration: line-through; }
  .rs-cal__cell--step    { background: rgba(150,96,40,0.42); color: #f0cfa4; }
  .rs-cal__cell--charge  { background: rgba(64,132,120,0.42); color: #a9e6d8; }
  .rs-cal__cell--today::after {
    content: "";
    position: absolute;
    inset: 0;
    border: 1.5px solid #fff;
    border-radius: 9px;
  }
  .rs-cal__legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 7px;
    margin-top: 14px;
  }
  .rs-cal__leg {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    color: #b3a9bb;
  }
  .rs-cal__dot { width: 11px; height: 11px; border-radius: 4px; flex: none; }
  .rs-cal__dot--golden  { background: #e91e7a; }
  .rs-cal__dot--silence { background: #46484f; }
  .rs-cal__dot--step    { background: #966028; }
  .rs-cal__dot--charge  { background: #408478; }

  /* ── #5 사주팔자 표 ── */
  .rs-pill {
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 14px;
    background: rgba(255,255,255,0.04);
    padding: 13px 12px;
    margin-bottom: 12px;
  }
  .rs-pill__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .rs-pill__name { font-size: 14px; font-weight: 800; letter-spacing: -0.02em; }
  .rs-pill__meta { font-size: 11px; color: #9d94a6; }
  .rs-pill__grid { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .rs-pill__grid th {
    padding: 5px 2px;
    font-size: 10.5px;
    font-weight: 700;
    color: #857b8e;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .rs-pill__grid td {
    padding: 6px 2px;
    text-align: center;
    font-size: 11.5px;
    color: #ccc3d3;
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  .rs-pill__gj {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 4px 0;
    width: 100%;
    border-radius: 7px;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.15;
  }
  .rs-pill__gj small { font-size: 9.5px; font-weight: 600; opacity: 0.72; }
  .el-목 { background: rgba(74,158,96,0.24); color: #8fe0a8; }
  .el-화 { background: rgba(206,66,66,0.24); color: #ff9b93; }
  .el-토 { background: rgba(176,132,60,0.24); color: #f0cf94; }
  .el-금 { background: rgba(150,158,172,0.24); color: #dfe4ee; }
  .el-수 { background: rgba(58,112,190,0.24); color: #9cc4f5; }
  .rs-pill__day td { background: rgba(233,30,122,0.09); }
  .rs-pill__els { display: flex; gap: 5px; margin-top: 10px; }
  .rs-pill__el {
    flex: 1;
    text-align: center;
    padding: 6px 0;
    border-radius: 8px;
    font-size: 11px;
    font-weight: 700;
  }

  /* ── #6 락 카드 ── */
  .rs-lock {
    position: relative;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    background: rgba(255,255,255,0.04);
    padding: 18px 16px 20px;
    overflow: hidden;
  }
  .rs-lock__text { font-size: 14.5px; line-height: 1.72; color: #d9d1e0; word-break: keep-all; }
  .rs-lock__text b { color: #ff8ec0; font-weight: 800; }
  .rs-lock__fade {
    position: relative;
    margin-top: 8px;
    filter: blur(4.5px);
    user-select: none;
    color: #b0a7b8;
    font-size: 14.5px;
    line-height: 1.72;
    max-height: 108px;
    overflow: hidden;
  }
  .rs-lock__veil {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 128px;
    background: linear-gradient(180deg, rgba(20,15,24,0) 0%, rgba(20,15,24,0.92) 62%, #140f18 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding-bottom: 16px;
  }
  .rs-lock__icon { font-size: 22px; }
  .rs-lock__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 20px;
    border: none;
    border-radius: 11px;
    background: #e91e7a;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: -0.02em;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(233,30,122,0.4);
  }
  .rs-discount {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 12px;
    padding: 9px;
    border-radius: 10px;
    background: rgba(233,30,122,0.11);
    border: 1px solid rgba(233,30,122,0.28);
    font-size: 12.5px;
    color: #ffd0e4;
  }
  .rs-discount b { font-variant-numeric: tabular-nums; color: #fff; font-weight: 800; }

  /* 구매 알림 토스트 */
  .rs-toast {
    position: fixed;
    left: 50%;
    bottom: 96px;
    transform: translateX(-50%) translateY(14px);
    z-index: 95;
    display: flex;
    align-items: center;
    gap: 9px;
    max-width: 353px;
    width: calc(100% - 40px);
    padding: 10px 13px;
    border-radius: 12px;
    background: rgba(38, 30, 44, 0.96);
    border: 1px solid rgba(255,255,255,0.11);
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    font-size: 12.5px;
    color: #e5dded;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .rs-toast.is-on { opacity: 1; transform: translateX(-50%) translateY(0); }
