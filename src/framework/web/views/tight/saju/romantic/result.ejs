<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
</head>

<%
  const uname = (typeof userInfo !== 'undefined' && userInfo && userInfo.name) ? userInfo.name : '그대';
  const IMG = '/assets/images/tight/romantic/result';
  // 九命(아홉 목숨) 카운터: n개 점등
  function lives(n){
    let s='<div class="lives">';
    for(let i=1;i<=9;i++) s += '<i class="'+(i<=n?'on':'')+'"></i>';
    const han=['','第一命','第二命','第三命','第四命','第五命','第六命','第七命','第八命','第九命'][n]||'';
    s += '<b>'+han+'</b></div>';
    return s;
  }
%>

<style>
  :root{
    --bg:#070a09; --ink:#eef3f0; --dim:#8f9c96; --faint:#5c6660;
    --jade:#43e0ad; --jade-deep:#1c8f6c;
    --gold:#c8a14e; --wine:#c8244c;
    --line:rgba(170,215,200,.13); --line-2:rgba(170,215,200,.07);
    --sans:'Pretendard',system-ui,-apple-system,sans-serif;
    --serif:'Nanum Myeongjo','Apple Myungjo',serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);
    font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased;}
  img{display:block;}
  .stage{max-width:460px;margin:0 auto;background:var(--bg);position:relative;overflow-x:hidden;}

  /* ── top bar ── */
  .topbar{position:sticky;top:0;z-index:60;display:flex;align-items:center;justify-content:space-between;
    height:52px;padding:0 18px;background:rgba(7,10,9,.7);backdrop-filter:blur(12px);
    border-bottom:1px solid var(--line-2);}
  .topbar .back{color:var(--dim);text-decoration:none;font-size:19px;}
  .topbar .ttl{font-family:var(--serif);font-size:17px;letter-spacing:.06em;color:var(--ink);}
  .topbar .ttl .han{color:var(--jade);}
  .topbar .sp{width:18px;}

  /* ── 이미지 히어로 (하단이 검정으로 녹아듦, 텍스트 좌하단) ── */
  .hero{position:relative;background:var(--bg);}
  .hero > img{width:100%;height:auto;}
  .hero .veil{position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(to bottom,
      rgba(7,10,9,.5) 0%, rgba(7,10,9,0) 15%, rgba(7,10,9,0) 38%,
      rgba(7,10,9,.7) 74%, rgba(7,10,9,.95) 91%, var(--bg) 100%);}
  .cap{position:absolute;left:0;right:0;bottom:34px;padding:0 24px;z-index:3;}
  .topcap{position:absolute;left:0;right:0;top:66px;padding:0 24px;z-index:3;}

  /* 속삭임(나레이션) — 괄호 세리프 이탤릭 */
  .whisper{font-family:var(--serif);font-style:italic;font-size:16px;color:var(--jade);
    letter-spacing:.02em;margin-bottom:14px;text-shadow:0 2px 14px rgba(0,0,0,.9);}
  .whisper::before{content:"「";opacity:.6;margin-right:1px;}
  .whisper::after{content:"」";opacity:.6;margin-left:1px;}

  /* 대형 후크 — 세리프, 좌정렬 */
  .hook{font-family:var(--serif);font-weight:700;font-size:clamp(29px,8.4vw,40px);line-height:1.26;
    letter-spacing:-.01em;margin:0;text-align:left;text-shadow:0 4px 30px rgba(0,0,0,.85);}
  .hook.sm{font-size:clamp(24px,6.6vw,31px);}
  .j{color:var(--jade);} .au{color:var(--gold);} .w{color:var(--wine);}
  .hook b{font-weight:800;}

  /* ── 검은 콘텐츠 비트 ── */
  .beat{padding:46px 24px;}
  .beat.tight{padding:32px 24px 40px;}
  /* 섹션 키커 — 세리프 한자 + 라틴 라벨, 좌측 틱 */
  .kick{display:flex;align-items:center;gap:9px;margin:0 0 16px;font-size:12px;letter-spacing:.24em;
    text-transform:uppercase;color:var(--gold);font-weight:600;}
  .kick::before{content:"";width:16px;height:1px;background:var(--gold);}
  .kick .han{font-family:var(--serif);font-size:16px;letter-spacing:0;color:var(--jade);text-transform:none;}
  .beat h2{font-family:var(--serif);font-weight:700;font-size:26px;line-height:1.32;letter-spacing:-.01em;
    margin:0 0 16px;text-align:left;}
  .beat h2 b{font-weight:700;}
  .beat h2 .han{color:var(--jade);}
  .beat p{margin:0 0 12px;color:var(--dim);font-size:15px;line-height:1.68;}
  .beat p b{color:var(--ink);font-weight:600;}

  /* 九命 챕터 카운터 */
  .lives{display:flex;align-items:center;gap:6px;margin-bottom:16px;}
  .lives i{width:9px;height:9px;transform:rotate(45deg);border:1px solid var(--faint);border-radius:2px;}
  .lives i.on{background:var(--jade);border-color:var(--jade);box-shadow:0 0 9px rgba(67,224,173,.6);}
  .lives b{font-family:var(--serif);font-size:15px;color:var(--gold);margin-left:8px;letter-spacing:.05em;font-weight:400;}

  /* 目次(목차) — 命 넘버 인덱스 */
  .toc{list-style:none;padding:0;margin:8px 0 0;border-top:1px solid var(--line);}
  .toc li{display:flex;align-items:center;gap:15px;padding:17px 2px;border-bottom:1px solid var(--line);}
  .toc .tno{font-family:var(--serif);font-size:17px;color:var(--jade);flex:0 0 auto;width:52px;letter-spacing:.04em;}
  .toc .tt{flex:1;font-size:14.5px;color:var(--ink);line-height:1.42;}
  .toc .tt small{display:block;color:var(--dim);font-size:12.5px;margin-top:2px;}
  .toc .tlock{flex:0 0 auto;color:var(--gold);font-size:13px;opacity:.85;}

  /* 구분선 — 헤어라인 + 제이드 마름모 */
  .rule{display:flex;align-items:center;gap:14px;padding:0 24px;color:var(--line);}
  .rule::before,.rule::after{content:"";flex:1;height:1px;background:var(--line);}
  .rule i{width:6px;height:6px;transform:rotate(45deg);background:var(--jade);opacity:.7;}

  /* 스탯 티저 — 세로 한자 스택 */
  .teaser{border-top:1px solid var(--line);border-bottom:1px solid var(--line);}
  .trow{display:flex;align-items:center;justify-content:space-between;padding:18px 2px;border-bottom:1px solid var(--line-2);}
  .trow:last-child{border-bottom:none;}
  .trow .lab{display:flex;align-items:baseline;gap:10px;}
  .trow .lab .han{font-family:var(--serif);font-size:26px;color:var(--jade);line-height:1;}
  .trow .lab .ko{font-size:15px;color:var(--ink);font-weight:600;}
  .trow .val{font-family:var(--serif);font-size:20px;color:var(--gold);}

  /* 피처 리스트 — 헤어라인 인덱스(一二三) */
  .flist{border-top:1px solid var(--line);}
  .fitem{display:flex;gap:16px;padding:20px 2px;border-bottom:1px solid var(--line);align-items:flex-start;}
  .fitem .idx{font-family:var(--serif);font-size:24px;color:var(--jade);line-height:1;flex:0 0 auto;width:22px;}
  .fitem h3{margin:0 0 4px;font-size:17px;font-weight:700;}
  .fitem p{margin:0;font-size:13.5px;color:var(--dim);}
  .caution{margin-top:22px;padding:13px 15px;border-left:2px solid var(--wine);background:rgba(200,36,76,.07);
    font-size:13px;color:#e8b8c2;}

  /* 채팅 → 세리프 속삭임 라인 (박스 최소화) */
  .talk{display:flex;flex-direction:column;gap:14px;margin-top:6px;padding-left:14px;border-left:1px solid var(--line);}
  .talk .l{font-size:15.5px;color:var(--dim);line-height:1.55;}
  .talk .l b{color:var(--ink);}
  .talk .l.big{font-family:var(--serif);font-size:22px;color:var(--jade);}

  /* 유형 헤더(이미지 오버레이) */
  .thead{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;}
  .thead .nm{font-family:var(--serif);font-size:30px;line-height:1.05;}
  .thead .nm .han{color:var(--jade);font-size:20px;margin-left:4px;}
  .thead .nm span{display:block;font-family:var(--sans);font-size:14px;color:#cfd6d2;font-weight:500;margin-top:6px;letter-spacing:.02em;}
  .elem{width:56px;height:56px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;
    font-family:var(--serif);font-size:30px;color:var(--gold);border:1px solid rgba(200,161,78,.45);
    background:rgba(7,10,9,.5);box-shadow:0 0 20px rgba(200,161,78,.2);backdrop-filter:blur(4px);}

  /* 외모 bullets — 클로 틱 */
  .claws{list-style:none;padding:0;margin:0;}
  .claws li{font-size:14.5px;color:var(--ink);padding:12px 0 12px 22px;position:relative;border-bottom:1px solid var(--line-2);line-height:1.5;}
  .claws li:last-child{border-bottom:none;}
  .claws li::before{content:"⟍";position:absolute;left:0;top:11px;color:var(--jade);font-size:13px;}
  .tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;}
  .tags span{font-family:var(--serif);font-size:13.5px;color:var(--dim);border-bottom:1px solid var(--line);padding:2px 4px;}

  /* 표 */
  .tbl{overflow-x:auto;margin-top:14px;border-top:1px solid var(--line);}
  table{border-collapse:collapse;width:100%;font-size:13.5px;min-width:330px;}
  th,td{text-align:left;padding:13px 10px;border-bottom:1px solid var(--line-2);}
  thead th{font-family:var(--serif);color:var(--gold);font-size:13px;font-weight:400;letter-spacing:.04em;}
  td b{color:var(--ink);}

  /* 스탯 바 — 헤어라인, 우측 세리프 숫자 */
  .bars{display:flex;flex-direction:column;gap:17px;}
  .brow .bl{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;}
  .brow .bl b{font-size:14.5px;color:var(--ink);font-weight:600;}
  .brow .bl .v{font-family:var(--serif);font-size:19px;color:var(--gold);font-variant-numeric:tabular-nums;}
  .track{height:2px;background:var(--line);overflow:hidden;}
  .fill{height:100%;background:var(--jade);box-shadow:0 0 8px rgba(67,224,173,.5);}
  .fill.w{background:var(--wine);box-shadow:0 0 8px rgba(200,36,76,.5);}

  /* 잠금(封印) */
  .seal{position:relative;margin-top:16px;border:1px solid var(--line);overflow:hidden;}
  .seal .blur{filter:blur(6px);opacity:.5;pointer-events:none;user-select:none;padding:18px;}
  .seal .blur p{margin:0 0 9px;color:#c6ccc8;font-size:14px;}
  .seal .lock{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;
    background:linear-gradient(180deg,rgba(7,10,9,.2),rgba(7,10,9,.8));}
  .seal .han-seal{font-family:var(--serif);font-size:22px;color:var(--gold);letter-spacing:.1em;
    border:1px solid rgba(200,161,78,.5);padding:5px 12px;}
  .seal .tx{font-size:12.5px;color:var(--dim);letter-spacing:.06em;}

  /* 하단 고정 CTA — 제이드 + 골드 테두리 + 고양이 눈 */
  .ctaFixed{position:sticky;bottom:0;z-index:60;padding:14px 18px calc(16px + env(safe-area-inset-bottom,0));
    background:linear-gradient(to top, var(--bg) 60%, rgba(7,10,9,0));}
  .cta{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;padding:17px 0;
    text-decoration:none;font-family:var(--serif);font-weight:700;font-size:17px;letter-spacing:.02em;color:#05130e;
    background:linear-gradient(90deg,#4be3b0,#1f9f78);border:1px solid rgba(240,220,150,.55);
    box-shadow:0 0 22px rgba(67,224,173,.32), 0 12px 34px rgba(0,0,0,.5);
    animation:glow 2.6s ease-in-out infinite;}
  .cta .eye{font-style:normal;}
  @keyframes glow{0%,100%{box-shadow:0 0 20px rgba(67,224,173,.28),0 12px 30px rgba(0,0,0,.5);}
    50%{box-shadow:0 0 30px rgba(67,224,173,.55),0 12px 40px rgba(0,0,0,.5);}}
  @media (prefers-reduced-motion:reduce){.cta{animation:none;}}
</style>

<body>
<div class="stage">

  <div class="topbar"><a href="/saju/romantic/input" class="back">←</a><span class="ttl">흑묘사주 <span class="han">黑猫</span></span><span class="sp"></span></div>

  <!-- ①  IMG1 도발① -->
  <div class="hero">
    <img src="<%= IMG %>/1.jpg" alt="">
    <div class="veil"></div>
    <div class="cap">
      <div class="whisper">그르릉…</div>
      <p class="hook"><%= uname %>,<br>넌 타고난 <span class="j">고양이</span>면서<br>왜 <span class="au">순한 집냥이</span> 흉내를?</p>
    </div>
  </div>

  <!-- ▸ 검정: 스탯 티저 (세로 한자 스택) -->
  <div class="beat">
    <div class="kick"><span class="han">三猫力</span> 세 가지 홀림</div>
    <div class="teaser">
      <div class="trow"><div class="lab"><span class="han">猫</span><span class="ko">묘력</span></div><div class="val">?? 점</div></div>
      <div class="trow"><div class="lab"><span class="han">妖</span><span class="ko">요망력</span></div><div class="val">?? 점</div></div>
      <div class="trow"><div class="lab"><span class="han">色</span><span class="ko">색기력</span></div><div class="val">?? 점</div></div>
    </div>
    <p style="margin-top:18px">사주에 새겨진 <b><%= uname %></b>의 홀림을, 흑묘가 낱낱이 읽어줄게.</p>
  </div>

  <div class="rule"><i></i></div>

  <!-- ②  IMG2 도발② -->
  <div class="hero">
    <img src="<%= IMG %>/2.jpg" alt="">
    <div class="veil"></div>
    <div class="cap">
      <div class="whisper">냐하…</div>
      <p class="hook">이제 지치지 않아?<br>고양이는 <span class="j">고양이답게</span> —<br>참으면 병나.</p>
    </div>
  </div>

  <!-- ▸ 검정: 피처 인덱스 리스트 -->
  <div class="beat">
    <div class="flist">
      <div class="fitem"><span class="idx">一</span><div><h3>요망력 🔥</h3><p>여러 명이 엮일 수밖에 없는 요망한 팔자</p></div></div>
      <div class="fitem"><span class="idx">二</span><div><h3>3개월 내로 🖤</h3><p>너에게 스며들 이성의 외모와 타입</p></div></div>
      <div class="fitem"><span class="idx">三</span><div><h3>호구 감별법 😼</h3><p>너에게 꼼짝 못 하는 사람 구분법</p></div></div>
    </div>
    <div class="caution">본 해석은 다소 <b>자극적인 내용</b>을 포함합니다.</div>
  </div>

  <!-- ③  IMG3 유혹 -->
  <div class="hero">
    <img src="<%= IMG %>/3.jpg" alt="">
    <div class="veil"></div>
    <div class="cap">
      <p class="hook">너는 <span class="au">‘이것’ 하나</span>만<br>바꾸면 미친 듯이<br>사랑받는다는 걸,<br><span class="j">이미 알잖아.</span></p>
    </div>
  </div>

  <!-- ▸ 검정: 여왕 셋업 -->
  <div class="beat tight">
    <div class="kick"><span class="han">卽位</span> 그래서</div>
    <h2>너를 <b>여왕</b>으로<br>만들어줄게.</h2>
  </div>

  <!-- ④  IMG4 여왕 -->
  <div class="hero">
    <img src="<%= IMG %>/4.jpg" alt="">
    <div class="veil"></div>
    <div class="cap">
      <p class="hook sm">네 안에 잠든 <span class="j">흑묘</span>를<br>깨우는 <span class="au">비기</span>를?</p>
    </div>
  </div>

  <!-- ▸ 검정: 目次(목차) -->
  <div class="beat">
    <div class="kick"><span class="han">目次</span> 이 사주가 밝힐 것</div>
    <ul class="toc">
      <li><span class="tno">第一命</span><span class="tt">나는 어떤 흑묘인가<small>타고난 유형과 색기의 정체</small></span></li>
      <li><span class="tno">第二命</span><span class="tt">아홉 개의 목숨<small>숨겨둔 치명적 무기 — 도화·홍염</small></span><span class="tlock">封</span></li>
      <li><span class="tno">第三命</span><span class="tt">숨만 쉬어도 플러팅<small>수동적 지배 스킬</small></span><span class="tlock">封</span></li>
      <li><span class="tno">第四命</span><span class="tt">포식할 사냥감<small>상대의 심연까지 벗겨보는 법</small></span><span class="tlock">封</span></li>
    </ul>
  </div>

  <!-- ▸ 검정: Chapter 1 유형 리빌 -->
  <div class="beat">
    <%- lives(1) %>
    <h2>나는 <b>어떤 흑묘</b>일까?</h2>
    <div class="talk">
      <div class="l"><b><%= uname %></b>, 넌 보아하니…</div>
      <div class="l big">흑요묘(黑曜猫)구나.</div>
      <div class="l">무심한 듯 곁을 내주다, 어느새 상대를 <b>네게 길들이는</b> 묵직한 지배력이 있다더군.</div>
    </div>
  </div>

  <!-- ⑤  IMG5 유형 -->
  <div class="hero">
    <img src="<%= IMG %>/5.jpg" alt="">
    <div class="veil"></div>
    <div class="cap">
      <div class="thead">
        <div class="nm">흑요묘<span class="han">黑曜猫</span><span>나른한 관능</span></div>
        <div class="elem">土</div>
      </div>
    </div>
  </div>

  <!-- ▸ 검정: 유형 상세 + 타임라인 -->
  <div class="beat">
    <div class="kick"><span class="han">相</span> 흑요묘의 외모</div>
    <ul class="claws">
      <li>무심한 듯 시선을 붙드는 단정한 미인</li>
      <li>자연스러운데 세련까지 갖춘 얼굴</li>
      <li>눈빛이 나른하고, 어둠 속에서 빛나는 금빛 눈</li>
      <li>은근한 효과 — 나도 모르게 곁에 귀인이 꼬임</li>
    </ul>
    <div class="kick" style="margin-top:28px"><span class="han">人</span> 흑요묘 유명인</div>
    <div class="tags"><span>김태희</span><span>제니</span><span>한소희</span><span>정국</span><span>차은우</span><span>수지</span></div>

    <div class="kick" style="margin-top:32px"><span class="han">緣</span> 다가올 인연</div>
    <h2 style="font-size:21px">3개월 내로 <b><%= uname %></b>에게<br>스며들 녀석들은?</h2>
    <div class="tbl">
      <table>
        <thead><tr><th>시기</th><th>성향·외모</th><th>공략법</th></tr></thead>
        <tbody>
          <tr><td><b>이번 달</b></td><td>다정한 연상</td><td>먼저 곁을 내줘</td></tr>
          <tr><td><b>다음 달</b></td><td>시크한 동갑</td><td>무심한 척 밀당</td></tr>
          <tr><td><b>3개월 내</b></td><td>다정+능력</td><td>기다리면 옴</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ⑥  IMG6 스탯 배경 -->
  <div class="hero">
    <img src="<%= IMG %>/6.jpg" alt="">
    <div class="veil"></div>
    <div class="topcap"><p class="hook sm">나의 <span class="j">묘력</span>과<br>요망력은?</p></div>
    <div class="cap">
      <div class="bars">
        <div class="brow"><div class="bl"><b>묘력</b><span class="v">?? 점</span></div><div class="track"><div class="fill" style="width:84%"></div></div></div>
        <div class="brow"><div class="bl"><b>요망력</b><span class="v">?? 점</span></div><div class="track"><div class="fill" style="width:73%"></div></div></div>
        <div class="brow"><div class="bl"><b>색기력</b><span class="v">?? 점</span></div><div class="track"><div class="fill" style="width:68%"></div></div></div>
      </div>
    </div>
  </div>

  <!-- ▸ 검정: 짧은 연결 -->
  <div class="beat tight">
    <p style="font-size:16px;color:var(--ink)">같은 사주라도 <b>쓸 줄 아는 흑묘</b>와<br>모르는 흑묘의 인생은 정반대야.</p>
  </div>

  <div class="rule"><i></i></div>

  <!-- ⑦  IMG7 귀인 -->
  <div class="hero">
    <img src="<%= IMG %>/7.jpg" alt="">
    <div class="veil"></div>
    <div class="cap">
      <p class="hook sm">충성을 끌어내는<br><span class="au">귀인(貴人)의 발톱</span></p>
    </div>
  </div>

  <!-- ▸ 검정: 귀인 잠금 -->
  <div class="beat">
    <p>천을귀인·월덕귀인 — <b>나를 여왕으로 떠받들</b> ‘호구(사주)’ 감별법.</p>
    <div class="seal">
      <div class="blur">
        <p>네 사주엔 특정 시기에 강력한 귀인이 붙는다. 그 사람이 나타나는 달과, 알아보는 신호는…</p>
        <p>이 귀인을 놓치지 않고 내 편으로 묶어두는 결정적 한마디는 —</p>
      </div>
      <div class="lock"><div class="han-seal">封印</div><div class="tx">풀버전에서 해제</div></div>
    </div>
  </div>

  <!-- ⑧  IMG8 색기 클로즈업 -->
  <div class="hero">
    <img src="<%= IMG %>/8.jpg" alt="">
    <div class="veil"></div>
    <div class="topcap">
      <%- lives(2) %>
      <p class="hook sm">아홉 개의 목숨 <span class="j">九命</span><br>숨겨둔 <span class="au">치명적 무기</span></p>
    </div>
    <div class="cap"><div class="whisper">어디 보자… 네 색기를 모르겠다고?</div></div>
  </div>

  <!-- ▸ 검정: 도화 잠금 -->
  <div class="beat">
    <h2>도화 <span class="han">桃花</span></h2>
    <p><b>아우라로 기선을 제압하는 법.</b> 남들은 평생 노력해도 못 가질, 네 사주에만 허락된 ‘색기’의 종류.</p>
    <div class="seal">
      <div class="blur">
        <p>너의 도화는 첫 대면 3초에 폭발한다. 상대가 눈을 마주친 순간 이미 주도권은 네게 있고, 그때 해야 할 단 하나는…</p>
        <p>이 색기를 200% 끌어올리는 시간대·색·말투까지 —</p>
      </div>
      <div class="lock"><div class="han-seal">封印</div><div class="tx">풀버전에서 해제</div></div>
    </div>
  </div>

  <!-- ⑨  IMG9 홍염 -->
  <div class="hero">
    <img src="<%= IMG %>/9.jpg" alt="">
    <div class="veil"></div>
    <div class="topcap"><p class="hook sm">홍염 <span class="w">紅艶</span><br><span style="font-family:var(--sans);font-size:14px;color:#cfd6d2;font-weight:600">거부할 수 없는 맹목적 끌림 💅</span></p></div>
    <div class="cap"><div class="whisper">네 자리는… 여기가 어울려.</div></div>
  </div>

  <!-- ▸ 검정: 19금 스탯바 잠금 -->
  <div class="beat">
    <div class="kick rose" style="color:var(--wine)"><span class="han" style="color:var(--wine)">夜</span> 19+ 밤의 사주</div>
    <h2>밤의 주도권을 쥐는<br>은밀한 사주 해석 <span style="color:var(--wine)">😈</span></h2>
    <div class="seal">
      <div class="blur" style="filter:blur(4px);opacity:.55">
        <div class="bars">
          <div class="brow"><div class="bl"><b>주도력</b><span class="v">93</span></div><div class="track"><div class="fill w" style="width:93%"></div></div></div>
          <div class="brow"><div class="bl"><b>지구력</b><span class="v">75</span></div><div class="track"><div class="fill w" style="width:75%"></div></div></div>
          <div class="brow"><div class="bl"><b>테크닉</b><span class="v">69</span></div><div class="track"><div class="fill w" style="width:69%"></div></div></div>
          <div class="brow"><div class="bl"><b>중독성</b><span class="v">58</span></div><div class="track"><div class="fill w" style="width:58%"></div></div></div>
        </div>
      </div>
      <div class="lock"><div class="han-seal" style="color:var(--wine);border-color:rgba(200,36,76,.5)">禁</div><div class="tx">풀버전에서 해제</div></div>
    </div>
  </div>

  <!-- ⑩  IMG10 니어키스 배너 -->
  <div class="hero">
    <img src="<%= IMG %>/10.jpg" alt="">
    <div class="veil"></div>
    <div class="cap">
      <%- lives(3) %>
      <p class="hook sm">굳이 애쓰지 않아도 —<br>숨만 쉬어도 <span class="j">플러팅</span></p>
    </div>
  </div>

  <!-- ▸ 검정: Ch3 스킬 잠금 -->
  <div class="beat">
    <h2 style="font-size:20px">특유의 ‘<b>수동적 지배</b>’ 스킬</h2>
    <p>쫓아가지 마 — 알아서 매달리게 둬.</p>
    <div class="seal">
      <div class="blur">
        <p>상대가 밤새 너를 상상하게 만드는 3가지 언어 습관, 그리고 안달 난 강아지처럼 매달리게 만드는 조련 타이밍…</p>
      </div>
      <div class="lock"><div class="han-seal">封印</div><div class="tx">풀버전에서 해제</div></div>
    </div>
  </div>

  <!-- ⑪  IMG11 포식자 (BONUS) -->
  <div class="hero">
    <img src="<%= IMG %>/11.jpg" alt="">
    <div class="veil"></div>
    <div class="topcap">
      <%- lives(4) %>
      <p class="hook sm">천 년 묵은 흑묘가<br>포식할 <span class="w">사냥감</span></p>
    </div>
    <div class="cap"><div class="whisper">정복해버려, 그냥. 냐하ㅋ</div></div>
  </div>

  <!-- ▸ 검정: 마무리 -->
  <div class="beat">
    <h2 style="font-size:21px">잔잔해 보이는 그 사람의<br>심연까지 벗겨보고 싶은<br><b><%= uname %></b>에게 —</h2>
    <p>알아서 감겨드는 사냥감들의 정체, 흑묘 사주 풀버전에서 전부 공개된다.</p>
  </div>

  <div class="ctaFixed">
    <a href="/saju/payment" class="cta"><span class="eye">🐈‍⬛</span> 흑묘 사주 풀버전 열기</a>
  </div>

</div>
</body>
</html>
