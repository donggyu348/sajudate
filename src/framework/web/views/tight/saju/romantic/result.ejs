<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jua&family=Poor+Story&display=swap" rel="stylesheet">
</head>

<body>

<%
const STEM_TO_HANJA = {
  '갑':'甲','을':'乙','병':'丙','정':'丁','무':'戊',
  '기':'己','경':'庚','신':'辛','임':'壬','계':'癸'
};
const BRANCH_TO_HANJA = {
  '자':'子','축':'丑','인':'寅','묘':'卯','진':'辰','사':'巳',
  '오':'午','미':'未','신':'申','유':'酉','술':'戌','해':'亥'
};
function H(v){ return STEM_TO_HANJA[v] || BRANCH_TO_HANJA[v] || v; }

const g = String(userInfo.gender).trim();
let genderKey = "man";
if (["여","여자","여성","female","F","woman"].includes(g)) genderKey = "woman";

const dayStem = sampleInfo && sampleInfo.tenGodTable && sampleInfo.tenGodTable.data
  && sampleInfo.tenGodTable.data[1] && sampleInfo.tenGodTable.data[1][1]
  ? H(sampleInfo.tenGodTable.data[1][1]) : null;

const STEM_TO_KR_KEY = {
  "甲":"갑목","乙":"을목","丙":"병화","丁":"정화","戊":"무토",
  "己":"기토","庚":"경금","辛":"신금","壬":"임수","癸":"계수"
};
const stemKey = STEM_TO_KR_KEY[dayStem] || null;

// Calendar
const cy = todayDate.year;
const cm = todayDate.month;
const cd = todayDate.day;
const daysInMonth   = new Date(cy, cm, 0).getDate();
const firstDayOfWeek = new Date(cy, cm - 1, 1).getDay();
const WEEKDAYS  = ['일','월','화','수','목','금','토'];
const MONTH_KR  = ['1월','2월','3월','4월','5월','6월','7월','8월','9월','10월','11월','12월'];

const GOOD_DAYS_MAP = {
  "갑목":[4,9,16,23],"을목":[5,10,17,24],"병화":[3,8,15,22],"정화":[6,11,18,25],
  "무토":[2,7,14,21],"기토":[4,9,16,23],"경금":[5,12,19,26],"신금":[7,14,21,28],
  "임수":[3,10,17,24],"계수":[2,9,16,23]
};
const goodDays = new Set(GOOD_DAYS_MAP[stemKey] || [5,12,19,26]);

const dayMasterImg1 = stemKey ? `/assets/images/tight/romantic/result/${genderKey}1/${stemKey}.png` : null;
const spouseFaceImg = stemKey ? `/assets/images/tight/romantic/report/${genderKey}/${stemKey}.png` : null;

// ────── 일간 연애 분석 데이터 ──────
const STEM_ROMANCE = {
  "갑목": {
    type:"직진형 리더 💪",
    color:"#16a34a",
    bg:"#f0fdf4",
    border:"#86efac",
    keywords:["열정적","주도적","불굴의 의지"],
    desc:"좋아하면 바로 들이대는 직진 스타일! 연애에서 주도권을 쥐고 상대를 리드하길 좋아합니다. 포기를 모르는 강한 의지로 관계를 지키지만, 가끔 지나친 자존심이 걸림돌이 되기도 해요.",
    traits:["♥ 밀당 NO! 좋으면 바로 고백하는 타입","♥ 한번 마음 먹으면 절대 안 포기","♥ 연인을 위해 뭐든지 해주는 헌신파"]
  },
  "을목": {
    type:"감성 로맨티시스트 🌿",
    color:"#15803d",
    bg:"#f0fdf4",
    border:"#86efac",
    keywords:["감성 폭발","공감 최강","유연한 매력"],
    desc:"상대방의 마음을 꿰뚫는 공감 능력이 최강! 직접 들이대기보다 조금씩 거리를 좁혀가는 스타일이에요. 연애를 예쁘게 꾸미고 싶어하는 타고난 로맨티시스트입니다.",
    traits:["♥ 상대 기분을 귀신같이 캐치하는 공감왕","♥ 연애 분위기 메이킹 천재","♥ 한번 좋아하면 오래오래 좋아함"]
  },
  "병화": {
    type:"분위기 메이커 ☀️",
    color:"#dc2626",
    bg:"#fff5f5",
    border:"#fca5a5",
    keywords:["에너지 폭발","솔직 담백","인싸력 만렙"],
    desc:"주변을 환하게 밝히는 태양 같은 존재! 솔직하고 표현이 풍부해 연애 초반 엄청난 인상을 줘요. 관심 있는 사람에겐 망설임 없이 어필하는 스타일이지만 질투를 유발하기도 합니다.",
    traits:["♥ 솔직한 감정 표현으로 상대 심장 저격","♥ 어디서나 주인공, 같이 있으면 신남","♥ 첫만남부터 호감 뿜뿜"]
  },
  "정화": {
    type:"올인 진심러 🕯️",
    color:"#b91c1c",
    bg:"#fff5f5",
    border:"#fca5a5",
    keywords:["깊은 감성","완전 헌신","진심 가득"],
    desc:"한번 마음을 주면 깊게 깊게 빠져드는 타입. 상대방 한 명에게 모든 정성을 쏟아붓는 헌신적 연애를 합니다. 감수성이 풍부해 연인에게 특별한 감동을 주지만 상처도 깊게 받아요.",
    traits:["♥ 연애할 때 온 우주가 그 사람","♥ 이벤트·깜짝 선물의 달인","♥ 감수성 폭발 연인 최강"]
  },
  "무토": {
    type:"든든한 보호자 🏔️",
    color:"#92400e",
    bg:"#fffbeb",
    border:"#fcd34d",
    keywords:["신뢰 최강","묵직한 매력","행동파"],
    desc:"산처럼 든든하고 믿음직한 연애를 해요. 말보다 행동으로 사랑을 표현하는 스타일이며, 상대방에게 안전한 울타리가 되어주길 좋아합니다. 변하지 않는 꾸준함이 가장 큰 매력!",
    traits:["♥ 말은 없어도 행동으로 보여주는 타입","♥ 한번 사귀면 오래가는 장거리 선수","♥ 어떤 상황에서도 든든한 존재"]
  },
  "기토": {
    type:"따뜻한 배려왕 🤗",
    color:"#78350f",
    bg:"#fffbeb",
    border:"#fcd34d",
    keywords:["배려 천재","포용력 만렙","따뜻한 에너지"],
    desc:"상대방을 챙기고 배려하는 게 연애의 기본! 관계 속에서 편안하고 안정적인 분위기를 만드는 능력이 뛰어나요. 단, 감정 표현을 직접적으로 안 해서 상대가 답답할 수도 있어요.",
    traits:["♥ 챙겨주는 거로는 이 세상 최강","♥ 편안하고 안정적인 연애 분위기 조성","♥ 상대방 필요한 거 이미 다 알고 있음"]
  },
  "경금": {
    type:"차도남·차도녀 카리스마 ⚔️",
    color:"#1d4ed8",
    bg:"#eff6ff",
    border:"#93c5fd",
    keywords:["강렬한 카리스마","고집 있는 기준","뜨거운 내면"],
    desc:"겉은 차갑지만 내면은 뜨거운 연애를 해요. 기준이 높아 쉽게 사람을 받아들이지 않지만, 일단 마음을 열면 깊고 진한 사랑을 합니다. 독립심이 강해 의존적인 연인을 힘들어해요.",
    traits:["♥ 밀당 실력 1위, 잡을 듯 말 듯","♥ 마음 열면 극한으로 챙겨줌","♥ 강한 자기 기준으로 관계를 지킴"]
  },
  "신금": {
    type:"완벽주의 심미가 💎",
    color:"#4338ca",
    bg:"#eef2ff",
    border:"#a5b4fc",
    keywords:["세련미 폭발","완벽한 기준","감각적 연애"],
    desc:"외적·내적으로 자신을 아름답게 가꾸는 노력을 해요. 연애에서도 완벽한 모습을 추구하며 감각적인 데이트를 즐깁니다. 까다로운 기준을 가졌지만 그만큼 연인에게 최선을 다해요.",
    traits:["♥ 데이트 코스 기획력 상위 1%","♥ 외모·센스 모두 챙기는 완벽파","♥ 연인에겐 아낌없이 최선"]
  },
  "임수": {
    type:"자유로운 매력인 🌊",
    color:"#0369a1",
    bg:"#f0f9ff",
    border:"#7dd3fc",
    keywords:["신비로운 매력","자유로운 영혼","넘치는 흡인력"],
    desc:"바다처럼 넓고 자유로운 영혼! 매력이 넘쳐 주변에 사람이 많지만 쉽게 구속되는 걸 싫어해요. 자유를 주는 연애에서 최고의 파트너가 되며 상대방에게 늘 새로운 자극을 줍니다.",
    traits:["♥ 갈수록 매력이 더 강해지는 타입","♥ 넓은 인간관계, 인기 많음 주의","♥ 예측 불가능한 매력으로 계속 설레게 함"]
  },
  "계수": {
    type:"감성 최강 로맨티스트 🌧️",
    color:"#0e7490",
    bg:"#ecfeff",
    border:"#67e8f9",
    keywords:["감수성 최강","공감 천재","꿈같은 연애"],
    desc:"빗소리에도 감성이 폭발하는 최강 감성러! 연애를 꿈처럼 아름답게 만드는 능력이 있어요. 상대방 감정에 깊이 공감하고 함께 울고 웃는 연애를 합니다. 감정 기복이 있어 케어가 필요해요.",
    traits:["♥ 로맨틱 감성 연출은 이 사람이 최고","♥ 상대 감정 즉시 파악하는 공감왕","♥ 함께하면 영화 같은 연애 가능"]
  }
};
const romance = STEM_ROMANCE[stemKey] || {
  type:"특별한 연애 스타일 ✨",
  color:"#7c3aed", bg:"#faf5ff", border:"#c4b5fd",
  keywords:["독특한 매력","특별한 인연","나만의 스타일"],
  desc:"당신만의 특별한 연애 에너지가 있어요. 자세한 분석은 전체 결과에서 확인하세요!",
  traits:["♥ 나만의 독특한 연애 스타일 보유","♥ 특별한 인연을 끌어당기는 힘","♥ 연애에서 빛나는 나만의 매력"]
};

// Future partner
const partner = (sampleInfo && sampleInfo.futurePartner) ? sampleInfo.futurePartner : {};
const partnerAppearance  = Array.isArray(partner.appearance)  ? partner.appearance  : [];

const isUserMale = ["남","남자","남성","male","M","man"].includes(g);
const spouseNoun = isUserMale ? "아내" : "남편";
%>

<div class="rp">

  <!-- ══ HERO ══ -->
  <section class="hero">
    <div class="hero-bg-deco" aria-hidden="true"></div>
    <p class="hero-tag">✨ <%= cy %>년 연애 사주</p>
    <h1 class="hero-title">
      <span class="hero-name-grad"><%= userInfo.name %></span>님의<br>
      연애운이 열립니다
    </h1>
    <% if (stemKey) { %>
    <div class="hero-stem">
      <span class="hs-key"><%= stemKey %></span>
      <span class="hs-dot">·</span>
      <span class="hs-type"><%= romance.type %></span>
    </div>
    <% } %>
    <div class="hero-chips">
      <span class="chip">📖 4개 챕터</span>
      <span class="chip">📝 22,000자+</span>
      <span class="chip">🔒 잠금 해제</span>
    </div>
    <p class="scroll-hint">아래로 스크롤 ↓</p>
  </section>

  <!-- ══ 사주 원국(천간 · 지지) ══ -->
  <section class="saju-section">
    <div class="saju-card">
      <div class="saju-head">
        <div>
          <div class="saju-k">🧾 내 사주 원국</div>
          <div class="saju-t">천간 · 지지</div>
        </div>
        <div class="saju-meta">
          <div><%= userInfo.birthType || "" %> <%= (userInfo.birthDate || userInfo.birthdate || "") %></div>
          <div><%= (userInfo.birthTime && userInfo.birthTime !== "unknown") ? (userInfo.birthTime + "시") : "시간 미상" %></div>
        </div>
      </div>

      <div class="saju-grid">
        <div class="saju-col-label">시주</div>
        <div class="saju-col-label">일주</div>
        <div class="saju-col-label">월주</div>
        <div class="saju-col-label">년주</div>

        <div class="saju-cell gan">
          <div class="saju-val"><%= (saju && saju.hour && saju.hour.gan) ? saju.hour.gan : "-" %></div>
          <div class="saju-sub gan">천간</div>
        </div>
        <div class="saju-cell gan">
          <div class="saju-val"><%= (saju && saju.day && saju.day.gan) ? saju.day.gan : "-" %></div>
          <div class="saju-sub gan">천간</div>
        </div>
        <div class="saju-cell gan">
          <div class="saju-val"><%= (saju && saju.month && saju.month.gan) ? saju.month.gan : "-" %></div>
          <div class="saju-sub gan">천간</div>
        </div>
        <div class="saju-cell gan">
          <div class="saju-val"><%= (saju && saju.year && saju.year.gan) ? saju.year.gan : "-" %></div>
          <div class="saju-sub gan">천간</div>
        </div>

        <div class="saju-cell ji">
          <div class="saju-val"><%= (saju && saju.hour && saju.hour.ji) ? saju.hour.ji : "-" %></div>
          <div class="saju-sub ji">지지</div>
        </div>
        <div class="saju-cell ji">
          <div class="saju-val"><%= (saju && saju.day && saju.day.ji) ? saju.day.ji : "-" %></div>
          <div class="saju-sub ji">지지</div>
        </div>
        <div class="saju-cell ji">
          <div class="saju-val"><%= (saju && saju.month && saju.month.ji) ? saju.month.ji : "-" %></div>
          <div class="saju-sub ji">지지</div>
        </div>
        <div class="saju-cell ji">
          <div class="saju-val"><%= (saju && saju.year && saju.year.ji) ? saju.year.ji : "-" %></div>
          <div class="saju-sub ji">지지</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ 일간 연애 분석 ══ -->
  <% if (stemKey) { %>
  <section class="ilgan-section">
    <div class="ilgan-card igtheme-<%= stemKey %>">
      <div class="ig-top">
        <div class="ig-title-wrap">
          <span class="ig-tag">🔍 나의 일간</span>
          <h2 class="ig-name"><%= stemKey %> 일간</h2>
        </div>
        <div class="ig-type-pill"><%= romance.type %></div>
      </div>

      <div class="ig-keywords">
        <% romance.keywords.forEach(function(kw) { %>
          <span class="ig-kw">#<%= kw %></span>
        <% }); %>
      </div>

      <p class="ig-desc">💬 <%= romance.desc %></p>

      <div class="ig-traits">
        <% romance.traits.forEach(function(t) { %>
          <div class="ig-trait-row"><span><%= t %></span></div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- ══ CHAPTER 1 : 솔로탈출 시기 ══ -->
  <section class="chapter">
    <div class="ch-header ch1-header">
      <div class="ch-num-row">
        <span class="ch-num">CHAPTER 1</span>
        <span class="ch-icon">🌙</span>
        <span class="ch-wc">6,000자+</span>
      </div>
      <h2 class="ch-title">솔로탈출 시기</h2>
      <p class="ch-sub">정확히 언제 내 연애가 시작될까?</p>
    </div>

    <div class="ch-body">
      <!-- Calendar -->
      <div class="cal-card">
        <div class="cal-top">
          <span class="cal-month"><%= cy %>년 <%= MONTH_KR[cm-1] %></span>
          <span class="cal-good-badge">💗 연애운 좋은 날 <b><%= goodDays.size %>일</b></span>
        </div>
        <div class="cal-weekdays">
          <% WEEKDAYS.forEach(function(d,i){ %>
            <span class="<%= i===0?'wd-sun':i===6?'wd-sat':'' %>"><%= d %></span>
          <% }); %>
        </div>
        <div class="cal-grid">
          <% for(let i=0;i<firstDayOfWeek;i++){ %><span class="cc cc-empty"></span><% } %>
          <% for(let d=1;d<=daysInMonth;d++){ %>
            <span class="cc<%= goodDays.has(d)?' cc-love':'' %><%= d===cd?' cc-today':'' %>">
              <%= d %><% if(goodDays.has(d)){ %><i class="ldot"></i><% } %>
            </span>
          <% } %>
        </div>
        <p class="cal-note">💗 핑크 날짜: 연애운이 특히 강한 날</p>
      </div>

      <div class="lock-list">
        <div class="lock-item li-ch1">
          <span class="li-ico">📅</span>
          <div class="li-body"><strong>솔로탈출 시기</strong><p class="blur-t"><%= cy %>년 ■■월, 이 시기에 ■■■■■■■■ 가능성이 집중됩니다.</p></div>
          <span class="li-lock">🔒</span>
        </div>
        <div class="lock-item li-ch1">
          <span class="li-ico">🎯</span>
          <div class="li-body"><strong>인만추 vs 자만추</strong><p class="blur-t">■■ 통해 만날 확률 ■■%, ■■■■ 시기가 가장 유리합니다.</p></div>
          <span class="li-lock">🔒</span>
        </div>
        <div class="lock-item li-ch1">
          <span class="li-ico">📍</span>
          <div class="li-body"><strong>그 사람을 만나게 될 장소</strong><p class="blur-t">■■■, ■■■ 에서 만날 확률이 높으며 ■■■■ 환경이 핵심입니다.</p></div>
          <span class="li-lock">🔒</span>
        </div>
        <div class="lock-item li-ch1">
          <span class="li-ico">👥</span>
          <div class="li-body"><strong>주변인 vs 새로 알게 될 사람</strong><p class="blur-t">이미 아는 ■■■■ 가능성 vs 새로 만나는 ■■■■■ 심층 분석</p></div>
          <span class="li-lock">🔒</span>
        </div>
      </div>

      <div class="peek-block">
        <div class="peek-title">미리보기로 한 줄만 보여드리면</div>
        <div class="peek-lines">
          <div class="peek-line">
            <span class="peek-ico">💗</span>
