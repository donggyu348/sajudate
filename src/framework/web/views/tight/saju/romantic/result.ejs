<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  const CHEONGAN_MAP = {
    "갑":"甲","을":"乙","병":"丙","정":"丁","무":"戊",
    "기":"己","경":"庚","신":"辛","임":"壬","계":"癸"
  };
  const JIJI_MAP = {
    "자":"子","축":"丑","인":"寅","묘":"卯","진":"辰","사":"巳",
    "오":"午","미":"未","신":"申","유":"酉","술":"戌","해":"亥"
  };
  const toHanjaGan = (g) => (g ? (CHEONGAN_MAP[g] || g) : null);
  const toHanjaJi = (j) => (j ? (JIJI_MAP[j] || j) : null);

  const pillars = [
    { label: "시주", gan: saju.hour.gan, ji: saju.hour.ji, isMe: false },
    { label: "일주", gan: saju.day.gan, ji: saju.day.ji, isMe: true },
    { label: "월주", gan: saju.month.gan, ji: saju.month.ji, isMe: false },
    { label: "년주", gan: saju.year.gan, ji: saju.year.ji, isMe: false },
  ];

  const g = String(userInfo.gender || "").trim();
  let genderKey = "man";
  if (["여", "여자", "여성", "female", "F", "woman"].includes(g)) genderKey = "woman";
  if (["남", "남자", "남성", "male", "M", "man"].includes(g)) genderKey = "man";

  const partnerImagePool = {
    man: ["Rectangle 157.png", "Rectangle 159.png", "Rectangle 160.png", "Rectangle 161.png", "Rectangle 162.png"],
    woman: ["Rectangle 152.png", "Rectangle 153.png", "Rectangle 154.png", "Rectangle 155.png", "Rectangle 156.png"],
  };
  const partnerFile = partnerImagePool[genderKey][Math.floor(Math.random() * partnerImagePool[genderKey].length)];
  const partnerImageSrc = `/assets/images/tight/romantic/result/${genderKey}/${encodeURIComponent(partnerFile)}`;

  const el = saju.fiveElements;
  const elementSlots = [
    { hanja: "金", key: "금", value: el.금, left: "49.6%", top: "23.6%", color: "metal" },
    { hanja: "水", key: "수", value: el.수, left: "18.06%", top: "24.45%", color: "water" },
    { hanja: "火", key: "화", value: el.화, left: "80.91%", top: "24.45%", color: "fire" },
    { hanja: "木", key: "목", value: el.목, left: "69.46%", top: "25.95%", color: "wood" },
    { hanja: "土", key: "토", value: el.토, left: "30.28%", top: "25.9%", color: "earth" },
  ];
%>

<head>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: #0a0a0c;
    }

    .page {
      max-width: 393px;
      margin: 0 auto;
      padding-bottom: 71px;
    }

    .preview-wrap {
      position: relative;
      width: 100%;
    }

    .preview-img {
      display: block;
      width: 100%;
      height: auto;
    }

    /* 곧 만나게 될 당신의 연애 상대 — 성별별 사진 동적 삽입용 빈 슬롯 */
    .partner-photo-slot {
      position: absolute;
      left: 38.17%;
      top: 10.815%;
      width: 24.17%;
      height: 1.499%;
      overflow: hidden;
      border-radius: 4px;
      background: rgba(20, 16, 24, 0.6);
    }

    .partner-photo-slot img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    /* 당신의 홍연을 이루는 운명 구조 — 천간지지 */
    .destiny-pillars-slot {
      --pillar-gan-ji-gap: 70px; /* 천간 ↔ 지지 간격 (이 값으로 조절) */
      --pillar-hanja-kr-gap: 1px; /* 한자 ↔ 한글 간격 */
      position: absolute;
      left: 17.7%;
      top: 20.85%;
      width: 70.6%;
      height: auto;
      pointer-events: none;
    }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 5px;
      width: 100%;
    }

    .pillar-card {
      display: flex;
      flex-direction: column;
      background: transparent;
      border: none;
      box-shadow: none;
    }

    .pillar-body {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--pillar-gan-ji-gap);
    }

    .pillar-half {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pillar-cell {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--pillar-hanja-kr-gap);
    }

    .pillar-kr {
      font-family: 'Noto Serif KR', sans-serif;
      font-size: clamp(12px, 3.8vw, 16px);
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.02em;
      color: rgba(243, 230, 200, 0.55);
    }

    .pillar-hanja {
      font-family: 'Noto Serif KR', 'GyeonggiBatang', Georgia, serif;
      font-weight: 700;
      font-size: clamp(28px, 9vw, 40px);
      line-height: 1;
      letter-spacing: 0.04em;
      background: linear-gradient(180deg, #fff8ef 0%, #e6c27a 55%, #c9a066 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .pillar-unknown {
      font-size: clamp(24px, 7vw, 34px);
      color: rgba(255, 255, 255, 0.22);
      -webkit-text-fill-color: rgba(255, 255, 255, 0.22);
      background: none;
    }

    /* 오행 개수 */
    .five-elements-slot {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .element-count {
      position: absolute;
      transform: translate(-50%, 0);
      font-family: 'Noto Serif KR', sans-serif;
      font-size: clamp(14px, 4.2vw, 20px);
      font-weight: 700;
      line-height: 1;
      text-align: center;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    }

    .element-count.metal { color: #e8e8e8; }
    .element-count.water { color: #9ec5e8; }
    .element-count.fire  { color: #ff9aaa; }
    .element-count.wood  { color: #9fd4b0; }
    .element-count.earth { color: #e6d4a8; }

    /* 잠금 해제 버튼 */
    .unlock-btn {
      position: absolute;
      z-index: 10;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      margin: 0;
      padding: 0 14px;
      border: 1px solid rgba(243, 230, 200, 0.22);
      border-radius: 999px;
      background: rgba(22, 16, 28, 0.94);
      color: rgba(255, 255, 255, 0.88);
      font-family: 'Noto Serif KR', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(8px);
      -webkit-tap-highlight-color: transparent;
    }

    .unlock-btn:hover {
      background: rgba(32, 22, 38, 0.96);
      border-color: rgba(255, 77, 141, 0.35);
    }

    .unlock-btn:active {
      transform: scale(0.97);
    }

    .unlock-btn--partner {
      left: 34.6%;
      top: 13.24%;
      width: 31.04%;
      min-height: 32px;
      padding: 9px 10px;
    }

    .unlock-btn--relation {
      left: 33.84%;
      top: 15.43%;
      width: 31.04%;
      min-height: 32px;
      padding: 9px 10px;
    }

    .fixed-cta {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 393px;
      z-index: 100;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      cursor: pointer;
    }

    .fixed-cta img {
      display: block;
      width: 100%;
      height: auto;
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="preview-wrap">
      <img
        class="preview-img"
        src="/assets/images/tight/romantic/preview/result-full.png"
        alt="연화가 읽어낸 당신의 홍연 보고서"
        width="393"
        height="10671"
        loading="eager"
        decoding="async"
      >
      <div class="partner-photo-slot" aria-label="곧 만나게 될 당신의 연애 상대 사진">
        <img src="<%= partnerImageSrc %>" alt="곧 만나게 될 당신의 연애 상대">
      </div>

      <div class="destiny-pillars-slot" aria-label="당신의 홍연을 이루는 운명 구조">
        <div class="pillars-grid">
          <% pillars.forEach(function(p) {
            const ganHanja = toHanjaGan(p.gan);
            const jiHanja = toHanjaJi(p.ji);
            const isUnknown = !ganHanja || !jiHanja;
          %>
            <div class="pillar-card<%= p.isMe ? ' is-me' : '' %>">
              <div class="pillar-body">
                <div class="pillar-half pillar-gan">
                  <% if (isUnknown) { %>
                    <div class="pillar-cell">
                      <span class="pillar-hanja pillar-unknown">－</span>
                    </div>
                  <% } else { %>
                    <div class="pillar-cell">
                      <span class="pillar-hanja"><%= ganHanja %></span>
                      <span class="pillar-kr"><%= p.gan %></span>
                    </div>
                  <% } %>
                </div>
                <div class="pillar-half pillar-ji">
                  <% if (isUnknown) { %>
                    <div class="pillar-cell">
                      <span class="pillar-hanja pillar-unknown">－</span>
                    </div>
                  <% } else { %>
                    <div class="pillar-cell">
                      <span class="pillar-hanja"><%= jiHanja %></span>
                      <span class="pillar-kr"><%= p.ji %></span>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="five-elements-slot" aria-label="오행 개수">
        <% elementSlots.forEach(function(item) { %>
          <span
            class="element-count <%= item.color %>"
            style="left:<%= item.left %>;top:<%= item.top %>;"
            aria-label="<%= item.key %> <%= item.value %>"
          ><%= item.value %></span>
        <% }); %>
      </div>

      <button type="button" class="unlock-btn unlock-btn--partner js-payment-submit" aria-label="잠금 해제 후 확인">
        🔒 잠금 해제 후 확인
      </button>
      <button type="button" class="unlock-btn unlock-btn--relation js-payment-submit" aria-label="잠금 해제 후 확인">
        🔒 잠금 해제 후 확인
      </button>
    </div>
  </div>

  <form method="POST" action="<%= userInfo.name === '관리자' ? '/saju/skip-payment' : '/saju/payment' %>" class="hidden">
    <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
    <input type="hidden" name="sample" value='<%= JSON.stringify(sample) %>' />
    <input type="hidden" name="goodsType" value="ROMANTIC" />
  </form>

  <div class="fixed-cta js-payment-submit" id="floating-btn" role="button" tabindex="0">
    <img
      src="/assets/images/tight/romantic/landing/cta-fixed.png?v=2"
      alt="🌸 홍연 보고서 잠금 해제"
      width="389"
      height="71"
    >
  </div>

  <script>
    $(document).ready(function() {
      function goPayment() {
        document.querySelector('form').submit();
      }

      document.querySelectorAll('.js-payment-submit').forEach(function(el) {
        el.addEventListener('click', goPayment);
        el.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            goPayment();
          }
        });
      });

      if (window.karrotPixel) window.karrotPixel.track('Lead');
    });
  </script>
</body>
</html>
