            <span class="ri-pillar"><%= r.pillar %></span>
            <span class="ri-date"><%= dt %></span>
            <span class="ri-stars"><%= "⭐".repeat(r.stars || 5) %></span>
          </div>
          <div class="ri-body">
            <% r.text.forEach(function(line){ %>
              <p><%= line %></p>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </div>

    <details class="reviews-more">
      <summary class="rm-summary">
        <span class="rm-title">리뷰 더 보기</span>
        <span class="rm-sub">비슷한 톤의 후기 더 모아뒀어요</span>
      </summary>
      <div class="rm-body">
        <% moreReviewItems.forEach(function(r, idx){ const dt = fmtYmd(daysAgo(offsets[(idx+7) % offsets.length])); %>
          <div class="rm-item">
            <div class="rm-headline"><%= r.headline %></div>
            <div class="rm-email"><%= r.email %></div>
            <div class="rm-metaRow">
              <span class="rm-pillar"><%= r.pillar %></span>
              <span class="rm-date"><%= dt %></span>
              <span class="rm-stars"><%= "⭐".repeat(r.stars || 5) %></span>
            </div>
            <p class="rm-text"><%= r.text %></p>
          </div>
        <% }); %>
      </div>
    </details>
  </section>

</div>

<!-- Form -->
<form method="POST" action="<%= userInfo.name === '관리자' ? '/saju/skip-payment' : '/saju/payment' %>" class="r-form">
  <input type="hidden" name="userInfo"  value='<%= JSON.stringify(userInfo) %>' />
  <input type="hidden" name="sample"    value='<%= JSON.stringify(sample) %>' />
  <input type="hidden" name="goodsType" value='ROMANTIC' />
</form>

<!-- Floating -->
<div id="floating-btn">
  <div class="fb-inner">
    <div class="fb-top">
      <span class="fb-label">⏰ 할인 종료까지</span>
      <span id="countdown-time">60:00:000</span>
    </div>
    <button class="fb-btn unlock-btn">연애운 전체 보기 →</button>
  </div>
</div>

