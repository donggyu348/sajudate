.cc-love{background:#fce4ec;color:#c2185b;font-weight:700;border-radius:7px}
.ldot{
  font-style:normal;position:absolute;bottom:2px;left:50%;transform:translateX(-50%);
  width:3px;height:3px;border-radius:50%;background:#e91e63;
}
.cal-note{font-size:11px;color:#c4a0b8;text-align:center;margin-top:10px}

/* ══ LOCK LIST ══ */
.lock-list{display:flex;flex-direction:column;gap:10px;margin-bottom:20px}
.lock-item{
  display:flex;align-items:flex-start;gap:12px;
