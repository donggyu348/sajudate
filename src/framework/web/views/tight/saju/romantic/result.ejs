<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  const CHEONGAN_MAP = {
    "갑":"甲","을":"乙","병":"丙","정":"丁","무":"戊",
    "기":"己","경":"庚","신":"辛","임":"壬","계":"癸"
  };
  const JIJI_MAP = {
    "자":"子","축":"丑","인":"寅","묘":"卯","진":"辰","사":"巳",
    "오":"午","미":"未","신":"申","유":"酉","술":"戌","해":"亥"
  };
  const toHanjaGan = (g) => (g ? (CHEONGAN_MAP[g] || g) : null);
  const toHanjaJi = (j) => (j ? (JIJI_MAP[j] || j) : null);

  const pillars = [
    { label: "시주", gan: saju.hour.gan, ji: saju.hour.ji, isMe: false },
    { label: "일주", gan: saju.day.gan, ji: saju.day.ji, isMe: true },
    { label: "월주", gan: saju.month.gan, ji: saju.month.ji, isMe: false },
    { label: "년주", gan: saju.year.gan, ji: saju.year.ji, isMe: false },
  ];

  const el = saju.fiveElements;
  const elementSlots = [
    { hanja: "金", key: "금", value: el.금, left: "49.53%", top: "76.03%", color: "metal" },
    { hanja: "水", key: "수", value: el.수, left: "17.91%", top: "79.7%", color: "water" },
    { hanja: "火", key: "화", value: el.화, left: "81.15%", top: "79.7%", color: "fire" },
    { hanja: "木", key: "목", value: el.목, left: "69.32%", top: "86%", color: "wood" },
    { hanja: "土", key: "토", value: el.토, left: "29.48%", top: "86%", color: "earth" },
  ];
%>

<head>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: #0a0a0c;
    }

    .page {
      max-width: 393px;
      margin: 0 auto;
      padding-bottom: 96px;
    }

    .preview-wrap {
      position: relative;
      width: 100%;
    }

    .preview-img {
      display: block;
      width: 100%;
      height: auto;
    }

    /* 당신의 홍연을 이루는 운명 구조 — 천간지지 */
    .destiny-pillars-slot {
      --pillar-gan-ji-gap: 70px;
      --pillar-hanja-kr-gap: 1px;
      position: absolute;
      left: 15.42%;
      top: 61.95%;
      width: 74.04%;
      height: auto;
      pointer-events: none;
    }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      width: 100%;
    }

    .pillar-card {
      display: flex;
      flex-direction: column;
      background: transparent;
      border: none;
      box-shadow: none;
    }

    .pillar-body {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--pillar-gan-ji-gap);
    }

    .pillar-half {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pillar-cell {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--pillar-hanja-kr-gap);
    }

    .pillar-kr {
      font-family: 'Noto Serif KR', sans-serif;
      font-size: clamp(12px, 3.8vw, 16px);
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.02em;
      color: rgba(243, 230, 200, 0.55);
    }

    .pillar-hanja {
      font-family: 'Noto Serif KR', 'GyeonggiBatang', Georgia, serif;
      font-weight: 700;
      font-size: clamp(28px, 9vw, 40px);
      line-height: 1;
      letter-spacing: 0.04em;
      background: linear-gradient(180deg, #fff8ef 0%, #e6c27a 55%, #c9a066 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .pillar-unknown {
      font-size: clamp(24px, 7vw, 34px);
      color: rgba(255, 255, 255, 0.22);
      -webkit-text-fill-color: rgba(255, 255, 255, 0.22);
      background: none;
    }

    /* 오행 개수 */
    .five-elements-slot {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .element-count {
      position: absolute;
      transform: translate(-50%, -50%);
      font-family: 'Noto Serif KR', sans-serif;
      font-size: clamp(14px, 4.2vw, 20px);
      font-weight: 700;
      line-height: 1;
      text-align: center;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    }

    .element-count.metal { color: #e8e8e8; }
    .element-count.water { color: #9ec5e8; }
    .element-count.fire  { color: #ff9aaa; }
    .element-count.wood  { color: #9fd4b0; }
    .element-count.earth { color: #e6d4a8; }

    /* 연애 성향 미리보기 */
    .love-tendency-preview {
      position: absolute;
      left: 5%;
      top: 90%;
      width: 90%;
      z-index: 5;
      padding: 0 4px 12px;
      background: transparent;
      pointer-events: none;
    }

    .love-tendency-preview__title {
      margin: 0 0 14px;
      font-family: 'Noto Serif KR', serif;
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #fff;
      text-shadow: 1px 1px 2.6px rgba(0, 0, 0, 0.8);
    }

    .love-tendency-preview__title em {
      font-style: normal;
      color: #f5c0cf;
    }

    .love-tendency-preview__text {
      margin: 0;
      font-family: 'Noto Serif KR', serif;
      font-size: 13px;
      line-height: 1.85;
      letter-spacing: 0.02em;
      color: rgba(255, 255, 255, 0.88);
    }

    .love-tendency-preview__visible {
      display: inline;
    }

    .love-tendency-preview__blurred {
      display: inline;
      filter: blur(5px);
      user-select: none;
      color: rgba(255, 255, 255, 0.55);
    }

    .preview-wrap--section2 {
      margin-top: -1px;
    }

    .preview-wrap--section2 + .preview-wrap--section2 {
      margin-top: -1px;
    }

    .preview-wrap--section2-mid + .preview-wrap--section2-bottom {
      margin-top: -2px;
    }

    /* 섹션 2 상단: 연애 상대 얼굴 */
    .partner-photo-slot {
      position: absolute;
      left: 38.17%;
      top: 30.47%;
      width: 24.22%;
      height: 37.21%;
      overflow: hidden;
      border-radius: 10px;
      z-index: 2;
    }

    .partner-photo-slot img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }

    /* 섹션 2 중단: 타고난 연애 기질 — 사용자 이름 */
    .radar-name-slot {
      position: absolute;
      left: 18%;
      top: 4.5%;
      z-index: 2;
      max-width: 28%;
      font-family: 'Noto Serif KR', serif;
      font-size: clamp(14px, 5.1vw, 20px);
      font-weight: 400;
      color: #fff;
      letter-spacing: 0.4px;
      line-height: 1.06;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .floating-cta {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 393px;
      z-index: 9999;
      transition: transform 0.3s ease, opacity 0.3s ease;
      padding: 16px 20px;
      padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      background: #0a0a0c;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    #floating-btn.hide {
      transform: translateX(-50%) translateY(100%);
      opacity: 0;
      pointer-events: none;
    }

    .floating-cta .cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      height: 56px;
      border-radius: 12px;
      background: #e91e7a;
      color: #fff;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      box-shadow:
        0 6px 20px rgba(0, 0, 0, 0.45),
        0 2px 10px rgba(233, 30, 122, 0.35);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .floating-cta:active .cta-btn {
      transform: scale(0.98);
      box-shadow:
        0 3px 12px rgba(0, 0, 0, 0.4),
        0 1px 6px rgba(233, 30, 122, 0.3);
    }

    .floating-cta .cta-btn__arrow {
      font-size: 1.12em;
      font-weight: 700;
      line-height: 1;
      opacity: 1;
      letter-spacing: -0.05em;
      margin-left: 4px;
    }

    .floating-cta .cta-btn__text {
      line-height: 1;
    }
  </style>
</head>

<body>
  <div class="page">
    <div class="preview-wrap">
      <img
        class="preview-img"
        src="/assets/images/tight/romantic/preview/result-full.png?v=3"
        alt="연화가 읽어낸 당신의 홍연 보고서"
        width="393"
        height="2392"
        loading="eager"
        decoding="async"
      >
      <div class="destiny-pillars-slot" aria-label="당신의 홍연을 이루는 운명 구조">
        <div class="pillars-grid">
          <% pillars.forEach(function(p) {
            const ganHanja = toHanjaGan(p.gan);
            const jiHanja = toHanjaJi(p.ji);
            const isUnknown = !ganHanja || !jiHanja;
          %>
            <div class="pillar-card<%= p.isMe ? ' is-me' : '' %>">
              <div class="pillar-body">
                <div class="pillar-half pillar-gan">
                  <% if (isUnknown) { %>
                    <div class="pillar-cell">
                      <span class="pillar-hanja pillar-unknown">－</span>
                    </div>
                  <% } else { %>
                    <div class="pillar-cell">
                      <span class="pillar-hanja"><%= ganHanja %></span>
                      <span class="pillar-kr"><%= p.gan %></span>
                    </div>
                  <% } %>
                </div>
                <div class="pillar-half pillar-ji">
                  <% if (isUnknown) { %>
                    <div class="pillar-cell">
                      <span class="pillar-hanja pillar-unknown">－</span>
                    </div>
                  <% } else { %>
                    <div class="pillar-cell">
                      <span class="pillar-hanja"><%= jiHanja %></span>
                      <span class="pillar-kr"><%= p.ji %></span>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="five-elements-slot" aria-label="오행 개수">
        <% elementSlots.forEach(function(item) { %>
          <span
            class="element-count <%= item.color %>"
            style="left:<%= item.left %>;top:<%= item.top %>;"
            aria-label="<%= item.key %> <%= item.value %>"
          ><%= item.value %></span>
        <% }); %>
      </div>

      <section class="love-tendency-preview" aria-label="연애 성향 미리보기">
        <h2 class="love-tendency-preview__title">연화가 읽어낸 <em>연애 성향</em></h2>
        <p class="love-tendency-preview__text">
          <span class="love-tendency-preview__visible"><%= loveTendencyPreview.visible %></span><span class="love-tendency-preview__blurred"><%= loveTendencyPreview.blurred %></span>
        </p>
      </section>
    </div>

    <div class="preview-wrap preview-wrap--section2">
      <img
        class="preview-img"
        src="/assets/images/tight/romantic/preview/result-section-2-top.png?v=1"
        alt="곧 만나게 될 당신의 연애 상대"
        width="393"
        height="430"
        loading="lazy"
        decoding="async"
      >
      <div class="partner-photo-slot" aria-label="곧 만나게 될 당신의 연애 상대">
        <img src="<%= romanticPreview.partnerImageSrc %>" alt="곧 만나게 될 당신의 연애 상대">
      </div>
    </div>

    <div class="preview-wrap preview-wrap--section2 preview-wrap--section2-mid">
      <img
        class="preview-img"
        src="/assets/images/tight/romantic/preview/result-section-2-mid.png?v=4"
        alt="타고난 연애 기질과 홍연 시기"
        width="393"
        height="650"
        loading="lazy"
        decoding="async"
      >
      <div class="radar-name-slot"><%= romanticPreview.userName %></div>
    </div>

    <div class="preview-wrap preview-wrap--section2 preview-wrap--section2-bottom">
      <img
        class="preview-img"
        src="/assets/images/tight/romantic/preview/result-section-2-bottom.png?v=2"
        alt="홍연 보고서 목차"
        width="393"
        height="2286"
        loading="lazy"
        decoding="async"
      >
    </div>

    <div id="result10-button" class="h-4"></div>

    <div class="preview-wrap preview-wrap--section2">
      <img
        class="preview-img"
        src="/assets/images/tight/romantic/landing/landing-full.png?v=6"
        alt="연애사주 — 당신의 사주 속, 홍연의 흐름을 읽어드립니다"
        width="393"
        height="7100"
        loading="lazy"
        decoding="async"
      >
    </div>
  </div>

  <form method="POST" action="<%= userInfo.name === '관리자' ? '/saju/skip-payment' : '/saju/payment' %>" class="hidden">
    <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
    <input type="hidden" name="sample" value='<%= JSON.stringify(sample) %>' />
    <input type="hidden" name="goodsType" value="ROMANTIC" />
  </form>

  <div id="floating-btn" class="floating-cta">
    <div class="cta-btn">
      <span class="cta-btn__text">나의 홍연 리포트 확인하기</span>
      <span class="cta-btn__arrow" aria-hidden="true">--></span>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var form = document.querySelector("form");
      var floatingBtn = document.getElementById("floating-btn");
      var target = document.getElementById("result10-button");

      if (floatingBtn && target) {
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) floatingBtn.classList.add("hide");
            else floatingBtn.classList.remove("hide");
          });
        }, { threshold: 0.1 });
        observer.observe(target);
      }

      if (floatingBtn) {
        floatingBtn.addEventListener("click", function () {
          if (form) form.submit();
        });
      }

      if (window.karrotPixel) window.karrotPixel.track("Lead");
    });
  </script>
</body>
</html>
