  box-shadow:0 8px 28px rgba(0,0,0,0.2);
  transition:transform 120ms ease;letter-spacing:-0.02em;
}
.fc-btn:active{transform:scale(0.98)}

/* ══ FLOATING ══ */
#floating-btn{
  position:fixed;bottom:0;left:50%;transform:translateX(-50%);
  width:100%;max-width:480px;z-index:9999;
  padding:12px 16px 20px;
  background:linear-gradient(to top,rgba(255,245,251,0.98) 0%,transparent 100%);
  pointer-events:none;
  transition:opacity 280ms ease;
}
#floating-btn.hide{opacity:0;pointer-events:none}
.fb-inner{
  background:#fff;border:1.5px solid #f8bbd0;
  border-radius:16px;padding:12px 16px;
  box-shadow:0 -4px 24px rgba(233,30,99,0.12);
  pointer-events:all;
}
.fb-top{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:10px}
.fb-label{font-size:12px;color:#a892b8}
#countdown-time{font-family:'Jua',sans-serif;font-size:14px;color:#e91e63;letter-spacing:0.1em}
.fb-btn{
  display:block;width:100%;padding:16px;
  border-radius:12px;
  font-family:'Jua',sans-serif;font-size:17px;color:#fff;
  background:linear-gradient(135deg,#e91e63,#c44dff);
  box-shadow:0 6px 18px rgba(233,30,99,0.35);
