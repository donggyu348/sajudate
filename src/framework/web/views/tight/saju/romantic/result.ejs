<!-- ══════════════ STYLES ══════════════ -->
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{background:#fff5fb}
button{border:none;cursor:pointer}

/* ── Page ── */
.rp{
  max-width:480px; margin:0 auto;
  background:#fff5fb;
  color:#1a0a2e;
  font-family:'Poor Story','Noto Sans KR',system-ui,sans-serif;
  padding-bottom:140px;
  overflow-x:hidden;
}

/* ══ HERO ══ */
.hero{
  position:relative;
  padding:56px 22px 48px;
  text-align:center;
  background:linear-gradient(160deg,#ff6b9d 0%,#c44dff 50%,#7b5ea7 100%);
  overflow:hidden;
}
.hero-bg-deco{
  position:absolute;inset:0;
  background-image:radial-gradient(circle,rgba(255,255,255,0.12) 1px,transparent 1px);
  background-size:32px 32px;
  pointer-events:none;
}
.hero-tag{
  display:inline-block;
  font-size:13px;color:#ffe8f4;
  background:rgba(255,255,255,0.15);
  border:1px solid rgba(255,255,255,0.25);
  padding:5px 14px;border-radius:999px;
  margin-bottom:14px;letter-spacing:0.06em;
}
.hero-title{
  font-family:'Jua',sans-serif;
  font-size:clamp(28px,7vw,38px);
  line-height:1.28;color:#fff;
  margin-bottom:16px;
  text-shadow:0 4px 20px rgba(0,0,0,0.2);
}
.hero-name-grad{
  background:linear-gradient(90deg,#fff176,#ffd54f);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero-stem{
  display:inline-flex;align-items:center;gap:8px;
  padding:8px 18px;border-radius:999px;
  background:rgba(255,255,255,0.2);
  border:1px solid rgba(255,255,255,0.35);
  margin-bottom:14px;
}
.hs-key{font-family:'Jua',sans-serif;font-size:16px;color:#fff176}
.hs-dot{color:rgba(255,255,255,0.5)}
.hs-type{font-size:13px;color:rgba(255,255,255,0.9)}
.hero-chips{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:4px}
.chip{
  font-size:12px;color:rgba(255,255,255,0.85);
  background:rgba(255,255,255,0.15);
  border:1px solid rgba(255,255,255,0.25);
  padding:5px 12px;border-radius:999px;
}
.scroll-hint{
  position:absolute;bottom:14px;left:50%;transform:translateX(-50%);
  font-size:12px;color:rgba(255,255,255,0.5);
  animation:sh 2s ease-in-out infinite;
}
@keyframes sh{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(5px)}}

/* ══ 일간 SECTION ══ */
.ilgan-section{
  padding:24px 18px 8px;
}
.ilgan-card{
  border-radius:20px;border:1.5px solid;
  padding:22px 20px 20px;
  margin-bottom:14px;
  box-shadow:0 4px 20px rgba(0,0,0,0.07);
}
.ig-top{
  display:flex;align-items:flex-start;
  justify-content:space-between;gap:12px;
  margin-bottom:14px;
}
.ig-title-wrap{display:flex;flex-direction:column;gap:4px}
.ig-tag{
  display:inline-block;font-size:11px;
  border:1px solid;border-radius:999px;
  padding:3px 10px;letter-spacing:0.05em;
  width:fit-content;
}
.ig-name{
  font-family:'Jua',sans-serif;font-size:24px;
}
.ig-type-pill{
  display:inline-flex;align-items:center;
  padding:7px 14px;border-radius:999px;
  font-size:13px;color:#fff;
  white-space:nowrap;flex-shrink:0;
  font-family:'Poor Story',sans-serif;
  box-shadow:0 4px 14px rgba(0,0,0,0.15);
}
.ig-keywords{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}
.ig-kw{
  font-size:12px;border:1px solid;border-radius:999px;
  padding:4px 11px;background:rgba(255,255,255,0.7);
}
.ig-desc{
  font-size:14px;line-height:1.7;color:#3a2a50;
  margin-bottom:16px;
}
.ig-traits{display:flex;flex-direction:column;gap:8px}
.ig-trait-row{
  padding:10px 14px;border-left:3px solid;
  border-radius:0 10px 10px 0;
  background:rgba(255,255,255,0.6);
  font-size:13px;color:#2a1a3e;line-height:1.4;
}
.dm-img-wrap{border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.1)}
.dm-img{width:100%;height:auto;display:block;object-fit:cover}

/* ══ CHAPTER ══ */
.chapter{margin-top:6px}

.ch-header{padding:28px 18px 0}
.ch1-header{background:linear-gradient(135deg,#fff0f8 0%,#fce4ec 100%)}
.ch2-header{background:linear-gradient(135deg,#fffde7 0%,#fff3e0 100%)}
.ch3-header{background:linear-gradient(135deg,#e8f4fd 0%,#e3f2fd 100%)}
.ch4-header{background:linear-gradient(135deg,#f3e5f5 0%,#ede7f6 100%)}

.ch-num-row{display:flex;align-items:center;gap:8px;margin-bottom:10px}
.ch-num{
