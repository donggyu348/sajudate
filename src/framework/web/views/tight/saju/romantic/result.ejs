      </div>
      <button class="cta-btn btn-ch3 unlock-btn">🔓 그 사람 완전 분석 보기 →</button>
    </div>
  </section>

  <!-- ══ CHAPTER 4 : 19금 ══ -->
  <section class="chapter">
    <div class="ch-header ch4-header">
      <div class="ch-num-row">
        <span class="ch-num">CHAPTER 4</span>
        <span class="ch-icon">🔥</span>
        <span class="ch-wc">4,000자+</span>
