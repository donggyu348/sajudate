<script>
let _rem = 60*60*1000, _lt = performance.now();
(function tick(now){
  _rem = Math.max(0, _rem-(now-_lt)); _lt=now;
  const ms=Math.floor(_rem%1000), tot=Math.floor(_rem/1000);
  document.getElementById("countdown-time").innerText =
    String(Math.floor(tot/60)).padStart(2,"0")+":"+
    String(tot%60).padStart(2,"0")+":"+
    String(ms).padStart(3,"0");
  if(_rem>0) requestAnimationFrame(tick);
})(performance.now());

$(document).ready(function(){
  $(".unlock-btn").on("click",function(){ $(".r-form").submit(); });
  if(window.karrotPixel) window.karrotPixel.track("Lead");
});

document.addEventListener("DOMContentLoaded",function(){
  const fl=document.getElementById("floating-btn");
  const tg=document.getElementById("result10-button");
  if(fl&&tg){
    new IntersectionObserver(function(e){
      fl.classList.toggle("hide",e[0].isIntersecting);
    },{threshold:0.1}).observe(tg);
  }
});
</script>

