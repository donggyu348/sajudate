<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: #180e0a;
    }

    .page {
      max-width: 393px;
      margin: 0 auto;
      padding-bottom: 71px;
    }

    .landing-img {
      display: block;
      width: 100%;
      height: auto;
    }

    .fixed-cta {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 393px;
      z-index: 100;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .fixed-cta a {
      display: block;
      line-height: 0;
      text-decoration: none;
    }

    .fixed-cta img {
      display: block;
      width: 100%;
      height: auto;
    }
  </style>
</head>

<body>
  <div class="page">
    <img
      class="landing-img"
      src="/assets/images/tight/romantic/landing/landing-full.png"
      alt="연애사주 — 당신의 사주 속, 홍연의 흐름을 읽어드립니다"
      width="393"
      height="7102"
      loading="eager"
      decoding="async"
    >
  </div>

  <div class="fixed-cta">
    <a href="/saju/romantic/input">
      <img
        src="/assets/images/tight/romantic/landing/cta-fixed.png?v=2"
        alt="🌸 3초만에 나의 연애운 미리보기"
        width="389"
        height="71"
      >
    </a>
  </div>

  <script>
    $(document).ready(function(){
      if(window.karrotPixel) window.karrotPixel.track('ViewContent');
    });
  </script>
</body>
</html>
