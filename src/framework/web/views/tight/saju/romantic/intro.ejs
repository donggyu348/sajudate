<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jua&family=Poor+Story&display=swap" rel="stylesheet">
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
  <style>
    :root {
      /* 텍스트 위치(배경 보고 여기만 미세조정하면 됨) */
      --hero-top: 48%;
      --hero-translate-y: -50%;
    }

    /* 1. 배경 흰색 노출 원천 차단 */
    html, body {
      margin: 0;
      padding: 0;
      background-color: #0f0c12 !important;
      height: 100%;
      width: 100%;
      overflow: hidden;
    }

    .frame-wrap {
      display: flex;
      justify-content: center;
      background-color: #0f0c12;
      height: 100%;
    }

    /* 2. 모바일 주소창 대응 높이 설정 */
    .video-stage {
      position: relative;
      width: 100%;
      max-width: 448px;
      /* 스크립트로 계산된 --vh 값을 사용하거나, 지원 안될 시 100vh 사용 */
      height: 100vh;
      height: calc(var(--vh, 1vh) * 100);
      overflow: hidden;
    }

    /* 3. 배경(흑묘 사주 인트로) — 9:19.5(576x1248) 세로 이미지라 cover로 꽉 채움
       - cover: 화면을 꽉 채우며 버튼 위치까지 이미지가 내려옴(여백 없음)
       - 비율이 폰과 거의 일치해 타이틀 좌우가 잘리지 않음
       - center top: 상단(타이틀/얼굴) 고정, 필요 시 하단만 미세 크롭 */
    .bg-stage {
      position: absolute;
      inset: 0;
      background-image: url('/assets/images/tight/romantic/intro/intro.jpg');
      background-size: cover;
      background-position: center top;
      background-repeat: no-repeat;
    }

    /* 4. 오버레이 및 그라데이션 수정 */
    .overlay-wrap {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      padding: 0 24px;
      pointer-events: none;
    }

    .hero {
      position: absolute;
      left: 50%;
      top: var(--hero-top);
      transform: translate(-50%, var(--hero-translate-y));
      width: min(420px, calc(100% - 40px));
      z-index: 5;
      pointer-events: none;
      animation: heroIn 780ms cubic-bezier(.2,.85,.2,1) both;
    }

    .speech {
      position: relative;
      margin: 0 auto;
      width: 100%;
      padding: 0;
      border-radius: 0;
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      box-shadow: none;
      border: none;
      animation: floaty 5.2s ease-in-out infinite;
    }

    .speech::after {
      content: "";
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: -12px;
      width: 22px;
      height: 22px;
      display: none;
    }

    .romantic-title {
      font-family: 'Jua', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: clamp(34px, 8.6vw, 50px);
      font-weight: 400;
      color: #fffaf2;
      letter-spacing: -0.04em;
      margin: 0 0 12px;
      text-shadow:
        0 14px 32px rgba(0,0,0,0.62),
        0 0 28px rgba(226, 200, 152, 0.20);
      -webkit-text-stroke: 0.8px rgba(0,0,0,0.35);
    }

    .romantic-sub {
      font-family: 'Poor Story', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: clamp(16px, 4.2vw, 20px);
      line-height: 1.65;
      color: rgba(255, 245, 228, 0.96);
      text-shadow: 0 10px 22px rgba(0,0,0,0.52);
      margin: 0;
    }

    .mini-points {
      margin: 18px auto 0;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 10px;
      pointer-events: none;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border-radius: 999px;
      background: rgba(15, 12, 18, 0.54);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: rgba(255, 245, 228, 0.92);
      font-family: 'Poor Story', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 13px;
      line-height: 1;
      white-space: nowrap;
      box-shadow: 0 14px 30px rgba(0,0,0,0.42);
    }

    .chip b {
      font-family: 'Jua', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-weight: 400;
      color: #fffaf2;
    }

    .chip i {
      font-style: normal;
      opacity: 0.9;
    }

    .spark {
      display: inline-block;
      /* 배경에 묻히지 않도록 더 밝은 샴페인-골드 톤 */
      background: linear-gradient(
        90deg,
        rgba(255, 219, 170, 0.35) 0%,
        rgba(255, 255, 255, 0.92) 46%,
        rgba(255, 200, 214, 0.55) 58%,
        rgba(255, 219, 170, 0.35) 100%
      );
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      background-size: 220% 100%;
      animation: shimmer 2.8s ease-in-out infinite;
      text-shadow:
        0 10px 22px rgba(0,0,0,0.55),
        0 0 26px rgba(255, 223, 170, 0.22);
    }

    /* 5. CTA 버튼 위치 최적화 */
    .cta-wrapper {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: 28px; /* 바닥에 딱 붙지 않게 여유 */
      width: calc(100% - 48px);
      max-width: 400px;
      z-index: 10;
      animation: ctaIn 920ms cubic-bezier(.2,.85,.2,1) 120ms both;
    }

    .proof-wrap {
      width: 100%;
      margin-bottom: 10px;
      display: flex;
      justify-content: center;
      pointer-events: none;
    }

    .proof-ticker {
      position: relative;
      width: 100%;
      border-radius: 999px;
      background: rgba(10, 8, 14, 0.62);
      border: 1px solid rgba(226, 200, 152, 0.55);
      box-shadow: 0 14px 30px rgba(0,0,0,0.46);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      overflow: hidden;
      padding: 10px 12px;
    }

    .proof-ticker::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(226, 200, 152, 0.14) 0%, rgba(226, 200, 152, 0.00) 60%);
      pointer-events: none;
    }

    .proof-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 999px;
      background: rgba(226, 200, 152, 0.16);
      border: 1px solid rgba(226, 200, 152, 0.40);
      margin-right: 8px;
      flex: 0 0 auto;
    }

    .proof-line {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-family: 'Poor Story', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 14px;
      color: rgba(255, 245, 228, 0.94);
      letter-spacing: -0.01em;
      text-shadow: 0 10px 18px rgba(0,0,0,0.55);
      white-space: nowrap;
      line-height: 20px;
      height: 20px;
    }

    .proof-viewport {
      position: relative;
      height: 20px;
      overflow: hidden;
      width: 100%;
    }

    .proof-list {
      margin: 0;
      padding: 0;
      list-style: none;
      animation: proofSlide 7.2s cubic-bezier(.2,.85,.2,1) infinite;
    }

    .proof-list li {
      height: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .proof-strong {
      font-family: 'Jua', system-ui, -apple-system, "Segoe UI", sans-serif;
      color: #fffaf2;
    }

    .cta-banner {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 100%;
      min-height: 72px;
      padding: 18px 18px;
      background: rgba(15, 12, 18, 0.72);
      border-radius: 14px;
      text-decoration: none;
      color: #fffaf2;
      box-shadow: 0 18px 40px rgba(0,0,0,0.55);
      border: 1px solid rgba(226, 200, 152, 0.75);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      transition: transform 140ms ease, box-shadow 140ms ease, background-color 140ms ease;
    }

    .cta-meta {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 10px;
      font-family: 'Poor Story', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 12px;
      color: rgba(255, 245, 228, 0.78);
      text-shadow: 0 10px 18px rgba(0,0,0,0.55);
      pointer-events: none;
    }

    .cta-meta span {
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(15, 12, 18, 0.46);
      border: 1px solid rgba(255, 255, 255, 0.10);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      white-space: nowrap;
    }

    .cta-banner::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(226, 200, 152, 0.18) 0%, rgba(226, 200, 152, 0.00) 55%);
      border-radius: inherit;
      pointer-events: none;
    }

    .cta-kicker {
      font-family: 'Poor Story', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 14px;
      opacity: 0.92;
      letter-spacing: -0.01em;
    }

    .cta-main {
      font-family: 'Jua', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 20px;
      line-height: 1.2;
      letter-spacing: -0.03em;
      text-shadow: 0 10px 22px rgba(0,0,0,0.38);
    }

    .cta-banner:hover {
      transform: translateY(-1px);
      box-shadow: 0 22px 48px rgba(0,0,0,0.62);
      background: rgba(15, 12, 18, 0.78);
    }

    .cta-banner:active {
      transform: translateY(0px);
      box-shadow: 0 16px 34px rgba(0,0,0,0.55);
    }

    @keyframes heroIn {
      from { opacity: 0; transform: translate(-50%, calc(var(--hero-translate-y) + 10px)) scale(0.985); }
      to { opacity: 1; transform: translate(-50%, var(--hero-translate-y)) scale(1); }
    }

    @keyframes ctaIn {
      from { opacity: 0; transform: translateX(-50%) translateY(10px); }
      to { opacity: 1; transform: translateX(-50%) translateY(0); }
    }

    @keyframes floaty {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }

    @keyframes shimmer {
      0% { background-position: 110% 0; opacity: 0.85; }
      50% { opacity: 1; }
      100% { background-position: -10% 0; opacity: 0.85; }
    }

    @keyframes proofSlide {
      0% { transform: translateY(0); }
      28% { transform: translateY(0); }
      36% { transform: translateY(-20px); }
      61% { transform: translateY(-20px); }
      69% { transform: translateY(-40px); }
      94% { transform: translateY(-40px); }
      100% { transform: translateY(-60px); } /* 마지막은 첫 줄과 자연스럽게 연결 */
    }

    .bottom-fade {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 220px;
      background: linear-gradient(to top, rgba(8, 5, 14, 0.88) 0%, rgba(8, 5, 14, 0.0) 100%);
      pointer-events: none;
      z-index: 5;
    }

    .cta-wrap {
      position: absolute;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 400px;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      animation: ctaIn 700ms cubic-bezier(.2,.85,.2,1) 100ms both;
    }

    .proof-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 16px;
      border-radius: 999px;
      background: rgba(10, 8, 18, 0.70);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      font-family: 'Poor Story', system-ui, -apple-system, sans-serif;
      font-size: 13px;
      color: rgba(255, 245, 228, 0.90);
      white-space: nowrap;
    }

    .proof-badge strong {
      font-family: 'Jua', system-ui, -apple-system, sans-serif;
      font-weight: 400;
      color: #ffcce0;
    }

    .cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 20px 24px;
      border-radius: 999px;
      text-decoration: none;
      font-family: 'Jua', system-ui, -apple-system, sans-serif;
      font-size: 19px;
      letter-spacing: -0.02em;
      color: #fff;
      background: #e8366e;
      box-shadow: 0 8px 28px rgba(232, 54, 110, 0.45), 0 2px 8px rgba(0,0,0,0.3);
      transition: transform 130ms ease, filter 130ms ease;
    }

    .cta-btn:active {
      transform: scale(0.97);
      filter: brightness(0.9);
    }

    @keyframes ctaIn {
      from { opacity: 0; transform: translateX(-50%) translateY(12px); }
      to   { opacity: 1; transform: translateX(-50%) translateY(0); }
    }

    /* ===== 생동감 FX: A 떠다니는 캡슐 · C 고양이 눈 발광 · D 타이틀/버튼 ===== */
    .fx { position: absolute; inset: 0; z-index: 4; pointer-events: none; }

    /* D-1) 네온 타이틀 뒤 초록 글로우가 숨쉬듯 맥동 */
    .title-glow {
      position: absolute; left: 50%; top: 11%;
      transform: translate(-50%, -50%);
      width: 76%; height: 120px; border-radius: 50%;
      background: radial-gradient(ellipse at center, rgba(96,255,176,0.30) 0%, rgba(96,255,176,0) 70%);
      filter: blur(6px); mix-blend-mode: screen;
      animation: titleBreath 3.6s ease-in-out infinite;
    }
    @keyframes titleBreath {
      0%,100% { opacity: .40; transform: translate(-50%,-50%) scale(.97); }
      50%     { opacity: .90; transform: translate(-50%,-50%) scale(1.05); }
    }

    /* C) 어둠 속 검은 고양이들 눈이 초록으로 깜빡·발광 (서로 다른 리듬) */
    .eye-glow {
      position: absolute; width: 26px; height: 26px;
      transform: translate(-50%, -50%); border-radius: 50%;
      background: radial-gradient(circle, rgba(150,255,190,0.95) 0%, rgba(90,240,150,0.5) 38%, rgba(70,220,130,0) 72%);
      mix-blend-mode: screen;
      animation: eyePulse 2.8s ease-in-out infinite;
    }
    .eye-glow.e-l  { left: 17%; top: 48%; }
    .eye-glow.e-r1 { left: 88%; top: 44%; animation-duration: 3.5s; animation-delay: .6s; }
    .eye-glow.e-r2 { left: 88%; top: 50%; animation-duration: 2.2s; animation-delay: 1.1s; }
    @keyframes eyePulse {
      0%,100% { opacity: .30; transform: translate(-50%,-50%) scale(.80); }
      45%     { opacity: 1;   transform: translate(-50%,-50%) scale(1.15); }
    }

    /* A) 떠다니는 캡슐(후크 카피)이 둥실둥실 부유 */
    .floaties { position: absolute; inset: 0; z-index: 6; pointer-events: none; }
    .cap {
      position: absolute; display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 14px; border-radius: 999px; white-space: nowrap;
      font-family: 'Pretendard', system-ui, -apple-system, "Segoe UI", sans-serif;
      font-size: 13px; font-weight: 600; letter-spacing: -0.02em; color: #eafff2;
      background: rgba(10, 20, 16, 0.55);
      border: 1px solid rgba(120, 255, 180, 0.40);
      box-shadow: 0 8px 24px rgba(0,0,0,0.45), 0 0 16px rgba(80,240,150,0.18);
      backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      opacity: 0;
      animation: capIn .7s ease both, capFloat 5s ease-in-out infinite;
    }
    .cap.c1 { left: 6%;  top: 29%; animation-delay: .3s, .9s; }
    .cap.c2 { right: 6%; top: 39%; animation-delay: .6s, 1.4s; }
    .cap.c3 { left: 9%;  top: 57%; animation-delay: .9s, .5s; }
    @keyframes capIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes capFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }

    /* D-2) CTA 버튼이 은은하게 숨쉬며 시선 유도 */
    .cta-btn { animation: ctaBreath 2.4s ease-in-out infinite; }
    @keyframes ctaBreath {
      0%,100% { box-shadow: 0 8px 28px rgba(232,54,110,.45), 0 2px 8px rgba(0,0,0,.3); }
      50%     { box-shadow: 0 10px 40px rgba(232,54,110,.80), 0 0 22px rgba(232,54,110,.5); }
    }

    @media (prefers-reduced-motion: reduce) {
      .cta-wrap, .cta-btn, .cap, .eye-glow, .title-glow { animation: none !important; }
      .cap { opacity: 1 !important; }
    }
  </style>
</head>

<body>
  <div class="frame-wrap">
    <div class="video-stage">
      <div class="bg-stage" aria-hidden="true"></div>

      <!-- C) 고양이 눈 발광 + D) 타이틀 글로우 -->
      <div class="fx" aria-hidden="true">
        <span class="title-glow"></span>
        <span class="eye-glow e-l"></span>
        <span class="eye-glow e-r1"></span>
        <span class="eye-glow e-r2"></span>
      </div>

      <div class="bottom-fade" aria-hidden="true"></div>

      <!-- A) 떠다니는 캡슐(후크 카피) -->
      <div class="floaties" aria-hidden="true">
        <span class="cap c1">🖤 나를 거부 못하는 이성</span>
        <span class="cap c2">😼 치명적 매력 지수</span>
        <span class="cap c3">🥀 무릎 꿇을 상대</span>
      </div>

      <div class="cta-wrap">
        <a href="/saju/romantic/input" class="cta-btn">
          무료로 나의 연애운 미리보기
        </a>
      </div>
    </div>
  </div>

  <script>
    /* 1. 모바일 주소창 높이 보정 스크립트 */
    function setVh() {
      let vh = window.innerHeight * 0.01;
      document.documentElement.style.setProperty('--vh', `${vh}px`);
    }
    window.addEventListener('resize', setVh);
    setVh();

    /* 2. 픽셀 트래킹 */
    $(document).ready(function(){
      if(window.karrotPixel) window.karrotPixel.track('ViewContent');
    });
  </script>
</body>
</html>