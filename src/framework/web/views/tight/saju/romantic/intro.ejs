<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: #180e0a;
    }

    .page {
      max-width: 393px;
      margin: 0 auto;
      padding-bottom: 96px;
    }

    .landing-img {
      display: block;
      width: 100%;
      height: auto;
    }

    .fixed-cta {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 393px;
      z-index: 100;
      padding: 16px 20px;
      padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      background: #180e0a;
    }

    .cta-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      height: 56px;
      border: none;
      border-radius: 12px;
      background: #e91e7a;
      color: #fff;
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-decoration: none;
      cursor: pointer;
      box-shadow:
        0 6px 20px rgba(0, 0, 0, 0.45),
        0 2px 10px rgba(233, 30, 122, 0.35);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .cta-btn:active {
      transform: scale(0.98);
      box-shadow:
        0 3px 12px rgba(0, 0, 0, 0.4),
        0 1px 6px rgba(233, 30, 122, 0.3);
    }

    .cta-btn__arrow {
      font-size: 1.12em;
      font-weight: 700;
      line-height: 1;
      opacity: 1;
      letter-spacing: -0.05em;
      margin-left: 4px;
    }

    .cta-btn__text {
      line-height: 1;
    }
  </style>
</head>

<body>
  <div class="page">
    <img
      class="landing-img"
      src="/assets/images/tight/romantic/landing/landing-full.png?v=6"
      alt="연애사주 — 당신의 사주 속, 홍연의 흐름을 읽어드립니다"
      width="393"
      height="7100"
      loading="eager"
      decoding="async"
    >
  </div>

  <div class="fixed-cta">
    <a href="/saju/romantic/input" class="cta-btn">
      <span class="cta-btn__text">10초안에 나의 홍연 미리보기</span>
      <span class="cta-btn__arrow" aria-hidden="true">--></span>
    </a>
  </div>

  <script>
    $(document).ready(function(){
      if(window.karrotPixel) window.karrotPixel.track('ViewContent');
    });
  </script>
</body>
</html>
