<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <style>
    /* 1. 배경 흰색 노출 원천 차단 */
    html, body {
      margin: 0;
      padding: 0;
      background-color: #1a110a !important; /* 영상 톤과 유사한 딥브라운 */
      height: 100%;
      width: 100%;
      overflow: hidden;
    }

    .frame-wrap {
      display: flex;
      justify-content: center;
      background-color: #1a110a;
      height: 100%;
    }

    /* 2. 모바일 주소창 대응 높이 설정 */
    .video-stage {
      position: relative;
      width: 100%;
      max-width: 448px;
      /* 스크립트로 계산된 --vh 값을 사용하거나, 지원 안될 시 100vh 사용 */
      height: 100vh;
      height: calc(var(--vh, 1vh) * 100);
      overflow: hidden;
    }

    /* 3. 배경 영상 꽉 채우기 */
    video {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      object-fit: cover; /* 비율 유지하며 꽉 채움 */
    }

    /* 4. 오버레이 및 그라데이션 수정 */
    .overlay-wrap {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
      padding: 0 24px;
      /* 바닥 흰색 틈을 가리기 위해 하단 그라데이션 강화 */
      background: linear-gradient(
        to top,
        rgba(26, 17, 10, 1) 0%,
        rgba(26, 17, 10, 0.4) 30%,
        rgba(0, 0, 0, 0) 70%
      );
      padding-bottom: 80px;
    }

    .romantic-title {
      font-family: 'GyeonggiBatang', serif;
      font-size: clamp(34px, 8vw, 42px);
      font-weight: 800;
      color: #fffaf2;
      letter-spacing: -0.04em;
      margin-bottom: 16px;
      text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    }

    .romantic-sub {
      font-family: 'Pretendard', sans-serif;
      font-size: clamp(15px, 3.8vw, 17px);
      line-height: 1.6;
      color: #f6e3b5;
      opacity: 0.9;
    }

    /* 5. CTA 버튼 위치 최적화 */
    .cta-wrapper {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      bottom: 34px; /* 바닥에 딱 붙지 않게 여유 */
      width: calc(100% - 48px);
      max-width: 400px;
      z-index: 10;
    }

    .cta-wood {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      height: 58px;
      background: linear-gradient(180deg, #e6cfa5 0%, #d2b07a 50%, #b8935f 100%);
      border-radius: 12px;
      text-decoration: none;
      color: #2b1d12;
      font-weight: 700;
      font-size: 17px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }

    .cta-wood::before {
      content: "";
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(90deg, rgba(255,255,255,0.05) 0px, rgba(255,255,255,0.05) 1px, transparent 1px, transparent 6px);
      border-radius: inherit;
    }
  </style>
</head>

<body>
  <div class="frame-wrap">
    <div class="video-stage">
      <video src="/assets/images/tight/romantic/intro.mp4" autoplay muted loop playsinline></video>

      <div class="overlay-wrap">
        <h1 class="romantic-title">연화의 연애사주</h1>
        <p class="romantic-sub">당신이 마주할,<br/>인연의 비밀</p>
      </div>

      <div class="cta-wrapper">
        <a href="/saju/romantic/input" class="cta-wood">
          <span class="cta-text">무료 사주 보러가기</span>
        </a>
      </div>
    </div>
  </div>

  <script>
    /* 1. 모바일 주소창 높이 보정 스크립트 */
    function setVh() {
      let vh = window.innerHeight * 0.01;
      document.documentElement.style.setProperty('--vh', `${vh}px`);
    }
    window.addEventListener('resize', setVh);
    setVh();

    /* 2. 픽셀 트래킹 */
    $(document).ready(function(){
      if(window.karrotPixel) window.karrotPixel.track('ViewContent');
    });
  </script>
</body>
</html>