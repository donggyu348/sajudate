<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<head>
  <style>
    :root {
      --gold: #d4af37;
      --white-soft: rgba(255,255,255,0.6);
      --white-dim: rgba(255,255,255,0.35);
    }

    body {
      margin: 0;
      background: #000;
      color: #fff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont;
      overflow: auto;
    }

    /* ===== STAGE ===== */
    .stage {
      max-width: 480px;
      height: 100vh;
      margin: 0 auto;
      position: relative;
      background: linear-gradient(
        180deg,
        #060101 0%,
        #090202 25%,
        #070101 50%,
        #050000 75%,
        #030000 100%
      );
    }

    .stage::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.8) 100%);
    }

    /* ===== QUESTION ===== */
    .question-layer {
      position: absolute;
      top: 38%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      padding: 0 24px;
      text-align: center;
      z-index: 5;
    }

    .question-sub {
      font-size: 11px;
      letter-spacing: 0.22em;
      opacity: 0.55;
      margin-bottom: 10px;
    }

    .question-title {
      font-size: 24px;
      font-weight: 600;
      line-height: 1.5;
      letter-spacing: -0.01em;
    }

    /* ===== STEP ===== */
    .step { display: none; }
    .step.active { display: block; }

    /* ===== INPUT AREA ===== */
    .input-area {
      position: absolute;
      top: 56%;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 420px;
      z-index: 5;
      animation: fadeUp 0.5s ease;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translate(-50%, 14px);
      }
      to {
        opacity: 1;
        transform: translate(-50%, 0);
      }
    }

    /* ===== INPUT ===== */
    .input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid var(--white-dim);
      padding: 10px 6px;
      font-size: 20px;
      color: #fff;
      outline: none;
      text-align: center;
      letter-spacing: 0.02em;
      transition: border-color 0.3s ease;
    }

    .input::placeholder {
      color: rgba(255,255,255,0.35);
    }

    .input:focus {
      border-bottom-color: var(--gold);
    }

    /* ===== SELECT ===== */
    select.input {
      appearance: none;
      text-align-last: center;
      cursor: pointer;
    }

    select option {
      background-color: #111;
      color: #fff;
    }

    /* ===== CHOICE BUTTON ===== */
    .choice-btn {
      width: 100%;
      background: transparent;
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 12px;
      color: var(--white-soft);
      font-size: 16px;
      text-align: center;
      transition: all 0.25s ease;
    }

    .choice-btn.active {
      border-color: var(--gold);
      color: var(--gold);
      box-shadow: 0 0 14px rgba(212,175,55,0.25);
      font-weight: 700;
    }

    /* ===== NEXT BUTTON ===== */
    .next-btn {
      position: absolute;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 420px;
      height: 52px;
      border-radius: 26px;
      border: 1px solid var(--gold);
      background: transparent;
      color: var(--gold);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 0.12em;
      z-index: 5;
      transition: all 0.3s ease;
    }

    .next-btn:hover {
      background: var(--gold);
      color: #000;
    }

    .next-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      pointer-events: none;
    }

    /* ===== AUTOFILL ===== */
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-box-shadow: 0 0 0px 1000px rgba(10,10,10,0.6) inset;
      -webkit-text-fill-color: #fff;
    }
    /* 모바일 안전 영역 대응 */
.stage {
  height: 100svh; /* iOS, 최신 안드로이드 대응 */
}

/* 다음 버튼을 고정 바처럼 */
.next-btn {
  position: fixed;
  bottom: calc(20px + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
}

/* 키보드 올라와도 가려지지 않게 */
@supports (height: 100dvh) {
  .stage {
    height: 100dvh;
  }
}

    /* ===== 로딩 오버레이 (붉은 실 인연) ===== */
    .loading-overlay {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px;
      background: linear-gradient(180deg, #060101 0%, #090202 45%, #050000 100%);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.35s ease, visibility 0.35s ease;
    }

    .loading-overlay.is-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .loading-overlay::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, transparent 35%, rgba(0,0,0,0.75) 100%);
      pointer-events: none;
    }

    .loading-inner {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      max-width: 320px;
    }

    .thread-visual {
      width: min(82vw, 300px);
      margin-bottom: 24px;
      position: relative;
    }

    .thread-img {
      display: block;
      width: 100%;
      height: auto;
      filter: drop-shadow(0 0 8px rgba(230, 45, 55, 0.35));
      -webkit-mask-image: linear-gradient(128deg, #000 42%, transparent 58%);
      mask-image: linear-gradient(128deg, #000 42%, transparent 58%);
      -webkit-mask-size: 260% 260%;
      mask-size: 260% 260%;
      -webkit-mask-position: 88% 8%;
      mask-position: 88% 8%;
      animation: threadReveal 4.5s ease-in-out forwards;
    }

    @keyframes threadReveal {
      0%   { -webkit-mask-position: 88% 8%;  mask-position: 88% 8%; }
      100% { -webkit-mask-position: 8% 92%; mask-position: 8% 92%; }
    }

    .loading-flower {
      font-size: 22px;
      line-height: 1;
      margin-bottom: 14px;
      animation: flowerFloat 2.2s ease-in-out infinite;
    }

    @keyframes flowerFloat {
      0%, 100% { transform: translateY(0) scale(1); opacity: 0.75; }
      50%      { transform: translateY(-4px) scale(1.06); opacity: 1; }
    }

    .loading-title {
      font-family: 'Noto Serif KR', serif;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.02em;
      color: rgba(255, 255, 255, 0.88);
      text-align: center;
      min-height: 1.5em;
      transition: opacity 0.25s ease;
    }

    .loading-title.is-fading {
      opacity: 0;
    }

    .loading-sub {
      margin-top: 8px;
      font-size: 11px;
      letter-spacing: 0.18em;
      color: rgba(243, 230, 200, 0.45);
      text-transform: uppercase;
    }

    .loading-bar {
      width: 160px;
      height: 2px;
      margin-top: 28px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    .loading-bar-fill {
      width: 40%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, transparent, #e6c27a, #ff6b9d, transparent);
      animation: barShimmer 4.5s ease-in-out infinite;
    }

    @keyframes barShimmer {
      0%   { transform: translateX(-120%); }
      100% { transform: translateX(320%); }
    }

  </style>
</head>

<body>

<div class="stage">

  <!-- 질문 -->
  <div class="question-layer">
    <p class="question-sub">연애 사주</p>
    <h1 id="questionTitle" class="question-title">당신의 이름은?</h1>
  </div>

  <!-- 로딩 -->
  <div id="loading" class="loading-overlay" aria-live="polite" aria-busy="false">
    <div class="loading-inner">
      <div class="loading-flower" aria-hidden="true">🌸</div>
      <div class="thread-visual" aria-hidden="true">
        <img
          class="thread-img"
          src="/assets/images/tight/romantic/loading/red-thread.png"
          alt=""
          width="300"
          height="188"
        >
      </div>
      <p id="loading-title" class="loading-title">당신의 사주를 읽고 있습니다</p>
      <p class="loading-sub">HONGYEON</p>
      <div class="loading-bar" aria-hidden="true">
        <div class="loading-bar-fill"></div>
      </div>
    </div>
  </div>

  <form id="sajuForm" method="POST" action="/saju/romantic/result">

    <!-- hidden 유지 -->
    <input type="hidden" name="gender" id="genderInput">
    <input type="hidden" name="birthType" id="birthTypeInput">

    <!-- STEP 1 이름 -->
    <section class="step active">
      <div class="input-area">
        <input name="name" type="text" class="input" placeholder="이름을 입력하세요">
      </div>
    </section>

    <!-- STEP 2 성별 -->
    <section class="step">
      <div class="input-area">
        <button type="button" class="choice-btn" data-gender="남성">남성</button>
        <button type="button" class="choice-btn" data-gender="여성">여성</button>
      </div>
    </section>

    <!-- STEP 3 생년월일 -->
    <section class="step">
      <div class="input-area">
        <select id="birthTypeInputSelect" class="input" style="margin-bottom:14px">
          <option value="양력">양력</option>
          <option value="음력">음력</option>
        </select>
        <input name="birthdate" class="input" placeholder="YYYYMMDD">
      </div>
    </section>

    <!-- STEP 4 태어난 시 -->
    <section class="step">
      <div class="input-area">
        <select name="birthTime" class="input">
                        <option selected value="unknown">모름</option>
                            <option value="00">조자/朝子 (00:00~01:29)</option>
                            <option value="02">축/丑 (01:30~03:29)</option>
                            <option value="04">인/寅 (03:30~05:29)</option>
                            <option value="06">묘/卯 (05:30~07:29)</option>
                            <option value="08">진/辰 (07:30~09:29)</option>
                            <option value="10">사/巳 (09:30~11:29)</option>
                            <option value="12">오/午 (11:30~13:29)</option>
                            <option value="14">미/未 (13:30~15:29)</option>
                            <option value="16">신/申 (15:30~17:29)</option>
                            <option value="18">유/酉 (17:30~19:29)</option>
                            <option value="20">술/戌 (19:30~21:29)</option>
                            <option value="22">해/亥 (21:30~23:29)</option>
                            <option value="24">야자/夜子 (23:30~23:59)</option>
        </select>
      </div>
    </section>

    <button type="button" id="nextBtn" class="next-btn">다음으로</button>
  </form>
</div>

<script>
  let step = 0;
  const steps = document.querySelectorAll(".step");
  const questionTitle = document.getElementById("questionTitle");
const urlParams = new URLSearchParams(window.location.search);
  const ticketCode = urlParams.get('ticket');
  const questions = [
    "이름을 알려주세요",
    "성별을 선택해주세요",
    "생년월일을 입력해주세요",
    "몇시에 태어나셨나요?"
  ];

  function showStep() {
    steps.forEach((s, i) => s.classList.toggle("active", i === step));
    questionTitle.innerText = questions[step];
  }

  /* ===== STEP VALIDATION ===== */
  function validateStep() {
    // STEP 0 : 이름
    if (step === 0) {
      const nameInput = document.querySelector("input[name='name']");
      if (!nameInput.value.trim()) {
        shake(nameInput);
        nameInput.focus();
        return false;
      }
    }

    // STEP 1 : 성별
    if (step === 1) {
      if (!$("#genderInput").val()) {
        shake(document.querySelector(".input-area"));
        return false;
      }
    }

    // STEP 2 : 생년월일
    if (step === 2) {
      const birthdate = $("input[name='birthdate']").val()?.trim();
      if (!/^\d{8}$/.test(birthdate)) {
        const input = document.querySelector("input[name='birthdate']");
        shake(input);
        input.focus();
        return false;
      }
    }

    // STEP 3 : 태어난 시 → 모름(99)도 허용
    return true;
  }

  /* ===== SHAKE EFFECT ===== */
  function shake(target) {
    target.animate(
      [
        { transform: "translateX(0)" },
        { transform: "translateX(-6px)" },
        { transform: "translateX(6px)" },
        { transform: "translateX(0)" }
      ],
      { duration: 300 }
    );
  }

  /* ===== NEXT BUTTON ===== */
  document.getElementById("nextBtn").onclick = () => {
    if (!validateStep()) return;

    if (step < steps.length - 1) {
      step++;
      showStep();
    } else {
      submitTightForm();
    }
  };

  /* ===== GENDER SELECT ===== */
  $(".choice-btn").on("click", function () {
    $(".choice-btn").removeClass("active");
    $(this).addClass("active");
    $("#genderInput").val($(this).data("gender"));
  });

  /* ===== BIRTH TYPE ===== */
  $("#birthTypeInputSelect").on("change", function () {
    $("#birthTypeInput").val(this.value);
  }).trigger("change");

  /* ===== SUBMIT ===== */
  let isSubmitting = false;
  let loadingMsgTimer = null;
  const LOADING_MIN_MS = 4500;
  const loadingMessages = [
    "당신의 사주를 읽고 있습니다",
    "홍연의 흐름을 찾는 중…",
    "곧 미리보기가 열립니다"
  ];
  let loadingMsgIndex = 0;

  function showLoadingOverlay() {
    const overlay = document.getElementById("loading");
    const title = document.getElementById("loading-title");
    const nextBtn = document.getElementById("nextBtn");

    loadingMsgIndex = 0;
    title.textContent = loadingMessages[0];
    title.classList.remove("is-fading");
    overlay.classList.add("is-visible");
    overlay.setAttribute("aria-busy", "true");
    nextBtn.disabled = true;

    const threadImg = overlay.querySelector(".thread-img");
    if (threadImg) {
      threadImg.style.animation = "none";
      void threadImg.offsetWidth;
      threadImg.style.animation = "";
    }

    if (loadingMsgTimer) clearInterval(loadingMsgTimer);
    loadingMsgTimer = setInterval(() => {
      loadingMsgIndex = (loadingMsgIndex + 1) % loadingMessages.length;
      title.classList.add("is-fading");
      setTimeout(() => {
        title.textContent = loadingMessages[loadingMsgIndex];
        title.classList.remove("is-fading");
      }, 220);
    }, 2200);
  }

  function submitAfterLoading(doSubmit) {
    if (isSubmitting) return;
    isSubmitting = true;
    showLoadingOverlay();

    setTimeout(() => {
      doSubmit();
    }, LOADING_MIN_MS);
  }

  function submitTightForm() {
    const data = {
      name: $("input[name='name']").val()?.trim(),
      gender: $("#genderInput").val(),
      birthdate: $("input[name='birthdate']").val()?.trim(),
      birthTime: $("select[name='birthTime']").val(),
      birthType: $("#birthTypeInput").val(),
      goodsType: "2",
      ticket: ticketCode
    };

    if (!data.name || !data.gender || !/^\d{8}$/.test(data.birthdate)) {
      return;
    }

    submitAfterLoading(() => {
      if (data.name === "관리자") {
        const $form = $("#sajuForm");
        $form.find('input[name="userInfo"]').remove();
        $form.find('input[name="sample"]').remove();
        $form.find('input[name="goodsType"]').remove();
        $form.attr("action", "/saju/skip-payment");
        $('<input>', { type: 'hidden', name: 'userInfo', value: JSON.stringify(data) }).appendTo($form);
        $('<input>', { type: 'hidden', name: 'sample', value: '{}' }).appendTo($form);
        $('<input>').attr({ type: 'hidden', name: 'goodsType', value: '2' }).appendTo($form);
        $form[0].submit();
        return;
      }

      if (ticketCode) {
        const $form = $("#sajuForm");
        $form.find('input[name="ticket"]').remove();
        $form.find('input[name="goodsType"]').remove();
        $('<input>', { type: 'hidden', name: 'ticket', value: ticketCode }).appendTo($form);
        $('<input>', { type: 'hidden', name: 'goodsType', value: '2' }).appendTo($form);
        $form.attr("action", "/saju/romantic/result?ticket=" + ticketCode);
      }

      document.getElementById("sajuForm").submit();
    });
  }
 // 엔터로 다음 스텝
document.addEventListener("keydown", function (e) {
  if (e.key === "Enter") {
    const activeStep = document.querySelector(".step.active");

    // select 열려있을 땐 막기
    if (document.activeElement.tagName === "SELECT") return;

    e.preventDefault();
    document.getElementById("nextBtn").click();
  }
});

</script>

</body>
</html>
