<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>

<head>
  <style>
    body {
      margin: 0;
      background: #000;
      color: #fff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont;
      overflow: hidden;
    }

    /* ===== STAGE ===== */
.stage {
  max-width: 480px;
  height: 100vh;
  margin: 0 auto;
  position: relative;
  background:
    linear-gradient(
      180deg,
      #060101 0%,
      #090202 25%,
      #070101 50%,
      #050000 75%,
      #030000 100%
    );
}








    /* 비네트 */
    .stage::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.8) 100%);
    }

    /* ===== QUESTION ===== */
    .question-layer {
      position: absolute;
      top: 38%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      padding: 0 24px;
      text-align: center;
      z-index: 5;
    }

    .question-sub {
      font-size: 12px;
      letter-spacing: 0.12em;
      opacity: 0.5;
      margin-bottom: 10px;
    }

    .question-title {
      font-size: 24px;
      font-weight: 600;
      line-height: 1.5;
    }

    /* ===== STEP ===== */
    .step {
      display: none;
    }
    .step.active {
          overflow: visible;

      display: block;
    }

    /* ===== INPUT AREA ===== */
    .input-area {
      position: absolute;
      top: 56%;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 420px;
      z-index: 5;
      animation: fadeUp 0.5s ease;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translate(-50%, 16px);
      }
      to {
        opacity: 1;
        transform: translate(-50%, 0);
      }
    }

    /* ===== TEXT INPUT ===== */
    .input {
      width: 100%;
      background: transparent;
      border: none;
      border-bottom: 1px solid rgba(255,255,255,0.35);
      padding: 8px 6px;
      font-size: 20px;
      color: #fff;
      outline: none;
      text-align: center;
    }

    .input::placeholder {
      color: rgba(255,255,255,0.4);
    }

    /* ===== CHOICE BUTTON ===== */
    .choice-btn {
      width: 100%;
      background: transparent;
      border: 1px solid rgba(255,255,255,0.25);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 12px;
      color: #fff;
      font-size: 16px;
      text-align: center;
      transition: all 0.2s ease;
    }

    .choice-btn.active {
      background: #fff;
      color: #000;
      font-weight: 700;
    }

    /* ===== NEXT BUTTON ===== */
    .next-btn {
      position: absolute;
      bottom: 32px;
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 48px);
      max-width: 420px;
      height: 52px;
      border-radius: 26px;
      border: none;
      background: rgba(255,255,255,0.9);
      color: #000;
      font-size: 16px;
      font-weight: 700;
      z-index: 5;
    }

    /* ===== LOADING ===== */
    #loading {
      background: rgba(0,0,0,0.8);
      backdrop-filter: blur(6px);
    }

    select {
  background-color: transparent;
  color: #fff;
}

select option {
  background-color: #111;
  color: #fff;
}
input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus {
  -webkit-box-shadow: 0 0 0px 1000px rgba(10,10,10,0.55) inset;
  -webkit-text-fill-color: #fff;
}

  </style>
</head>

<body>

<div class="stage">

  <!-- 질문 -->
  <div class="question-layer">
    <p class="question-sub">29금 에로스 사주</p>
    <h1 id="questionTitle" class="question-title">당신의 이름은?</h1>
  </div>

  <!-- 로딩 -->
  <div id="loading"
       class="hidden fixed inset-0 z-50
              flex flex-col items-center justify-center">
    <div class="w-10 h-10 border-4 border-white border-t-transparent rounded-full animate-spin"></div>
    <p id="loading-title" class="mt-4 text-sm">사주를 분석중입니다</p>
  </div>

  <form id="sajuForm" method="POST" action="/saju/classic/result">

    <!-- hidden 유지 -->
    <input type="hidden" name="gender" id="genderInput">
    <input type="hidden" name="birthType" id="birthTypeInput">

    <!-- STEP 1 이름 -->
    <section class="step active">
      <div class="input-area">
        <input name="name" type="text" class="input" placeholder="이름을 입력하세요">
      </div>
    </section>

    <!-- STEP 2 성별 -->
    <section class="step">
      <div class="input-area">
        <button type="button" class="choice-btn" data-gender="남성">남성</button>
        <button type="button" class="choice-btn" data-gender="여성">여성</button>
      </div>
    </section>

    <!-- STEP 3 생년월일 -->
    <section class="step">
      <div class="input-area">
        <select id="birthTypeInputSelect" class="input" style="margin-bottom:14px">
          <option value="양력">양력</option>
          <option value="음력">음력</option>
        </select>
        <input name="birthdate" class="input" placeholder="YYYYMMDD">
      </div>
    </section>

    <!-- STEP 4 태어난 시 -->
    <section class="step">
      <div class="input-area">
        <select name="birthTime" class="input">
          <option value="99">모름</option>
          <option value="00">조자</option>
          <option value="02">축</option>
          <option value="04">인</option>
          <option value="06">묘</option>
          <option value="08">진</option>
          <option value="10">사</option>
          <option value="12">오</option>
          <option value="14">미</option>
          <option value="16">신</option>
          <option value="18">유</option>
          <option value="20">술</option>
          <option value="22">해</option>
          <option value="24">야자</option>
        </select>
      </div>
    </section>

    <button type="button" id="nextBtn" class="next-btn">다음으로</button>
  </form>
</div>

<script>
  let step = 0;
  const steps = document.querySelectorAll(".step");
  const questionTitle = document.getElementById("questionTitle");

  const questions = [
    "이름을 알려주세요",
    "성별을 선택해주세요",
    "생년월일을 입력해주세요",
    "몇시에 태어나셨나요?"
  ];

  function showStep() {
    steps.forEach((s, i) => s.classList.toggle("active", i === step));
    questionTitle.innerText = questions[step];
  }

  /* ===== STEP VALIDATION ===== */
  function validateStep() {
    // STEP 0 : 이름
    if (step === 0) {
      const nameInput = document.querySelector("input[name='name']");
      if (!nameInput.value.trim()) {
        shake(nameInput);
        nameInput.focus();
        return false;
      }
    }

    // STEP 1 : 성별
    if (step === 1) {
      if (!$("#genderInput").val()) {
        shake(document.querySelector(".input-area"));
        return false;
      }
    }

    // STEP 2 : 생년월일
    if (step === 2) {
      const birthdate = $("input[name='birthdate']").val()?.trim();
      if (!/^\d{8}$/.test(birthdate)) {
        const input = document.querySelector("input[name='birthdate']");
        shake(input);
        input.focus();
        return false;
      }
    }

    // STEP 3 : 태어난 시 → 모름(99)도 허용
    return true;
  }

  /* ===== SHAKE EFFECT ===== */
  function shake(target) {
    target.animate(
      [
        { transform: "translateX(0)" },
        { transform: "translateX(-6px)" },
        { transform: "translateX(6px)" },
        { transform: "translateX(0)" }
      ],
      { duration: 300 }
    );
  }

  /* ===== NEXT BUTTON ===== */
  document.getElementById("nextBtn").onclick = () => {
    if (!validateStep()) return;

    if (step < steps.length - 1) {
      step++;
      showStep();
    } else {
      submitTightForm();
    }
  };

  /* ===== GENDER SELECT ===== */
  $(".choice-btn").on("click", function () {
    $(".choice-btn").removeClass("active");
    $(this).addClass("active");
    $("#genderInput").val($(this).data("gender"));
  });

  /* ===== BIRTH TYPE ===== */
  $("#birthTypeInputSelect").on("change", function () {
    $("#birthTypeInput").val(this.value);
  }).trigger("change");

  /* ===== SUBMIT (기존 로직 유지) ===== */
  function submitTightForm() {
    const data = {
      name: $("input[name='name']").val()?.trim(),
      gender: $("#genderInput").val(),
      birthdate: $("input[name='birthdate']").val()?.trim(),
      birthTime: $("select[name='birthTime']").val(),
      birthType: $("#birthTypeInput").val()
    };

    if (!data.name || !data.gender || !/^\d{8}$/.test(data.birthdate)) {
      return;
    }

    if (data.name === "관리자") {
  const $form = $("#sajuForm");

  // 🔥 이 두 줄이 없으면 무조건 다시 터짐
  $form.find('input[name="userInfo"]').remove();
  $form.find('input[name="sample"]').remove();

  $form.attr("action", "/saju/skip-payment");

  $('<input>', {
    type: 'hidden',
    name: 'userInfo',
    value: JSON.stringify(data)
  }).appendTo($form);

  $('<input>', {
    type: 'hidden',
    name: 'sample',
    value: '{}'
  }).appendTo($form);

  $form[0].submit();
}

  }
</script>

</body>
</html>
