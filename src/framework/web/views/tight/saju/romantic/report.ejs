  .tone-violet{background:linear-gradient(90deg, #a78bfa, var(--accent-color))}

  .timeline{margin-top:12px;display:flex;flex-direction:column;gap:8px}
  .tl-item{display:flex;gap:10px;align-items:flex-start}
