  .callout{margin-top:14px;border-radius:18px;padding:14px 14px;border:1px solid rgba(243,230,200,0.11);background:linear-gradient(155deg, rgba(0,0,0,0.2), rgba(255,255,255,0.03));box-shadow:inset 0 1px 0 rgba(255,255,255,0.05)}
  .callout.kind-tip{background:linear-gradient(135deg, rgba(255,77,141,0.10), rgba(196,77,255,0.06))}
