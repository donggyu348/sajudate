  .tagcloud{margin-top:6px;}

  .face-viz{margin-top:12px;display:grid;grid-template-columns:140px 1fr;gap:12px;align-items:start}
  .avatar{display:flex;flex-direction:column;align-items:center}
  .avatar-cap{margin-top:6px;font-size:12px;color:var(--ink-soft);}
