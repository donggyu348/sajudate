<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  const STEM_TO_FILE = {
    "甲":"갑목","乙":"을목","丙":"병화","丁":"정화","戊":"무토",
    "己":"기토","庚":"경금","辛":"신금","壬":"임수","癸":"계수",
    "갑":"갑목","을":"을목","병":"병화","정":"정화","무":"무토",
    "기":"기토","경":"경금","신":"신금","임":"임수","계":"계수"
  };
  const myDayStem = STEM_TO_FILE[saju.day.gan] || "갑목";

  const g = String(userInfo.gender).trim();
  let genderKey = (["여","여자","여성","female","woman"].includes(g)) ? "woman" : "man";

  // reportInfo가 비어있으면, 6장 구성의 "긴/직관적/시각요소 많은" 기본 리포트를 생성
  // (서버에서 reportInfo를 주는 경우엔 그 값을 그대로 사용)
  const safeUserName = (userInfo && (userInfo.nickname || userInfo.name)) ? String(userInfo.nickname || userInfo.name) : "당신";
  const spouseNoun = (genderKey === "man") ? "미래 아내" : "미래 남편";

  const icon = {
    spark:"✦", heart:"♥", target:"◎", note:"✎", warn:"⚠", check:"✓", clock:"⏳", star:"★", key:"🔑"
  };

  function h(str){ return String(str || ""); }
  /** GPT report HTML과 동일 클래스 — 폴백에서도 같은 톤으로 사용 */
  function lead(txt){ return `<div class="section-lead">${h(txt)}</div>`; }
  function insightRow(cells){
    return `<div class="insight-row">${cells.map(c=>`
      <div class="insight-cell">
        <span class="insight-k">${h(c.k)}</span>
        <span class="insight-v">${h(c.v)}</span>
      </div>`).join("")}</div>`;
  }
  function chip(label){ return `<span class="chip">${h(label)}</span>`; }
  function bar(label, pct, tone){
    const p = Math.max(0, Math.min(Number(pct) || 0, 100));
    const t = tone || "pink";
    return `
      <div class="meter">
        <div class="meter-top">
          <span class="meter-k">${h(label)}</span>
          <span class="meter-v">${p}%</span>
        </div>
        <div class="meter-rail"><div class="meter-fill tone-${t}" data-w="${p}%"></div></div>
      </div>
    `;
  }

  function bullets(items){
    return `<ul class="bullets">${items.map(t=>`<li>${t}</li>`).join("")}</ul>`;
  }

  function callout(kind, title, body){
    const k = kind || "tip";
    return `
      <div class="callout kind-${k}">
        <div class="co-top">
          <span class="co-badge">${k.toUpperCase()}</span>
          <span class="co-title">${h(title)}</span>
        </div>
        <div class="co-body">${body}</div>
      </div>
    `;
  }

  function timeline(steps){
    return `
      <div class="timeline">
        ${steps.map(s=>`
          <div class="tl-item">
            <div class="tl-dot"></div>
            <div class="tl-box">
              <div class="tl-t">${h(s.t)}</div>
              <div class="tl-d">${h(s.d)}</div>
            </div>
          </div>
        `).join("")}
      </div>
    `;
  }

  function miniQuiz(q, options){
    return `
      <div class="quiz">
        <div class="quiz-q">${h(q)}</div>
        <div class="quiz-opts">
          ${options.map(o=>`<div class="quiz-opt">${h(o)}</div>`).join("")}
        </div>
        <div class="quiz-hint">정답은 리포트 흐름 안에서 자연스럽게 드러나도록 구성했어요.</div>
      </div>
    `;
  }

  function doDont(doList, dontList){
    return `
      <div class="dd">
        <div class="dd-col">
          <div class="dd-h ok">${icon.check} DO</div>
          ${bullets(doList.map(x=>`<span class="dd-t">${x}</span>`))}
        </div>
        <div class="dd-col">
          <div class="dd-h no">${icon.warn} DON'T</div>
          ${bullets(dontList.map(x=>`<span class="dd-t">${x}</span>`))}
        </div>
      </div>
    `;
  }

  if (!Array.isArray(reportInfo) || reportInfo.length === 0) {
    const c1 = "1장. 나만의 매력은?";
    const c2 = "2장. 연애운 흐름과 시기";
    const c3 = "3장. 연애운 상승 방법은?";
    const c4 = "4장. 내 운명의 짝은?";
    const c5 = "5장. 운명인 줄 알았는데, 아닌 사람";
    const c6 = "6장. 19금 연애운";

    // 장별 “대표 코멘트(동물+2줄)”를 리포트 곳곳에 반복 노출해 일관성을 줌
    const chapterMascot = {
      [c1]: { emoji:"🐰", lines:[
        "이번 장에서는 꾸민 문장보다 첫 카톡 한 통·첫 만남 자리 선택까지 어떻게 깔지 짚습니다.",
        "내 사주 패턴에서 꺼져 있는 스위치(말 버릇·리액션) 하나만 바꿔도 체감이 큽니다."
      ]},
      [c2]: { emoji:"🦊", lines:[
        "시기 예측은 막연한 언젠가가 아니라, 앞으로 52주 안에 접점을 늘리는 행위만 추립니다.",
        "달력에 박을 만남·연락 루틴을 하나 정하고 거기부터 실행합니다."
      ]},
      [c3]: { emoji:"🐥", lines:[
        "많이 하는 실수 한 가지부터 잡고, 지금 바로 붙여 쓸 대사 초안을 같이 만듭니다.",
        "표현이 부족한 게 아니라 확약→약속→리액션 순서가 비어 있는지부터 봅니다."
      ]},
      [c4]: { emoji:"🐻", lines:[
        "상대를 가늠할 테스트 질문 2개와, 만남 때 관찰할 체크 3항만 챙기고 들어가요.",
        "운명 서사보다 허용/거절 기준부터 확정해야 시간을 아낍니다."
      ]},
      [c5]: { emoji:"🐱", lines:[
        "독 초장면은 줄이고, 끝낼 때 보내는 문자 한 줄 템플릿까지 확인합니다.",
        "불안해서 연락하기 전에 한 번 할 경계 테스트로 답을 받아냅니다."
      ]},
      [c6]: { emoji:"🖤", lines:[
        "비노골 원칙 안에서 속도·여백·말버릇을 숫자와 문장으로 맞추는 연습 카드입니다.",
        "오늘 밤 챙길 디테일 1개만 골라 적용하면 다음 만남 톤이 달라집니다."
      ]}
    };

    function mascotBlock(ch){
      const m = chapterMascot[ch];
      if (!m) return "";
      return `
        <div class="mascot">
          <div class="ms-emoji">${m.emoji}</div>
          <div class="ms-lines">
            ${m.lines.map(x=>`<div class="ms-line">👉 ${h(x)}</div>`).join("")}
          </div>
        </div>
      `;
    }

    reportInfo = [
      // ── 1장 ──
      { chapter:c1, title:"풀이 1. 내가 타고난 기본 매력은 무엇일까?", isHtml:true, content: `
        ${lead(`${h(safeUserName)} 님의 기본 매력은 한 번에 튀는 화려함보다, 사람이 떠올릴 때마다 새옷처럼 또렷해지는 타입에 가깝습니다. 대화가 길어질수록 신뢰와 온도가 동시에 쌓이며, 그 여백이 관계의 깊이를 만들어요. 아래에서 어떤 결로 드러나는지, 일상에서 어떻게 보이는지 차례로 짚어볼게요.`)}
        ${insightRow([
          { k:"매력 타입", v:"정돈·신뢰형" },
          { k:"첫인상 속도", v:"천천히 번짐" },
          { k:"연애 시너지", v:"대화·약속" },
        ])}
        ${mascotBlock(c1)}
        ${callout("note","핵심 요약",`<div class="p">${h(safeUserName)} 님의 기본 매력은 <span class="hl">‘신뢰 + 분위기’</span>가 동시에 깔리는 타입이에요. 첫 만남에서는 조용해 보일 수 있어도, 시간이 지나며 ‘이 사람은 나를 흔들지 않고 곁에 서 주는 사람’이라는 인상이 강화됩니다.</div>
        <div class="p">가볍게 호감만 남기고 사라지는 매력보다, <span class="hl">계속 생각나는 여운</span>과 <span class="hl">말이 필요 없는 안정감</span>으로 기억에 남는 결을 가지고 있어요.</div>
        <div class="p">그래서 호감 신호는 크게 튀기보다 시선·웃음·목소리 톤처럼 미세한 레이어에서 읽히는 편입니다. 상대에게는 “편한데 자꾸 신경 쓰이는 사람”으로 각인되기 쉽습니다.</div>`)}
        <div class="meters">
          ${bar("첫인상 호감도", 78, "pink")}
          ${bar("신뢰감", 88, "gold")}
          ${bar("감정 전달력", 74, "violet")}
          ${bar("관계 지속력", 90, "ice")}
        </div>
        ${bullets([
          "<b>매력의 결</b>: 튀지 않아도 ‘정돈된 느낌’으로 신뢰를 먼저 줌",
          "<b>강점</b>: 상대가 불안할 때 중심을 잡아주는 안정감",
          "<b>주의</b>: 매력을 ‘설명’으로 증명하려 하면 오히려 매력이 늦게 들어옴"
        ])}
      `},
      { chapter:c1, title:"풀이 2. 사람들이 처음 만났을 때 느끼는 나의 분위기는?", isHtml:true, content: `
        ${lead(`첫 만남에서는 ‘감정 표현’보다 ‘존재감의 밀도’가 먼저 읽혀요. 말수가 적어도 눈빛·자세·말의 속도에서 풍기는 차분함이 곧 분위기가 됩니다. 사람들은 그걸 종종 “단정하다, 믿음직하다, 묘하게 성숙하다” 같은 말로 번역해요.`)}
        ${insightRow([{k:"무드 키워드", v:"차분·단정"},{k:"관계 타이밍", v:"3~7일"},{k:"첫인상 보정", v:"미소·리액션"},])}
        ${miniQuiz("첫인상으로 가장 많이 듣는 말은?",[
          "A. 차분해 보인다 / 단정하다",
          "B. 센스 있다 / 예쁘게 말한다",
          "C. 똑부러진다 / 믿음직하다",
          "D. 은근히 웃기다 / 편하다"
        ])}
        <div class="viz-grid">
          <div class="viz-card"><div class="viz-t">첫 30초</div><div class="viz-v">“눈빛/표정이 살아있다”</div><div class="viz-s">표정이 무표정이면 차가워 보일 수 있어요. ‘미소 0.5초’가 키예요.</div></div>
          <div class="viz-card"><div class="viz-t">첫 3분</div><div class="viz-v">“말이 정리돼 있다”</div><div class="viz-s">한 문장으로 요약해주는 말투가 매력으로 찍힙니다.</div></div>
        </div>
        ${callout("tip","바로 적용",`<div class="p">첫 인사 후 1문장: <span class="hl">“오 오늘 분위기 좋네요”</span> 같은 ‘가벼운 칭찬’이 차가움을 풀어줘요.</div>`)}
      `},
      { chapter:c1, title:"풀이 3. 썸 단계에서 상대를 끌어당기는 나만의 포인트는?", isHtml:true, content: `
        ${lead(`썸에서는 ‘자극적인 밀당’보다 ‘마음이 정리되는 대화’에서 당신의 매력이 가장 선명해져요. 상대가 흐릿한 생각을 정리해 주는 한 문장을 건넬 때, 사람들은 그 순간에 강한 끌림을 느끼기 쉽습니다.`)}
        ${insightRow([{k:"끌림 요인", v:"말의 정리력"},{k:"약점 주의", v:"과한 시험"},{k:"실천 팁", v:"약속 확정"},])}
        ${mascotBlock(c1)}
        ${callout("tip","썸에서 강해지는 포인트",`<div class="p">당신은 <span class="hl">“상대의 마음을 정리해주는 말”</span>을 할 때 매력이 올라가요.</div>
        <div class="p">그래서 썸 단계에서 ‘가벼운 드립’보다 <span class="hl">따뜻한 확신</span>이 먹혀요.</div>`)}
        ${doDont(
          ["상대 말의 핵심을 1줄로 정리", "약속을 짧게라도 확정", "좋은 건 ‘좋다’고 바로 말하기"],
          ["연락 텐션을 일부러 낮추기", "상대 마음을 시험하기", "혼자 결론 내리고 거리두기"]
        )}
        ${callout("note","추천 멘트",`<div class="quote">“나 오늘 대화 재밌었어. 다음에 ○○도 같이 해보자.”</div>`)}
      `},
      { chapter:c1, title:"풀이 4. 연애를 시작하면 더욱 빛나는 나의 장점은?", isHtml:true, content: `
        ${lead(`연애가 시작되면 당신은 ‘감정 기복’으로 흔들기보다 관계의 리듬을 잡는 쪽으로 강점이 드러나요. 크게 한 번이 아니라 꾸준한 온도 조절과 약속 지키기가 신뢰로 전환되면서, 파트너가 더 빨리 마음의 집을 짓게 됩니다.`)}
        ${insightRow([{k:"연애 초반", v:"온도 조절"},{k:"중반 이후", v:"문제 정리"},{k:"장기 강점", v:"일관성"},])}
        <div class="viz-grid">
          <div class="viz-card"><div class="viz-t">연애 초반</div><div class="viz-v">상대가 편해지는 ‘온도 조절’</div><div class="viz-s">강하게 밀지 않아도, 꾸준히 챙겨서 신뢰가 올라갑니다.</div></div>
          <div class="viz-card"><div class="viz-t">연애 중반</div><div class="viz-v">문제 해결 능력</div><div class="viz-s">싸움이 커지기 전에 ‘정리’가 들어가요. 대화로 풀리는 연애가 됩니다.</div></div>
        </div>
        ${bullets([
          "<b>루틴형 애정</b>: 크게 한 번보다, 작게 여러 번 챙기는 타입",
          "<b>관계 유지력</b>: 상대가 흔들릴 때 ‘기준’을 세워줌",
          "<b>신뢰 포인트</b>: 말보다 행동이 먼저 나오는 편"
        ])}
        ${callout("tip","연애에서 더 매력적으로 보이는 행동",`<div class="p">“약속 시간/장소를 먼저 정리해주는 사람”이 연애에서 굉장히 매력적으로 보여요.</div>`)}
      `},
      { chapter:c1, title:"풀이 5. 시간이 지날수록 더 크게 드러나는 나의 매력은?", isHtml:true, content: `
        ${lead(`시간이 쌓일수록 ‘말의 화려함’보다 ‘행동의 일관성’이 드러나며, 그게 곧 매력의 주파수가 됩니다. 상대는 당신을 통해 ‘나를 지키는 관계’의 감각을 배우게 되고, 그 신뢰가 곧 중독성으로 이어지기도 해요.`)}
        ${insightRow([{k:"누적 매력", v:"진정성·깊이"},{k:"전환점", v:"2~3개월"},{k:"상대 반응", v:"내 편 감각"},])}
        ${callout("note","시간이 지날수록 올라가는 매력",`<div class="p">당신은 시간이 쌓일수록 <span class="hl">‘진정성’</span>이 드러나서 매력이 커져요.</div>
        <div class="p">처음엔 조용했는데, 어느 순간 상대가 <span class="hl">‘이 사람 되게 깊다’</span>를 느끼게 됩니다. 그 순간부터는 호감이 ‘일시적 설렘’이 아니라 ‘함께 살림을 구상하게 되는 레벨’로 이동해요.</div>
        <div class="p">특히 갈등이 생겼을 때 욕설이 아니라 ‘정리’로 돌파하는 모습에서 매력 곡선이 급격히 상승합니다.</div>`)}
        ${timeline([
          {t:"1~2주", d:"호감은 생기지만 아직 ‘확신’은 부족"},
          {t:"3~4주", d:"상대가 당신의 기준/가치관을 느끼며 신뢰가 급상승"},
          {t:"2~3개월", d:"관계가 안정되면서 ‘내 편’이라는 감각이 생김"},
          {t:"그 이후", d:"서로의 미래 얘기가 자연스럽게 나오는 흐름"}
        ])}
      `},
      { chapter:c1, title:"풀이 6. 상대가 나에게 중독되는 결정적인 이유는?", isHtml:true, content: `
        ${lead(`중독이라는 표현은 ‘위험한 집착’이 아니라, 마음을 놓았을 때도 곁을 지키게 되는 ‘심리적 안전기지’ 같은 뜻으로 읽히면 좋아요. 당신은 상대에게 감정의 파도를 숨기지 않되, 과장 없이 버텨 주는 힘으로 기억됩니다.`)}
        ${insightRow([{k:"중독 키", v:"안정+설렘"},{k:"위험 밸런스", v:"과한 책임"},{k:"균형 팁", v:"여유·경계"},])}
