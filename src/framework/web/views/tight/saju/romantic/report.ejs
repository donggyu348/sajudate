<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;700&display=swap');

  :root {
    --accent-color: #ff4d8d;
    --gold-gradient: linear-gradient(135deg, #f3e6c8 0%, #d4af37 100%);
    --glass-bg: rgba(255, 255, 255, 0.03);
    --glass-border: rgba(255, 255, 255, 0.12);
  }

  .report-bg {
    background-color: #0a0a0c;
    background-image: 
      radial-gradient(circle at 10% 20%, rgba(255, 77, 141, 0.05) 0%, transparent 40%),
      radial-gradient(circle at 90% 80%, rgba(243, 230, 200, 0.05) 0%, transparent 40%);
    min-height: 100vh;
  }

  /* 챕터 표시 영역 */
  .chapter-progress-wrap {
    padding-top: 80px;
    padding-bottom: 40px;
    text-align: center;
  }

  .chapter-badge {
    display: inline-block;
    font-family: 'Noto Serif KR', serif;
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--accent-color);
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .chapter-title {
    font-family: 'Noto Serif KR', serif;
    font-size: 32px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .chapter-line {
    width: 40px;
    height: 1px;
    background: var(--gold-gradient);
    margin: 16px auto;
  }

  /* 콘텐츠 카드 디자인 */
  .content-card {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: 24px;
    padding: 32px 24px;
    margin-bottom: 40px;
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }

  .report-title {
    font-family: 'Noto Serif KR', serif;
    font-size: 22px;
    font-weight: 700;
    color: #f3e6c8; /* 골드톤 */
    margin-bottom: 20px;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .report-title::before {
    content: '';
    display: block;
    width: 4px;
    height: 20px;
    background: var(--accent-color);
    border-radius: 2px;
  }

  .report-content {
    font-size: 16px;
    line-height: 1.85;
    color: rgba(255, 255, 255, 0.85);
    white-space: pre-line;
    word-break: keep-all;
  }

  /* 진행 도트 커스텀 */
  .chapter-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    transition: all 0.3s ease;
  }

  .dot.active {
    background: var(--accent-color);
    transform: scale(1.5);
    box-shadow: 0 0 10px var(--accent-color);
  }

  .highlight {
    color: #ff4d8d;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  
</style>

<body class="page-classic">
  <div class="flex flex-col w-full max-w-[480px] mx-auto report-bg min-h-screen">
    <%- include('./../../common/common') %>
  <style>
    
  :root {
    --gold-bright: #f3e6c8;
    --accent-pink: #ffb3ba;
    --card-bg: rgba(255, 255, 255, 0.04);
  }

  .saju-summary-tool {
    background: radial-gradient(circle at 50% 50%, #1a1a1c 0%, #0a0a0c 100%);
    border: 1px solid rgba(243, 230, 200, 0.1);
    border-radius: 28px;
    padding: 30px 20px;
    margin: 20px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    font-family: 'Noto Serif KR', serif;
  }
/* 상단 라벨 스타일 추가 */
  .preview-badge-wrap {
    display: flex;
    align-items: center;
    justify-content: center; /* 중앙 정렬 (좌측 원하시면 flex-start) */
    gap: 8px;
    margin-bottom: 20px;
  }

  .preview-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #ff4d8d;
    border: 1px solid rgba(255, 77, 141, 0.4);
    padding: 2px 10px;
    border-radius: 99px;
    text-transform: uppercase;
  }

  .preview-main-title {
    font-size: 14px;
    color: var(--gold-bright);
    font-weight: 400;
    letter-spacing: 1px;
    opacity: 0.9;
  }
  /* 1. 오행 섹션 (EJS 데이터 바인딩) */
  .element-section {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 30px;
  }

  .el-card {
    flex: 1;
    background: var(--card-bg);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 10px 4px;
    text-align: center;
  }

  /* 데이터가 1개 이상일 때 강조 효과 */
  .el-card.has-value { border-color: rgba(243, 230, 200, 0.3); background: rgba(243, 230, 200, 0.05); }

  .el-han { font-size: 12px; opacity: 0.6; display: block; }
  .el-val { font-size: 18px; font-weight: 700; margin: 4px 0; display: block; }
  
  .el-bar-container { height: 40px; width: 4px; background: rgba(255,255,255,0.1); margin: 0 auto; border-radius: 2px; position: relative; }
  .el-bar-fill { position: absolute; bottom: 0; width: 100%; border-radius: 2px; transition: height 1s ease-in-out; }

  .color-wood { color: #A8D5BA; } .bg-wood { background: #A8D5BA; }
  .color-fire { color: #FFB3BA; } .bg-fire { background: #FFB3BA; }
  .color-earth { color: #F3E6C8; } .bg-earth { background: #F3E6C8; }
  .color-metal { color: #E0E0E0; } .bg-metal { background: #E0E0E0; }
  .color-water { color: #B3CDE3; } .bg-water { background: #B3CDE3; }

  /* 2. 천간지지 섹션 (EJS 데이터 바인딩) */
  .saju-grid-title {
    font-size: 12px;
    color: var(--gold-bright);
    text-align: center;
    letter-spacing: 3px;
    margin-bottom: 15px;
    opacity: 0.8;
  }

  .saju-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .saju-node {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 15px 0;
    text-align: center;
  }

  .node-label { font-size: 10px; color: rgba(255,255,255,0.4); margin-bottom: 8px; display: block; }
  .hanja-text {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(to bottom, #fff 0%, var(--gold-bright) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 일주(나) 하이라이트 */
  .is-me { border-color: #ff4d8d; background: rgba(255, 77, 141, 0.05); position: relative; }
  .is-me::after {
    content: '나'; position: absolute; top: -6px; right: -6px;
    background: #ff4d8d; color: #fff; font-size: 9px; padding: 2px 5px; border-radius: 4px;
  }
</style>

<div class="saju-summary-tool">
  <div class="preview-badge-wrap">
    <span class="preview-badge">Preview</span>
    <span class="preview-main-title">사주 명식 미리보기</span>
  </div>
  <div class="element-section">
    
    <% 
       const elements = saju.fiveElementsWeighted || saju.fiveElements;
       const elMax = Math.max(...Object.values(elements), 1);
       const getPercent = (val) => (Math.min((Number(val) || 0) / elMax * 100, 100)) + '%';
    %>
    
    <div class="el-card <%= elements.목 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-wood">木</span>
      <span class="el-val color-wood"><%= elements.목 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-wood" style="height: <%= getPercent(elements.목) %>;"></div>
      </div>
    </div>

    <div class="el-card <%= elements.화 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-fire">火</span>
      <span class="el-val color-fire"><%= elements.화 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-fire" style="height: <%= getPercent(elements.화) %>;"></div>
      </div>
    </div>

    <div class="el-card <%= elements.토 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-earth">土</span>
      <span class="el-val color-earth"><%= elements.토 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-earth" style="height: <%= getPercent(elements.토) %>;"></div>
      </div>
    </div>

    <div class="el-card <%= elements.금 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-metal">金</span>
      <span class="el-val color-metal"><%= elements.금 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-metal" style="height: <%= getPercent(elements.금) %>;"></div>
      </div>
    </div>

    <div class="el-card <%= elements.수 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-water">水</span>
      <span class="el-val color-water"><%= elements.수 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-water" style="height: <%= getPercent(elements.수) %>;"></div>
      </div>
    </div>
  </div>

  <div class="saju-grid-title">八字四柱</div>
  <div class="saju-grid">
    <div class="saju-node">
      <span class="node-label">시주</span>
      <div class="hanja-text"><%= saju.hour.gan || " " %><br><%= saju.hour.ji || " " %></div>
    </div>
    <div class="saju-node is-me">
      <span class="node-label">일주</span>
      <div class="hanja-text"><%= saju.day.gan %><br><%= saju.day.ji %></div>
    </div>
    <div class="saju-node">
      <span class="node-label">월주</span>
      <div class="hanja-text"><%= saju.month.gan %><br><%= saju.month.ji %></div>
    </div>
    <div class="saju-node">
      <span class="node-label">년주</span>
      <div class="hanja-text"><%= saju.year.gan %><br><%= saju.year.ji %></div>
    </div>
  </div>
</div>

<%- include('./_hongyeonStats') %>

    <div id="container" class="pb-20">
      <% 
        const chapters = [...new Set(reportInfo.map(r => r.chapter))];
        const totalChapters = chapters.length;
        let currentChapter = '';
      %>

      <% reportInfo.forEach((item, index) => { %>
        <% if (item.chapter !== currentChapter) { %>
          <% currentChapter = item.chapter; %>
          <% const chapterIndex = chapters.indexOf(item.chapter); %>

          <div class="chapter-progress-wrap px-8">
            <div class="chapter-dots">
              <% for (let i = 0; i < totalChapters; i++) { %>
                <div class="dot <%= i === chapterIndex ? 'active' : '' %>"></div>
              <% } %>
            </div>
            <span class="chapter-badge">Chapter 0<%= chapterIndex + 1 %></span>
            <h2 class="chapter-title"><%= item.chapter %></h2>
            <div class="chapter-line"></div>
          </div>

          <div class="px-6 space-y-10">
        <% } %>

       <div class="content-card">

  <% if (item.title && item.title !== item.chapter) { %>
    <h3 class="report-title">
      <%= item.title %>
    </h3>
  <% } %>
<%
  let formattedContent = item.content;
%>
  <div class="report-content">
    <%= formattedContent %>
  </div>
</div>


        <% 
          const nextItem = reportInfo[index + 1];
          if (!nextItem || nextItem.chapter !== currentChapter) { 
        %>
          </div> <% } %>
      <% }); %>
    </div>
  </div>
</body>
</html>