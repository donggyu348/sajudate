  const openPunches = [
    function (n){ return `${n}님은 사랑보다 ‘확신’을 더 먼저 찾는 사람일 수 있어요.`; },
    function (n){ return `좋아하면서도 표현을 아끼다 타이밍을 놓치는 타입의 함정이 있을 수 있어요.`; },
    function (n){ return `${n}님은 설렘보다 안전한 관계의 질을 더 비싸게 매기는 편이에요.`; },
    function (n){ return `‘좋아한다’는 말보다 ‘괜찮다’는 말에 마음이 더 많이 실릴 수 있어요.`; },
    function (n){ return `${n}님은 상대를 믿기 전에, 먼저 나를 지키는 루틴을 통과시키는 스타일이에요.`; },
    function (n){ return `애매함을 참는 만큼, 한 번 터지면 정리 비용이 커지는 패턴을 조심하면 좋아요.`; },
    function (n){ return `${n}님은 고백 장면보다 일상 속에서의 선택이 진심이라는 걸 증명받고 싶어 해요.`; },
  ];
  const openPunch = openPunches[subSeed(openSeed, 25) % openPunches.length](safeUserName);
  const moodLabels = [
    "약속부터 잠그는 타입","말풍선 온도 0.5℃ 올리기","경계 테스트 데이","설렘 버퍼링 중","리플레이 모드 OFF","카톡 한 통 덜 보내기"
  ];
  const openMood = moodLabels[openSeed % moodLabels.length];
  const openStamp = ["PASS", "URGENT FUN", "READ ME", "LAB VER."][openSeed % 4];
