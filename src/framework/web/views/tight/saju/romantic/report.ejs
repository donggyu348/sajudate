  .quiz-opt{border-radius:10px;padding:10px;background:#fff;border:2px solid var(--ink);color:var(--ink-soft);font-size:12.5px;line-height:1.42;font-weight:500;}
  .quiz-hint{margin-top:8px;font-size:11.5px;color:var(--text-muted);font-weight:500;}

  .dd{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .dd-col{border-radius:12px;padding:10px;background:#fff;border:2px solid var(--ink);}
  .dd-h{font-size:12px;font-weight:800;margin-bottom:8px;font-family:"Nunito",sans-serif;}
