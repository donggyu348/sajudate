    function (n){ return `왜 ${n}님은 ‘될 사람’ 앞에서만 말이 얇아지는 느낌이 날까요?`; },
    function (n){ return `왜 ${n}님은 애매한 관계를 정리할 때 가장 에너지를 쓰게 될까요?`; },
  ];
