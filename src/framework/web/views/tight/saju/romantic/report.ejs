  .plan-grid{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .plan-card{border-radius:12px;padding:10px;background:#fff;border:2px solid var(--ink);}
  .plan-t{font-size:10px;font-weight:800;letter-spacing:0.09em;color:var(--accent-color);font-family:"Nunito",sans-serif;text-transform:uppercase;}
  .plan-d{margin-top:6px;font-size:12.5px;color:var(--ink-soft);line-height:1.55}
  .plan-s{color:var(--text-muted);font-size:12px;}

  .ending{border-radius:12px;padding:12px;background:linear-gradient(135deg,#fffef0,#ffe8ee);border:2px solid var(--ink);}
  .ending-t{font-size:14px;color:var(--ink);line-height:1.58;font-weight:600;}
  .ending-s{margin-top:6px;font-size:12.5px;color:var(--ink-soft);line-height:1.62}

  .mascot{
    margin-top:12px;border-radius:12px;padding:12px;background:#fef3d1;border:2px solid var(--ink);
    display:flex;gap:10px;align-items:flex-start;
    box-shadow:4px 4px 0 rgba(21,34,56,0.07);
    transform:rotate(-0.3deg);
  }
  .ms-emoji{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:#fff;border:2px solid var(--ink);font-size:20px;flex:0 0 auto;}
  .ms-lines{flex:1}
  .ms-line{margin-top:4px;font-size:12.5px;color:var(--ink-soft);line-height:1.55;font-weight:500;}
  .ms-line:first-child{margin-top:0}
  
</style>

