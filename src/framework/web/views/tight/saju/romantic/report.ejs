  .co-top{display:flex;align-items:center;gap:10px;margin-bottom:8px}
  .co-badge{font-size:10px;letter-spacing:2px;color:rgba(255,255,255,0.70);padding:2px 8px;border-radius:999px;border:1px solid rgba(255,255,255,0.14);background:rgba(255,255,255,0.04)}
  .co-title{font-size:13px;color:rgba(255,255,255,0.92);font-weight:700}
  .co-body .p{margin-top:10px;color:rgba(255,255,255,0.80);line-height:1.78;font-size:15px}
  .co-body .p:first-child{margin-top:0}
  .quote{margin-top:6px;border-left:3px solid rgba(255,77,141,0.75);padding-left:10px;color:rgba(255,255,255,0.84);line-height:1.65}

  .meter{margin-top:10px}
  .meters .meter:first-child{margin-top:0}
  .meter-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
  .meter-k{font-size:12px;color:rgba(255,255,255,0.75)}
  .meter-v{font-size:12px;color:rgba(243,230,200,0.88)}
  .meter-rail{height:10px;border-radius:999px;background:rgba(255,255,255,0.08);overflow:hidden;border:1px solid rgba(255,255,255,0.10)}
  .meter-fill{height:100%;width:0%;border-radius:999px;transition:width 900ms ease}
  .tone-pink{background:linear-gradient(90deg, rgba(255,77,141,0.95), rgba(196,77,255,0.90))}
  .tone-gold{background:linear-gradient(90deg, rgba(243,230,200,0.95), rgba(212,175,55,0.90))}
  .tone-ice{background:linear-gradient(90deg, rgba(179,205,227,0.95), rgba(160,210,255,0.75))}
  .tone-violet{background:linear-gradient(90deg, rgba(196,77,255,0.90), rgba(255,77,141,0.75))}

  .timeline{margin-top:12px;display:flex;flex-direction:column;gap:10px}
  .tl-item{display:flex;gap:10px;align-items:flex-start}
  .tl-dot{width:10px;height:10px;border-radius:999px;background:rgba(255,77,141,0.85);box-shadow:0 0 12px rgba(255,77,141,0.35);margin-top:6px;flex:0 0 auto}
  .tl-box{flex:1;border-radius:14px;padding:10px 12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.10)}
  .tl-t{font-size:11px;letter-spacing:2px;color:rgba(243,230,200,0.85)}
  .tl-d{margin-top:6px;font-size:12.5px;color:rgba(255,255,255,0.78);line-height:1.6}

  .quiz{margin-top:12px;border-radius:16px;padding:12px 12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.10)}
  .quiz-q{font-size:13px;color:rgba(255,255,255,0.92);font-weight:700}
  .quiz-opts{margin-top:10px;display:grid;grid-template-columns:1fr;gap:8px}
  .quiz-opt{border-radius:12px;padding:10px 10px;background:rgba(0,0,0,0.14);border:1px solid rgba(255,255,255,0.10);color:rgba(255,255,255,0.78);font-size:12.5px;line-height:1.45}
  .quiz-hint{margin-top:10px;font-size:11.5px;color:rgba(255,255,255,0.60)}

  .dd{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .dd-col{border-radius:16px;padding:12px 12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.10)}
  .dd-h{font-size:12px;font-weight:700;margin-bottom:10px}
  .dd-h.ok{color:rgba(134,239,172,0.92)}
  .dd-h.no{color:rgba(255,180,120,0.92)}
  .dd .bullets li{margin-top:8px}
  .dd-t{color:rgba(255,255,255,0.78)}
  @media (max-width:420px){.dd{grid-template-columns:1fr}}

  .tagcloud{margin-top:8px}

  .face-viz{margin-top:12px;display:grid;grid-template-columns:140px 1fr;gap:12px;align-items:start}
  .avatar{display:flex;flex-direction:column;align-items:center}
  .avatar-cap{margin-top:8px;font-size:12px;color:rgba(255,255,255,0.72)}
  @media (max-width:420px){.face-viz{grid-template-columns:1fr}}

  .plan-grid{margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .plan-card{border-radius:16px;padding:12px 12px;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.10)}
  .plan-t{font-size:11px;letter-spacing:2px;color:rgba(243,230,200,0.85)}
  .plan-d{margin-top:8px;font-size:12.5px;color:rgba(255,255,255,0.80);line-height:1.6}
  .plan-s{color:rgba(255,255,255,0.62);font-size:12px}
  @media (max-width:420px){.plan-grid{grid-template-columns:1fr}}

  .ending{border-radius:18px;padding:14px 14px;background:linear-gradient(135deg, rgba(243,230,200,0.06), rgba(255,77,141,0.08));border:1px solid rgba(255,255,255,0.10)}
  .ending-t{font-size:15px;color:rgba(255,255,255,0.92);line-height:1.6}
  .ending-s{margin-top:8px;font-size:13px;color:rgba(255,255,255,0.75);line-height:1.65}
  .ending-chips{margin-top:8px}

  .mascot{
    margin-top:12px;
    border-radius:18px;
    padding:12px 12px;
    background:rgba(255,255,255,0.03);
    border:1px solid rgba(255,255,255,0.10);
    display:flex;
    gap:10px;
    align-items:flex-start;
  }
  .ms-emoji{
    width:36px;height:36px;
    border-radius:12px;
    display:flex;align-items:center;justify-content:center;
    background:linear-gradient(135deg, rgba(255,77,141,0.16), rgba(196,77,255,0.10));
    border:1px solid rgba(255,255,255,0.10);
    font-size:18px;
    flex:0 0 auto;
  }
  .ms-lines{flex:1}
  .ms-line{margin-top:6px;font-size:12.5px;color:rgba(255,255,255,0.78);line-height:1.55}
  .ms-line:first-child{margin-top:0}
  
</style>

<body class="page-classic">
  <div class="flex flex-col w-full max-w-[480px] mx-auto report-bg min-h-screen">
    <%- include('./../../common/common') %>
  <style>
    
  :root {
    --gold-bright: #f3e6c8;
    --accent-pink: #ffb3ba;
    --card-bg: rgba(255, 255, 255, 0.04);
  }

  .saju-summary-tool {
    background:
      radial-gradient(ellipse 140% 80% at 30% -20%, rgba(255, 92, 152, 0.08), transparent 50%),
      radial-gradient(circle at 80% 100%, rgba(212, 175, 55, 0.06), transparent 45%),
      linear-gradient(165deg, #141418 0%, #0d0d10 42%, #0a0a0c 100%);
    border: 1px solid rgba(243, 230, 200, 0.14);
    border-radius: 26px;
    padding: 28px 18px 30px;
    margin: 18px;
    box-shadow:
      0 24px 48px rgba(0, 0, 0, 0.52),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    font-family: 'Noto Serif KR', serif;
    position: relative;
    overflow: hidden;
  }

  .saju-summary-tool::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(60% 40% at 50% 0%, rgba(255, 255, 255, 0.06), transparent 70%);
    opacity: 0.5;
  }
/* 상단 라벨 스타일 추가 */
  .preview-badge-wrap {
    display: flex;
    align-items: center;
    justify-content: center; /* 중앙 정렬 (좌측 원하시면 flex-start) */
    gap: 8px;
    margin-bottom: 20px;
  }

  .preview-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 3px;
    color: rgba(253, 246, 228, 0.92);
    border: 1px solid rgba(212, 175, 55, 0.35);
    padding: 4px 12px;
    border-radius: 99px;
    text-transform: uppercase;
    background: linear-gradient(135deg, rgba(255, 92, 152, 0.12), rgba(212, 175, 55, 0.08));
    box-shadow: 0 0 20px rgba(255, 92, 152, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .preview-main-title {
    font-size: 13px;
    color: rgba(232, 213, 168, 0.88);
    font-weight: 500;
    letter-spacing: 2px;
    opacity: 0.95;
  }
  /* 1. 오행 섹션 (EJS 데이터 바인딩) */
  .element-section {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 30px;
  }

  .el-card {
    flex: 1;
    background: var(--card-bg);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px;
    padding: 10px 4px;
    text-align: center;
  }

  /* 데이터가 1개 이상일 때 강조 효과 */
  .el-card.has-value { border-color: rgba(243, 230, 200, 0.3); background: rgba(243, 230, 200, 0.05); }

  .el-han { font-size: 12px; opacity: 0.6; display: block; }
  .el-val { font-size: 18px; font-weight: 700; margin: 4px 0; display: block; }
  
  .el-bar-container { height: 40px; width: 4px; background: rgba(255,255,255,0.1); margin: 0 auto; border-radius: 2px; position: relative; }
  .el-bar-fill { position: absolute; bottom: 0; width: 100%; height: 0%; border-radius: 2px; transition: height 1s ease-in-out; }

  .color-wood { color: #A8D5BA; } .bg-wood { background: #A8D5BA; }
  .color-fire { color: #FFB3BA; } .bg-fire { background: #FFB3BA; }
  .color-earth { color: #F3E6C8; } .bg-earth { background: #F3E6C8; }
  .color-metal { color: #E0E0E0; } .bg-metal { background: #E0E0E0; }
  .color-water { color: #B3CDE3; } .bg-water { background: #B3CDE3; }

  /* 2. 천간지지 섹션 (EJS 데이터 바인딩) */
  .saju-grid-title {
    font-size: 12px;
    color: var(--gold-bright);
    text-align: center;
    letter-spacing: 3px;
    margin-bottom: 15px;
    opacity: 0.8;
  }

  .saju-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
  }

  .saju-node {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    padding: 15px 0;
    text-align: center;
  }

  .node-label { font-size: 10px; color: rgba(255,255,255,0.4); margin-bottom: 8px; display: block; }
  .hanja-text {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(to bottom, #fff 0%, var(--gold-bright) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 일주(나) 하이라이트 */
  .is-me { border-color: #ff4d8d; background: rgba(255, 77, 141, 0.05); position: relative; }
  .is-me::after {
    content: '나'; position: absolute; top: -6px; right: -6px;
    background: #ff4d8d; color: #fff; font-size: 9px; padding: 2px 5px; border-radius: 4px;
  }
</style>

<div class="saju-summary-tool">
  <div class="preview-badge-wrap">
    <span class="preview-badge">Premium</span>
    <span class="preview-main-title">명식 카드 · 오행 균형</span>
  </div>
  <div class="element-section">
    
    <% 
       // 오행 수치를 퍼센트로 변환 (최대 8개 기준)
       const getPercent = (val) => (Math.min((val / 8) * 100, 100)) + '%';
    %>
    
    <div class="el-card <%= saju.fiveElements.목 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-wood">木</span>
      <span class="el-val color-wood"><%= saju.fiveElements.목 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-wood" data-h="<%= getPercent(saju.fiveElements.목) %>"></div>
      </div>
    </div>

    <div class="el-card <%= saju.fiveElements.화 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-fire">火</span>
      <span class="el-val color-fire"><%= saju.fiveElements.화 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-fire" data-h="<%= getPercent(saju.fiveElements.화) %>"></div>
      </div>
    </div>

    <div class="el-card <%= saju.fiveElements.토 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-earth">土</span>
      <span class="el-val color-earth"><%= saju.fiveElements.토 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-earth" data-h="<%= getPercent(saju.fiveElements.토) %>"></div>
      </div>
    </div>

    <div class="el-card <%= saju.fiveElements.금 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-metal">金</span>
      <span class="el-val color-metal"><%= saju.fiveElements.금 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-metal" data-h="<%= getPercent(saju.fiveElements.금) %>"></div>
      </div>
    </div>

    <div class="el-card <%= saju.fiveElements.수 > 0 ? 'has-value' : '' %>">
      <span class="el-han color-water">水</span>
      <span class="el-val color-water"><%= saju.fiveElements.수 %></span>
      <div class="el-bar-container">
        <div class="el-bar-fill bg-water" data-h="<%= getPercent(saju.fiveElements.수) %>"></div>
      </div>
    </div>
  </div>

  <div class="saju-grid-title">八字四柱</div>
  <div class="saju-grid">
    <div class="saju-node">
      <span class="node-label">시주</span>
      <div class="hanja-text"><%= saju.hour.gan || " " %><br><%= saju.hour.ji || " " %></div>
    </div>
    <div class="saju-node is-me">
      <span class="node-label">일주</span>
      <div class="hanja-text"><%= saju.day.gan %><br><%= saju.day.ji %></div>
    </div>
    <div class="saju-node">
      <span class="node-label">월주</span>
      <div class="hanja-text"><%= saju.month.gan %><br><%= saju.month.ji %></div>
    </div>
    <div class="saju-node">
      <span class="node-label">년주</span>
      <div class="hanja-text"><%= saju.year.gan %><br><%= saju.year.ji %></div>
    </div>
  </div>
</div>
<script>
  (function(){
    try{
      document.querySelectorAll(".el-bar-fill[data-h]").forEach(function(el){
        var h = el.getAttribute("data-h");
        if (h) el.style.height = h;
      });
      document.querySelectorAll(".meter-fill[data-w]").forEach(function(el){
        var w = el.getAttribute("data-w");
        if (w) el.style.width = w;
      });
    }catch(e){}
  })();
</script>
    <div id="container" class="pb-20">
      <% 
        const chapters = [...new Set(reportInfo.map(r => r.chapter))];
        const totalChapters = chapters.length;
        let currentChapter = '';
      %>

      <% reportInfo.forEach((item, index) => { %>
        <% if (item.chapter !== currentChapter) { %>
          <% currentChapter = item.chapter; %>
          <% const chapterIndex = chapters.indexOf(item.chapter); %>

          <div class="chapter-progress-wrap px-8">
            <div class="chapter-dots">
              <% for (let i = 0; i < totalChapters; i++) { %>
                <div class="dot <%= i === chapterIndex ? 'active' : '' %>"></div>
              <% } %>
            </div>
            <span class="chapter-badge">Chapter 0<%= chapterIndex + 1 %></span>
            <h2 class="chapter-title"><%= item.chapter %></h2>
            <div class="chapter-line"></div>
          </div>

          <div class="px-6 space-y-10">
        <% } %>

       <div class="content-card">

  <% if (item.title.includes("이 사주에서 특히 힘든 상대 유형")) { %>
    <div class="w-full mb-6">
      <img 
        src="/assets/images/tight/romantic/report/<%= genderKey %>/<%= myDayStem %>.png"
        class="w-full rounded-xl"
        onerror="this.style.display='none';"
      />
    </div>
  <% } %>

  <% if (item.title.includes("이성에게 작용하는 기운의 결")) { %>
    <div class="w-full mb-6">
      <img 
        src="/assets/images/tight/romantic/report/<%= genderKey %>1/<%= myDayStem %>.png"
        class="w-full rounded-xl"
        onerror="this.style.display='none';"
      />
    </div>
  <% } %>



  <% if (item.title && item.title !== item.chapter) { %>
    <h3 class="report-title">
      <%= item.title %>
    </h3>
  <% } %>
<%
  let formattedContent = item.content;
%>
  <div class="report-content">
    <% if (item.isHtml) { %>
      <%- formattedContent %>
    <% } else { %>
      <%= formattedContent %>
    <% } %>
  </div>
</div>


        <% 
          const nextItem = reportInfo[index + 1];
          if (!nextItem || nextItem.chapter !== currentChapter) { 
        %>
          </div> <% } %>
      <% }); %>
    </div>
  </div>
</body>
</html>