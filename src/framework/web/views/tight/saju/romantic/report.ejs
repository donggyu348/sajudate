  ];
  const openVarLine = openVarHints[openSeed % openVarHints.length];
  const openCoachLines = [
    "오늘은 설명서 읽기보다, 한 가지 행동만 바꿔 보기.",
    "대사는 복붙해도 됨. 톤만 당신 말투로 살짝만.",
