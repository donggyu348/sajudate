<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  const STEM_TO_FILE = {
    "甲":"갑목","乙":"을목","丙":"병화","丁":"정화","戊":"무토",
    "己":"기토","庚":"경금","辛":"신금","壬":"임수","癸":"계수",
    "갑":"갑목","을":"을목","병":"병화","정":"정화","무":"무토",
    "기":"기토","경":"경금","신":"신금","임":"임수","계":"계수"
  };
  const myDayStem = STEM_TO_FILE[saju.day.gan] || "갑목";

  const g = String(userInfo.gender).trim();
  let genderKey = (["여","여자","여성","female","woman"].includes(g)) ? "woman" : "man";

  // reportInfo가 비어있으면, 6장 구성의 "긴/직관적/시각요소 많은" 기본 리포트를 생성
  // (서버에서 reportInfo를 주는 경우엔 그 값을 그대로 사용)
  const safeUserName = (userInfo && (userInfo.nickname || userInfo.name)) ? String(userInfo.nickname || userInfo.name) : "당신";
  const spouseNoun = (genderKey === "man") ? "미래 아내" : "미래 남편";

  const icon = {
    spark:"✦", heart:"♥", target:"◎", note:"✎", warn:"⚠", check:"✓", clock:"⏳", star:"★", key:"🔑"
  };

  /** 오프닝 ‘오늘의 관계 무드’ 등 — 서버 재현 가능한 단순 해시 */
  function seedFromUser(u) {
    const s = String((u?.birthDate || u?.birthdate || "") + (u?.name || "") + (u?.nickname || ""));
    let h = 2166136261;
    for (let i = 0; i < s.length; i++) {
      h ^= s.charCodeAt(i);
      h = Math.imul(h, 16777619);
    }
    return Math.abs(h);
  }
  const openSeed = seedFromUser(typeof userInfo !== "undefined" ? userInfo : {});
  /** 오프닝 문구 종류별로 독립 추첨 */
  function subSeed(base, salt) {
    let x = Math.imul(base ^ (salt * 73856093), 19349663);
    x ^= x >>> 16;
    return Math.abs(x) >>> 0;
  }
  function openStarsRating(nFull, max) {
    max = max || 5;
    let n = Math.max(0, Math.min(Number(nFull) || 0, max));
    let s = "";
    for (let i = 0; i < max; i++) s += i < n ? "★" : "☆";
    return s;
  }
  const openImmersionStars = 3 + (subSeed(openSeed, 31) % 3);
  const openHurtStars = 2 + (subSeed(openSeed, 32) % 3);
  const openClingStars = 3 + (subSeed(openSeed, 33) % 3);
  const openArchetypes = [
    function (n){ return `${n}님은 연애에서 ‘밀당 고수형 감성 전략가’입니다.`; },
    function (n){ return `${n}님은 겉은 차갑고 속은 집착하는 ‘츤데레 집착형’입니다.`; },
    function (n){ return `${n}님은 ‘설렘이 느리게 도는 깊은 몰입형 로맨티스트’에 가깝습니다.`; },
    function (n){ return `${n}님은 말보다 선택으로 마음을 보이는 ‘행동 신뢰형’입니다.`; },
    function (n){ return `${n}님은 겉으로는 무심한데 속으로는 테스트를 많이 하는 ‘관찰형 설렘 저장소’예요.`; },
    function (n){ return `${n}님은 시작은 조심스럽지만, 한 번 문이 열리면 진심 직진형입니다.`; },
    function (n){ return `${n}님은 호감이 생기면 먼저 손 안 대고 신호부터 읽는 ‘신중한 전략가’ 타입입니다.`; },
    function (n){ return `${n}님은 불안 속에서도 균형을 맞추려는 ‘감정 방어 후 진심’ 패턴이 강할 수 있어요.`; },
  ];
  const openArchetype = openArchetypes[subSeed(openSeed, 21) % openArchetypes.length](safeUserName);
  const openDramas = [
    function (n){ return `${n}님의 연애는 늦게 불붙는 로맨스 드라마처럼, 시간이 지날수록 몰입이 깊어지는 타입이에요.`; },
    function (n){ return `첫 만남은 무심하게 보여도 에피소드가 쌓일수록 속마음 제목은 바뀌는, 서사형 연애에 가까워요.`; },
    function (n){ return `${n}님의 에피소드 오프너는 담담한데, 회차 거듭할수록 ‘설렘 회상 장면’이 늘어나는 구조예요.`; },
    function (n){ return `처음은 가벼워 보이다가 한 번 깊어지면 쇼츠 같은 템포가 아니라 본방 드라마 템포로 가는 타입이에요.`; },
    function (n){ return `${n}님은 ‘바로 타오르는 불’보다 천천히 스며드는 온도에 강합니다.`; },
    function (n){ return `외부인 시점에서는 담백해 보여도 속으로 스토리가 길게 깔리는, 내레이션이 많은 로맨스예요.`; },
  ];
