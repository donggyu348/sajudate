  const openVsPairs = [
    { first: "첫인상: 쿨하고 거리감 있음", real: "실제 연애: 감정 깊고 쉽게 못 놓음" },
    { first: "첫인상: 차분·정리된 어른 느낌", real: "실제 연애: 애정은 은근히 끈질기게 남음" },
    { first: "첫인상: 관심 없어 보이는 편", real: "실제 연애: 한 번 열리면 투자·몰입이 확 올라감" },
    { first: "첫인상: 말수 적고 무덤덤", real: "실제 연애: 속으로는 시나리오·해석이 많음" },
    { first: "첫인상: 친구 같이 편함", real: "실제 연애: 경계가 흐려질 때가 가장 위험·가장 설렘" },
    { first: "첫인상: 밝고 사교적", real: "실제 연애: 관계 깊어질수록 ‘나만의 기준’이 강해짐" },
