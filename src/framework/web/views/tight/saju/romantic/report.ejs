<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<style>
  .report-bg {
    background:
      radial-gradient(
        120% 80% at 50% 0%,
        #1a0a10 0%,
        #0b0b0d 60%,
        #070707 100%
      );
  }

  .report-chapter {
    border: 1px solid rgba(255,255,255,0.25);
    color: #fff;
    font-size: 13px;
    padding: 4px 14px;
    border-radius: 9999px;
    display: inline-block;
  }

  .report-title {
    font-size: 20px;
    line-height: 1.3;
    font-weight: 700;
    color: #ffffff;
    white-space: pre-line;
  }

  .report-content {
    font-size: 16px;
    line-height: 1.9;
    color: #d1d1d1;
    white-space: pre-line;
  }

  .highlight {
    color: #ff4d8d;
    font-weight: 600;
  }
.report-top-spacer {
  height: 32px; /* 여기 숫자만 조절 */
}

  /* ===== CHAPTER PROGRESS ===== */
.chapter-progress-wrap {
  margin-top: 96px;
  margin-bottom: 64px;
}

.chapter-progress {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 16px;
}

.chapter-dot {
  width: 6px;
  height: 6px;
  border-radius: 9999px;
  background: rgba(255,255,255,0.25);
}

.chapter-dot.active {
  background: #ff4d8d;
  width: 18px;
}

.chapter-title {
  font-size: 26px;
  font-weight: 700;
  line-height: 1.3;

  background: linear-gradient(
    90deg,
    #ffffff 0%,
    #f3e6c8 50%,
    #ffffff 100%
  );
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}





.chapter-sub {
  margin-top: 12px;
  font-size: 14px;
  color: rgba(255,255,255,0.55);
}

</style>

<body class="page-classic">
  
<div class="flex flex-col w-full max-w-[480px] mx-auto ">
    <div class="flex justify-center flex-col items-center mx-auto max-w-7xl " >
        <%- include('./../../common/common') %>


        <div id="container">

            <div class="relative w-full max-w-[448px] mx-auto">
                <div class="relative">

     
                <div class="relative w-full max-w-[448px] mx-auto report-bg pb-32">
                    <div class="report-top-spacer"></div>


   
                 <% 
    const chapters = [...new Set(reportInfo.map(r => r.chapter))];
    const totalChapters = chapters.length;
    let currentChapter = '';
  %>
  <% reportInfo.forEach((item, index) => { %>
    <% if (item.chapter !== currentChapter) { %>
      <% currentChapter = item.chapter; %>

<%
  const chapterIndex = chapters.indexOf(item.chapter);
%>

<div class="px-8 chapter-progress-wrap ">

  <!-- 진행바 -->
  <div class="chapter-progress">
    <% for (let i = 0; i < totalChapters; i++) { %>
      <div class="chapter-dot <%= i <= chapterIndex ? 'active' : '' %>"></div>
    <% } %>
  </div>

  <!-- 챕터 타이틀 -->
  <div class="chapter-title">
    <%= item.chapter %>
  </div>

  <!-- 서브 카피 (선택) -->
  <div class="chapter-sub">
     <%= chapterIndex + 1 %> / <%= totalChapters %>
  </div>

</div>

<div class="mt-16 space-y-24 px-8">

    <% } %>

<div>

  <% if (item.title && item.title !== item.chapter) { %>
    <div class="report-title">
      <%= item.title %>
    </div>
  <% } %>

  <p class="report-content mt-12">
    <%= item.content %>
  </p>

</div>


    <%
      const nextItem = reportInfo[index + 1];
      if (!nextItem || nextItem.chapter !== currentChapter) {
    %>
      </div>
    <% } %>
  <% }); %>
</div>

            </div>
        </div>

    </div>
</div>

</body>



</html>
