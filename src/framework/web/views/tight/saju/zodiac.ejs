        </div>
      </button>

      <!-- 개띠 -->
      <button onclick="showFortune('dog')" class="zodiac-card flex flex-col items-center gap-2 p-4 rounded-2xl bg-zinc-900 border border-white/5 active:scale-95 transition-transform">
        <span class="text-3xl">🐶</span>
        <div class="text-center">
          <p class="text-sm font-semibold text-white">개띠</p>
          <p class="text-[10px] text-zinc-500 mt-0.5">1922 · 1934 · 1946<br>1958 · 1970 · 1982<br>1994 · 2006 · 2018</p>
        </div>
        <div class="flex gap-0.5 mt-1">
          <span class="text-amber-400 text-[10px]">★★★★☆</span>
        </div>
      </button>

      <!-- 돼지띠 -->
      <button onclick="showFortune('pig')" class="zodiac-card flex flex-col items-center gap-2 p-4 rounded-2xl bg-zinc-900 border border-white/5 active:scale-95 transition-transform">
        <span class="text-3xl">🐷</span>
        <div class="text-center">
          <p class="text-sm font-semibold text-white">돼지띠</p>
          <p class="text-[10px] text-zinc-500 mt-0.5">1923 · 1935 · 1947<br>1959 · 1971 · 1983<br>1995 · 2007 · 2019</p>
