        <div class="text-center">
          <p class="text-sm font-semibold text-white">양띠</p>
          <p class="text-[10px] text-zinc-500 mt-0.5">1919 · 1931 · 1943<br>1955 · 1967 · 1979<br>1991 · 2003 · 2015</p>
        </div>
        <div class="flex gap-0.5 mt-1">
          <span class="text-amber-400 text-[10px]">★★★★☆</span>
        </div>
      </button>

      <!-- 원숭이띠 -->
      <button onclick="showFortune('monkey')" class="zodiac-card flex flex-col items-center gap-2 p-4 rounded-2xl bg-zinc-900 border border-white/5 active:scale-95 transition-transform">
        <span class="text-3xl">🐵</span>
        <div class="text-center">
          <p class="text-sm font-semibold text-white">원숭이띠</p>
          <p class="text-[10px] text-zinc-500 mt-0.5">1920 · 1932 · 1944<br>1956 · 1968 · 1980<br>1992 · 2004 · 2016</p>
