<!DOCTYPE html>
<html lang="ko">

<%- include('./../common/header') %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />

<body class="min-h-screen bg-[#0a0a0b] text-white antialiased" style="font-family: 'Pretendard', -apple-system, sans-serif;">

<div class="w-full max-w-[480px] mx-auto min-h-screen flex flex-col">
  <%- include('./../common/common') %>

  <!-- TOP BAR -->
  <header class="sticky top-0 z-50 w-full bg-[#0a0a0b]/95 backdrop-blur-sm border-b border-white/5 flex-shrink-0">
    <div class="flex items-center justify-between px-4 h-12">
      <a href="/saju" class="text-zinc-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
        </svg>
      </a>
      <span class="text-sm font-semibold">오늘의 띠별 운세</span>
      <div class="w-5"></div>
    </div>
  </header>

  <!-- HERO -->
  <section class="px-4 pt-6 pb-5 border-b border-white/5">
    <div class="rounded-2xl bg-gradient-to-br from-violet-950 via-indigo-900 to-purple-950 border border-purple-500/20 p-5">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-xs text-purple-300 font-medium mb-1.5">
            <% const d = new Date(); %>
            <%= d.getFullYear() %>년 <%= d.getMonth()+1 %>월 <%= d.getDate() %>일
          </p>
          <h1 class="text-xl font-bold text-white leading-snug">오늘 내 띠는<br>어떤 운세일까요?</h1>
          <p class="text-xs text-purple-200/60 mt-2 leading-relaxed">12띠 중 내 띠를 선택하면<br>오늘의 운세를 바로 확인할 수 있어요</p>
        </div>
        <span class="text-5xl">🎋</span>
      </div>
    </div>
  </section>

  <!-- 12띠 그리드 -->
  <section class="px-4 py-5 flex-1">
    <div class="grid grid-cols-3 gap-3">

      <!-- 쥐띠 -->
