          <label class="field__label" for="birthdateDisplay">생년월일</label>
          <input type="text" id="birthdateDisplay" inputmode="numeric" maxlength="8"
                 placeholder="8자리 (예: 19980415)">
        </div>

        <div class="field">
          <label class="field__label" for="birthTimeSelect">출생시간</label>
          <select name="birthTime" id="birthTimeSelect">
            <option value="unknown">시(時) 모름</option>
            <option value="00">자시 子 (23:30~01:29)</option>
            <option value="02">축시 丑 (01:30~03:29)</option>
            <option value="04">인시 寅 (03:30~05:29)</option>
            <option value="06">묘시 卯 (05:30~07:29)</option>
            <option value="08">진시 辰 (07:30~09:29)</option>
            <option value="10">사시 巳 (09:30~11:29)</option>
            <option value="12">오시 午 (11:30~13:29)</option>
            <option value="14">미시 未 (13:30~15:29)</option>
            <option value="16">신시 申 (15:30~17:29)</option>
            <option value="18">유시 酉 (17:30~19:29)</option>
            <option value="20">술시 戌 (19:30~21:29)</option>
            <option value="22">해시 亥 (21:30~23:29)</option>
          </select>
        </div>

        <div class="field">
          <label class="field__label">성별</label>
          <div class="genderbtns">
            <button type="button" class="gender-cell" data-value="남성"><span class="hz">乾</span>남성</button>
            <button type="button" class="gender-cell" data-value="여성"><span class="hz">坤</span>여성</button>
          </div>
        </div>

        <button type="button" class="cta" id="openBtn">내 자미명반 열어보기</button>
      </form>
      <p class="final__note">입력한 정보는 당신의 명반을 계산하는 데에만 사용됩니다.</p>
