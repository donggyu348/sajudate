</div><!-- /.ziwei-lp -->

  <script>
    (function () {
      /* ── 페이드 업: Intersection Observer ── */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.ziwei-lp .fade-up').forEach(function (el, i) {
        // 같은 섹션 내 순차 등장 느낌을 위해 약간의 지연
        el.style.transitionDelay = (Math.min(i % 6, 5) * 0.06) + 's';
        io.observe(el);
      });

      /* ── 후기 자동 슬라이더 (Swiper) ── */
      if (window.Swiper) {
        new Swiper('#reviewSwiper', {
          slidesPerView: 1.1,
          spaceBetween: 14,
          centeredSlides: false,
          loop: true,
          autoplay: { delay: 3200, disableOnInteraction: false },
          speed: 700,
          breakpoints: { 768: { slidesPerView: 2.2, spaceBetween: 16 } }
        });
      }

      /* ── 성별 선택 ── */
      document.querySelectorAll('.genderbtns .gender-cell').forEach(function (btn) {
        btn.addEventListener('click', function () {
          document.querySelectorAll('.genderbtns .gender-cell').forEach(function (b) { b.classList.remove('active'); });
          btn.classList.add('active');
          document.getElementById('genderInput').value = btn.dataset.value;
        });
      });

      /* ── 생년월일 숫자만 ── */
      var bdDisplay = document.getElementById('birthdateDisplay');
      bdDisplay.addEventListener('input', function () {
        this.value = this.value.replace(/\D/g, '').slice(0, 8);
      });

      /* ── 제출 ── */
      var form = document.getElementById('ziweiForm');
      document.getElementById('openBtn').addEventListener('click', function () {
        var bd     = bdDisplay.value.replace(/\D/g, '');
        var gender = document.getElementById('genderInput').value;

        if (!/^\d{8}$/.test(bd)) { alert('생년월일을 8자리로 정확히 적어주세요. (예: 19980415)'); return; }
        if (!gender) { alert('성별을 선택해주세요.'); return; }

        document.getElementById('birthdateInput').value = bd;

        var ticket = new URLSearchParams(window.location.search).get('ticket');
        if (ticket) {
          var t = document.createElement('input');
          t.type = 'hidden'; t.name = 'ticket'; t.value = ticket;
          form.appendChild(t);
          form.action = '/saju/ziwei/input?ticket=' + ticket;
        }
        form.submit();
      });
    })();
  </script>
</body>
</html>
