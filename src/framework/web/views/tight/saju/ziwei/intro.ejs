  <!-- ══════ FINAL CTA ══════ -->
  <section class="final">
    <div class="wrap">
      <span class="eyebrow fade-up">OPEN YOUR CHART</span>
      <h2 class="title fade-up">당신의 명반에는<br>어떤 삶의 흐름이<br><span class="gold">기록되어 있을까요?</span></h2>

      <div class="media media--wide fade-up" data-label="FINAL · GIF" style="max-width:460px;">
        <img src="/gif/final.gif" alt="" onerror="this.remove()">
      </div>

      <form id="ziweiForm" method="POST" action="/saju/ziwei/input" class="form fade-up">
        <input type="hidden" name="gender" id="genderInput">
        <input type="hidden" name="birthType" value="양력">
        <input type="hidden" name="birthdate" id="birthdateInput">
        <input type="hidden" name="goodsType" value="ZIWEI">

