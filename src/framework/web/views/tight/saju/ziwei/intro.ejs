<!-- ══════ 하단 고정 CTA 바 ══════ -->
<div class="zw-bar">
  <div class="zw-bar__proof"><span class="heart">♥</span> <b id="zwCount">18,482</b>명이 확인했어요</div>
  <a href="/saju/ziwei/input" class="zw-bar__btn" id="zwStartBtn">자미두수 시작하기</a>
</div>

  <script>
    (function () {
      /* 페이드 업 */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { threshold: 0.14, rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.ziwei-lp .fade-up').forEach(function (el, i) {
        el.style.transitionDelay = (Math.min(i % 5, 4) * 0.06) + 's';
        io.observe(el);
      });

      /* 후기 슬라이더 */
      if (window.Swiper) {
        new Swiper('#reviewSwiper', {
          slidesPerView: 1.1, spaceBetween: 14, loop: true,
          autoplay: { delay: 3200, disableOnInteraction: false }, speed: 700,
          breakpoints: { 768: { slidesPerView: 2.2, spaceBetween: 16 } }
        });
      }

      /* 확인 인원 살짝 카운트업 (한 번) */
      var cntEl = document.getElementById('zwCount');
      if (cntEl) {
        var target = 18482, cur = 18300, t;
        t = setInterval(function () {
          cur += 7;
          if (cur >= target) { cur = target; clearInterval(t); }
          cntEl.textContent = cur.toLocaleString();
        }, 30);
      }

      /* 시작하기: ticket 파라미터 유지 */
      var startBtn = document.getElementById('zwStartBtn');
      if (startBtn) {
        var ticket = new URLSearchParams(window.location.search).get('ticket');
        if (ticket) startBtn.href = '/saju/ziwei/input?ticket=' + encodeURIComponent(ticket);
      }
    })();
  </script>
