<!DOCTYPE html>
<html lang="ko">

<%- include('./../common/header') %>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://js.tosspayments.com/v2/standard"></script>

<body class="bg-gray-100">

    <div class="w-full max-w-[480px] mx-auto">
        <div class="flex justify-center flex-col items-center mx-auto max-w-7xl">
            <div class="max-w-md w-full sm:border-x text-left bg-white min-h-screen">

                <div class="flex items-center justify-center border-b relative py-3">
                    <a href="/s/bluemoonladysaju/result" class="absolute left-4">
                        <svg class="w-5 h-5 text-gray-800" viewBox="0 0 1024 1024" fill="currentColor">
                            <path d="M724 218.3V141c0-6.7-7.7-10.4-12.9-6.3L260.3 486.8c-16.4 12.8-16.4 37.5 0 50.3l450.8 352.1c5.3 4.1 12.9.4 12.9-6.3v-77.3c0-4.9-2.3-9.6-6.1-12.6l-360-281 360-281.1c3.8-3 6.1-7.7 6.1-12.6z"></path>
                        </svg>
                    </a>
                    <h2 class="text-lg font-bold">결제하기</h2>
                </div>

                <div class="p-6 space-y-6">
                    <div>
                        <p class="text-lg font-bold">휴대폰 번호</p>
                        <p class="text-xs text-gray-600 mt-1">사주 결과 확인 및 안내 메시지 발송에 이용됩니다.</p>
                        <div class="flex gap-2 mt-2">
                            <select class="w-1/4 border border-gray-300 rounded px-2 py-1 text-sm bg-gray-50" disabled><option>010</option></select>
                            <input type="tel" name="buyerTelF" maxlength="4" class="w-1/4 border border-gray-200 rounded-lg px-3 py-2 text-sm bg-gray-50 focus:bg-white" />
                            <input type="tel" name="buyerTelB" maxlength="4" class="w-1/4 border border-gray-200 rounded-lg px-3 py-2 text-sm bg-gray-50 focus:bg-white" />
                        </div>
                    </div>

                    <div>
                        <p class="text-lg font-bold mt-6">비밀번호 <span class="text-xs">(숫자 4자리)</span></p>
                        <input type="password" name="buyerPW" maxlength="4" class="w-full border border-gray-200 rounded-lg px-3 py-2 mt-2 text-sm bg-gray-50 focus:bg-white" />
                    </div>

                    <hr class="border-gray-100 my-6">

                    <div>
                        <p class="text-lg font-bold mb-4">상품 선택</p>
                        <div class="space-y-3">
                            <div onclick="selectOption('single')" id="card-single" class="goods-card is-selected">
                                <div class="flex items-center gap-3">
                                    <div class="radio-dot"></div>
                                    <div>
                                        <p class="text-[11px] font-bold ">기본 패키지</p>
                                        <p class="font-bold text-gray-800"><%= goodsInfo.title %></p>
                                    </div>
                                </div>
                                <p class="font-bold text-gray-900"><%= goodsInfo.price.toLocaleString() %>원</p>
                            </div>

                            <% if (typeof bundleInfo !== 'undefined' && bundleInfo) { 
                                let targetTitle = (goodsInfo.code === 'CLASSIC') ? '연애사주' : '신년사주';
                                let bundleBenefit = (goodsInfo.code === 'CLASSIC') ? '연애사주 무료 쿠폰' : '신년사주 무료 쿠폰';
                            %>
                            
          <div onclick="selectOption('bundle')" id="card-bundle" class="goods-card relative border-2 border-pink-400 bg-pink-50/30">


    
    <div class="flex items-center gap-3">
        <div class="radio-dot border-pink-400"></div>
        <div>
            <p class="text-[11px] font-bold text-blue-600">특별 번들 패키지</p>
            <p class="font-bold text-gray-800"><%= goodsInfo.title %> + <%= targetTitle %></p>
            <p class="text-[11px] text-pink-500 mt-0.5"><%= bundleBenefit %> 증정</p>
        </div>
    </div>
                                    <p class="font-bold text-gray-900"><%= bundleInfo.price.toLocaleString() %>원</p>

    </div>

                            <div id="bundle-notice" class="hidden animate-fade-in mt-3">
                                <div class="rounded-xl border border-pink-100 bg-pink-50/50 p-4">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="text-pink-500">🎫</span>
                                        <p class="font-bold text-pink-600 text-sm">특별 번들 혜택 안내</p>
                                    </div>
                                    <ul class="space-y-1 text-[12px] text-gray-600">
                                        <li>• 결제 완료 후 즉시 <b>문자(SMS)</b>로 티켓 코드가 발송됩니다.</li>
                                        <li>• 발급된 티켓은 <b>지인에게 선물</b>이 가능합니다.</li>
                                    </ul>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="pt-6 mt-6 border-t border-gray-200 space-y-4 rounded-xl bg-gray-50 px-4 pb-4">
                        <div class="flex justify-between text-sm text-gray-600">
                            <p id="detail-title"><%= goodsInfo.title %></p>
                            <p id="detail-original-price"><%= goodsInfo.originalPrice.toLocaleString() %>원</p>
                        </div>
                        
                        <div id="discount-row" class="flex justify-between text-blue-600 text-sm">
                            <p>특별 할인</p>
                            <div class="flex items-center gap-2">
                                <span id="detail-discount-rate" class="text-[10px] bg-blue-600 text-white rounded-full px-2 h-4 flex items-center">
                                    -<%= Math.floor((goodsInfo.discountPrice / goodsInfo.originalPrice) * 100) %>%
                                </span>
                                <span id="detail-discount-price">-<%= goodsInfo.discountPrice.toLocaleString() %>원</span>
                            </div>
                        </div>

                        <div class="flex justify-between items-center bg-white rounded-lg px-4 py-3 mt-3 font-bold">
                            <p>최종 결제금액</p>
                            <p id="final-price-display" class="text-xl text-blue-600">
                                <%= goodsInfo.price.toLocaleString() %>원
                            </p>
                        </div>
                    </div>

                    <div class="mt-8 space-y-3">
                        <button onclick="requestTossCardPayment()" class="w-full text-white text-lg font-bold py-3 rounded shadow flex items-center justify-center" style="background-color: #0064ff;">
                            <span style="color: white;">카드 결제 (신용/체크)</span>
                        </button>
                    </div>
                </div>
            </div>
            <%- include('./../common/footer') %>
        </div>
    </div>

    <style>
        .goods-card { display: flex; justify-content: space-between; align-items: center; padding: 16px; border-radius: 12px; border: 1.5px solid #f3f4f6; cursor: pointer; transition: all 0.2s; }
        .goods-card.is-selected { border-color: #0064ff; background-color: #f0f7ff; }
        .radio-dot { width: 18px; height: 18px; border: 2px solid #d1d5db; border-radius: 50%; position: relative; }
        .is-selected .radio-dot { border-color: #0064ff; }
        .is-selected .radio-dot::after { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 8px; height: 8px; background: #0064ff; border-radius: 50%; }

        /* 번들 전용 흔들림 애니메이션 (주의 집중) */
@keyframes soft-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
}
.best-badge-anim {
    animation: soft-bounce 2s infinite ease-in-out;
}

/* 번들 선택 시 보더 색상 차별화 */
#card-bundle.is-selected {
    border-color: #ec4899 !important; /* 핑크색 강조 */
    background-color: #fff1f2 !important;
}
    </style>

    <script>
        const GOODS_MAP = <%- JSON.stringify(goodsTypeMap) %>;
        let finalGoodsCode = "<%= goodsInfo.code %>";
        const goodsNameBase = "<%= goodsInfo.title %>";
        const reportHistoryId = "<%= reportHistoryId %>";

        const tossPayments = TossPayments("live_ck_yZqmkKeP8gB9OlXz5ggnrbQRxB9l");
        const payment = tossPayments.payment({ customerKey: "USER_" + reportHistoryId });

        function selectOption(type) {
            const singleCard = document.getElementById('card-single');
            const bundleCard = document.getElementById('card-bundle');
            const notice = document.getElementById('bundle-notice');
            const finalPriceDisplay = document.getElementById('final-price-display');
            
            // 상세 내역 요소들
            const dTitle = document.getElementById('detail-title');
            const dOriginal = document.getElementById('detail-original-price');
            const dDiscountRow = document.getElementById('discount-row');
            const dDiscountPrice = document.getElementById('detail-discount-price');
            const dDiscountRate = document.getElementById('detail-discount-rate');

            singleCard.classList.remove('is-selected');
            if (bundleCard) bundleCard.classList.remove('is-selected');
            if (notice) notice.classList.add('hidden');

if (type === 'single') {
    singleCard.classList.add('is-selected'); // 테두리 생기게 함
    finalGoodsCode = "<%= goodsInfo.code %>"; // CLASSIC 또는 ROMANTIC
} else if (type === 'bundle') {
    bundleCard.classList.add('is-selected'); // 테두리 생기게 함
    // 현재 페이지 상품이 CLASSIC이면 CLASSIC_BUNDLE, ROMANTIC이면 ROMANTIC_BUNDLE이 됨
    finalGoodsCode = "<%= goodsInfo.code %>" + "_BUNDLE"; 
}

            const data = GOODS_MAP[finalGoodsCode];
            if (data) {
                finalPriceDisplay.innerText = data.price.toLocaleString() + "원";
                dTitle.innerText = data.title;
                dOriginal.innerText = data.originalPrice.toLocaleString() + "원";
                
                // 할인 금액이 있을 때만 할인 로우 노출
                if (data.discountPrice > 0) {
                    dDiscountRow.classList.remove('hidden');
                    dDiscountPrice.innerText = "-" + data.discountPrice.toLocaleString() + "원";
                    dDiscountRate.innerText = "-" + Math.floor((data.discountPrice / data.originalPrice) * 100) + "%";
                } else {
                    dDiscountRow.classList.add('hidden');
                }
            }
        }

        async function requestTossCardPayment() {
            const telF = document.querySelector("input[name='buyerTelF']").value.trim();
            const telB = document.querySelector("input[name='buyerTelB']").value.trim();
            const pw = document.querySelector("input[name='buyerPW']").value.trim();

            if (!/^\d{4}$/.test(telF) || !/^\d{4}$/.test(telB) || !/^\d{4}$/.test(pw)) {
                alert("휴대폰 번호와 비밀번호(4자리)를 정확히 입력해 주세요.");
                return;
            }

            const fullTel = `010${telF}${telB}`;

            try {
                const response = await axios.post("/api/payments/register", {
                    userTelNo: fullTel, userPw: pw, payMethod: "TOSS",
                    reportHistoryId: reportHistoryId, goodsCode: finalGoodsCode,goodsType: finalGoodsCode  // 서버 DB 업데이트용
                });

                if (response.data.code !== 200) throw new Error(response.data.message);

                const { shopOrderNo, amount } = response.data.data;
                await payment.requestPayment({
                    method: "CARD",
                    amount: { currency: "KRW", value: amount },
                    orderId: shopOrderNo,
                    orderName: GOODS_MAP[finalGoodsCode].title,
        successUrl: window.location.origin + "/api/payments/callback-toss" + 
                        `?tel=${fullTel}&pw=${pw}&historyId=${reportHistoryId}&goodsType=${finalGoodsCode}`,
                    failUrl: window.location.origin + "/saju/payment?error=fail",
                    customerMobilePhone: fullTel,
                    card: { flowMode: "DEFAULT", useCardPoint: false }
                });
            } catch (error) {
                alert("결제 준비 중 오류가 발생했습니다.");
            }
        }
    </script>
</body>
</html>