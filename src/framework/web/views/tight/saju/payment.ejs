    </style>

    <script>
        const GOODS_MAP = <%- JSON.stringify(goodsTypeMap) %>;
        let finalGoodsCode = "<%= goodsInfo.code %>";
        const goodsNameBase = "<%= goodsInfo.title %>";
        const reportHistoryId = "<%= reportHistoryId %>";
        let allowLeave = false;
        let pendingLeaveUrl = null;
        let countdownTimerId = null;
        const COUNTDOWN_STORAGE_KEY = "payment_exit_countdown_end";
        const COUNTDOWN_DURATION_MS = 20 * 60 * 60 * 1000;

        /* ── 카카오톡 채널 추가 쿠폰 ── */
        const KAKAO_CHANNEL_PUBLIC_ID = "<%= kakaoChannelPublicId %>";
        const KAKAO_CHANNEL_ADD_URL = `https://pf.kakao.com/${KAKAO_CHANNEL_PUBLIC_ID}/friend`;
        const CHANNEL_COUPON_CODE = "<%= channelCouponCode %>";
        const CHANNEL_COUPON_DISCOUNT = <%= channelCouponDiscount %>;
        // 채널 쿠폰은 번들 상품에만 적용된다 (서버 ChannelCouponService와 동일 규칙)
        const channelDiscountFor = (code) => (String(code).includes("_BUNDLE") ? CHANNEL_COUPON_DISCOUNT : 0);
        // 값에 "다시 노출 가능 시각(ms)"을 저장한다. (구버전의 "1" 기록은 무시)
        const CHANNEL_POPUP_SEEN_KEY = "kakaoChannelPopupSeen";
        // 채널을 추가해 쿠폰을 받은 적이 있는지 (결제 없이 나갔다 돌아와도 쿠폰을 되살리는 근거)
        const CHANNEL_COUPON_OWNED_KEY = "kakaoChannelCouponOwned";
        const CHANNEL_POPUP_MUTE_HOURS = 24;
        const CHANNEL_POPUP_MUTE_FOREVER_HOURS = 24 * 365;
        // 서버 세션에 이미 발급 기록이 있으면 새로고침 후에도 할인 표기를 유지한다.
        let channelCouponApplied = <%= channelCouponIssued ? "true" : "false" %>;

        const channelModal = document.getElementById("channel-modal");
        const channelCouponRow = document.getElementById("channel-coupon-row");
        let channelToastTimerId = null;

        const exitModal = document.getElementById("exit-modal");
        const exitHoursEl = document.getElementById("exit-hours");
        const exitMinutesEl = document.getElementById("exit-minutes");
        const exitSecondsEl = document.getElementById("exit-seconds");
        const exitBenefitEl = document.getElementById("exit-benefit");
        const exitLeaveBtn = document.getElementById("exit-leave-btn");
        const exitStayBtn = document.getElementById("exit-stay-btn");
        const backLink = document.querySelector(".border-b a");

        function getCountdownEndTime() {
            let end = sessionStorage.getItem(COUNTDOWN_STORAGE_KEY);
            if (!end) {
                end = String(Date.now() + COUNTDOWN_DURATION_MS);
                sessionStorage.setItem(COUNTDOWN_STORAGE_KEY, end);
            }
            return Number(end);
        }

        function formatCountdown(ms) {
            const totalSec = Math.max(0, Math.floor(ms / 1000));
            const h = String(Math.floor(totalSec / 3600)).padStart(2, "0");
            const m = String(Math.floor((totalSec % 3600) / 60)).padStart(2, "0");
            const s = String(totalSec % 60).padStart(2, "0");
            return { h, m, s };
        }

        function startExitCountdown() {
            if (countdownTimerId) clearInterval(countdownTimerId);
            const tick = () => {
                const remain = getCountdownEndTime() - Date.now();
                const { h, m, s } = formatCountdown(remain);
                exitHoursEl.textContent = h;
                exitMinutesEl.textContent = m;
                exitSecondsEl.textContent = s;
            };
            tick();
            countdownTimerId = setInterval(tick, 1000);
        }

        function updateExitBenefitText() {
            const data = GOODS_MAP[finalGoodsCode];
            const discount = data?.discountPrice || <%= goodsInfo.discountPrice %>;
            exitBenefitEl.textContent = `${discount.toLocaleString()}원`;
        }

        function showExitModal(leaveUrl) {
            pendingLeaveUrl = leaveUrl || null;
            updateExitBenefitText();
            exitModal.classList.remove("hidden");
            exitModal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
        }

        function hideExitModal() {
            exitModal.classList.add("hidden");
            exitModal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
            pendingLeaveUrl = null;
        }

        function confirmLeave() {
            // hideExitModal()이 pendingLeaveUrl을 비우므로 먼저 목적지를 확보한다.
            // 뒤로가기로 진입한 경우엔 목적지가 없으므로 상단 뒤로가기 링크(결과 페이지)로 보낸다.
            const leaveUrl = pendingLeaveUrl || (backLink ? backLink.getAttribute("href") : null);

            allowLeave = true;
            hideExitModal();

            if (leaveUrl) {
                window.location.href = leaveUrl;
                return;
            }
            // 최후 수단: 이탈 가드가 push한 항목까지 건너뛰어야 실제로 이전 페이지로 나간다.
            history.go(-2);
        }

        function setupExitGuard() {
            history.pushState({ paymentGuard: true }, "", location.href);

            window.addEventListener("popstate", () => {
                if (allowLeave) return;
                history.pushState({ paymentGuard: true }, "", location.href);
                showExitModal();
            });

            if (backLink) {
                backLink.addEventListener("click", (e) => {
                    e.preventDefault();
                    showExitModal(backLink.getAttribute("href"));
                });
            }

            exitStayBtn.addEventListener("click", hideExitModal);
            exitLeaveBtn.addEventListener("click", confirmLeave);
            exitModal.querySelector(".exit-modal__backdrop").addEventListener("click", hideExitModal);

            startExitCountdown();
        }

        /* =========================================================
         * 카카오톡 채널 추가 팝업 + 4,000원 쿠폰
         *
         * Kakao JS SDK의 Kakao.Channel.followChannel()은 '비즈 앱'으로 전환된
         * 애플리케이션에서만 동작하므로, 채널 추가 페이지를 새 창으로 여는 방식을 쓴다.
         * 이 방식은 실제 추가 여부를 콜백으로 확인할 수 없어, 창을 연 시점에 쿠폰을 발급한다.
         * (중복 수령은 서버에서 전화번호 기준 1회로 제한한다)
         *
         * 비즈 앱 전환이 완료되면 SDK 방식으로 되돌리는 편이 정확하다.
         * 그 경우 Kakao Developers 콘솔의 [플랫폼 > Web] 사이트 도메인에
         * 개발 서버 주소와 프로덕션 도메인이 모두 등록돼 있어야 한다(누락 시 CORS 에러).
         * ========================================================= */
        function showChannelModal() {
            channelModal.classList.remove("hidden");
            channelModal.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";
        }

        function hideChannelModal() {
            channelModal.classList.add("hidden");
            channelModal.setAttribute("aria-hidden", "true");
            document.body.style.overflow = "";
        }

        // "24시간 동안 안 보기" / 쿠폰 수령 시에만 재노출을 막는다.
        // X로 닫거나 그냥 떠난 경우엔 기록하지 않아 다시 들어오면 한 번 더 노출된다.
        function muteChannelPopup(hours) {
            localStorage.setItem(CHANNEL_POPUP_SEEN_KEY, String(Date.now() + hours * 60 * 60 * 1000));
        }

        function isChannelPopupMuted() {
            const until = localStorage.getItem(CHANNEL_POPUP_SEEN_KEY);
            if (!until || until === "1") return false; // 구버전 기록은 무시

            // 쿠폰 수령으로 인한 장기 억제인데 보유 기록이 없으면(구버전에서 받은 경우)
            // 쿠폰도 팝업도 못 받는 상태가 되므로 억제를 무시하고 다시 노출한다.
            const remainHours = (Number(until) - Date.now()) / (60 * 60 * 1000);
            if (remainHours > CHANNEL_POPUP_MUTE_HOURS + 1 && localStorage.getItem(CHANNEL_COUPON_OWNED_KEY) !== "1") {
                localStorage.removeItem(CHANNEL_POPUP_SEEN_KEY);
                return false;
            }

            return Date.now() < Number(until);
        }

        function dismissChannelModal() {
            muteChannelPopup(CHANNEL_POPUP_MUTE_HOURS);
            hideChannelModal();
        }

        // 쿠폰 적용 안내 — alert 대신 하단 토스트로 보여주고 몇 초 뒤 자동으로 닫는다.
        function showChannelToast() {
            const toast = document.getElementById("channel-toast");
            if (!toast) return;

            toast.classList.add("is-visible");
            if (channelCouponRow) {
                channelCouponRow.classList.remove("coupon-row-pop");
                void channelCouponRow.offsetWidth; // 애니메이션 재시작
                channelCouponRow.classList.add("coupon-row-pop");
            }

            clearTimeout(channelToastTimerId);
            channelToastTimerId = setTimeout(() => toast.classList.remove("is-visible"), 4200);
        }

        // 쿠폰 적용 상태를 결제 상세 UI에 반영 (금액 계산은 selectOption에서 함께 처리)
        function renderChannelCoupon() {
            if (!channelCouponRow) return;
            channelCouponRow.classList.toggle("hidden", !channelCouponApplied);
            selectOption(finalGoodsCode === "<%= goodsInfo.code %>" ? "single" : finalGoodsCode);
        }

        async function requestChannelCoupon({ silent = false } = {}) {
            try {
                const response = await axios.post("/api/payments/channel-coupon", { reportHistoryId });
                if (response.data.code !== 200) return;
                channelCouponApplied = true;
                localStorage.setItem(CHANNEL_COUPON_OWNED_KEY, "1");
                muteChannelPopup(CHANNEL_POPUP_MUTE_FOREVER_HOURS);
                renderChannelCoupon();
                if (!silent) showChannelToast();
            } catch (error) {
                console.error("[ChannelCoupon] 발급 실패", error);
            }
        }

        function followKakaoChannel() {
            if (!KAKAO_CHANNEL_PUBLIC_ID) {
                console.warn("[ChannelCoupon] KAKAO_CHANNEL_PUBLIC_ID 미설정");
                hideChannelModal();
                return;
            }

            // 클릭 핸들러 안에서 바로 열어야 팝업 차단에 걸리지 않는다.
            window.open(KAKAO_CHANNEL_ADD_URL, "_blank");
            hideChannelModal();
            requestChannelCoupon();
        }

        // 채널을 이미 추가한 사용자가 결제 없이 나갔다가 다시 들어온 경우,
        // 세션이 끊겼어도 브라우저 기록을 근거로 쿠폰을 되살린다. (실제 1회 제한은 서버가 전화번호로 판단)
        async function restoreChannelCoupon() {
            // 서버가 이미 쿠폰을 인정한 상태면 그 사실을 브라우저에도 남겨, 다음 방문에서 복구가 가능하게 한다.
            if (channelCouponApplied) {
                localStorage.setItem(CHANNEL_COUPON_OWNED_KEY, "1");
                return;
            }
            if (localStorage.getItem(CHANNEL_COUPON_OWNED_KEY) !== "1") return;

            await requestChannelCoupon({ silent: true });
        }

        function setupChannelPopup() {
            renderChannelCoupon();
            restoreChannelCoupon();

            document.getElementById("channel-follow-btn").addEventListener("click", followKakaoChannel);
            document.getElementById("channel-close-btn").addEventListener("click", hideChannelModal); // X는 이번 방문만 닫기
            document.getElementById("channel-later-btn").addEventListener("click", dismissChannelModal); // 24시간 동안 안 보기

            // 쿠폰을 받았거나 "24시간 동안 안 보기"를 누른 사용자에게는 노출하지 않는다.
            if (channelCouponApplied) return;
            if (isChannelPopupMuted()) return;

            showChannelModal();
        }

        const tossPayments = TossPayments("live_ck_yZqmkKeP8gB9OlXz5ggnrbQRxB9l");
        const payment = tossPayments.payment({ customerKey: "USER_" + reportHistoryId });

        function syncMetaAdvancedMatching(phone) {
            if (typeof fbq !== "function" || !phone) return;
            const digits = String(phone).replace(/\D/g, "");
            if (!digits) return;
            const ph = digits.startsWith("82")
                ? digits
                : digits.startsWith("0")
                    ? `82${digits.slice(1)}`
                    : `82${digits}`;
            fbq("init", "4732994036924225", { ph, country: "kr" });
        }

        // sel = 'single' 또는 번들 상품 코드(예: ROMANTIC_REAPER_BUNDLE)
        function selectOption(sel) {
            const notice = document.getElementById('bundle-notice');
            const finalPriceDisplay = document.getElementById('final-price-display');
            const bundleHighlight = document.getElementById('bundle-highlight');

            // 상세 내역 요소들
            const dTitle = document.getElementById('detail-title');
            const dOriginal = document.getElementById('detail-original-price');
            const dDiscountRow = document.getElementById('discount-row');
            const dDiscountPrice = document.getElementById('detail-discount-price');
            const dDiscountRate = document.getElementById('detail-discount-rate');

            document.querySelectorAll('.goods-card').forEach(function (c) { c.classList.remove('is-selected'); });
            if (notice) notice.classList.add('hidden');

            if (sel === 'single') {
                const singleCard = document.getElementById('card-single');
                if (singleCard) singleCard.classList.add('is-selected');
                finalGoodsCode = "<%= goodsInfo.code %>";
                if (bundleHighlight) bundleHighlight.style.display = "none";
            } else {
                const bundleCard = document.getElementById('card-' + sel);
                if (bundleCard) bundleCard.classList.add('is-selected');
                finalGoodsCode = sel; // 번들 상품 코드 그대로 사용
                if (notice) notice.classList.remove('hidden');
                if (bundleHighlight) bundleHighlight.style.display = "block";
            }

            const data = GOODS_MAP[finalGoodsCode];
            if (data) {
                // 카카오톡 채널 쿠폰(번들 한정)이 적용됐다면 최종 결제금액에서 추가 차감 (서버 register와 동일 계산)
                const channelDiscount = channelCouponApplied ? channelDiscountFor(finalGoodsCode) : 0;
                if (channelCouponRow) {
                    channelCouponRow.classList.toggle("hidden", channelDiscount <= 0);
                    const amountEl = document.getElementById("channel-coupon-amount");
                    if (amountEl) amountEl.innerText = "-" + channelDiscount.toLocaleString() + "원";
                }
                // 쿠폰은 있는데 단품을 고른 경우에만 적용 조건을 안내한다.
                const couponHint = document.getElementById("channel-coupon-hint");
                if (couponHint) couponHint.classList.toggle("hidden", !(channelCouponApplied && channelDiscount <= 0));

                finalPriceDisplay.innerText = Math.max(1000, data.price - channelDiscount).toLocaleString() + "원";
                dTitle.innerText = data.title;
                dOriginal.innerText = data.originalPrice.toLocaleString() + "원";
                
                // 할인 금액이 있을 때만 할인 로우 노출
                if (data.discountPrice > 0) {
                    dDiscountRow.classList.remove('hidden');
                    dDiscountPrice.innerText = "-" + data.discountPrice.toLocaleString() + "원";
                    dDiscountRate.innerText = "-" + Math.floor((data.discountPrice / data.originalPrice) * 100) + "%";
                } else {
                    dDiscountRow.classList.add('hidden');
                }
                updateExitBenefitText();
            }
        }

        async function requestTossCardPayment() {
            const telF = document.querySelector("input[name='buyerTelF']").value.trim();
            const telB = document.querySelector("input[name='buyerTelB']").value.trim();
            const pw = document.querySelector("input[name='buyerPW']").value.trim();

            if (!/^\d{4}$/.test(telF) || !/^\d{4}$/.test(telB) || !/^\d{4}$/.test(pw)) {
                alert("휴대폰 번호와 비밀번호(4자리)를 정확히 입력해 주세요.");
                return;
            }

            const fullTel = `010${telF}${telB}`;
            syncMetaAdvancedMatching(fullTel);
console.log(" [FRONT] 전송 데이터 확인:", { 
        goodsCode: finalGoodsCode, 
        goodsType: finalGoodsCode 
    });
            try {
                const response = await axios.post("/api/payments/register", {
                    userTelNo: fullTel, userPw: pw, payMethod: "TOSS",
                    reportHistoryId: reportHistoryId, goodsCode: finalGoodsCode,goodsType: finalGoodsCode,  // 서버 DB 업데이트용
                    couponCode: channelCouponApplied ? CHANNEL_COUPON_CODE : null  // 실제 할인 적용 여부는 서버 세션 기준
                });

                if (response.data.code !== 200) throw new Error(response.data.message);

                const { shopOrderNo, amount } = response.data.data;
                await payment.requestPayment({
                    method: "CARD",
                    amount: { currency: "KRW", value: amount },
                    orderId: shopOrderNo,
                    orderName: GOODS_MAP[finalGoodsCode].title,
        successUrl: window.location.origin + "/api/payments/callback-toss" + 
                        `?tel=${fullTel}&pw=${pw}&historyId=${reportHistoryId}&goodsType=${finalGoodsCode}`,
                    failUrl: window.location.origin + "/saju/payment?historyId=" + reportHistoryId,
                    customerMobilePhone: fullTel,
                    card: { flowMode: "DEFAULT", useCardPoint: false }
                });
            } catch (error) {
                alert("결제 준비 중 오류가 발생했습니다.");
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
  const firstBundle = document.querySelector(".bundle-card");
  if (firstBundle) {
    selectOption(firstBundle.id.replace("card-", ""));
  } else {
    selectOption("single");
    updateExitBenefitText();
  }
  setupExitGuard();
  setupChannelPopup();
});
    </script>
</body>
</html>