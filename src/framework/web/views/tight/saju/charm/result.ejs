<!DOCTYPE html>
<html lang="ko">
<%- include('./../../common/header') %>
<%
  /*
   * 매혹사주 세일즈 퍼널 — 재회사주(reunion/result.ejs)와 같은 섹션 구성.
   * 캘린더·사주팔자표·그래프·레이더는 전부 charmSajuService의 실계산값(charm)이다.
   *
   * 재회사주와 달리 상대 사주를 받지 않으므로 #5는 본인 원국 한 장뿐이고,
   * 그 자리를 #7 매혹운 곡선과 #8 레이더차트가 메운다.
   */
  const name = charm.me.name;
  const targetType = charm.targetType;

  /*
   * 배경 일러스트 — public/assets/images/tight/charm/1~6.png (퍼널 등장 순서)
   *   1 훅 · 2,3 공감 2컷 · 4 금기 · 5 신뢰 · 6 마무리
   *   #4·#6·#7·#8은 UI 전용이라 이미지가 없다.
   *   에셋이 아직 없으면 onerror로 지워지고 어두운 배경만 남는다.
   */
  const scene = (n) => `/assets/images/tight/charm/${n}.png`;

  /* 리포트 목차 — charmReportPrompt.js의 장·풀이 제목과 1:1로 맞춰야 한다 */
  const CHAPTERS = [
    {
      title: '내 안에 잠들어 있는 무기',
      sub: `${name}님 원국의 매혹 코드 해부`,
      items: [
        `${name}님 원국이 타고난 매혹의 결`,
        '도화와 홍염, 내게 있는 것과 없는 것',
        '오행으로 본 나의 분위기와 첫인상',
        '내가 남자를 끌어당길 때 쓰는 방식',
      ],
      more: 1,
    },
    {
      title: '내가 반복해서 끌어당기는 남자',
      sub: '같은 유형만 걸려드는 이유',
      items: [
        '내 사주가 불러오는 남자의 유형',
        '그 유형이 나에게 끌리는 진짜 이유',
        '그 유형이 감추고 있는 약점',
        '매번 같은 지점에서 어긋났던 이유',
      ],
      more: 1,
    },
    {
      title: '그를 넘어오게 만드는 법',
      sub: '태도 · 화법 · 연락 리듬 실전편',
      items: [
        '지금 당장 바꿔야 할 태도 한 가지',
        '그에게 먹히는 말투와 대화의 간격',
        '연락의 리듬 — 언제 답하고 언제 미룰지',
        '[주의] 절대 하면 안 되는 다섯 가지',
      ],
      more: 2,
    },
    {
      title: '언제 움직여야 하는가',
      sub: '함락일과 금기일, 12개월 타이밍',
      items: [
        '이번 달, 그가 무너지는 날',
        '절대 연락하면 안 되는 날',
        '앞으로 12개월, 판이 바뀌는 시점',
        '지금부터 그날까지 해야 할 것',
      ],
      more: 0,
    },
  ];
%>

<head>
  <%- include('./_bubbleStyles') %>
  <%- include('./_landingStyles') %>
</head>

<body>
  <div class="page">

    <!-- ═══════════ #1 훅 — 매혹지수 + 넘어오는 카톡 ═══════════ -->
    <section class="rs rs--scene rs--hook" id="sec1">
      <img class="rs__bg" src="<%= scene(1) %>" alt="" onerror="this.remove()" loading="eager" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner rs-hook">

        <!-- 상단: 이름 + 매혹지수 -->
        <div class="rs-hook__top">
          <p class="rs-hook__who"><%= name %>님의</p>
          <p class="rs-hook__label">매혹지수</p>
          <p class="rs-hook__num"><%= charm.charmScore %><small>점</small></p>
        </div>

        <!-- 하단: 짧게 던진 내 한 마디에 상대가 연달아 답하는 대화 -->
        <div class="kt" id="ktHero">
          <!-- 첫 메시지는 진입 즉시 보이도록 is-in을 처음부터 붙여둔다 -->
          <div class="kt-row kt-row--right is-in" data-kt="0">
            <span class="kt-time">오후 11:41</span>
            <div class="kt-msg kt-msg--me">아 오늘은 좀 피곤하다</div>
          </div>

          <div class="kt-row kt-row--left" data-kt="1">
            <div class="kt-msg kt-msg--them">자?</div>
            <span class="kt-time">오후 11:52</span>
          </div>

          <div class="kt-row kt-row--left" data-kt="2">
            <div class="kt-msg kt-msg--them">아니 그냥… 생각나서</div>
            <span class="kt-time">오전 12:06</span>
          </div>

          <div class="kt-row kt-row--left kt-typing" data-kt-typing>
            <div class="kt-msg kt-msg--them"><i></i><i></i><i></i></div>
          </div>
        </div>

        <div class="rs-hook__scroll" aria-hidden="true"></div>
      </div>
    </section>

    <!-- ═══════════ #2 공감 (2컷) ═══════════ -->
    <section class="rs" id="sec2">
      <div class="rs-cut">
        <img class="rs__bg" src="<%= scene(2) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
        <div class="rs__scrim"></div>
        <div class="rs__inner">
          <div class="rs-lines">
            <p class="rs-line" data-line>먼저 좋아하는 쪽이<br><span class="rs-hl rs-hl--line">늘 지는</span> 것 같나요?</p>
          </div>
        </div>
      </div>

      <div class="rs-cut">
        <img class="rs__bg" src="<%= scene(3) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
        <div class="rs__scrim"></div>
        <div class="rs__inner">
          <div class="rs-lines">
            <p class="rs-line rs-line--right" data-line><%= name %>님,<br><span class="rs-hl">순서가 틀렸을</span> 뿐이에요</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ #3 금기 / 호기심 갭 ═══════════ -->
    <section class="rs rs--scene" id="sec3">
      <img class="rs__bg" src="<%= scene(4) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner">
        <div class="rs-lines">
          <p class="rs-line" data-line>지금 더 잘해주면,<br><span class="rs-hl--warn rs-hl">오히려 식어요</span></p>
          <p class="rs-line rs-line--sm" data-line>이 <span class="rs-blur"><%= charm.silenceRule %></span> 지키면<br><span class="rs-hl">그쪽에서 먼저 옵니다</span></p>
        </div>
      </div>
    </section>

    <!-- ═══════════ #4 함락 캘린더 (UI) ═══════════ -->
    <section class="rs rs--ui" id="sec4">
      <p class="rs__eyebrow">Timing</p>
      <h2 class="rs__title">그가 무너지는 날</h2>
      <div class="rs-lines" style="margin-bottom:22px;">
        <p class="rs-line rs-line--sm" data-line><%= name %>님, 같은 말도 <span class="rs-hl">언제 하느냐</span>에 따라 달라져요</p>
      </div>
      <%- include('./_calendar') %>
    </section>

    <!-- ═══════════ #5 신뢰 소스 — 내 사주팔자 (UI 전용) ═══════════ -->
    <section class="rs rs--ui" id="sec5">
      <div class="rs-lines" style="margin-bottom:22px;">
        <p class="rs-line" data-line><%= name %>님의 사주,<br><span class="rs-hl">숫자로</span> 확인해보세요</p>
      </div>
      <%- include('./_pillarTable', { table: charm.me.table, locked: false }) %>
    </section>

    <!-- ═══════════ #7 12개월 매혹운 곡선 (UI) ═══════════ -->
    <section class="rs rs--ui" id="sec7">
      <%- include('./_timelineChart') %>
    </section>

    <!-- ═══════════ #8 매혹 지표 레이더 (UI) ═══════════ -->
    <section class="rs rs--ui" id="sec8">
      <%- include('./_radarChart') %>
    </section>

    <!-- ═══════════ #6 클라이맥스 + 락 ═══════════ -->
    <section class="rs rs--ui" id="sec6">
      <div class="rs-lines" style="margin-bottom:20px;">
        <p class="rs-line" data-line><%= name %>님의 매혹지수는<br><strong><%= charm.charmScore %>점</strong>으로 나왔어요.</p>
        <p class="rs-line rs-line--sm" data-line>
          <span class="rs-blur"><%= charm.boost.action %></span>
          <strong><%= charm.boost.percent %>%</strong> 더 올라갑니다.
        </p>
      </div>

      <div class="rs-lock" data-reveal>
        <p class="rs-lock__text">
          <%= name %>님의 일주는 <b><%= charm.me.table.dayPillarHanja %>(<%= charm.me.dayPillar %>)</b>,
          원국에서 가장 강하게 잡히는 무기는 <b><%= charm.keyword %></b>입니다.
          그래서 <%= name %>님 앞에는 <b><%= targetType.title %></b>이 반복해서 나타나고,
          매번 비슷한 지점에서 관계가 틀어졌던 것도 여기서 시작됩니다.
        </p>
        <div class="rs-lock__fade" aria-hidden="true">
          이 유형이 무너지는 지점은 <%= targetType.weak %>이고, 통하는 방식은 <%= targetType.grip %> 다가가는 것입니다.
          <%= name %>님의 <%= charm.me.table.strength %> 원국에서는 이 접근을 언제 시작하고 언제 멈춰야 하는지가 결과를 가릅니다.
          먼저 바꿔야 할 태도 한 가지와, 그에게 실제로 보낼 수 있는 문장,
          그리고 절대 하면 안 되는 다섯 가지까지 리포트 본문에서 순서대로 정리해 드립니다.
          이번 달 함락일과 금기일, 앞으로 12개월 중 판이 바뀌는 시점도 날짜로 확인할 수 있습니다.
          <div class="rs-lock__veil">
            <span class="rs-lock__icon">🔒</span>
            <button type="button" class="rs-lock__cta" data-cta>막힌 내용, 리포트에서 이어서 보기</button>
          </div>
        </div>
      </div>

      <div class="rs-discount">
        <span>할인 마감까지</span>
        <b id="rsDiscountTime">--:--</b>
      </div>
    </section>

    <!-- ═══════════ #9 리포트 목차 (배경 이미지 없이 단독) ═══════════ -->
    <section class="rs rs--ui" id="sec9">
      <div class="rs-lines" style="margin-bottom:26px;">
        <p class="rs-line" data-line>리포트 안에 <span class="rs-hl">뭐가 들어있는지</span><br>보여드릴게요</p>
        <p class="rs-line rs-line--sm" data-line>왜 항상 <span class="rs-hl">내가 더 매달렸을까요?</span></p>
      </div>

      <% CHAPTERS.forEach(function (ch, i) { %>
      <div class="rs-ch" data-reveal>
        <p class="rs-ch__no">CHAPTER <%= String(i + 1).padStart(2, '0') %></p>
        <h3 class="rs-ch__title"><%= ch.title %></h3>
        <p class="rs-ch__sub"><%= ch.sub %></p>

        <ul class="rs-ch__list">
          <% ch.items.forEach(function (item, j) { %>
          <li class="rs-ch__item">
            <span class="rs-ch__idx">풀이 <%= j + 1 %></span>
            <span><%= item %></span>
          </li>
          <% }); %>
        </ul>

        <% if (ch.more) { %>
        <p class="rs-ch__more">그 외 <%= ch.more %>가지 풀이 추가 제공</p>
        <% } %>
      </div>
      <% }); %>
    </section>

    <!-- ═══════════ #9-2 마무리 씬 ═══════════ -->
    <section class="rs rs--scene" id="sec9b" style="min-height:auto;padding-top:64px;padding-bottom:44px;">
      <img class="rs__bg" src="<%= scene(6) %>" alt="" onerror="this.remove()" loading="lazy" decoding="async">
      <div class="rs__scrim"></div>
      <div class="rs__inner">
        <div class="rs-lines">
          <p class="rs-bonus" data-line>BONUS</p>
          <p class="rs-line" data-line><span class="rs-hl">넘어왔다는 신호</span>도<br>하나 더 얹어드려요</p>
          <p class="rs-line rs-line--sm" data-line>
            <span class="rs-hl rs-hl--line">그가 티 내지 않고 흔들리는 순간</span>까지
          </p>
        </div>
      </div>
    </section>

    <!-- 스크롤 앵커: 여기 도달하면 플로팅 CTA 숨김 -->
    <div id="rsBottomAnchor" style="height:4px;"></div>
  </div>

  <!-- 실시간 구매 알림 토스트 -->
  <div class="rs-toast" id="rsToast">
    <span class="rs-toast__dot"></span>
    <span id="rsToastText"></span>
  </div>

  <!-- 결제 폼 (기존 상품과 동일한 규약) -->
  <form method="POST" action="<%= charm.me.name === '관리자' ? '/saju/skip-payment' : '/saju/payment' %>" class="hidden" id="rsForm">
    <input type="hidden" name="userInfo" value='<%= JSON.stringify(userInfo) %>' />
    <input type="hidden" name="sample" value='<%= JSON.stringify(charm.snapshot) %>' />
    <input type="hidden" name="goodsType" value="CHARM" />
  </form>

  <div class="rs-cta" id="rsCta">
    <button type="button" class="rs-cta__btn" data-cta>
      <span><%= name %>님의 매혹 리포트 확인하기</span>
      <span aria-hidden="true">--&gt;</span>
    </button>
  </div>

  <div class="rs-notice">AI 분석 기반 참고용 콘텐츠입니다. 의사결정의 근거로 사용하지 마세요.</div>

  <script>
    (function () {
      /* ── 등장 애니메이션 ── */
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

      document.querySelectorAll('[data-line], [data-reveal]').forEach(function (el) { io.observe(el); });

      /* 한 씬에 문장이 여럿이면 순서대로 뜨게 지연을 준다 */
      document.querySelectorAll('.rs-lines').forEach(function (group) {
        group.querySelectorAll('[data-line]').forEach(function (el, i) {
          el.style.transitionDelay = (i * 420) + 'ms';
        });
      });

      /* ── 히어로 카톡 ──
         내가 한 마디 던져놓고 마는 사이, 상대가 연달아 말을 붙여온다.
         마지막엔 상대가 '입력 중…'만 켰다 껐다 하며 망설인다. */
      (function playHeroChat() {
        var wrap = document.getElementById('ktHero');
        if (!wrap) return;

        var msgs = wrap.querySelectorAll('[data-kt]');
        var typing = wrap.querySelector('[data-kt-typing]');

        // 첫 메시지는 마크업에서 이미 떠 있으므로 두 번째부터 순차 등장시킨다
        var t = 1100;
        msgs.forEach(function (msg, i) {
          if (i === 0) return;
          setTimeout(function () { msg.classList.add('is-in'); }, t);
          t += 1100;
        });

        if (!typing) return;

        // 썼다 지웠다 — 켜져 있는 시간과 꺼져 있는 시간을 조금씩 다르게 줘 망설이는 느낌을 낸다
        var onMs  = [1700, 1100, 2300, 900];
        var offMs = [1200, 1900, 900, 1500];
        var i = 0;

        function loop() {
          setTimeout(function () {
            typing.classList.add('is-in');
            setTimeout(function () {
              typing.classList.remove('is-in');
              i++;
              loop();
            }, onMs[i % onMs.length]);
          }, offMs[i % offMs.length]);
        }

        setTimeout(loop, t);
      })();

      /* ── 할인 카운트다운 (#6) ── */
      var DEADLINE_MIN = 15;
      var endAt = Date.now() + DEADLINE_MIN * 60 * 1000;
      var discTime = document.getElementById('rsDiscountTime');

      function pad(n) { return String(n).padStart(2, '0'); }
      function tick() {
        var left = Math.max(0, endAt - Date.now());
        var m = Math.floor(left / 60000);
        var s = Math.floor((left % 60000) / 1000);
        if (discTime) discTime.textContent = pad(m) + ':' + pad(s);
      }
      tick();
      setInterval(tick, 1000);

      /* ── 구매 알림 토스트 ── */
      var toast = document.getElementById('rsToast');
      var toastText = document.getElementById('rsToastText');
      var NAMES = ['김O은', '이O진', '박O연', '최O우', '정O아', '한O림', '조O윤', '유O빈'];
      var toastIdx = 0;
      function showToast() {
        if (!toast || !toastText) return;
        toastText.textContent = NAMES[toastIdx % NAMES.length] + '님, 방금 결제를 완료했어요';
        toastIdx++;
        toast.classList.add('is-on');
        setTimeout(function () { toast.classList.remove('is-on'); }, 3600);
      }
      setTimeout(function () {
        showToast();
        setInterval(showToast, 14000);
      }, 6000);

      /* ── CTA ── */
      var form = document.getElementById('rsForm');
      document.querySelectorAll('[data-cta]').forEach(function (btn) {
        btn.addEventListener('click', function () { if (form) form.submit(); });
      });

      if (window.karrotPixel) window.karrotPixel.track('Lead');
    })();
  </script>
</body>
</html>
