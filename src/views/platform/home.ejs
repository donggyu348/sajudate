<%
  const hero = (featured && featured[0]) || products[0] || null;
  // 히어로로 이미 크게 보여준 상품은 아래 목록에서 빼서 중복 노출을 막는다
  const rest = hero ? products.filter((p) => p.slug !== hero.slug) : products;
  function href(p) { return '/products/' + p.slug; }
  function two(n) { return String(n + 1).padStart(2, '0'); }
  // 카드 썸네일이 없는 상품은 카테고리 첫 글자를 크게 띄운 플레이스홀더로 대체
  function initial(p) { return (p.name || '?').trim().charAt(0); }
%>

<!-- 풀블리드 히어로 (대표 제품 배너) -->
<% if (hero) { %>
<a href="<%= href(hero) %>" class="relative block">
  <div class="relative aspect-[4/5] w-full overflow-hidden bg-accent">
    <% if (hero.thumbnailUrl) { %>
      <img src="<%= hero.thumbnailUrl %>" alt="<%= hero.name %>" class="absolute inset-0 h-full w-full object-cover" />
    <% } else { %>
      <div class="absolute inset-0" style="background:#3730a3"></div>
    <% } %>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
    <span class="badge-featured absolute right-4 top-4">추천</span>
    <div class="absolute inset-x-0 bottom-0 p-6 text-white">
      <span class="text-[11px] tracking-[0.14em] text-white/80"><%= hero.category %></span>
      <h2 class="mt-2 font-serif text-3xl leading-[1.25]"><%= hero.headline || hero.name %></h2>
      <% if (hero.subcopy) { %>
        <p class="mt-3 max-w-[19rem] text-sm leading-relaxed text-white/85"><%= hero.subcopy %></p>
      <% } %>
      <span class="mt-5 inline-flex items-center gap-1.5 border-b-2 border-white/60 pb-1 text-sm font-semibold">
        진단 시작하기
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l14 0" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" /></svg>
      </span>
    </div>
  </div>
</a>
<% } %>

<% if (!products.length) { %>
  <p class="py-16 text-center text-sm text-ink-soft">표시할 제품이 없습니다.</p>
<% } else { %>

<!-- 섹션 1: 가로 스크롤 카드 레일 -->
<% if (rest.length) { %>
<section class="px-5 pb-2 pt-7">
  <h3 class="section-title">💜 내 관계, 지금 어떤 상태일까?</h3>
  <p class="mt-1 text-[12px] text-ink-soft">혼자 고민하지 말고 하나씩 짚어봐요</p>

  <div class="card-rail mt-4 pb-1">
    <% rest.forEach(function (p) { %>
      <a href="<%= href(p) %>" class="block">
        <div class="aspect-[295/370] w-full overflow-hidden rounded-lg border border-line bg-gray-100">
          <% if (p.thumbnailUrl) { %>
            <img src="<%= p.thumbnailUrl %>" alt="<%= p.name %>" class="h-full w-full object-cover" />
          <% } else { %>
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-accent-soft to-white">
              <span class="font-serif text-4xl text-accent/40"><%= initial(p) %></span>
            </div>
          <% } %>
        </div>
        <p class="mt-2.5 truncate text-[13.5px] font-semibold text-ink"><%= p.name %></p>
        <p class="mt-0.5 line-clamp-2 text-[11.5px] leading-relaxed text-ink-soft"><%= p.subcopy || p.description || p.category %></p>
      </a>
    <% }); %>
  </div>
</section>
<% } %>

<!-- 섹션 2: 번호 매긴 전체 목록 -->
<section class="px-5 pb-6 pt-7">
  <div class="flex items-baseline justify-between">
    <h3 class="section-title">📋 <%= selected === '전체' ? '전체 진단 한눈에 보기' : selected %></h3>
    <span class="text-xs text-ink-soft"><%= products.length %></span>
  </div>

  <ul class="mt-3">
    <% products.forEach(function (p, i) { %>
      <a href="<%= href(p) %>" class="flex items-start gap-4 border-t border-line py-4 <%= i === products.length - 1 ? 'border-b' : '' %>">
        <span class="w-5 shrink-0 font-serif text-[15px] text-accent"><%= two(i) %></span>
        <span class="min-w-0 flex-1">
          <span class="block text-[15px] font-semibold leading-snug"><%= p.name %></span>
          <span class="mt-1 line-clamp-1 block text-[12.5px] leading-relaxed text-ink-soft">
            <%= p.category %><%= (p.subcopy || p.description) ? ' · ' + (p.subcopy || p.description) : '' %>
          </span>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-ink-soft"><path d="M17 7l-10 10" /><path d="M8 7l9 0l0 9" /></svg>
      </a>
    <% }); %>
  </ul>
</section>

<% } %>
