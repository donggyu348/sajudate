<%
  // Tabler 아이콘(inline). 하단 고정 탭바 — 상품 무관한 플랫폼 내비게이션만.
  const tabs = [
    { key: 'home', label: '홈', href: '/',
      icon: '<path d="M5 12l-2 0l9 -9l9 9l-2 0" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" /><path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />' },
    { key: 'library', label: '보관함', href: '/library',
      icon: '<path d="M9 4v13l-3 -2l-3 2v-13a2 2 0 0 1 2 -2h4a2 2 0 0 0 -1 3z" /><path d="M9 4h7a2 2 0 0 1 2 2v13l-3 -2l-3 2" />' },
    { key: 'my', label: '마이', href: '/my',
      icon: '<path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />' },
  ];
%>
<nav class="fixed inset-x-0 bottom-0 z-30 mx-auto flex max-w-app border-t border-line bg-white">
  <% tabs.forEach(function (t) { const active = activeTab === t.key; %>
    <a href="<%= t.href %>" class="flex flex-1 flex-col items-center gap-0.5 py-2.5 <%= active ? 'text-accent' : 'text-ink-soft' %>">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="<%= active ? '2.2' : '1.8' %>" stroke-linecap="round" stroke-linejoin="round"><%- t.icon %></svg>
      <span class="text-[11px] font-medium"><%= t.label %></span>
    </a>
  <% }); %>
</nav>
