<%# 10문항 고정. 한 화면에 1문항, 뒤로 가기 가능, 진행 바 필수.
    선택 즉시 다음으로 넘어가고 마지막 Q10만 자유 입력이다. %>
<div class="px-6 py-8">
  <div class="flex items-center gap-2 text-[11px] font-medium text-ink-soft">
    <span><span id="stepNo">1</span> / <%= questions.length %></span>
    <span class="h-1 flex-1 overflow-hidden rounded-full bg-line">
      <span id="progressBar" class="block h-full rounded-full bg-accent transition-all duration-300" style="width: 10%"></span>
    </span>
  </div>

  <form id="checkForm" method="post" action="<%= base %>/check" class="mt-8">
    <% questions.forEach(function (q, qi) { %>
      <section class="lc-step <%= qi === 0 ? '' : 'hidden' %>" data-step="<%= qi %>" data-key="<%= q.key %>" data-free="<%= q.free ? '1' : '' %>">
        <h1 class="font-serif text-[20px] font-bold leading-[1.5] text-ink <%= q.emphasis ? 'text-accent' : '' %>">
          <%= q.label %>
        </h1>
        <% if (q.hint) { %>
          <%# Q4는 이 제품에서 가장 중요한 문항이라 오해 소지를 한 줄로 못 박는다 %>
          <p class="mt-2 rounded-lg border border-accent-ring bg-accent-soft px-3 py-2.5 text-[12px] leading-relaxed text-accent">
            <%= q.hint %>
          </p>
        <% } %>

        <% if (q.free) { %>
          <textarea name="<%= q.key %>" rows="2" required maxlength="500"
                    placeholder="<%= q.placeholder %>"
                    class="mt-5 w-full resize-none rounded-lg border border-line bg-gray-50 px-3 py-2.5 text-sm focus:border-accent focus:bg-white focus:outline-none"></textarea>
          <button type="submit" class="btn-primary mt-5 w-full py-3.5">상담 시작하기</button>
        <% } else { %>
          <div class="mt-5 space-y-2">
            <% q.options.forEach(function (o) { %>
              <label class="block cursor-pointer">
                <input type="radio" name="<%= q.key %>" value="<%= o.value %>" class="peer sr-only" required />
                <span class="block rounded-xl border border-line px-4 py-3.5 text-[14px] font-medium text-ink peer-checked:border-accent peer-checked:bg-accent-soft peer-checked:text-accent">
                  <%= o.label %>
                </span>
              </label>
            <% }); %>
          </div>
        <% } %>
      </section>
    <% }); %>

    <button type="button" id="backBtn" class="mt-6 hidden text-[12px] text-ink-soft underline underline-offset-2">
      이전 질문
    </button>
  </form>
</div>

<script>
  (function () {
    var steps = Array.prototype.slice.call(document.querySelectorAll('.lc-step'));
    var bar = document.getElementById('progressBar');
    var stepNo = document.getElementById('stepNo');
    var backBtn = document.getElementById('backBtn');
    var i = 0;

    function show(next) {
      steps[i].classList.add('hidden');
      i = next;
      steps[i].classList.remove('hidden');
      stepNo.textContent = i + 1;
      bar.style.width = Math.round(((i + 1) / steps.length) * 100) + '%';
      backBtn.classList.toggle('hidden', i === 0);
      window.scrollTo(0, 0);
    }

    // 선택 즉시 다음 문항으로 — 탭 한 번에 하나씩 넘어가야 10문항이 부담스럽지 않다
    steps.forEach(function (sec, si) {
      sec.querySelectorAll('input[type=radio]').forEach(function (input) {
        input.addEventListener('change', function () {
          if (si < steps.length - 1) setTimeout(function () { show(si + 1); }, 140);
        });
      });
    });

    backBtn.addEventListener('click', function () { if (i > 0) show(i - 1); });

    // 마지막 자유 입력 전에는 엔터로 제출되지 않게 한다 (라디오 단계에서 오제출 방지)
    document.getElementById('checkForm').addEventListener('submit', function (e) {
      if (i !== steps.length - 1) e.preventDefault();
    });
  })();
</script>
