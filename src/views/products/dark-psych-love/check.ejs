<style>
  body { background: #0b0f16 !important; }
  .app-shell { background: #0b0f16; color: #e8ecf3; min-height: 100vh; }
  .app-shell > header {
    background: rgba(11, 15, 22, 0.88);
    backdrop-filter: blur(10px);
    border-bottom-color: rgba(255, 255, 255, 0.07);
  }
  .app-shell > header span { color: #f2f4f8; }
  .app-shell > header button { color: rgba(255, 255, 255, 0.62); }
  .app-shell > nav {
    background: rgba(11, 15, 22, 0.96);
    border-top-color: rgba(255, 255, 255, 0.07);
  }
  .app-shell > nav a.text-ink-soft { color: rgba(255, 255, 255, 0.4); }

  .rp-eyebrow {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.32);
  }
  .kw { color: #f87171; font-weight: 600; }

  /* 한 문항씩 넘기는 모드는 스크립트가 켜졌을 때만 적용한다.
     스크립트가 없으면 7문항이 모두 보이는 평범한 폼으로 남아 그대로 제출된다. */
  .stepped .step { display: none; }
  .stepped .step.is-current { display: block; }
  .stepped #fallbackSubmit { display: none; }

  @keyframes stepIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  .stepped .step.is-current { animation: stepIn 0.32s cubic-bezier(0.16, 1, 0.3, 1); }
  @media (prefers-reduced-motion: reduce) {
    .stepped .step.is-current { animation: none; }
  }

  /* 예/아니오 — 라디오를 감춘 라벨 버튼 */
  .opt {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    border-radius: 14px;
    transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
  }
  .opt:active { transform: scale(0.99); }
  input:checked ~ .opt-yes {
    border-color: rgba(239, 68, 68, 0.55);
    background: rgba(239, 68, 68, 0.12);
    color: #fca5a5;
  }
  input:checked ~ .opt-no {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  .progress-fill { transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
</style>

<div class="px-5 py-6">
  <!-- 진행 표시 -->
  <div class="flex items-center justify-between">
    <p class="rp-eyebrow">30초 자가 체크</p>
    <p class="text-[11.5px] font-semibold text-white/50">
      <span id="stepNow">1</span> / <%= checklist.length %>
    </p>
  </div>
  <div class="mt-2.5 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]">
    <div id="progressFill" class="progress-fill h-full rounded-full" style="width: 0%; background: linear-gradient(90deg, #b91c1c, #ef4444);"></div>
  </div>

  <form id="checkForm" method="post" action="<%= base %>/check" class="mt-8">
    <% checklist.forEach(function (q, i) { %>
      <section class="step" data-index="<%= i %>">
        <p class="font-serif text-[13px] font-bold text-white/25"><%= String(i + 1).padStart(2, '0') %></p>
        <h2 class="mt-2 font-serif text-[21px] font-bold leading-[1.5] text-white"><%= q.text %></h2>

        <div class="mt-7 space-y-2.5">
          <label class="block cursor-pointer">
            <input type="radio" name="q_<%= q.key %>" value="yes" class="peer sr-only" />
            <span class="opt opt-yes flex items-center justify-center px-4 py-4 text-[15px] font-semibold text-white/70">그렇다</span>
          </label>
          <label class="block cursor-pointer">
            <input type="radio" name="q_<%= q.key %>" value="no" class="peer sr-only" />
            <span class="opt opt-no flex items-center justify-center px-4 py-4 text-[15px] font-semibold text-white/70">아니다</span>
          </label>
        </div>
      </section>
    <% }); %>

    <button type="submit" id="fallbackSubmit"
      class="mt-8 flex w-full items-center justify-center rounded-xl bg-red-600 py-3.5 text-[15px] font-bold text-white">
      결과 확인하기
    </button>
  </form>

  <!-- 스텝 모드에서만 쓰는 이전 버튼 -->
  <button type="button" id="prevBtn" class="mt-8 hidden text-[12px] text-white/30 underline underline-offset-2">← 이전 질문</button>

  <p class="mt-10 text-[11px] leading-relaxed text-white/25">
    체크한 내용은 결과를 계산하는 데만 쓰이며, 따로 저장하지 않습니다.
  </p>
</div>

<script>
  (function () {
    var form = document.getElementById('checkForm');
    var steps = [].slice.call(form.querySelectorAll('.step'));
    var stepNow = document.getElementById('stepNow');
    var fill = document.getElementById('progressFill');
    var prevBtn = document.getElementById('prevBtn');
    if (!steps.length) return;

    // 여기서부터 한 문항씩 보여주는 모드 — 스크립트가 죽으면 위 CSS가 적용되지 않아
    // 7문항이 전부 보이는 일반 폼으로 남는다.
    document.body.classList.add('stepped');

    var current = 0;

    function render() {
      steps.forEach(function (s, i) {
        s.classList.toggle('is-current', i === current);
      });
      stepNow.textContent = current + 1;
      fill.style.width = (current / steps.length) * 100 + '%';
      prevBtn.classList.toggle('hidden', current === 0);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function next() {
      if (current < steps.length - 1) {
        current += 1;
        render();
      } else {
        fill.style.width = '100%';
        form.submit();
      }
    }

    steps.forEach(function (step) {
      step.addEventListener('change', function (e) {
        if (e.target.name && e.target.name.indexOf('q_') === 0) {
          // 고른 게 바로 사라지면 눌렀는지 확신이 안 든다 — 선택 표시를 잠깐 보여주고 넘긴다
          setTimeout(next, 180);
        }
      });
    });

    prevBtn.addEventListener('click', function () {
      if (current > 0) {
        current -= 1;
        render();
      }
    });

    render();
  })();
</script>
