<style>
  body { background: #0b0f16 !important; }
  .app-shell { background: #0b0f16; color: #e8ecf3; min-height: 100vh; }
  .app-shell > header {
    background: rgba(11, 15, 22, 0.88);
    backdrop-filter: blur(10px);
    border-bottom-color: rgba(255, 255, 255, 0.07);
  }
  .app-shell > header span { color: #f2f4f8; }
  .app-shell > header button { color: rgba(255, 255, 255, 0.62); }
  .app-shell > nav {
    background: rgba(11, 15, 22, 0.96);
    border-top-color: rgba(255, 255, 255, 0.07);
  }
  .app-shell > nav a.text-ink-soft { color: rgba(255, 255, 255, 0.4); }

  .rp-eyebrow {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.32);
  }
  .kw { color: #f87171; font-weight: 600; }

  /* 문항 카드 — 체크되면 붉은 톤으로 확실히 반응해, 누르는 재미로 끝까지 가게 한다 */
  .q-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.028);
    border-radius: 16px;
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  .q-card:has(input:checked) {
    border-color: rgba(239, 68, 68, 0.45);
    background: rgba(239, 68, 68, 0.07);
  }
  .q-box {
    border: 1.5px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    transition: border-color 0.18s ease, background 0.18s ease;
  }
  /* 체크박스 자체의 반응은 :has() 없이도 동작해야 한다 —
     카드 배경만 :has()로 얹고, 핵심 피드백은 인접 형제 선택자로 준다 */
  input:checked ~ .q-box {
    border-color: #ef4444;
    background: #ef4444;
  }
  .q-check { opacity: 0; transition: opacity 0.18s ease; }
  input:checked ~ .q-box .q-check { opacity: 1; }

  .progress-fill { transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
</style>

<div class="px-5 py-7 pb-32">
  <p class="rp-eyebrow">30초 자가 체크</p>
  <h1 class="mt-2.5 font-serif text-[23px] font-bold leading-[1.45] text-white">
    지금 그 관계,<br /><span class="kw">확인해봐야 할 신호</span>가 있나요?
  </h1>
  <p class="mt-3 text-[13px] leading-relaxed text-white/45">
    해당하는 항목만 눌러주세요. 업로드도, 회원가입도 필요 없어요.
  </p>

  <form id="checkForm" method="post" action="<%= base %>/check" class="mt-7">
    <div class="space-y-2.5">
      <% checklist.forEach(function (q, i) { %>
        <label class="q-card flex cursor-pointer items-start gap-3.5 p-4">
          <input type="checkbox" name="answers" value="<%= q.key %>" class="peer sr-only" />
          <span class="q-box mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center">
            <svg class="q-check" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5l10 -10" /></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-[10px] font-semibold tracking-wider text-white/25"><%= String(i + 1).padStart(2, '0') %></span>
            <span class="mt-1 block text-[14px] font-medium leading-relaxed text-white/85"><%= q.text %></span>
          </span>
        </label>
      <% }); %>
    </div>

    <p class="mt-6 text-[11px] leading-relaxed text-white/25">
      체크한 내용은 결과를 계산하는 데만 쓰이며, 따로 저장하지 않습니다.
    </p>
  </form>

  <%# 이미 캡처를 준비해 온 사람까지 체크리스트에 붙잡아 둘 이유는 없다 %>
  <a href="<%= base %>/upload" class="mt-5 block text-center text-[11.5px] text-white/30 underline">
    대화 캡처가 이미 있다면 바로 분석하기
  </a>
</div>

<!-- 하단 고정 CTA — 체크 개수를 실시간으로 보여줘 끝까지 훑게 만든다 -->
<div class="fixed inset-x-0 bottom-14 z-20 mx-auto max-w-app px-4 pb-3">
  <div class="rounded-xl border border-white/10 bg-[#0e1420]/95 p-3 backdrop-blur-md">
    <div class="flex items-center justify-between px-1 text-[11.5px]">
      <span class="text-white/45">해당 항목</span>
      <span class="font-semibold text-white/80"><span id="checkedCount">0</span> / <%= checklist.length %></span>
    </div>
    <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-white/[0.08]">
      <div id="progressFill" class="progress-fill h-full rounded-full" style="width: 0%; background: linear-gradient(90deg, #b91c1c, #ef4444);"></div>
    </div>
    <button type="submit" form="checkForm" id="submitBtn"
      class="mt-3 flex w-full items-center justify-center gap-1.5 rounded-xl bg-red-600 py-3.5 text-[15px] font-bold text-white shadow-[0_12px_28px_-8px_rgba(239,68,68,0.55)] active:bg-red-700">
      결과 확인하기
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l14 0" /><path d="M13 18l6 -6" /></svg>
    </button>
  </div>
</div>

<script>
  (function () {
    var boxes = document.querySelectorAll('#checkForm input[name="answers"]');
    var countEl = document.getElementById('checkedCount');
    var fill = document.getElementById('progressFill');
    var total = boxes.length;

    function sync() {
      var n = document.querySelectorAll('#checkForm input[name="answers"]:checked').length;
      countEl.textContent = n;
      fill.style.width = (total ? (n / total) * 100 : 0) + '%';
    }
    Array.prototype.forEach.call(boxes, function (b) {
      b.addEventListener('change', sync);
    });
    sync();
  })();
</script>
