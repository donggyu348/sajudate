<style>
  body { background: #0b0f16 !important; }
  .app-shell { background: #0b0f16; color: #e8ecf3; min-height: 100vh; }
  .app-shell > header {
    background: rgba(11, 15, 22, 0.88);
    backdrop-filter: blur(10px);
    border-bottom-color: rgba(255, 255, 255, 0.07);
  }
  .app-shell > header span { color: #f2f4f8; }
  .app-shell > header button { color: rgba(255, 255, 255, 0.62); }
  .app-shell > nav {
    background: rgba(11, 15, 22, 0.96);
    border-top-color: rgba(255, 255, 255, 0.07);
  }
  .app-shell > nav a.text-ink-soft { color: rgba(255, 255, 255, 0.4); }

  .rp-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.028);
    border-radius: 16px;
  }
  .rp-eyebrow {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.32);
  }
  .kw { color: #f87171; font-weight: 600; }

  @keyframes jackpotLand {
    0% { transform: scale(1); }
    35% { transform: scale(1.08); }
    65% { transform: scale(0.97); }
    100% { transform: scale(1); }
  }
  .jackpot-land { animation: jackpotLand 0.45s ease-out; }
</style>

<div class="px-5 py-7 pb-28">
  <p class="rp-eyebrow">1차 간이 진단</p>
  <h1 class="mt-2.5 font-serif text-[22px] font-bold leading-[1.45] text-white">체크리스트 결과</h1>

  <!-- 위험도 -->
  <div id="scoreCard" class="relative mt-5 overflow-hidden rounded-2xl border border-red-500/25 bg-[#140b12] p-6 text-center">
    <span class="pointer-events-none absolute -top-24 left-1/2 h-48 w-48 -translate-x-1/2 rounded-full bg-red-500/20 blur-3xl"></span>
    <div class="relative">
      <p class="rp-eyebrow">위험 신호 강도</p>
      <p class="mt-3 font-serif text-[52px] font-bold leading-none text-white">
        <%# 실제 수치를 먼저 박아둔다 — 스크립트가 안 돌면 0%가 그대로 남아 결과를 오해하게 된다 %>
        <span id="scorePercent" style="font-variant-numeric: tabular-nums;"><%= result.percent %></span><span class="text-[24px] text-red-400/80">%</span>
      </p>
      <p class="mt-3 text-[15px] font-semibold text-red-400"><%= result.band.label %></p>
      <p class="mt-2 text-[12px] text-white/40"><%= result.total %>개 문항 중 <%= result.checkedCount %>개 해당</p>
    </div>
  </div>

  <!-- 공감 + 근거 -->
  <div class="mt-4 rounded-2xl border-l-2 border-red-500/45 bg-white/[0.025] py-5 pl-5 pr-4">
    <p class="text-[13.5px] leading-relaxed text-white/80"><%= result.band.tone %></p>
    <% if (result.reasons.length) { %>
      <ul class="mt-3 space-y-2">
        <% result.reasons.forEach(function (reason) { %>
          <li class="flex items-start gap-2.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="mt-1 shrink-0 text-red-400/70"><path d="M12 9v4" /><path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" /><path d="M12 16h.01" /></svg>
            <span class="text-[12.5px] leading-relaxed text-white/50"><%= reason %></span>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </div>

  <!-- 한계 고지 → 정밀 분석의 필요를 만든다 -->
  <div class="mt-7 rp-card p-5">
    <p class="text-[14px] font-semibold leading-relaxed text-white/90">
      다만 이 수치는 <span class="kw">체크한 개수만으로 낸 값</span>입니다
    </p>
    <p class="mt-2.5 text-[12.5px] leading-relaxed text-white/45">
      실제로 상대가 어떤 방식으로 그렇게 만들었는지, 어떤 성향이 얼마나 강한지는
      <span class="text-white/70">실제 대화</span>를 봐야 나옵니다.
      정밀 분석은 나르시시즘·마키아벨리즘·사이코패시·사디즘 4개 축 점수와
      가스라이팅 확률을 대화 근거로 계산해요.
    </p>
  </div>

  <!-- 3단계: 정밀 분석 유도 -->
  <div class="mt-5 space-y-2.5">
    <a href="<%= base %>/upload" class="flex w-full items-center justify-center gap-1.5 rounded-xl bg-red-600 py-4 text-[15px] font-bold text-white shadow-[0_12px_28px_-8px_rgba(239,68,68,0.55)] active:bg-red-700">
      카톡 대화로 정밀 분석하기
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l14 0" /><path d="M13 18l6 -6" /></svg>
    </a>
    <p class="text-center text-[11.5px] text-white/30">캡처 1장이면 충분해요 · 분석 후 즉시 삭제됩니다</p>

    <%# 업로드가 부담인 사람을 여기서 놓치지 않는다 — 상담만으로도 리포트까지 갈 수 있다 %>
    <a href="<%= base %>/counsel" class="flex w-full items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/[0.06] py-3.5 text-[14px] font-semibold text-white/85 active:bg-white/[0.12]">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="text-red-400"><path d="M8 9h8" /><path d="M8 13h6" /><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3z" /></svg>
      업로드 없이 AI 상담으로 바로 시작
    </a>
    <p class="text-center text-[11.5px] text-white/30">방금 체크한 내용을 이어받아 대화를 시작해요</p>
  </div>

  <a href="<%= base %>/check" class="mt-7 block text-center text-[11.5px] text-white/25 underline">다시 체크하기</a>
</div>

<script>
  (function () {
    var el = document.getElementById('scorePercent');
    var card = document.getElementById('scoreCard');
    if (!el) return;
    var target = <%- JSON.stringify(result.percent) %>;
    var settleMs = 900;
    var startTime = null;
    el.textContent = '0'; // 애니메이션이 실제로 돌 때만 0에서 출발시킨다

    function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

    function tick(ts) {
      if (!startTime) startTime = ts;
      var p = (ts - startTime) / settleMs;
      if (p < 1) {
        el.textContent = Math.round(target * easeOutCubic(p));
        requestAnimationFrame(tick);
      } else {
        el.textContent = target;
        card.classList.add('jackpot-land');
        setTimeout(function () { card.classList.remove('jackpot-land'); }, 500);
      }
    }
    requestAnimationFrame(tick);
  })();
</script>
