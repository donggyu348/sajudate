<div class="relative">
  <!-- 은은한 배경 글로우 -->
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-72 bg-gradient-to-b from-accent-soft/80 via-accent-soft/25 to-transparent"></div>

  <div class="p-5 pt-8">
    <span class="inline-block text-[11px] font-semibold tracking-[0.16em] text-accent">AI 관계 상담</span>
    <h1 class="mt-2 font-serif text-[26px] leading-[1.35] text-ink">상담을 시작할 준비가<br />됐어요</h1>
    <p class="mt-3 text-[13.5px] leading-relaxed text-ink-soft">
      바로 대화로 시작해도 되고, 카카오톡 대화 캡처가 있으면 AI 상담사가 의심스러운 구간을 참고해 더 정확하게 상담해요.
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <p class="mt-3 rounded-xl bg-red-50 p-3 text-xs text-red-600"><%= error %></p>
    <% } %>

    <!-- 선택 1: 바로 상담 -->
    <a href="<%= base %>/counsel" class="mt-7 flex w-full items-center justify-center gap-2 rounded-full bg-accent px-6 py-4 text-[15px] font-semibold text-white shadow-[0_14px_28px_-10px_rgba(67,56,202,0.55)] transition-transform active:scale-[0.98]">
      지금 바로 상담 시작하기
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l14 0" /><path d="M13 18l6 -6" /><path d="M13 6l6 6" /></svg>
    </a>

    <!-- 선택 2: 카카오톡 대화 파일 첨부 (선택, 펼치면 설명) -->
    <details <% if (typeof error !== 'undefined' && error) { %>open<% } %> class="group mt-4 overflow-hidden rounded-2xl border border-line/70 bg-white shadow-sm transition-shadow duration-300 open:shadow-md">
      <summary class="flex cursor-pointer list-none items-center gap-3 p-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 9h8" /><path d="M8 13h6" /><path d="M12.01 20c-4.965 0 -9.01 -3.582 -9.01 -8c0 -4.418 4.045 -8 9.01 -8c4.964 0 8.99 3.582 8.99 8c0 1.658 -.57 3.196 -1.55 4.472c-.223 .29 -.351 .649 -.351 1.028v2.5l-2.9 -1.5c-.336 -.174 -.72 -.232 -1.09 -.166c-.983 .173 -2.02 .166 -1.099 .166" /></svg>
        </span>
        <span class="flex-1 text-left">
          <span class="block text-[14px] font-semibold text-ink">카카오톡 대화 캡처 첨부하기</span>
          <span class="block text-[11.5px] text-ink-soft">선택 · 더 정확한 진단이 가능해요</span>
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-ink-soft transition-transform duration-200 group-open:rotate-180"><path d="M6 9l6 6l6 -6" /></svg>
      </summary>

      <div class="space-y-4 border-t border-line/70 bg-gray-50/60 p-4">
        <!-- 프라이버시 고지 -->
        <div class="rounded-xl border border-accent-ring/70 bg-accent-soft p-4">
          <p class="text-sm font-semibold text-accent"><%= privacyNotice.title %></p>
          <ul class="mt-2 space-y-1.5">
            <% privacyNotice.bullets.forEach(function (b) { %>
              <li class="flex items-start gap-2 text-xs leading-relaxed text-accent">
                <span class="mt-1 h-1 w-1 shrink-0 rounded-full bg-accent"></span><span><%= b %></span>
              </li>
            <% }); %>
          </ul>
        </div>

        <form method="post" action="<%= base %>/upload" enctype="multipart/form-data" class="space-y-4">
          <label id="dropzone" class="group relative flex cursor-pointer flex-col items-center justify-center overflow-hidden rounded-2xl border border-line bg-gradient-to-b from-white to-gray-50 px-4 py-10 text-center shadow-sm transition-colors duration-300 hover:border-accent-ring hover:bg-accent-soft/40">
            <span class="pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-black/5"></span>
            <span class="flex h-14 w-14 items-center justify-center rounded-full bg-accent-soft text-accent transition-transform duration-300 group-hover:scale-105">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 8h.01" /><path d="M12.5 21h-6.5a3 3 0 0 1 -3 -3v-12a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v6.5" /><path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l4 4" /><path d="M14 14l1 -1c.653 -.629 1.359 -.815 2.045 -.564" /><path d="M20.2 20.2l1.8 1.8" /><path d="M17.5 18a2.5 2.5 0 1 0 0 -5a2.5 2.5 0 0 0 0 5" /></svg>
            </span>
            <span class="mt-4 font-serif text-[15px] text-ink">카카오톡 캡처 이미지를 올려주세요</span>
            <span id="fileName" class="mt-2 inline-flex items-center gap-1.5 text-xs text-ink-soft">
              <span id="fileDot" class="h-1 w-1 rounded-full bg-ink-soft/50"></span><span id="fileLabel">선택된 이미지 없음</span>
            </span>
            <span class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-line bg-white px-3.5 py-1.5 text-xs font-semibold text-ink shadow-sm transition-colors group-hover:border-accent group-hover:text-accent">이미지 선택 (여러 장 가능)</span>
            <input type="file" name="chatImages" accept="image/png,image/jpeg,image/webp" multiple class="sr-only" id="chatImages" required />
          </label>

          <!-- 카카오톡 캡처 방법 안내 (앱 자체 기능이라 iOS/Android 동일) -->
          <details class="group/os rounded-xl border border-line/70 bg-white p-4">
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-medium [&::-webkit-details-marker]:hidden">
              카카오톡 대화 캡처하는 방법
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-ink-soft transition-transform duration-200 group-open/os:rotate-180"><path d="M6 9l6 6l6 -6" /></svg>
            </summary>
            <div class="mt-3 space-y-1.5 text-xs leading-relaxed text-ink-soft">
              <p>1. 캡처하고 싶은 첫 메시지를 길게 누르기</p>
              <p>2. 메뉴에서 <span class="font-medium text-ink">캡처</span> 선택</p>
              <p>3. 파란 선을 원하는 대화 끝까지 드래그해서 범위 지정</p>
              <p>4. <span class="font-medium text-ink">캡처</span> 버튼을 누르면 대화가 이미지로 저장됨</p>
              <p>5. 저장된 이미지를 여기에 올리기 (여러 구간이면 여러 장 올려도 돼요)</p>
              <p class="text-[11px]">※ 카카오톡 앱 자체 기능이라 iOS·Android 모두 동일하게 사용할 수 있어요.</p>
            </div>

            <div class="mt-3 rounded-lg bg-accent-soft/60 p-3 text-xs leading-relaxed text-ink-soft">
              <p class="font-medium text-ink">💡 캡처 넣을 때 꿀팁</p>
              <p class="mt-1.5">모든 대화를 다 넣을 필요는 없어요. 수개월 치 대화를 통째로 올리기보다, 갈등이 시작된 시점부터 대화가 끝나는(혹은 내가 사과하거나 유구무언이 된) <span class="font-medium text-ink">핵심 에피소드 1~2개</span>의 전후 흐름을 캡처하는 게 가장 효과적이에요.</p>
              <p class="mt-1.5">분량은 화면 기준 연속 <span class="font-medium text-ink">3~5장</span> 정도면 대화의 주도권과 패턴을 분석하기에 충분합니다.</p>
            </div>
          </details>

          <button type="submit" class="w-full rounded-full bg-accent px-6 py-3.5 text-sm font-semibold text-white shadow-[0_10px_20px_-8px_rgba(67,56,202,0.5)] transition-transform active:scale-[0.98]">업로드하고 상담 시작하기</button>
        </form>
      </div>
    </details>
  </div>
</div>

<script>
  (function () {
    const input = document.getElementById('chatImages');
    const dropzone = document.getElementById('dropzone');
    const dot = document.getElementById('fileDot');
    const label = document.getElementById('fileLabel');
    if (!input || !dropzone || !dot || !label) return;

    function setFiles(files) {
      const count = files ? files.length : 0;
      label.textContent = count > 0 ? count + '장 선택됨' : '선택된 이미지 없음';
      label.classList.toggle('font-medium', count > 0);
      label.classList.toggle('text-accent', count > 0);
      dot.classList.toggle('bg-accent', count > 0);
      dot.classList.toggle('bg-ink-soft/50', count === 0);
    }

    input.addEventListener('change', function () {
      setFiles(input.files);
    });

    ['dragover', 'dragenter'].forEach(function (evt) {
      dropzone.addEventListener(evt, function (e) {
        e.preventDefault();
        dropzone.classList.add('border-accent', 'bg-accent-soft/40');
      });
    });
    ['dragleave', 'drop'].forEach(function (evt) {
      dropzone.addEventListener(evt, function (e) {
        e.preventDefault();
        dropzone.classList.remove('border-accent', 'bg-accent-soft/40');
      });
    });
    dropzone.addEventListener('drop', function (e) {
      const files = e.dataTransfer && e.dataTransfer.files;
      if (files && files.length) {
        input.files = files;
        setFiles(files);
      }
    });
  })();
</script>
