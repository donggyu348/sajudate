<div class="flex h-[calc(100vh-3.5rem-5rem)] flex-col">
  <!-- 헤더/고지 -->
  <div class="border-b border-line px-4 py-3">
    <div class="flex items-center justify-between gap-2">
      <h1 class="text-base font-bold"><%= current ? current.name : '관계 상담' %></h1>
      <% if (agents && agents.length > 1) { %>
        <select id="agentSelect" class="rounded-lg border border-line px-2 py-1 text-xs text-ink-soft focus:border-accent focus:outline-none">
          <% agents.forEach(function (a) { %>
            <option value="<%= a.slug %>" <%= current && a.slug === current.slug ? 'selected' : '' %>><%= a.name %></option>
          <% }); %>
        </select>
      <% } %>
    </div>
    <p class="mt-0.5 text-[11px] leading-relaxed text-ink-soft">
      <%= current && current.description ? current.description : '대화하며 관계의 신호를 함께 살펴봐요.' %>
      참고용 정서적 지지이며 전문 상담을 대체하지 않습니다.
    </p>
    <% if (!enabled) { %>
      <div class="mt-2 rounded-lg border border-amber-200 bg-amber-50 p-2 text-[11px] text-amber-700">
        현재 상담 봇이 설정되지 않았습니다(API 키 미설정). 화면 구성은 확인할 수 있으나 실제 응답은 나오지 않습니다.
      </div>
    <% } %>
  </div>

  <% if (!current) { %>
    <div class="flex flex-1 flex-col items-center justify-center px-6 text-center">
      <p class="text-sm text-ink-soft">등록된 상담 봇이 없습니다.</p>
      <a href="/admin/agents" class="btn-outline mt-4">관리자에서 봇 만들기</a>
    </div>
  <% } else { %>
  <!-- 메시지 영역 -->
  <div id="chatLog" class="flex-1 space-y-3 overflow-y-auto px-4 py-4">
    <div class="flex">
      <div class="max-w-[85%] whitespace-pre-wrap rounded-2xl rounded-tl-sm border border-line bg-white px-3.5 py-2.5 text-sm leading-relaxed"><%= current.greeting || '안녕하세요. 어떤 이야기가 있으신가요? 편하게 말씀해 주세요.' %></div>
    </div>
  </div>

  <!-- 입력 -->
  <form id="chatForm" class="border-t border-line px-3 py-3">
    <div class="flex items-end gap-2">
      <textarea id="chatInput" rows="1" placeholder="메시지를 입력하세요…"
        class="max-h-32 flex-1 resize-none rounded-2xl border border-line px-3.5 py-2.5 text-sm focus:border-accent focus:outline-none"></textarea>
      <button id="sendBtn" type="submit" class="btn-primary shrink-0 rounded-full !px-4 !py-2.5" aria-label="보내기">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14l11 -11" /><path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" /></svg>
      </button>
    </div>
  </form>
  <% } %>
</div>

<% if (current) { %>
<script>
  (function () {
    const base = <%- JSON.stringify(base) %>;
    const agentSlug = <%- JSON.stringify(current.slug) %>;
    const log = document.getElementById('chatLog');
    const form = document.getElementById('chatForm');
    const input = document.getElementById('chatInput');
    const sendBtn = document.getElementById('sendBtn');
    const agentSelect = document.getElementById('agentSelect');

    // 봇 전환 → 페이지 리로드(대화 초기화)
    if (agentSelect) {
      agentSelect.addEventListener('change', function () {
        location.href = base + '/counsel?agent=' + encodeURIComponent(agentSelect.value);
      });
    }

    const history = []; // user/assistant 만

    function bubble(role) {
      const wrap = document.createElement('div');
      wrap.className = 'flex ' + (role === 'user' ? 'justify-end' : '');
      const b = document.createElement('div');
      b.className = role === 'user'
        ? 'max-w-[85%] whitespace-pre-wrap rounded-2xl rounded-tr-sm bg-accent px-3.5 py-2.5 text-sm leading-relaxed text-white'
        : 'max-w-[85%] whitespace-pre-wrap rounded-2xl rounded-tl-sm border border-line bg-white px-3.5 py-2.5 text-sm leading-relaxed';
      wrap.appendChild(b);
      log.appendChild(wrap);
      log.scrollTop = log.scrollHeight;
      return b;
    }

    input.addEventListener('input', function () {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 128) + 'px';
    });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
    });

    let busy = false;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || busy) return;

      busy = true; sendBtn.disabled = true;
      input.value = ''; input.style.height = 'auto';

      bubble('user').textContent = text;
      history.push({ role: 'user', content: text });

      const answer = bubble('assistant');
      answer.innerHTML = '<span class="text-ink-soft">…</span>';

      try {
        const res = await fetch(base + '/counsel/stream', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ agentSlug: agentSlug, messages: history }),
        });
        if (!res.body) throw new Error('no stream');
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let acc = '';
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          acc += decoder.decode(value, { stream: true });
          answer.textContent = acc;
          log.scrollTop = log.scrollHeight;
        }
        history.push({ role: 'assistant', content: acc });
      } catch (err) {
        answer.textContent = '연결에 문제가 발생했어요. 잠시 후 다시 시도해 주세요.';
      } finally {
        busy = false; sendBtn.disabled = false; input.focus();
      }
    });
  })();
</script>
<% } %>
