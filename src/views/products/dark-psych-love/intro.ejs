  <!-- ─────────────────────────────────────────────
       8. CTA
       ───────────────────────────────────────────── -->
  <%# 하단 고정 CTA가 계속 따라다니므로 최종 CTA 블록은 두지 않는다.
      다만 공통 푸터를 뺀 페이지라, 법적 고지와 약관 링크는 최소한으로 남긴다. %>
  <section class="reveal bg-[#0b0f16] px-6 pb-10 pt-2">
    <p class="text-center text-[10.5px] leading-relaxed text-white/25">
      본 진단은 참고용 인사이트이며 임상적 진단을 대체하지 않습니다
    </p>
    <div class="mt-3 flex justify-center gap-3 text-[10.5px] text-white/25">
      <a href="/terms" class="underline underline-offset-2 hover:text-white/45">이용약관</a>
      <span class="text-white/15">|</span>
      <a href="/privacy" class="underline underline-offset-2 hover:text-white/45">개인정보 처리방침</a>
    </div>
  </section>
</div>

<!-- 스크롤 후 따라붙는 하단 고정 CTA (히어로를 지나면 등장) -->
<div id="stickyCta" class="pointer-events-none fixed inset-x-0 bottom-14 z-20 mx-auto max-w-app px-4 pb-3 opacity-0 transition-opacity duration-300">
  <a href="<%= base %>/upload" class="flex w-full items-center justify-center gap-1.5 rounded-xl bg-red-600 py-3.5 text-[14px] font-bold text-white shadow-[0_12px_28px_-10px_rgba(220,38,38,0.85)]">
    무료로 진단 받기
    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l14 0" /><path d="M13 18l6 -6" /></svg>
  </a>
</div>

<script>
  (function () {
    // ── 스크롤 진입 시 페이드인 ──
    // .reveal은 기본 상태가 opacity:0이라, 어떤 이유로든 관찰자가 동작하지 않으면
    // 페이지 전체가 빈 화면이 된다. 그래서 (1) 미지원 브라우저 (2) 모션 최소화 설정
    // (3) 관찰자가 끝내 동작하지 않은 경우까지 모두 즉시 노출로 되돌린다.
    const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 섹션이 통째로 한 번에 뜨면 밋밋해서, 섹션 안의 블록들을 각각 관찰 대상으로 만들어
    // 스크롤을 내리는 동안 위에서부터 차례로 올라오게 한다.
    // (배경 레이어·이미지는 제외 — opacity/transform을 건드리면 배경 연출이 깨진다)
    if (!prefersReduced) {
      document.querySelectorAll('section').forEach(function (sec, si) {
        if (si === 0) return; // 히어로는 이미 개별 reveal이 잡혀 있음
        const host = sec.querySelector(':scope > .relative') || sec;
        Array.prototype.forEach.call(host.children, function (child, i) {
          if (child.tagName === 'IMG') return;
          if (child.classList.contains('absolute')) return;
          if (child.classList.contains('reveal')) return;
          child.classList.add('reveal');
          child.style.transitionDelay = Math.min(i * 80, 320) + 'ms';
        });
      });
    }

    const targets = document.querySelectorAll('.reveal');

    function revealAll() {
      targets.forEach(function (el) {
        el.classList.add('is-in');
        el.querySelectorAll('.sample-bar').forEach(function (bar) {
          bar.style.width = bar.dataset.w + '%';
        });
      });
    }

    if (!('IntersectionObserver' in window) || prefersReduced) {
      revealAll();
    } else {
      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          // 샘플 리포트 막대는 화면에 들어온 시점에 목표 너비로 늘린다
          e.target.querySelectorAll('.sample-bar').forEach(function (bar) {
            bar.style.width = bar.dataset.w + '%';
          });
          io.unobserve(e.target);
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
      targets.forEach((el) => io.observe(el));

      // 안전장치: 1.5초가 지나도 단 하나도 노출되지 않았다면 관찰자가 동작하지 않는 환경으로 보고 전부 노출
      setTimeout(function () {
        if (!document.querySelector('.reveal.is-in')) revealAll();
      }, 1500);
    }

    // ── 다크 테트라드 카드 캐러셀: 현재 위치 배지 + 인디케이터 ──
    (function () {
      const rail = document.getElementById('axisRail');
      const indexEl = document.getElementById('axisIndex');
      const dots = document.getElementById('axisDots');
      if (!rail || !indexEl || !dots) return;

      // 무한 루프 —
      // 첫 카드에서 왼쪽이 비어 보이지 않도록, 맨 앞에 "마지막 카드 복제본"을,
      // 맨 뒤에 "첫 카드 복제본"을 붙인다. 복제본에 도달하면 스크롤이 멈춘 뒤
      // 애니메이션 없이 같은 그림의 진짜 카드 위치로 순간 이동시켜 끝없이 도는 것처럼 보이게 한다.
      const originals = Array.prototype.slice.call(rail.querySelectorAll('.axis-card'));
      const n = originals.length;
      if (n > 1) {
        const headClone = originals[n - 1].cloneNode(true);
        const tailClone = originals[0].cloneNode(true);
        headClone.setAttribute('aria-hidden', 'true');
        tailClone.setAttribute('aria-hidden', 'true');
        rail.insertBefore(headClone, originals[0]);
        rail.appendChild(tailClone);
      }

      const cards = Array.prototype.slice.call(rail.querySelectorAll('.axis-card'));
      const hasLoop = n > 1;
      const firstReal = hasLoop ? 1 : 0;   // 진짜 첫 카드의 인덱스
      const lastReal = hasLoop ? n : n - 1; // 진짜 마지막 카드의 인덱스

      let raf = null;
      let idleTimer = null;

      // i번 카드가 화면 정중앙에 오는 scrollLeft 값
      function scrollPosFor(i) {
        return cards[i].offsetLeft - (rail.clientWidth - cards[i].offsetWidth) / 2;
      }

      function jumpTo(i) {
        const prev = rail.style.scrollSnapType;
        rail.style.scrollSnapType = 'none'; // 스냅이 순간 이동을 방해하지 않도록 잠시 끔
        rail.scrollLeft = scrollPosFor(i);
        requestAnimationFrame(function () { rail.style.scrollSnapType = prev || ''; });
      }

      let current = firstReal;

      function sync() {
        raf = null;
        // 레일 중앙에 가장 가까운 카드를 현재 카드로 본다
        const center = rail.scrollLeft + rail.clientWidth / 2;
        let best = 0;
        let bestGap = Infinity;

        cards.forEach(function (card, i) {
          const cardCenter = card.offsetLeft + card.offsetWidth / 2;
          const gap = Math.abs(cardCenter - center);
          if (gap < bestGap) { bestGap = gap; best = i; }

          // 중앙에서 멀어질수록 작아지고 흐려져서 "뒤에 있는" 느낌을 준다.
          // 카드 하나 폭만큼 벗어나면 최대치(축소 12%, 불투명도 55%)에 도달.
          const t = Math.min(1, gap / card.offsetWidth);
          card.style.transform = 'scale(' + (1 - t * 0.12).toFixed(4) + ')';
          card.style.opacity = (1 - t * 0.45).toFixed(3);
          card.style.zIndex = String(10 - Math.round(t * 10));
        });

        current = best;

        // 복제본을 실제 순서로 환산 (앞 복제본=마지막, 뒤 복제본=첫번째)
        const real = hasLoop ? ((best - 1) % n + n) % n : best;
        indexEl.textContent = real + 1;
        dots.querySelectorAll('span').forEach(function (dot, i) {
          dot.classList.toggle('w-5', i === real);
          dot.classList.toggle('bg-white/60', i === real);
          dot.classList.toggle('w-1.5', i !== real);
          dot.classList.toggle('bg-white/20', i !== real);
        });
      }

      rail.addEventListener('scroll', function () {
        if (raf === null) raf = requestAnimationFrame(sync);

        // 스크롤이 멎은 뒤에만 순간 이동 — 스와이프 도중에 옮기면 손가락에서 카드가 튄다
        if (!hasLoop) return;
        clearTimeout(idleTimer);
        idleTimer = setTimeout(function () {
          if (current === 0) jumpTo(lastReal);
          else if (current === cards.length - 1) jumpTo(firstReal);
        }, 140);
      }, { passive: true });

      // 시작 위치를 진짜 첫 카드로 (그 왼쪽에는 마지막 카드 복제본이 걸쳐 보인다)
      if (hasLoop) jumpTo(firstReal);
      sync();
      window.addEventListener('resize', function () {
        jumpTo(current);
        sync();
      });
    })();

    // ── 히어로를 지나면 하단 고정 CTA 노출 ──
    const sticky = document.getElementById('stickyCta');
    const hero = document.querySelector('section');
    if (sticky && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        const past = !entries[0].isIntersecting;
        sticky.style.opacity = past ? '1' : '0';
        sticky.style.pointerEvents = past ? 'auto' : 'none';
      }, { threshold: 0 }).observe(hero);
    }
  })();
</script>
