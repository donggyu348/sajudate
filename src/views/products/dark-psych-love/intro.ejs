    </h2>
    <p class="mt-3 text-[12px] text-white/40">아래는 예시 데이터입니다</p>

    <div class="mt-7 overflow-hidden rounded-2xl border border-white/[0.08] bg-black/30">
      <!-- 헤드라인 수치 -->
      <div class="border-b border-white/[0.06] px-5 py-6 text-center">
        <p class="text-[11px] font-medium text-white/40">가스라이팅 확률</p>
        <p class="mt-2 font-serif text-[38px] font-bold leading-none text-red-300"><%= sample.percent %><span class="text-[18px] text-red-300/60">%</span></p>
        <p class="mt-2 text-[12.5px] font-semibold text-white/80">주의 깊게 살펴봐야 할 수준</p>
      </div>

      <!-- 레이더 차트 -->
      <div class="border-b border-white/[0.06] px-5 py-6">
        <p class="text-[11px] font-medium text-white/40">상대방 성향 4축</p>
        <svg viewBox="0 0 200 184" class="mx-auto mt-2 h-48 w-48">
          <% [0.25, 0.5, 0.75, 1].forEach(function (lv) {
               const poly = sample.axes.map((a, i) => pt(i, lv).join(',')).join(' '); %>
            <polygon points="<%= poly %>" fill="none" stroke="#ffffff" stroke-opacity="0.08" stroke-width="1" />
          <% }); %>
          <% sample.axes.forEach(function (a, i) { const p = pt(i, 1); %>
            <line x1="<%= CX %>" y1="<%= CY %>" x2="<%= p[0] %>" y2="<%= p[1] %>" stroke="#ffffff" stroke-opacity="0.08" stroke-width="1" />
          <% }); %>
          <polygon class="sample-poly" points="<%= samplePoly %>" fill="rgba(248,113,113,0.22)" stroke="#f87171" stroke-width="2" />
          <% sample.axes.forEach(function (a, i) {
               const p = pt(i, 1.24);
               const anchor = Math.abs(p[0] - CX) < 5 ? 'middle' : (p[0] < CX ? 'end' : 'start'); %>
            <text x="<%= p[0] %>" y="<%= p[1] %>" text-anchor="<%= anchor %>" dominant-baseline="middle" font-size="9" fill="rgba(255,255,255,0.45)"><%= a.label %></text>
          <% }); %>
        </svg>
