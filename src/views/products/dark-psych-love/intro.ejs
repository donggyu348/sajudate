    <img src="/assets/intro/hero.png" alt="" class="absolute inset-0 h-full w-full object-cover" />
    <!-- 사진 위에 얹는 어두운 레이어 — 카피가 확실히 읽히도록 아래쪽을 진하게 깐다 -->
    <div class="absolute inset-0 bg-[#0b0f16]/35"></div>
    <div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-[#0b0f16] via-[#0b0f16]/85 to-transparent"></div>

    <div class="relative flex min-h-[88vh] flex-col justify-end px-6 pb-12 pt-24">
      <p class="reveal text-[11px] font-medium tracking-[0.22em] text-white/40">GASLIGHTING SELF-CHECK</p>
      <h1 class="reveal reveal-delay-1 mt-5 font-serif text-[30px] font-bold leading-[1.35] tracking-tight">
        당신도 지금,<br /><span class="kw-strong">가스라이팅</span>을<br />당하고 있나요?
      </h1>
      <p class="reveal reveal-delay-2 mt-5 text-[14px] leading-relaxed text-white/60">
