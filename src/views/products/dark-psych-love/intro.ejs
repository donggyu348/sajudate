<%
  // 진단 3단계 모델
  const steps = [
    { no: '1', name: '대화 수집', desc: '실제 카카오톡 대화를 읽어 조종 신호가 의심되는 구간을 찾습니다' },
    { no: '2', name: 'AI 심층 상담', desc: '그 구간의 앞뒤 맥락을 직접 묻고, 반복성과 의도를 확인합니다' },
    { no: '3', name: '리포트 산출', desc: '4개 축 점수와 감지된 패턴을 리포트로 정리합니다' },
  ];

  // 다크 테트라드 축별 아이콘 (Tabler, inline)
  const axisIcons = {
    narcissism: '<path d="M12 3l1.9 5.8h6.1l-4.9 3.6l1.9 5.8l-5-3.6l-5 3.6l1.9-5.8l-4.9-3.6h6.1z" />',
    machiavellianism: '<path d="M12 3a3 3 0 0 0 -3 3v1.5a3 3 0 0 1 -3 3h-1.5" /><path d="M12 3a3 3 0 0 1 3 3v1.5a3 3 0 0 0 3 3h1.5" /><path d="M12 21v-8" /><path d="M9 17h6" />',
    psychopathy: '<path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.566z" /><path d="M3 12h5l1 -2l3 6l2 -4h7" />',
    sadism: '<path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" /><path d="M17 4l1 2l2 1l-2 1l-1 2l-1 -2l-2 -1l2 -1z" />',
  };

  // 샘플 리포트 목업용 더미 수치 (실제 진단 결과 아님)
  const sample = {
    percent: 78,
    axes: [
      { label: '나르시시즘', score: 4.2 },
      { label: '마키아벨리즘', score: 3.8 },
      { label: '사이코패시', score: 2.6 },
      { label: '사디즘', score: 2.1 },
    ],
    patterns: [
      { label: '기억 부정', count: 7 },
      { label: '책임 전가', count: 5 },
      { label: '고립 유도', count: 3 },
    ],
  };
  const R = 74, CX = 100, CY = 92;
  function pt(i, ratio) {
    const a = -Math.PI / 2 + (2 * Math.PI * i) / sample.axes.length;
    return [CX + R * ratio * Math.cos(a), CY + R * ratio * Math.sin(a)];
  }
  const samplePoly = sample.axes.map((a, i) => pt(i, a.score / 5).join(',')).join(' ');
%>

<style>
  /* ── 랜딩 전용 스크롤 인터랙션 ────────────────── */
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reveal.is-in { opacity: 1; transform: none; }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.2s; }
  .reveal-delay-3 { transition-delay: 0.3s; }

  /* 하강 곡선 그래프 — 화면에 들어오면 선이 그려진다 */
  .decline-path {
    stroke-dasharray: 420;
    stroke-dashoffset: 420;
    transition: stroke-dashoffset 2s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .is-in .decline-path { stroke-dashoffset: 0; }

  /* 본문 속 핵심 키워드 강조 — 공포 구간에서만 쓰고, 안심/CTA 구간에는 쓰지 않는다
     (톤이 밝아지는 구간까지 빨강을 끌고 가면 대비 효과가 사라짐) */
  .kw {
    color: #fca5a5;
    font-weight: 600;
  }
  /* 더 강하게 눌러야 하는 한 문장 안의 핵심어 */
  .kw-strong {
    color: #f87171;
    font-weight: 700;
  }

  /* 근거 섹션 — 논문 5장을 부채꼴로 펼쳐 보여주는 전용 칸.
     배경으로 깔지 않고 하나의 전시물처럼 다룬다. 가운데 장이 가장 앞·선명하고
     양옆으로 갈수록 뒤로 눕고 흐려져서 원근감이 생긴다. */
  .paper-stage {
    position: relative;
    height: 300px;
    perspective: 1100px;
    /* 부채꼴로 회전한 장이 칸 밖으로 삐져나와 위 글씨를 덮지 않도록 잘라낸다 */
    overflow: hidden;
  }
  .paper-doc {
    position: absolute;
    bottom: 0;
    left: 50%;
    /* 세로 기준으로 맞춰야 원본 비율과 무관하게 칸 안에 들어온다 (가로 기준이면 세로로 넘침) */
    height: 72%;
    width: auto;
    max-width: none;
    border-radius: 3px;
    background: #d9d9d9;
    transform-origin: 50% 120%;
    box-shadow: 0 18px 34px -12px rgba(0, 0, 0, 0.85);
    filter: grayscale(1) contrast(0.95);
  }
  /* 뒤쪽 두 장 → 중간 두 장 → 가운데 한 장 순으로 앞으로 나온다 */
  /* 좌우로 벌려 5장이 각각 자기 지면을 조금씩 드러내게 한다(카드 부채처럼).
     이동값은 자기 폭 기준(%)이라 화면 크기가 달라져도 간격 비율이 유지된다.
     블러는 글자는 못 읽되 지면 구성(단·표·여백)은 알아볼 정도로만. */
  .paper-doc:nth-child(1) { transform: translateX(-96%) rotate(-12deg); z-index: 1; opacity: 0.6;  filter: grayscale(1) contrast(0.9) brightness(0.6) blur(4px); }
  .paper-doc:nth-child(2) { transform: translateX(-73%) rotate(-6deg);  z-index: 2; opacity: 0.78; filter: grayscale(1) contrast(0.9) brightness(0.78) blur(3.2px); }
  .paper-doc:nth-child(3) { transform: translateX(-50%) rotate(0deg);   z-index: 5; opacity: 1;    filter: grayscale(1) contrast(0.9) blur(2.4px); }
  .paper-doc:nth-child(4) { transform: translateX(-27%) rotate(6deg);   z-index: 2; opacity: 0.78; filter: grayscale(1) contrast(0.9) brightness(0.78) blur(3.2px); }
  .paper-doc:nth-child(5) { transform: translateX(-4%)  rotate(12deg);  z-index: 1; opacity: 0.6;  filter: grayscale(1) contrast(0.9) brightness(0.6) blur(4px); }

  /* 다크 테트라드 카드 캐러셀 — 옆으로 스와이프. 한 장이 화면에 꽉 차되 다음 장이 살짝 걸쳐 보이게 해서
     "옆에 더 있다"는 걸 알린다. scroll-snap으로 카드가 딱딱 걸리도록 함. */
  .axis-rail {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* 좌우 패딩 대신 첫/마지막 카드의 margin으로 여백을 준다.
       패딩을 쓰면 flex-basis의 % 기준(content-box)이 줄어들어 카드 폭이 어긋난다. */
    padding-inline: 0;
  }
  .axis-rail::-webkit-scrollbar { display: none; }
  .axis-card {
    flex: 0 0 68%;
    scroll-snap-align: center;
    /* 가운데 카드만 앞으로 나오고 양옆은 뒤로 물러난 느낌 — 값은 스크롤 위치에 따라 JS가 갱신 */
    transform-origin: center center;
    will-change: transform, opacity;
  }
  /* 68% + 16% + 16% = 100% → 첫 카드와 마지막 카드가 정확히 가운데에 선다 */
  .axis-card:first-child { margin-left: 16%; }
  .axis-card:last-child { margin-right: 16%; }
  /* 카드 이미지 위 텍스트 가독성 —
     일러스트가 밝거나 복잡한 부분에 글자가 겹치면 안 읽히므로 3중으로 방어한다.
     (1) 아래쪽을 거의 불투명하게 덮는 그라디언트
     (2) 텍스트 영역만 살짝 블러 처리해 배경 디테일을 뭉갬
     (3) 글자 자체에 그림자 */
  .axis-card-shade {
    background: linear-gradient(
      to top,
      rgba(8, 11, 18, 0.98) 0%,
      rgba(8, 11, 18, 0.94) 34%,
      rgba(8, 11, 18, 0.72) 62%,
      rgba(8, 11, 18, 0.25) 84%,
      transparent 100%
    );
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    /* 블러가 위쪽 경계에서 딱 잘려 보이지 않게 마스크로 서서히 사라지게 함 */
    -webkit-mask-image: linear-gradient(to top, #000 62%, transparent 100%);
    mask-image: linear-gradient(to top, #000 62%, transparent 100%);
  }
  .axis-card-shade > * {
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
  }

  /* 스크롤 유도 화살표 */
  @keyframes scrollNudge {
    0%, 100% { transform: translateY(0); opacity: 0.5; }
    50% { transform: translateY(5px); opacity: 1; }
  }
  .scroll-nudge { animation: scrollNudge 1.8s ease-in-out infinite; }

  /* 체크리스트 카드 선택 상태 */

  /* 샘플 리포트 레이더가 화면에 들어올 때 커지는 연출 */
  .sample-poly {
    transform-box: view-box;
    transform-origin: 100px 92px;
    transform: scale(0);
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .is-in .sample-poly { transform: scale(1); }

  .sample-bar { width: 0; transition: width 1.1s cubic-bezier(0.16, 1, 0.3, 1); }
</style>

<div class="bg-[#0b0f16] text-white">

  <!-- ─────────────────────────────────────────────
       1. 히어로
       배경 이미지: /assets/intro/hero.png
       ───────────────────────────────────────────── -->
