  <section class="reveal border-t border-white/[0.06] bg-[#0e1420] px-6 py-16">
    <p class="text-[11px] font-medium tracking-[0.18em] text-white/35">SAMPLE REPORT</p>
    <h2 class="mt-4 font-serif text-[21px] font-bold leading-[1.5]">
