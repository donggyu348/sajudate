<%# 결제 완료 직후 한 번만 실행되는 구매 이벤트.
    결제 후 처음 도착하는 화면이 리포트일 수도, 생성 대기 화면일 수도 있어 양쪽에서 include한다. %>
<% if (typeof purchaseEvent !== 'undefined' && purchaseEvent) { %>
<script>
  (function () {
    var ev = <%- JSON.stringify(purchaseEvent) %>;
    var key = 'dpl_purchase_' + ev.orderId;

    try {
      if (sessionStorage.getItem(key)) return;
    } catch (e) {}

    function send() {
      if (typeof fbq !== 'function') return false;
      fbq('track', 'Purchase', {
        value: Number(ev.value),
        currency: ev.currency || 'KRW',
        content_name: '전체 리포트 잠금 해제',
        content_type: 'product',
        contents: [{ id: 'dark-psych-love-report', quantity: 1 }],
      }, { eventID: ev.orderId });
      try { sessionStorage.setItem(key, '1'); } catch (e) {}
      return true;
    }

    // fbq 스텁은 head에서 바로 생기지만, 드물게 스크립트 차단/지연 시 재시도한다.
    // 성공한 뒤에만 sessionStorage에 남겨, 실패했는데 "이미 보냄"으로 막히는 일을 방지한다.
    if (send()) return;
    var tries = 0;
    var timer = setInterval(function () {
      tries += 1;
      if (send() || tries >= 20) clearInterval(timer);
    }, 250);
  })();
</script>
<% } %>
