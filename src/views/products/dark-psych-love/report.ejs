  <%# 결제위젯 전용 SDK — 클라이언트 키가 gck 계열이면 이 SDK를 써야 한다.
      (결제창 SDK인 /v1/payment 에 gck 키를 넣으면 COMMON_ERROR로 거부된다) %>
  <script src="https://js.tosspayments.com/v1/payment-widget"></script>
