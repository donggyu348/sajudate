<%
  // 레이더 차트 좌표 계산 (4축)
  const cx = 130, cy = 130, R = 92;
  const n = rows.length;
  function pt(i, ratio) {
    const angle = -Math.PI / 2 + (2 * Math.PI * i) / n; // 12시 방향 시작
    return [cx + R * ratio * Math.cos(angle), cy + R * ratio * Math.sin(angle)];
  }
  const gridLevels = [0.25, 0.5, 0.75, 1];
  const dataPoly = rows.map((r, i) => pt(i, Math.max(0.02, (r.score100 || 0) / 100)).join(',')).join(' ');
  const axisEnds = rows.map((r, i) => pt(i, 1));
%>

<div class="p-4">
  <h1 class="text-lg font-bold">최종 리포트</h1>
  <p class="mt-1 text-sm text-ink-soft">체크리스트<%= report.chatAnalysisId ? ' 및 대화 분석' : '' %> 결과를 종합했습니다.</p>

  <!-- 레이더 차트 -->
  <div class="mt-5 flat-card flex justify-center p-4">
    <svg viewBox="0 0 260 260" class="h-64 w-64">
      <% gridLevels.forEach(function (lv) {
           const poly = rows.map((r, i) => pt(i, lv).join(',')).join(' '); %>
        <polygon points="<%= poly %>" fill="none" stroke="#e5e7eb" stroke-width="1" />
      <% }); %>
      <% axisEnds.forEach(function (p) { %>
        <line x1="<%= cx %>" y1="<%= cy %>" x2="<%= p[0] %>" y2="<%= p[1] %>" stroke="#e5e7eb" stroke-width="1" />
      <% }); %>
      <polygon points="<%= dataPoly %>" fill="rgba(67,56,202,0.18)" stroke="#4338ca" stroke-width="2" />
      <% rows.forEach(function (r, i) {
           const p = pt(i, 1.16);
           const anchor = Math.abs(p[0] - cx) < 4 ? 'middle' : (p[0] < cx ? 'end' : 'start'); %>
        <text x="<%= p[0] %>" y="<%= p[1] %>" text-anchor="<%= anchor %>" dominant-baseline="middle" font-size="11" fill="#6b7280"><%= r.label %></text>
      <% }); %>
    </svg>
  </div>

  <!-- 축별 점수 -->
  <div class="mt-4 space-y-3">
    <% rows.forEach(function (r) { %>
      <div class="flat-card p-4">
        <div class="flex items-baseline justify-between">
          <p class="text-sm font-semibold"><%= r.label %></p>
          <p class="text-sm font-bold text-accent"><%= r.score.toFixed(1) %><span class="text-ink-soft">/5.0</span></p>
        </div>
        <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-gray-100">
          <div class="h-full rounded-full bg-accent" style="width: <%= r.score100 %>%"></div>
        </div>
        <p class="mt-2 text-xs text-ink-soft"><%= r.band.label %>.</p>
      </div>
    <% }); %>
  </div>

  <!-- 대화 패턴 통계 요약 (인용문 없음) -->
  <% if (patterns && patterns.length) { %>
  <div class="mt-6">
    <h2 class="text-sm font-bold">대화에서 감지된 패턴</h2>
    <p class="mt-1 text-[11px] text-ink-soft">실제 대화 문장은 저장·표시되지 않으며, 유형과 빈도만 집계됩니다.</p>
    <div class="mt-3 space-y-2">
      <% patterns.forEach(function (p) { %>
        <div class="flat-card flex items-center justify-between p-3">
          <span class="text-sm font-medium"><%= p.label %></span>
          <span class="text-xs text-ink-soft"><%= p.count %>회 · 신뢰도 <%= p.confidence %>%</span>
        </div>
      <% }); %>
    </div>
  </div>
  <% } else if (report.chatAnalysisId) { %>
  <div class="mt-6 rounded-lg bg-gray-50 p-4 text-xs leading-relaxed text-ink-soft">
    대화 분석에서 뚜렷한 조종 패턴 신호는 통계적으로 감지되지 않았습니다.
  </div>
  <% } %>

  <!-- 종합 소견 -->
  <div class="mt-6 flat-card p-4">
    <h2 class="text-sm font-bold">종합 소견</h2>
    <p class="mt-2 text-sm leading-relaxed text-ink"><%= report.summaryText %></p>
  </div>

  <!-- 안전 안내 -->
  <div class="mt-6 rounded-xl border border-accent-ring bg-accent-soft p-4">
    <h2 class="text-sm font-bold text-accent">안전 안내</h2>
    <p class="mt-2 text-xs leading-relaxed text-accent"><%= disclaimer %></p>
    <div class="mt-3 space-y-2">
      <% helpResources.forEach(function (h) { %>
        <div class="rounded-lg bg-white p-3">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold"><%= h.name %></span>
            <span class="text-sm font-bold text-accent"><%= h.contact %></span>
          </div>
          <p class="mt-0.5 text-[11px] text-ink-soft"><%= h.desc %></p>
          <% if (h.url) { %>
            <a href="<%= h.url %>" target="_blank" rel="noopener" class="mt-1 inline-block text-[11px] text-accent underline">바로가기</a>
          <% } %>
        </div>
      <% }); %>
    </div>
    <p class="mt-3 text-[10px] leading-relaxed text-accent/70">※ 상담 기관 정보는 배포 전 최신 여부를 확인해 확정합니다.</p>
  </div>

  <a href="/" class="btn-outline mt-6 w-full">홈으로</a>
</div>
