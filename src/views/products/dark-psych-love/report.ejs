<script>
  (function () {
    var el = document.getElementById('gaslightPercent');
    var card = document.getElementById('gaslightCard');
    if (!el) return;
    var target = <%- JSON.stringify(gaslightingPercent) %>;
    var spinMs = 550;
    var settleMs = 900;
    var startTime = null;

    function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }

    function tick(ts) {
      if (!startTime) startTime = ts;
      var elapsed = ts - startTime;
      if (elapsed < spinMs) {
        // 잭팟처럼 관계없는 숫자가 빠르게 스쳐 지나가는 구간
        el.textContent = Math.floor(Math.random() * 101);
        requestAnimationFrame(tick);
      } else if (elapsed < spinMs + settleMs) {
        // 진짜 값으로 서서히 수렴
        var p = easeOutCubic((elapsed - spinMs) / settleMs);
        el.textContent = Math.round(target * p);
        requestAnimationFrame(tick);
      } else {
        el.textContent = target;
        if (card) {
          card.classList.add('jackpot-land');
          setTimeout(function () { card.classList.remove('jackpot-land'); }, 500);
        }
      }
    }
    requestAnimationFrame(tick);
  })();

  // 스크롤에 맞춰 섹션이 하나씩 나타나게 한다.
  // 실패해도 내용이 보이지 않는 상태로 남으면 안 되므로, 관찰이 안 되는 환경에서는 즉시 해제한다.
  (function () {
    var items = document.querySelectorAll('.reveal');
    if (!items.length) return;
    function showAll() {
      items.forEach(function (el) { el.classList.add('is-in'); });
    }
    if (!('IntersectionObserver' in window)) return showAll();

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-in');
        io.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -12% 0px' });
    items.forEach(function (el) { io.observe(el); });

    setTimeout(showAll, 1500); // 관찰이 어떤 이유로든 동작하지 않았을 때의 안전장치
  })();

  (function () {
    var openBtn = document.getElementById('openReportSheetBtn');
    var sheet = document.getElementById('reportSheet');
    var overlay = document.getElementById('reportSheetOverlay');
    if (!openBtn || !sheet || !overlay) return;

    function openSheet() {
      sheet.classList.add('is-open');
      overlay.classList.add('is-open');
    }
    function closeSheet() {
      sheet.classList.remove('is-open');
      overlay.classList.remove('is-open');
    }

    openBtn.addEventListener('click', openSheet);
    overlay.addEventListener('click', closeSheet);
  })();

  <% if (unlocked) { %>
  // 리포트 후속 질문 — 답변은 서버에서 스트리밍으로 온다
  (function () {
    var openBtn = document.getElementById('openAskSheetBtn');
    var closeBtn = document.getElementById('closeAskSheetBtn');
    var sheet = document.getElementById('askSheet');
    var overlay = document.getElementById('askSheetOverlay');
    var log = document.getElementById('askLog');
    var input = document.getElementById('askInput');
    var sendBtn = document.getElementById('askSendBtn');
    var suggestions = document.getElementById('askSuggestions');
    if (!openBtn || !sheet) return;

    var askUrl = window.location.pathname.replace(/\/$/, '') + '/ask';
    var history = [];
    var busy = false;

    openBtn.addEventListener('click', function () {
      sheet.classList.add('is-open');
      overlay.classList.add('is-open');
    });
    function close() {
      sheet.classList.remove('is-open');
      overlay.classList.remove('is-open');
    }
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', close);

    function scrollToEnd() { log.scrollTop = log.scrollHeight; }

    function addBubble(role, text) {
      var el = document.createElement('div');
      el.className =
        role === 'user'
          ? 'ml-auto max-w-[85%] rounded-2xl rounded-tr-md bg-red-600/90 px-4 py-2.5 text-[13px] leading-relaxed text-white'
          : 'max-w-[92%] whitespace-pre-wrap rounded-2xl rounded-tl-md border border-white/[0.08] bg-white/[0.04] px-4 py-3 text-[13px] leading-relaxed text-white/80';
      el.textContent = text;
      log.appendChild(el);
      scrollToEnd();
      return el;
    }

    // textarea 높이를 내용에 맞춘다 (한 줄로 시작해 길어지면 늘어남)
    input.addEventListener('input', function () {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 112) + 'px';
    });

    function send(text) {
      if (busy) return;
      var question = String(text || input.value).trim();
      if (!question) return;

      if (suggestions) suggestions.remove();
      busy = true;
      sendBtn.disabled = true;
      input.value = '';
      input.style.height = 'auto';

      addBubble('user', question);
      history.push({ role: 'user', content: question });

      var bubble = addBubble('assistant', '');
      bubble.classList.add('animate-pulse');
      bubble.textContent = '…';
      var answer = '';

      fetch(askUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      })
        .then(function (res) {
          if (!res.body) throw new Error('스트리밍을 지원하지 않는 환경이에요.');
          var reader = res.body.getReader();
          var decoder = new TextDecoder();
          function pump() {
            return reader.read().then(function (chunk) {
              if (chunk.done) return;
              answer += decoder.decode(chunk.value, { stream: true });
              bubble.classList.remove('animate-pulse');
              bubble.textContent = answer;
              scrollToEnd();
              return pump();
            });
          }
          return pump();
        })
        .then(function () {
          history.push({ role: 'assistant', content: answer });
        })
        .catch(function (err) {
          console.error('[report/ask]', err);
          bubble.classList.remove('animate-pulse');
          bubble.textContent = '답변을 받지 못했어요. 잠시 후 다시 시도해 주세요.';
          history.pop(); // 실패한 질문은 기록에서 빼서 다음 요청이 꼬이지 않게 한다
        })
        .then(function () {
          busy = false;
          sendBtn.disabled = false;
          scrollToEnd();
        });
    }

    sendBtn.addEventListener('click', function () { send(); });
    input.addEventListener('keydown', function (e) {
      // 모바일에서는 엔터가 줄바꿈이라, 데스크톱에서만 엔터로 전송한다
      if (e.key === 'Enter' && !e.shiftKey && window.matchMedia('(min-width: 640px)').matches) {
        e.preventDefault();
        send();
      }
    });
    Array.prototype.forEach.call(document.querySelectorAll('.ask-suggestion'), function (btn) {
      btn.addEventListener('click', function () { send(btn.dataset.q); });
    });
  })();
  <% } %>

  <% if (!report.paid && tossEnabled) { %>
  (function () {
    var phoneInput = document.getElementById('sheetPhoneInput');
    var phoneError = document.getElementById('sheetPhoneError');
    var payBtn = document.getElementById('sheetPayBtn');
    if (!phoneInput || !payBtn) return;

    var clientKey = <%- JSON.stringify(clientKey) %>;
    var amount = <%- JSON.stringify(reportUnlockPrice) %>;
    var orderId = <%- JSON.stringify(orderId) %>;
    var orderName = <%- JSON.stringify(orderName) %>;
    var successUrl = <%- JSON.stringify(successUrl) %>;
    var failUrl = <%- JSON.stringify(failUrl) %>;

    function isValidPhone(v) {
      return /^01[016789]\d{7,8}$/.test(String(v || '').replace(/[^0-9]/g, ''));
    }

    function showError(msg) {
      phoneError.textContent = msg;
      phoneError.classList.remove('hidden');
    }

    // 실패 원인을 화면에 그대로 보여준다 — 이걸 삼키면 "눌러도 아무 일이 없는" 것처럼 보인다
    function reportTossError(err, prefix) {
      if (err && err.code === 'USER_CANCEL') return; // 사용자가 직접 닫은 것은 오류가 아니다
      console.error('[toss] ' + prefix, err);
      var code = (err && err.code) || '';
      var detail =
        code === 'INVALID_CLIENT_KEY'
          ? '클라이언트 키가 올바르지 않습니다.'
          : code === 'COMMON_ERROR' || code === 'NOT_ALLOWED_ORIGIN'
            ? '이 주소에서는 결제를 진행할 수 없습니다.'
            : (err && err.message) || '알 수 없는 오류';
      showError(prefix + ' — ' + detail + (code ? ' [' + code + ']' : ''));
    }

    // 결제위젯은 결제수단 UI를 DOM에 직접 렌더링해야 한다.
    // 페이지 로드마다 그리면 낭비라, 시트를 처음 열 때 한 번만 그린다.
    var widget = null;
    var methodWidget = null; // 금액 변경(updateAmount)은 이 객체에만 있다
    var rendering = null;
    // 위젯에 "실제로 설정돼 있는" 금액. 서버가 정한 승인 금액과 이 값이 다르면
    // 토스가 결제요청/승인요청 금액 불일치로 FORBIDDEN_REQUEST를 낸다.
    var widgetAmount = amount;

    function syncWidgetAmount(next) {
      if (!Number.isInteger(next) || next === widgetAmount) return Promise.resolve();
      if (!methodWidget || typeof methodWidget.updateAmount !== 'function') {
        return Promise.reject(new Error('결제 금액을 설정할 수 없습니다.'));
      }
      return Promise.resolve(methodWidget.updateAmount(next)).then(function () {
        widgetAmount = next;
        // updateAmount는 위젯 iframe으로 비동기 반영된다. 반영 전에 requestPayment가 나가면
        // 결제창은 옛 금액으로 열리고 서버는 새 금액으로 승인해 금액이 어긋난다.
        return new Promise(function (resolve) { setTimeout(resolve, 400); });
      });
    }

    function ensureWidget() {
      if (rendering) return rendering;
      rendering = Promise.resolve()
        .then(function () {
          // 비회원 결제이므로 익명 고객키를 사용한다
          widget = PaymentWidget(clientKey, PaymentWidget.ANONYMOUS);
          // renderPaymentMethods의 반환값이 결제수단 위젯 — updateAmount는 여기 달려 있다
          methodWidget = widget.renderPaymentMethods('#payment-method', { value: amount });
          widget.renderAgreement('#agreement');
          payBtn.disabled = false;
          payBtn.textContent = '구매하기';
        })
        .catch(function (err) {
          rendering = null; // 실패 시 다시 시도할 수 있게
          payBtn.textContent = '결제 수단을 불러오지 못했습니다';
          reportTossError(err, '결제 수단을 불러오지 못했습니다');
          throw err;
        });
      return rendering;
    }

    // 시트를 열 때 위젯을 준비시킨다 (버튼은 준비될 때까지 비활성)
    var openBtnForWidget = document.getElementById('openReportSheetBtn');
    if (openBtnForWidget) {
      openBtnForWidget.addEventListener('click', function () {
        ensureWidget().catch(function () {});
      });
    }

    payBtn.addEventListener('click', function () {
      var phone = phoneInput.value.trim();
      if (!isValidPhone(phone)) {
        showError('휴대폰 번호를 정확히 입력해 주세요.');
        phoneInput.focus();
        return;
      }
      phoneError.classList.add('hidden');
      payBtn.disabled = true;
      payBtn.textContent = '결제 진행 중…';

      // 전화번호를 서버 세션에 먼저 저장한 뒤 결제를 요청한다
      // (successUrl 쿼리로 넘기면 접속 로그에 전화번호가 평문으로 남는다)
      fetch(window.location.pathname + '/checkout/prepare-phone', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: phone.replace(/[^0-9]/g, '') }),
      })
        .then(function (r) {
          if (!r.ok) throw new Error('결제 준비에 실패했습니다.');
          return r.json();
        })
        .then(function (data) {
          if (!data || !data.orderId) throw new Error('주문번호를 받지 못했습니다.');
          return ensureWidget()
            // 금액은 서버가 정한다. 테스트 번호면 서버가 다른 금액을 돌려주므로 위젯 금액을 맞춘다.
            // 위젯에 설정된 금액이 곧 결제 금액이라 이 갱신은 반드시 성공해야 한다.
            // (승인 시 토스에 보내는 금액도 서버 세션 값이라, 여기서 조작해도 소용없다)
            .then(function () { return syncWidgetAmount(data.amount); })
            .then(function () { return data; });
        })
        .then(function (data) {
          // orderId는 서버가 이번 시도용으로 새로 발급한 값을 쓴다 —
          // 페이지에 박힌 값을 재사용하면 재시도 시 토스가 거부한다
          return widget.requestPayment({
            orderId: data.orderId,
            orderName: orderName,
            successUrl: successUrl,
            failUrl: failUrl,
          });
        })
        .catch(function (err) {
          payBtn.disabled = false;
          payBtn.textContent = '구매하기';
          reportTossError(err, '결제를 진행하지 못했습니다');
        });
    });
  })();
  <% } %>
</script>
