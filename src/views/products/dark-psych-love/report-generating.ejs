<style>
  /* 리포트 페이지와 같은 다크 톤 — 결제 직후 화면이 밝아지면 흐름이 끊긴다 */
  body { background: #0b0f16 !important; }
  .app-shell { background: #0b0f16; color: #e8ecf3; min-height: 100vh; }
  .app-shell > header {
    background: rgba(11, 15, 22, 0.88);
    backdrop-filter: blur(10px);
    border-bottom-color: rgba(255, 255, 255, 0.07);
  }
  .app-shell > header span { color: #f2f4f8; }
  .app-shell > header button { color: rgba(255, 255, 255, 0.62); }
  .app-shell > nav {
    background: rgba(11, 15, 22, 0.96);
    border-top-color: rgba(255, 255, 255, 0.07);
  }
  .app-shell > nav a.text-ink-soft { color: rgba(255, 255, 255, 0.4); }

  @keyframes gen-pulse {
    0%, 100% { opacity: 0.35; transform: scale(0.94); }
    50% { opacity: 1; transform: scale(1); }
  }
  .gen-ring { animation: gen-pulse 1.8s ease-in-out infinite; }

  @keyframes gen-sweep {
    from { transform: translateX(-100%); }
    to { transform: translateX(400%); }
  }
  .gen-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 25%;
    background: linear-gradient(90deg, transparent, #ef4444, transparent);
    animation: gen-sweep 1.6s ease-in-out infinite;
  }

  /* 지금 어떤 챕터를 쓰고 있는지 한 줄씩 올라오게 — 기다리는 시간이 덜 지루하다 */
  .gen-step { opacity: 0.25; transition: opacity 0.4s ease, color 0.4s ease; }
  .gen-step.is-active { opacity: 1; color: #ffffff; }
  .gen-step.is-done { opacity: 0.55; }
  @media (prefers-reduced-motion: reduce) {
    .gen-ring, .gen-bar::after { animation: none; }
  }
</style>

<div class="flex min-h-[80vh] flex-col justify-center px-6 py-16">
  <% if (failed) { %>
    <div class="text-center">
      <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-red-500/30 bg-red-500/10 text-red-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4" /><path d="M12 16h.01" /><path d="M12 3a9 9 0 1 0 0 18a9 9 0 0 0 0 -18" /></svg>
      </div>
      <p class="mt-5 font-serif text-[19px] font-bold text-white">리포트를 만들지 못했어요</p>
      <p class="mt-3 text-[12.5px] leading-relaxed text-white/45">
        결제는 정상적으로 완료됐습니다.<br />
        아래 버튼으로 다시 시도해 주세요.
      </p>
      <a href="<%= base %>/report/<%= reportId %>?retry=1"
         class="mt-7 inline-flex w-full max-w-xs items-center justify-center rounded-xl bg-red-600 py-3.5 text-[15px] font-bold text-white active:bg-red-700">
        다시 시도하기
      </a>
    </div>
  <% } else { %>
    <div class="text-center">
      <div class="relative mx-auto h-16 w-16">
        <span class="gen-ring absolute inset-0 rounded-full border border-red-500/40"></span>
        <span class="gen-ring absolute inset-2 rounded-full border border-red-500/25" style="animation-delay: 0.3s;"></span>
        <span class="absolute inset-0 flex items-center justify-center text-red-400">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4h6a2 2 0 0 1 2 2v13a1 1 0 0 1 -1.5 .866l-3 -1.732l-3 1.732a1 1 0 0 1 -1.5 -.866v-13a2 2 0 0 1 2 -2" /></svg>
        </span>
      </div>

      <p class="rp-gen-eyebrow mt-7 text-[10.5px] font-semibold tracking-[0.18em] text-white/30">FULL REPORT</p>
      <h1 class="mt-2.5 font-serif text-[21px] font-bold leading-[1.5] text-white">
        전체 리포트를<br />작성하고 있어요
      </h1>
      <p class="mt-3.5 text-[12.5px] leading-relaxed text-white/45">
        상담 내용을 <%= chapterCount %>개 챕터로 나눠 하나씩 분석하는 중이에요.<br />
        1~2분 정도 걸리니 이 화면을 닫지 말고 기다려 주세요.
      </p>

      <div class="relative mx-auto mt-7 h-[3px] w-full max-w-xs overflow-hidden rounded-full bg-white/[0.07]">
        <span class="gen-bar absolute inset-0"></span>
      </div>

      <ul id="genSteps" class="mx-auto mt-8 max-w-xs space-y-2.5 text-left">
        <% ['상담 내용 다시 읽는 중', '상대방 심리 정리하는 중', '내 반응 패턴 분석하는 중', '관계의 흐름 짚는 중', '행동 가이드 작성하는 중', '리포트 마무리하는 중'].forEach(function (label, i) { %>
          <li class="gen-step flex items-center gap-2.5 text-[12.5px] text-white/70">
            <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-red-400"></span>
            <%= label %>
          </li>
        <% }); %>
      </ul>

      <p class="mt-8 text-[11px] leading-relaxed text-white/25">
        결제는 이미 완료됐어요. 창을 닫아도 리포트는 계속 만들어지고,<br />
        준비가 끝나면 입력하신 번호로 리포트 링크 문자가 발송됩니다.
      </p>
    </div>
  <% } %>
</div>

<% if (!failed) { %>
<script>
  (function () {
    var statusUrl = <%- JSON.stringify(`${base}/report/${reportId}/premium-status`) %>;
    var reportUrl = <%- JSON.stringify(`${base}/report/${reportId}`) %>;

    // 진행 단계 표시 — 실제 챕터 진행률을 알 수는 없어서, 예상 소요시간에 맞춰 순서대로 켠다
    var steps = Array.prototype.slice.call(document.querySelectorAll('.gen-step'));
    var stepIndex = 0;
    function advanceStep() {
      if (stepIndex > 0) steps[stepIndex - 1].classList.add('is-done');
      if (stepIndex >= steps.length) return;
      steps[stepIndex].classList.add('is-active');
      stepIndex += 1;
    }
    advanceStep();
    setInterval(advanceStep, 13000);

    var tries = 0;
    function poll() {
      tries += 1;
      fetch(statusUrl, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.ready) return window.location.replace(reportUrl);
          // 생성이 실패했으면 다시 그려서 재시도 버튼을 보여준다
          if (data && data.failed) return window.location.reload();
          // 5분(60회)까지도 안 끝나면 서버 쪽에서 멈춘 것으로 보고 새로고침해 상태를 다시 잡는다
          if (tries >= 60) return window.location.reload();
          setTimeout(poll, 5000);
        })
        .catch(function () {
          setTimeout(poll, 5000); // 일시적인 네트워크 오류로 폴링이 끊기지 않게 한다
        });
    }
    setTimeout(poll, 4000);
  })();
</script>
<% } %>

<%- include("_purchase-pixel") %>
