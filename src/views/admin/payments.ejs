<%
  function won(n) { return (n || 0).toLocaleString('ko-KR') + '원'; }
  function maskPhone(p) {
    if (!p) return '-';
    const s = String(p);
    if (s.length < 7) return s;
    return s.slice(0, 3) + '-****-' + s.slice(-4);
  }
  function formatDateTime(d) {
    const dt = new Date(d);
    return dt.getFullYear() + '.' + String(dt.getMonth() + 1).padStart(2, '0') + '.' + String(dt.getDate()).padStart(2, '0') +
      ' ' + String(dt.getHours()).padStart(2, '0') + ':' + String(dt.getMinutes()).padStart(2, '0');
  }
%>

<!-- 헤더 -->
<div class="border-b border-gray-200 p-6">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-xl font-bold text-gray-800">결제내역</h2>
      <p class="mt-1 text-gray-500">리포트 잠금 해제를 결제 완료한 내역입니다.</p>
    </div>
    <div class="mt-4 text-right md:mt-0">
      <p class="text-sm font-medium text-gray-500">오늘 승인 총 매출액</p>
      <p class="text-2xl font-extrabold text-green-600"><%= won(todayRevenue) %></p>
    </div>
  </div>

  <div class="mt-5 grid grid-cols-3 gap-3">
    <div class="rounded-xl border border-gray-200 p-3 text-center">
      <p class="text-xs text-gray-500">오늘</p>
      <p class="mt-1 text-sm font-bold text-gray-800"><%= won(todayRevenue) %></p>
    </div>
    <div class="rounded-xl border border-gray-200 p-3 text-center">
      <p class="text-xs text-gray-500">이번 달</p>
      <p class="mt-1 text-sm font-bold text-gray-800"><%= won(monthRevenue) %></p>
    </div>
    <div class="rounded-xl border border-gray-200 p-3 text-center">
      <p class="text-xs text-gray-500">누적</p>
      <p class="mt-1 text-sm font-bold text-indigo-600"><%= won(totalRevenue) %></p>
    </div>
  </div>

  <% if (notice) { %>
    <div class="mt-4 rounded-lg border border-indigo-200 bg-indigo-50 p-2.5 text-xs text-indigo-700"><%= notice %></div>
  <% } %>
  <% if (!smsEnabled) { %>
    <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-2 text-xs text-amber-700">
      알리고 문자 발송이 꺼져 있습니다 — <code>.env</code>의 <code>ALIGO_API_KEY</code>, <code>ALIGO_USER_ID</code>, <code>ALIGO_SENDER</code>를 설정하고 재시작하세요.
    </div>
  <% } %>
  <% if (usingDefaultPw) { %>
    <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-2 text-xs text-amber-700">
      임시 비밀번호(<code>admin</code>) 사용 중 — 배포 전 <code>.env</code>의 <code>ADMIN_PASSWORD</code>를 설정하세요.
    </div>
  <% } %>
</div>

<!-- 날짜별 매출 -->
<div class="border-b border-gray-200 p-6">
  <h3 class="mb-3 text-lg font-bold text-gray-800">날짜별 매출 기록 (최근 30일)</h3>
  <div class="overflow-x-auto rounded-xl border shadow-sm">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">날짜</th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">건수</th>
          <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">매출액</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% if (!dailySales.length) { %>
          <tr><td colspan="3" class="py-4 text-center text-sm text-gray-500">매출 기록이 없습니다.</td></tr>
        <% } %>
        <% dailySales.forEach(function (d) { %>
          <tr>
            <td class="whitespace-nowrap px-6 py-3 text-sm text-gray-900"><%= d.date %></td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm text-gray-500"><%= d.count %>건</td>
            <td class="whitespace-nowrap px-6 py-3 text-right text-sm font-medium text-green-700"><%= won(d.amount) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- 결제 목록 -->
<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">ID</th>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">주문번호</th>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">휴대폰</th>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">결제금액</th>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">문자</th>
        <th scope="col" class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-gray-500">결제일</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 bg-white">
      <% if (!payments.length) { %>
        <tr><td colspan="6" class="py-10 text-center text-sm text-gray-500">아직 결제 내역이 없습니다.</td></tr>
      <% } %>
      <% payments.forEach(function (p) { %>
        <tr class="transition-colors duration-150 hover:bg-gray-50">
          <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900">
            <a href="/products/dark-psych-love/report/<%= p.publicId %>" class="font-semibold text-indigo-600 underline">#<%= p.id %></a>
          </td>
          <td class="max-w-[16rem] truncate px-6 py-4 text-sm text-gray-500"><%= p.orderId || '-' %></td>
          <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900"><%= maskPhone(p.phone) %></td>
          <td class="whitespace-nowrap px-6 py-4">
            <span class="inline-flex rounded-full bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800"><%= won(p.amount) %></span>
          </td>
          <td class="whitespace-nowrap px-6 py-4 text-sm">
            <%# 결제는 됐는데 문자가 안 갔을 때 복구용. 알리고 응답은 상단 알림으로 그대로 보여준다. %>
            <form method="post" action="/admin/reports/<%= p.id %>/resend-sms">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="text-xs text-indigo-600 underline disabled:text-gray-400 disabled:no-underline" <%= p.phone ? '' : 'disabled' %>>
                <%= p.phone ? (p.smsSentAt ? '재발송' : '발송') : '번호 없음' %>
              </button>
            </form>
          </td>
          <td class="whitespace-nowrap px-6 py-4 text-right text-sm text-gray-900"><%= formatDateTime(p.createdAt) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- 페이지네이션 -->
<div class="border-t border-gray-200 bg-white px-4 py-3 sm:px-6">
  <div class="flex flex-col items-center justify-between sm:flex-row">
    <p class="mb-4 text-sm text-gray-700 sm:mb-0"><%= totalCount %> 건</p>
    <% if (totalPages > 1) { %>
      <div class="relative z-0 -space-x-px inline-flex rounded-md shadow-sm">
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/admin?page=<%= i %>"
             class="relative inline-flex items-center border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-indigo-100 <%= i === page ? 'bg-indigo-50 text-indigo-600' : 'bg-white text-gray-700' %>"><%= i %></a>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
