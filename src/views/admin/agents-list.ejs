<div class="px-4 py-6">
  <div class="flex items-center justify-between">
    <h1 class="text-lg font-bold">에이전트 관리</h1>
    <form method="post" action="/admin/logout"><button class="text-xs text-ink-soft underline">로그아웃</button></form>
  </div>
  <p class="mt-1 text-sm text-ink-soft">상담 봇의 인격(시스템 프롬프트)·모델·파라미터를 코드 없이 관리합니다.</p>

  <a href="/admin/sales" class="mt-3 inline-block text-xs text-accent underline">매출 보기 →</a>

  <% if (usingDefaultPw) { %>
    <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-2 text-[11px] text-amber-700">
      임시 비밀번호(<code>admin</code>) 사용 중 — 배포 전 <code>.env</code>의 <code>ADMIN_PASSWORD</code>를 설정하세요.
    </div>
  <% } %>

  <a href="/admin/agents/new" class="btn-primary mt-5 w-full">+ 새 에이전트 만들기</a>

  <div class="mt-5 space-y-3">
    <% if (!agents.length) { %>
      <p class="rounded-lg bg-gray-50 p-6 text-center text-sm text-ink-soft">아직 에이전트가 없습니다. 위 버튼으로 만들어 보세요.</p>
    <% } %>
    <% agents.forEach(function (a) { %>
      <div class="flat-card p-4">
        <div class="flex items-start justify-between gap-2">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <p class="truncate text-sm font-semibold"><%= a.name %></p>
              <span class="shrink-0 rounded-full px-2 py-0.5 text-[10px] <%= a.isActive ? 'bg-accent-soft text-accent' : 'bg-gray-100 text-ink-soft' %>"><%= a.isActive ? '활성' : '비활성' %></span>
            </div>
            <p class="mt-0.5 truncate text-[11px] text-ink-soft">/<%= a.slug %> · <%= a.model || '기본 모델' %> · effort <%= a.effort %></p>
            <% if (a.description) { %><p class="mt-1 line-clamp-2 text-xs text-ink-soft"><%= a.description %></p><% } %>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <a href="/admin/agents/<%= a.id %>/edit" class="btn-outline !px-3 !py-1.5 text-xs">수정</a>
          <a href="/products/dark-psych-love/counsel?agent=<%= a.slug %>" class="btn-outline !px-3 !py-1.5 text-xs">대화 테스트</a>
          <form method="post" action="/admin/agents/<%= a.id %>/toggle"><button class="btn-outline !px-3 !py-1.5 text-xs"><%= a.isActive ? '비활성화' : '활성화' %></button></form>
          <form method="post" action="/admin/agents/<%= a.id %>/delete" onsubmit="return confirm('삭제할까요? 되돌릴 수 없습니다.');"><button class="!px-3 !py-1.5 text-xs text-red-500">삭제</button></form>
        </div>
      </div>
    <% }); %>
  </div>
</div>
