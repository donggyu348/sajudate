<%
  const a = agent || {};
  const isEdit = a && a.id;
  const action = isEdit ? ('/admin/agents/' + a.id) : '/admin/agents';
  function v(x) { return x == null ? '' : String(x); }
%>
<div class="px-4 py-6">
  <a href="/admin/agents" class="text-xs text-ink-soft">← 목록으로</a>
  <h1 class="mt-2 text-lg font-bold"><%= isEdit ? '에이전트 수정' : '새 에이전트' %></h1>

  <% if (error) { %>
    <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-600"><%= error %></div>
  <% } %>

  <form method="post" action="<%= action %>" class="mt-5 space-y-4">
    <div>
      <label class="text-sm font-medium">이름 *</label>
      <input type="text" name="name" value="<%= v(a.name) %>" required placeholder="예: 관계 상담사"
        class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:border-accent focus:outline-none" />
    </div>

    <div>
      <label class="text-sm font-medium">slug (URL 키, 비우면 자동)</label>
      <input type="text" name="slug" value="<%= v(a.slug) %>" placeholder="예: relationship-counselor"
        class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:border-accent focus:outline-none" />
    </div>

    <div>
      <label class="text-sm font-medium">한 줄 설명</label>
      <input type="text" name="description" value="<%= v(a.description) %>" placeholder="목록/채팅 화면에 노출"
        class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:border-accent focus:outline-none" />
    </div>

    <div>
      <label class="text-sm font-medium">시스템 프롬프트 * <span class="font-normal text-ink-soft">(봇의 인격·규칙)</span></label>
      <textarea name="systemPrompt" rows="12" required placeholder="당신은 ~~ 입니다. [역할] ... [하지 말 것] ... [안전] ..."
        class="mt-1.5 w-full resize-y rounded-lg border border-line px-3 py-2.5 font-mono text-xs leading-relaxed focus:border-accent focus:outline-none"><%= v(a.systemPrompt) %></textarea>
      <p class="mt-1 text-[11px] text-ink-soft">위기 신호(자해·폭력) 대응, 진단 단정 금지 등 안전 지침을 꼭 포함하세요.</p>
    </div>

    <div>
      <label class="text-sm font-medium">첫 인사말</label>
      <textarea name="greeting" rows="2" placeholder="안녕하세요. 어떤 이야기가 있으신가요?"
        class="mt-1.5 w-full resize-y rounded-lg border border-line px-3 py-2.5 text-sm focus:border-accent focus:outline-none"><%= v(a.greeting) %></textarea>
    </div>

    <div class="grid grid-cols-3 gap-3">
      <div class="col-span-3">
        <label class="text-sm font-medium">모델 (비우면 서버 기본)</label>
        <input type="text" name="model" value="<%= v(a.model) %>" placeholder="claude-opus-5 / claude-sonnet-5"
          class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:border-accent focus:outline-none" />
      </div>
      <div>
        <label class="text-sm font-medium">max tokens</label>
        <input type="number" name="maxTokens" value="<%= v(a.maxTokens || 1600) %>" min="256" max="8000"
          class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:border-accent focus:outline-none" />
      </div>
      <div>
        <label class="text-sm font-medium">effort</label>
        <select name="effort" class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:border-accent focus:outline-none">
          <% ['low','medium','high'].forEach(function (e) { %>
            <option value="<%= e %>" <%= (a.effort || 'low') === e ? 'selected' : '' %>><%= e %></option>
          <% }); %>
        </select>
      </div>
      <div>
        <label class="text-sm font-medium">정렬순서</label>
        <input type="number" name="sortOrder" value="<%= v(a.sortOrder || 0) %>"
          class="mt-1.5 w-full rounded-lg border border-line px-3 py-2.5 text-sm focus:border-accent focus:outline-none" />
      </div>
    </div>

    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="isActive" <%= (a.id ? a.isActive : true) ? 'checked' : '' %> class="h-4 w-4 rounded border-line text-accent" />
      활성 (채팅 화면에 노출)
    </label>

    <button type="submit" class="btn-primary w-full"><%= isEdit ? '저장' : '만들기' %></button>
  </form>
</div>
