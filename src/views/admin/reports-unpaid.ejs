<%
  function formatDateTime(d) {
    const dt = new Date(d);
    return dt.getFullYear() + '.' + String(dt.getMonth() + 1).padStart(2, '0') + '.' + String(dt.getDate()).padStart(2, '0') +
      ' ' + String(dt.getHours()).padStart(2, '0') + ':' + String(dt.getMinutes()).padStart(2, '0');
  }
%>
<div class="border-b border-gray-200 p-6">
  <h2 class="text-xl font-bold text-gray-800">미결제 리포트</h2>
  <p class="mt-1 max-w-3xl text-sm text-gray-500">
    토스 결제는 승인됐는데 successUrl 리다이렉트가 유실돼 우리 서버가 결제를 못 받은 경우, 고객이 결제 시 받은
    영수증/토스 앱 내역에서 <b>paymentKey</b>와 <b>orderId</b>를 확인해 아래에서 수동으로 확인·해제할 수 있어요.
    입력한 값은 토스 승인 API로 실제 검증한 뒤에만 잠금이 풀립니다.
  </p>

  <% if (error) { %>
    <div class="mt-3 rounded-lg border border-red-200 bg-red-50 p-2 text-xs text-red-700"><%= error %></div>
  <% } %>
  <% if (usingDefaultPw) { %>
    <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-2 text-xs text-amber-700">
      임시 비밀번호(<code>admin</code>) 사용 중 — 배포 전 <code>.env</code>의 <code>ADMIN_PASSWORD</code>를 설정하세요.
    </div>
  <% } %>
</div>

<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">ID</th>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">생성일</th>
        <th scope="col" class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-gray-500">수동 결제 확인</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 bg-white">
      <% if (!reports.length) { %>
        <tr><td colspan="3" class="py-10 text-center text-sm text-gray-500">미결제 리포트가 없습니다.</td></tr>
      <% } %>
      <% reports.forEach(function (r) { %>
        <tr class="transition-colors duration-150 hover:bg-gray-50">
          <td class="whitespace-nowrap px-6 py-4 text-sm">
            <a href="/products/dark-psych-love/report/<%= r.publicId %>" class="font-semibold text-indigo-600 underline">#<%= r.id %></a>
          </td>
          <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= formatDateTime(r.createdAt) %></td>
          <td class="px-6 py-4">
            <form method="post" action="/admin/reports/<%= r.id %>/mark-paid" class="flex flex-wrap items-center gap-1.5">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <input name="paymentKey" placeholder="paymentKey" class="min-w-0 flex-1 rounded-lg border border-gray-300 bg-gray-50 px-2 py-1.5 text-xs focus:border-indigo-500 focus:bg-white focus:outline-none" required />
              <input name="orderId" placeholder="orderId" class="min-w-0 flex-1 rounded-lg border border-gray-300 bg-gray-50 px-2 py-1.5 text-xs focus:border-indigo-500 focus:bg-white focus:outline-none" required />
              <button type="submit" class="shrink-0 rounded-lg bg-indigo-600 px-3 py-1.5 text-xs font-semibold text-white hover:bg-indigo-700">결제 확인 후 해제</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
