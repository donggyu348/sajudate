<%
  function formatDate(d) {
    const dt = new Date(d);
    return dt.getFullYear() + '.' + String(dt.getMonth() + 1).padStart(2, '0') + '.' + String(dt.getDate()).padStart(2, '0') +
      ' ' + String(dt.getHours()).padStart(2, '0') + ':' + String(dt.getMinutes()).padStart(2, '0');
  }
%>
<div class="px-4 py-6">
  <div class="flex items-center justify-between">
    <h1 class="text-lg font-bold">미결제 리포트</h1>
    <form method="post" action="/admin/logout"><button class="text-xs text-ink-soft underline">로그아웃</button></form>
  </div>
  <p class="mt-1 text-sm text-ink-soft">
    토스 결제는 승인됐는데 successUrl 리다이렉트가 유실돼 우리 서버가 결제를 못 받은 경우, 고객이 결제 시 받은
    영수증/토스 앱 내역에서 <b>paymentKey</b>와 <b>orderId</b>를 확인해 아래에서 수동으로 확인·해제할 수 있어요.
    입력한 값은 토스 승인 API로 실제 검증한 뒤에만 잠금이 풀립니다.
  </p>

  <a href="/admin/sales" class="mt-3 inline-block text-xs text-accent underline">← 매출로</a>

  <% if (error) { %>
    <div class="mt-3 rounded-lg border border-red-200 bg-red-50 p-2 text-[11px] text-red-700"><%= error %></div>
  <% } %>

  <div class="mt-5 space-y-3">
    <% if (!reports.length) { %>
      <p class="rounded-lg bg-gray-50 p-6 text-center text-sm text-ink-soft">미결제 리포트가 없습니다.</p>
    <% } %>
    <% reports.forEach(function (r) { %>
      <div class="flat-card p-3">
        <div class="flex items-center justify-between">
          <a href="/products/dark-psych-love/report/<%= r.publicId %>" class="text-sm font-semibold text-ink underline">리포트 #<%= r.id %></a>
          <span class="text-[11px] text-ink-soft"><%= formatDate(r.createdAt) %></span>
        </div>
        <form method="post" action="/admin/reports/<%= r.id %>/mark-paid" class="mt-2 flex flex-wrap items-center gap-1.5">
          <input name="paymentKey" placeholder="paymentKey" class="min-w-0 flex-1 rounded-lg border border-line bg-gray-50 px-2 py-1.5 text-[11px] focus:border-accent focus:bg-white focus:outline-none" required />
          <input name="orderId" placeholder="orderId" class="min-w-0 flex-1 rounded-lg border border-line bg-gray-50 px-2 py-1.5 text-[11px] focus:border-accent focus:bg-white focus:outline-none" required />
          <button type="submit" class="shrink-0 rounded-lg bg-accent px-3 py-1.5 text-[11px] font-semibold text-white">결제 확인 후 해제</button>
        </form>
      </div>
    <% }); %>
  </div>
</div>
