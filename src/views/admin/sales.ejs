<%
  function won(n) { return (n || 0).toLocaleString('ko-KR') + '원'; }
  function maskPhone(p) {
    if (!p) return '-';
    const s = String(p);
    if (s.length < 7) return s;
    return s.slice(0, 3) + '-****-' + s.slice(-4);
  }
  function formatDate(d) {
    const dt = new Date(d);
    return dt.getFullYear() + '.' + String(dt.getMonth() + 1).padStart(2, '0') + '.' + String(dt.getDate()).padStart(2, '0') +
      ' ' + String(dt.getHours()).padStart(2, '0') + ':' + String(dt.getMinutes()).padStart(2, '0');
  }
%>
<div class="px-4 py-6">
  <div class="flex items-center justify-between">
    <h1 class="text-lg font-bold">매출</h1>
    <form method="post" action="/admin/logout"><button class="text-xs text-ink-soft underline">로그아웃</button></form>
  </div>
  <p class="mt-1 text-sm text-ink-soft">전체 리포트 잠금 해제 결제 현황입니다.</p>

  <a href="/admin/agents" class="mt-3 inline-block text-xs text-accent underline">← 에이전트 관리로</a>

  <% if (usingDefaultPw) { %>
    <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-2 text-[11px] text-amber-700">
      임시 비밀번호(<code>admin</code>) 사용 중 — 배포 전 <code>.env</code>의 <code>ADMIN_PASSWORD</code>를 설정하세요.
    </div>
  <% } %>

  <div class="mt-5 grid grid-cols-3 gap-2">
    <div class="flat-card p-3 text-center">
      <p class="text-[10px] text-ink-soft">오늘</p>
      <p class="mt-1 text-sm font-bold text-ink"><%= won(todayRevenue) %></p>
    </div>
    <div class="flat-card p-3 text-center">
      <p class="text-[10px] text-ink-soft">이번 달</p>
      <p class="mt-1 text-sm font-bold text-ink"><%= won(monthRevenue) %></p>
    </div>
    <div class="flat-card p-3 text-center">
      <p class="text-[10px] text-ink-soft">누적</p>
      <p class="mt-1 text-sm font-bold text-accent"><%= won(totalRevenue) %></p>
    </div>
  </div>

  <p class="mt-6 text-sm font-bold">결제 내역 <span class="text-ink-soft font-normal">(<%= totalCount %>건)</span></p>

  <div class="mt-3 space-y-2">
    <% if (!payments.length) { %>
      <p class="rounded-lg bg-gray-50 p-6 text-center text-sm text-ink-soft">아직 결제 내역이 없습니다.</p>
    <% } %>
    <% payments.forEach(function (p) { %>
      <div class="flat-card p-3">
        <div class="flex items-center justify-between">
          <a href="/products/dark-psych-love/report/<%= p.id %>" class="text-sm font-semibold text-ink underline">리포트 #<%= p.id %></a>
          <span class="text-sm font-bold text-accent"><%= won(p.amount) %></span>
        </div>
        <div class="mt-1 flex items-center justify-between text-[11px] text-ink-soft">
          <span><%= formatDate(p.createdAt) %></span>
          <span><%= maskPhone(p.phone) %></span>
        </div>
        <% if (p.orderId) { %>
          <p class="mt-1 truncate text-[10px] text-ink-soft/70">주문번호 <%= p.orderId %></p>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>
