# 서버
NODE_ENV=development
PORT=3000
# 운영에서는 반드시 강한 랜덤 값 지정 (미지정 시 NODE_ENV=production 기동이 차단됨)
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production

# 전화번호 등 PII의 DB 필드 암호화 키 — 32바이트 hex(64자). 운영에서 필수.
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 주의: 이 키를 잃어버리면 기존에 저장된 전화번호를 복호화할 수 없습니다.
FIELD_ENCRYPTION_KEY=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=psychology_platform
DB_USER=root
DB_PASSWORD=

# LLM (카카오 대화 분석 + AI 상담 봇) — 실제 사용 시 채워넣기
# Anthropic SDK는 ANTHROPIC_API_KEY를 읽음. 없으면 LLM_API_KEY로 대체 사용.
ANTHROPIC_API_KEY=
LLM_API_KEY=
# 상담 봇/분석 기본 모델 (미설정 시 claude-opus-5)
LLM_MODEL=claude-opus-5
# 카톡 캡처 이미지 판독(비전 OCR) 전용 모델 (미설정 시 claude-sonnet-5)
KAKAO_VISION_MODEL=claude-sonnet-5

# 관리자 UI 비밀번호 (미설정 시 임시로 'admin' 사용 — 배포 전 반드시 지정)
ADMIN_PASSWORD=

# 토스페이먼츠 (전체 리포트 잠금 해제 결제) — 개발 중엔 테스트키(test_ck_/test_sk_) 사용 권장
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 알리고(Aligo) 문자 발송 — 결제 완료 후 리포트 링크 문자 전송에 사용. 발신번호는 알리고에 사전 등록 필요
ALIGO_API_KEY=
ALIGO_USER_ID=
ALIGO_SENDER=
# 'true'로 두면 실제 발송 없이 테스트 모드로 호출(알리고 계정에 테스트 모드 지원 여부 확인 필요)
ALIGO_TEST_MODE=false
