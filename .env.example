# 서버
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-in-production

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=psychology_platform
DB_USER=root
DB_PASSWORD=

# LLM (카카오 대화 분석 + AI 상담 봇) — 실제 사용 시 채워넣기
# Anthropic SDK는 ANTHROPIC_API_KEY를 읽음. 없으면 LLM_API_KEY로 대체 사용.
ANTHROPIC_API_KEY=
LLM_API_KEY=
# 상담 봇/분석 기본 모델 (미설정 시 claude-opus-5)
LLM_MODEL=claude-opus-5

# 관리자 UI 비밀번호 (미설정 시 임시로 'admin' 사용 — 배포 전 반드시 지정)
ADMIN_PASSWORD=
