<%
  function productHref(p) {
    return '/products/' + p.slug;
  }
%>

<!-- 카테고리 탭 -->
<div class="sticky top-14 z-20 border-b border-line bg-white">
  <div class="no-scrollbar flex gap-2 overflow-x-auto px-4 py-3">
    <% categories.forEach(function (c) { %>
      <a href="<%= c === '전체' ? '/' : '/?category=' + encodeURIComponent(c) %>"
         class="chip <%= selected === c ? 'chip-active' : '' %>"><%= c %></a>
    <% }); %>
  </div>
</div>

<!-- 세로형 메인 배너 캐러셀 (4:5) -->
<% if (featured && featured.length) { %>
<section class="px-4 pt-4">
  <div id="banner" class="no-scrollbar flex snap-x snap-mandatory gap-3 overflow-x-auto">
    <% featured.forEach(function (p, i) { %>
      <a href="<%= productHref(p) %>" class="relative aspect-[4/5] w-full shrink-0 snap-center overflow-hidden rounded-2xl border border-line"
         style="flex-basis: 100%;">
        <!-- 이미지 자리 (직접 업로드 예정) -->
        <% if (p.thumbnailUrl) { %>
          <img src="<%= p.thumbnailUrl %>" alt="<%= p.name %>" class="h-full w-full object-cover" />
        <% } else { %>
          <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 text-xs text-ink-soft">이미지 준비 중 (4:5)</div>
        <% } %>
        <!-- 그라데이션 오버레이 -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
        <!-- 추천 뱃지 (우상단) -->
        <span class="badge-featured absolute right-3 top-3">추천</span>
        <!-- 헤드/서브 카피 (하단) -->
        <div class="absolute inset-x-0 bottom-0 p-5 text-white">
          <p class="text-lg font-bold leading-snug"><%= p.headline || p.name %></p>
          <% if (p.subcopy) { %><p class="mt-1 text-sm text-white/85"><%= p.subcopy %></p><% } %>
        </div>
      </a>
    <% }); %>
  </div>
  <!-- 도트 인디케이터 -->
  <% if (featured.length > 1) { %>
  <div id="bannerDots" class="mt-3 flex justify-center gap-1.5">
    <% featured.forEach(function (p, i) { %>
      <span class="h-1.5 w-1.5 rounded-full <%= i === 0 ? 'bg-accent' : 'bg-line' %>" data-dot="<%= i %>"></span>
    <% }); %>
  </div>
  <% } %>
</section>
<% } %>

<!-- 훅 섹션 (동적 카피) -->
<section class="px-4 pt-8">
  <h2 class="text-lg font-bold leading-snug"><%= hook.title %></h2>
  <p class="mt-1 text-sm text-ink-soft"><%= hook.subtitle %></p>
</section>

<!-- 가로 스크롤 상품 카드 -->
<section class="pt-4">
  <% if (!products.length) { %>
    <p class="px-4 py-10 text-center text-sm text-ink-soft">표시할 상품이 없습니다.</p>
  <% } else { %>
  <div class="no-scrollbar flex gap-3 overflow-x-auto px-4 pb-2">
    <% products.forEach(function (p) { %>
      <a href="<%= productHref(p) %>" class="flat-card w-40 shrink-0 overflow-hidden">
        <div class="aspect-[4/5] w-full">
          <% if (p.thumbnailUrl) { %>
            <img src="<%= p.thumbnailUrl %>" alt="<%= p.name %>" class="h-full w-full object-cover" />
          <% } else { %>
            <div class="flex h-full w-full items-center justify-center bg-gray-100 text-[11px] text-ink-soft">이미지 준비 중</div>
          <% } %>
        </div>
        <div class="p-3">
          <span class="text-[11px] text-accent"><%= p.category %></span>
          <p class="mt-0.5 line-clamp-2 text-sm font-semibold leading-snug"><%= p.name %></p>
        </div>
      </a>
    <% }); %>
  </div>
  <% } %>
</section>

<script>
  (function () {
    const banner = document.getElementById('banner');
    const dots = document.querySelectorAll('#bannerDots [data-dot]');
    if (!banner || !dots.length) return;
    banner.addEventListener('scroll', function () {
      const idx = Math.round(banner.scrollLeft / banner.clientWidth);
      dots.forEach(function (d, i) {
        d.classList.toggle('bg-accent', i === idx);
        d.classList.toggle('bg-line', i !== idx);
      });
    }, { passive: true });
  })();
</script>
