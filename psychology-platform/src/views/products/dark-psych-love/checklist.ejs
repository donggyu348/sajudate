<div class="p-4">
  <h1 class="text-lg font-bold">관계 체크리스트</h1>
  <p class="mt-1 text-sm text-ink-soft">상대가 관계 안에서 보이는 모습을 떠올리며 응답해 주세요. (총 <%= items.length %>문항)</p>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mt-4 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-600"><%= error %></div>
  <% } %>

  <form method="post" action="<%= base %>/checklist" id="checklistForm" class="mt-5 space-y-5">
    <% items.forEach(function (item, idx) { %>
      <fieldset class="flat-card p-4">
        <legend class="mb-3 flex gap-2 text-sm font-medium leading-snug">
          <span class="text-accent"><%= idx + 1 %>.</span>
          <span><%= item.text %></span>
        </legend>
        <div class="grid grid-cols-5 gap-1.5">
          <% scale.forEach(function (s) {
               const prevVal = (typeof prev !== 'undefined' && prev) ? prev['q' + item.id] : null;
               const checked = String(prevVal) === String(s.value);
          %>
            <label class="flex cursor-pointer flex-col items-center gap-1">
              <input type="radio" name="q<%= item.id %>" value="<%= s.value %>" class="peer sr-only" <%= checked ? 'checked' : '' %> required />
              <span class="flex h-9 w-full items-center justify-center rounded-lg border border-line text-sm text-ink-soft peer-checked:border-accent peer-checked:bg-accent peer-checked:text-white"><%= s.value %></span>
              <span class="text-center text-[10px] leading-tight text-ink-soft"><%= s.label %></span>
            </label>
          <% }); %>
        </div>
      </fieldset>
    <% }); %>

    <button type="submit" class="btn-primary w-full">결과 보기</button>
  </form>
</div>
